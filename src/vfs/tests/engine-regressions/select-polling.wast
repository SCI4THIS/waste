;; Real SELECT/pselect polling: errors, copied guest buffers, pipe sets and
;; descriptor word boundaries. All successful polls use a zero timeout.
;; The legacy import ABI returns raw negative errno (including EINVAL for
;; rejected input spans); this fixture does not assume libc errno translation.
(module
  (import "env" "select" (func $select (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "pselect" (func $pselect (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "env" "pipe" (func $pipe (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (import "env" "dup2" (func $dup2 (param i32 i32) (result i32)))
  (memory 1)
  (global $reader (mut i32) (i32.const -1))
  (global $writer (mut i32) (i32.const -1))
  ;; 128-byte sets at 64/208/352, canaries at 192/336/480;
  ;; timeval/timespec at 512, empty sigset at 544, pipe pair at 16.
  (data (i32.const 576) "test")
  (func (export "word") (param i32) (result i32) (i32.load (local.get 0)))
  (func (export "store") (param i32 i32) (i32.store (local.get 0) (local.get 1)))
  (func (export "clear")
    (memory.fill (i32.const 64) (i32.const 0) (i32.const 128))
    (memory.fill (i32.const 208) (i32.const 0) (i32.const 128))
    (memory.fill (i32.const 352) (i32.const 0) (i32.const 128)))
  (func $address (param $base i32) (param $fd i32) (result i32)
    (i32.add (local.get $base) (i32.mul (i32.div_u (local.get $fd) (i32.const 32)) (i32.const 4))))
  (func (export "set") (param $base i32) (param $fd i32)
    (i32.store (call $address (local.get $base) (local.get $fd))
      (i32.or (i32.load (call $address (local.get $base) (local.get $fd)))
        (i32.shl (i32.const 1) (local.get $fd)))))
  (func (export "bit") (param $base i32) (param $fd i32) (result i32)
    (i32.ne (i32.and (i32.load (call $address (local.get $base) (local.get $fd)))
      (i32.shl (i32.const 1) (local.get $fd))) (i32.const 0)))
  (func (export "timeout") (param i64 i32)
    (i64.store (i32.const 512) (local.get 0))
    (i32.store (i32.const 520) (local.get 1)))
  (func (export "select") (param i32 i32 i32 i32 i32) (result i32)
    (call $select (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4)))
  (func (export "pselect") (param i32 i32 i32 i32 i32 i32) (result i32)
    (call $pselect (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4) (local.get 5)))
  (func (export "pipe") (result i32) (local $result i32)
    (local.set $result (call $pipe (i32.const 16)))
    (global.set $reader (i32.load (i32.const 16)))
    (global.set $writer (i32.load (i32.const 20)))
    (local.get $result))
  (func (export "pair") (result i32)
    (i32.and (i32.eq (global.get $reader) (i32.const 0))
      (i32.eq (global.get $writer) (i32.const 1))))
  (func (export "write") (param i32) (result i32)
    (call $write (global.get $writer) (i32.const 576) (local.get 0)))
  (func (export "read") (param i32) (result i32)
    (call $read (global.get $reader) (i32.const 1024) (local.get 0)))
  (func (export "fill") (result i32)
    (memory.fill (i32.const 4096) (i32.const 120) (i32.const 4096))
    (call $write (global.get $writer) (i32.const 4096) (i32.const 4096)))
  (func (export "close") (param i32) (result i32) (call $close (local.get 0)))
  (func (export "dup2") (param i32 i32) (result i32)
    (call $dup2 (local.get 0) (local.get 1))))


;; EINVAL: nfds and timeval/timespec validation through real imports.
(assert_return (invoke "timeout" (i64.const 0) (i32.const 0)))
(assert_return (invoke "select" (i32.const -1) (i32.const 64) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const -22))
(assert_return (invoke "select" (i32.const 1025) (i32.const 64) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const -22))
(assert_return (invoke "timeout" (i64.const -1) (i32.const 0)))
(assert_return (invoke "select" (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const -22))
(assert_return (invoke "timeout" (i64.const 0) (i32.const -1)))
(assert_return (invoke "select" (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const -22))
(assert_return (invoke "timeout" (i64.const 0) (i32.const 1000000)))
(assert_return (invoke "select" (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const -22))
(assert_return (invoke "timeout" (i64.const -1) (i32.const 0)))
(assert_return (invoke "pselect" (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 512) (i32.const 0)) (i32.const -22))
(assert_return (invoke "timeout" (i64.const 0) (i32.const -1)))
(assert_return (invoke "pselect" (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 512) (i32.const 0)) (i32.const -22))
(assert_return (invoke "timeout" (i64.const 0) (i32.const 1000000000)))
(assert_return (invoke "pselect" (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 512) (i32.const 0)) (i32.const -22))
(assert_return (invoke "timeout" (i64.const 0) (i32.const 0)))

;; All-null and empty-set bounded polls; EAGAIN remains a private C boundary.
(assert_return (invoke "select" (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const 0))
(assert_return (invoke "pselect" (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 512) (i32.const 0)) (i32.const 0))
(assert_return (invoke "clear"))
(assert_return (invoke "select" (i32.const 3) (i32.const 64) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const 0))

;; Closed descriptors in each interest set, plus all three high-fd cases.
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 64) (i32.const 0)))
(assert_return (invoke "select" (i32.const 1) (i32.const 64) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const -9))
(assert_return (invoke "bit" (i32.const 64) (i32.const 0)) (i32.const 1))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 208) (i32.const 5)))
(assert_return (invoke "select" (i32.const 6) (i32.const 0) (i32.const 208) (i32.const 0) (i32.const 512)) (i32.const -9))
(assert_return (invoke "bit" (i32.const 208) (i32.const 5)) (i32.const 1))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 352) (i32.const 10)))
(assert_return (invoke "select" (i32.const 11) (i32.const 0) (i32.const 0) (i32.const 352) (i32.const 512)) (i32.const -9))
(assert_return (invoke "bit" (i32.const 352) (i32.const 10)) (i32.const 1))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 64) (i32.const 3)))
(assert_return (invoke "pselect" (i32.const 4) (i32.const 64) (i32.const 0) (i32.const 0) (i32.const 512) (i32.const 0)) (i32.const -9))
(assert_return (invoke "bit" (i32.const 64) (i32.const 3)) (i32.const 1))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 64) (i32.const 65)))
(assert_return (invoke "select" (i32.const 66) (i32.const 64) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const -9))
(assert_return (invoke "bit" (i32.const 64) (i32.const 65)) (i32.const 1))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 208) (i32.const 65)))
(assert_return (invoke "select" (i32.const 66) (i32.const 0) (i32.const 208) (i32.const 0) (i32.const 512)) (i32.const -9))
(assert_return (invoke "bit" (i32.const 208) (i32.const 65)) (i32.const 1))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 352) (i32.const 65)))
(assert_return (invoke "select" (i32.const 66) (i32.const 0) (i32.const 0) (i32.const 352) (i32.const 512)) (i32.const -9))
(assert_return (invoke "bit" (i32.const 352) (i32.const 65)) (i32.const 1))

;; Rejected input spans/timeouts/masks preserve valid output sets and canaries.
(assert_return (invoke "store" (i32.const 192) (i32.const 324478056)))
(assert_return (invoke "store" (i32.const 336) (i32.const 324478056)))
(assert_return (invoke "store" (i32.const 480) (i32.const 324478056)))
(assert_return (invoke "store" (i32.const 64) (i32.const 2864434397)))
(assert_return (invoke "store" (i32.const 208) (i32.const 287454020)))
(assert_return (invoke "store" (i32.const 352) (i32.const 1432778632)))
(assert_return (invoke "select" (i32.const 0) (i32.const 65528) (i32.const 208) (i32.const 352) (i32.const 512)) (i32.const -22))
(assert_return (invoke "word" (i32.const 64)) (i32.const 2864434397))
(assert_return (invoke "word" (i32.const 208)) (i32.const 287454020))
(assert_return (invoke "word" (i32.const 352)) (i32.const 1432778632))
(assert_return (invoke "word" (i32.const 192)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 336)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 480)) (i32.const 324478056))
(assert_return (invoke "select" (i32.const 0) (i32.const 64) (i32.const 65528) (i32.const 352) (i32.const 512)) (i32.const -22))
(assert_return (invoke "word" (i32.const 64)) (i32.const 2864434397))
(assert_return (invoke "word" (i32.const 208)) (i32.const 287454020))
(assert_return (invoke "word" (i32.const 352)) (i32.const 1432778632))
(assert_return (invoke "word" (i32.const 192)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 336)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 480)) (i32.const 324478056))
(assert_return (invoke "select" (i32.const 0) (i32.const 64) (i32.const 208) (i32.const 65528) (i32.const 512)) (i32.const -22))
(assert_return (invoke "word" (i32.const 64)) (i32.const 2864434397))
(assert_return (invoke "word" (i32.const 208)) (i32.const 287454020))
(assert_return (invoke "word" (i32.const 352)) (i32.const 1432778632))
(assert_return (invoke "word" (i32.const 192)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 336)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 480)) (i32.const 324478056))
(assert_return (invoke "select" (i32.const 0) (i32.const 64) (i32.const 208) (i32.const 352) (i32.const 65528)) (i32.const -22))
(assert_return (invoke "word" (i32.const 64)) (i32.const 2864434397))
(assert_return (invoke "word" (i32.const 208)) (i32.const 287454020))
(assert_return (invoke "word" (i32.const 352)) (i32.const 1432778632))
(assert_return (invoke "word" (i32.const 192)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 336)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 480)) (i32.const 324478056))
(assert_return (invoke "pselect" (i32.const 0) (i32.const 65528) (i32.const 208) (i32.const 352) (i32.const 512) (i32.const 544)) (i32.const -22))
(assert_return (invoke "word" (i32.const 64)) (i32.const 2864434397))
(assert_return (invoke "word" (i32.const 208)) (i32.const 287454020))
(assert_return (invoke "word" (i32.const 352)) (i32.const 1432778632))
(assert_return (invoke "word" (i32.const 192)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 336)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 480)) (i32.const 324478056))
(assert_return (invoke "pselect" (i32.const 0) (i32.const 64) (i32.const 65528) (i32.const 352) (i32.const 512) (i32.const 544)) (i32.const -22))
(assert_return (invoke "word" (i32.const 64)) (i32.const 2864434397))
(assert_return (invoke "word" (i32.const 208)) (i32.const 287454020))
(assert_return (invoke "word" (i32.const 352)) (i32.const 1432778632))
(assert_return (invoke "word" (i32.const 192)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 336)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 480)) (i32.const 324478056))
(assert_return (invoke "pselect" (i32.const 0) (i32.const 64) (i32.const 208) (i32.const 65528) (i32.const 512) (i32.const 544)) (i32.const -22))
(assert_return (invoke "word" (i32.const 64)) (i32.const 2864434397))
(assert_return (invoke "word" (i32.const 208)) (i32.const 287454020))
(assert_return (invoke "word" (i32.const 352)) (i32.const 1432778632))
(assert_return (invoke "word" (i32.const 192)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 336)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 480)) (i32.const 324478056))
(assert_return (invoke "pselect" (i32.const 0) (i32.const 64) (i32.const 208) (i32.const 352) (i32.const 65528) (i32.const 544)) (i32.const -22))
(assert_return (invoke "word" (i32.const 64)) (i32.const 2864434397))
(assert_return (invoke "word" (i32.const 208)) (i32.const 287454020))
(assert_return (invoke "word" (i32.const 352)) (i32.const 1432778632))
(assert_return (invoke "word" (i32.const 192)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 336)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 480)) (i32.const 324478056))
(assert_return (invoke "pselect" (i32.const 0) (i32.const 64) (i32.const 208) (i32.const 352) (i32.const 512) (i32.const 65528)) (i32.const -22))
(assert_return (invoke "word" (i32.const 64)) (i32.const 2864434397))
(assert_return (invoke "word" (i32.const 208)) (i32.const 287454020))
(assert_return (invoke "word" (i32.const 352)) (i32.const 1432778632))
(assert_return (invoke "word" (i32.const 192)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 336)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 480)) (i32.const 324478056))

;; Pipe sets use explicitly verified lowest free endpoints in the isolated store.
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "pair") (i32.const 1))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 64) (i32.const 0)))
(assert_return (invoke "set" (i32.const 208) (i32.const 1)))
(assert_return (invoke "select" (i32.const 2) (i32.const 64) (i32.const 208) (i32.const 0) (i32.const 512)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 64) (i32.const 0)) (i32.const 0))
(assert_return (invoke "bit" (i32.const 208) (i32.const 1)) (i32.const 1))
(assert_return (invoke "write" (i32.const 4)) (i32.const 4))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 64) (i32.const 0)))
(assert_return (invoke "select" (i32.const 1) (i32.const 64) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 64) (i32.const 0)) (i32.const 1))
(assert_return (invoke "read" (i32.const 4)) (i32.const 4))
(assert_return (invoke "word" (i32.const 1024)) (i32.const 1953719668))

;; Output sets retain only readable/writable endpoints, counting set bits.
(assert_return (invoke "write" (i32.const 2)) (i32.const 2))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 64) (i32.const 0)))
(assert_return (invoke "set" (i32.const 64) (i32.const 1)))
(assert_return (invoke "set" (i32.const 208) (i32.const 0)))
(assert_return (invoke "set" (i32.const 208) (i32.const 1)))
(assert_return (invoke "select" (i32.const 2) (i32.const 64) (i32.const 208) (i32.const 0) (i32.const 512)) (i32.const 2))
(assert_return (invoke "bit" (i32.const 64) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 64) (i32.const 1)) (i32.const 0))
(assert_return (invoke "bit" (i32.const 208) (i32.const 0)) (i32.const 0))
(assert_return (invoke "bit" (i32.const 208) (i32.const 1)) (i32.const 1))
(assert_return (invoke "read" (i32.const 2)) (i32.const 2))

;; Same OFD appears through two real read descriptors.
(assert_return (invoke "dup2" (i32.const 0) (i32.const 10)) (i32.const 10))
(assert_return (invoke "write" (i32.const 3)) (i32.const 3))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 64) (i32.const 0)))
(assert_return (invoke "set" (i32.const 64) (i32.const 10)))
(assert_return (invoke "select" (i32.const 11) (i32.const 64) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const 2))
(assert_return (invoke "bit" (i32.const 64) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 64) (i32.const 10)) (i32.const 1))
(assert_return (invoke "read" (i32.const 3)) (i32.const 3))
(assert_return (invoke "close" (i32.const 10)) (i32.const 0))

;; Full pipe is not writable; draining sixteen bytes restores readiness.
(assert_return (invoke "fill") (i32.const 4096))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 208) (i32.const 1)))
(assert_return (invoke "select" (i32.const 2) (i32.const 0) (i32.const 208) (i32.const 0) (i32.const 512)) (i32.const 0))
(assert_return (invoke "bit" (i32.const 208) (i32.const 1)) (i32.const 0))
(assert_return (invoke "read" (i32.const 16)) (i32.const 16))
(assert_return (invoke "word" (i32.const 1024)) (i32.const 2021161080))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 208) (i32.const 1)))
(assert_return (invoke "select" (i32.const 2) (i32.const 0) (i32.const 208) (i32.const 0) (i32.const 512)) (i32.const 1))
(assert_return (invoke "read" (i32.const 4096)) (i32.const 4080))

;; Real duplicate writers cover sign bits, word boundaries and nfds filtering.
(assert_return (invoke "dup2" (i32.const 1) (i32.const 31)) (i32.const 31))
(assert_return (invoke "dup2" (i32.const 1) (i32.const 32)) (i32.const 32))
(assert_return (invoke "dup2" (i32.const 1) (i32.const 63)) (i32.const 63))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 64) (i32.const 1)))
(assert_return (invoke "set" (i32.const 64) (i32.const 31)))
(assert_return (invoke "set" (i32.const 64) (i32.const 32)))
(assert_return (invoke "set" (i32.const 64) (i32.const 63)))
(assert_return (invoke "set" (i32.const 208) (i32.const 1)))
(assert_return (invoke "set" (i32.const 208) (i32.const 31)))
(assert_return (invoke "set" (i32.const 208) (i32.const 32)))
(assert_return (invoke "set" (i32.const 208) (i32.const 63)))
(assert_return (invoke "set" (i32.const 352) (i32.const 1)))
(assert_return (invoke "set" (i32.const 352) (i32.const 31)))
(assert_return (invoke "set" (i32.const 352) (i32.const 32)))
(assert_return (invoke "set" (i32.const 352) (i32.const 63)))
(assert_return (invoke "pselect" (i32.const 64) (i32.const 64) (i32.const 208) (i32.const 352) (i32.const 512) (i32.const 544)) (i32.const 4))
(assert_return (invoke "word" (i32.const 64)) (i32.const 0))
(assert_return (invoke "word" (i32.const 68)) (i32.const 0))
(assert_return (invoke "word" (i32.const 208)) (i32.const 2147483650))
(assert_return (invoke "word" (i32.const 212)) (i32.const 2147483649))
(assert_return (invoke "word" (i32.const 352)) (i32.const 0))
(assert_return (invoke "word" (i32.const 356)) (i32.const 0))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 208) (i32.const 1)))
(assert_return (invoke "set" (i32.const 208) (i32.const 31)))
(assert_return (invoke "set" (i32.const 208) (i32.const 32)))
(assert_return (invoke "set" (i32.const 208) (i32.const 63)))
(assert_return (invoke "set" (i32.const 208) (i32.const 65)))
(assert_return (invoke "set" (i32.const 208) (i32.const 1023)))
(assert_return (invoke "select" (i32.const 32) (i32.const 0) (i32.const 208) (i32.const 0) (i32.const 512)) (i32.const 2))
(assert_return (invoke "word" (i32.const 208)) (i32.const 2147483650))
(assert_return (invoke "word" (i32.const 212)) (i32.const 0))
(assert_return (invoke "word" (i32.const 216)) (i32.const 0))
(assert_return (invoke "word" (i32.const 332)) (i32.const 0))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 208) (i32.const 1)))
(assert_return (invoke "pselect" (i32.const 1024) (i32.const 0) (i32.const 208) (i32.const 0) (i32.const 512) (i32.const 0)) (i32.const 1))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 208) (i32.const 1)))
(assert_return (invoke "set" (i32.const 208) (i32.const 65)))
(assert_return (invoke "select" (i32.const 65) (i32.const 0) (i32.const 208) (i32.const 0) (i32.const 512)) (i32.const 1))
(assert_return (invoke "word" (i32.const 216)) (i32.const 0))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 208) (i32.const 1)))
(assert_return (invoke "set" (i32.const 208) (i32.const 65)))
(assert_return (invoke "select" (i32.const 66) (i32.const 0) (i32.const 208) (i32.const 0) (i32.const 512)) (i32.const -9))
(assert_return (invoke "word" (i32.const 208)) (i32.const 2))
