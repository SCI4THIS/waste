;; Last-writer hangup is readable; a broken writer has exceptional readiness.
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 64) (i32.const 0)))
(assert_return (invoke "select" (i32.const 1) (i32.const 64) (i32.const 0) (i32.const 0) (i32.const 512)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 64) (i32.const 0)) (i32.const 1))
(assert_return (invoke "read" (i32.const 1)) (i32.const 0))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "pair") (i32.const 1))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))
(assert_return (invoke "clear"))
(assert_return (invoke "set" (i32.const 352) (i32.const 1)))
(assert_return (invoke "select" (i32.const 2) (i32.const 0) (i32.const 0) (i32.const 352) (i32.const 512)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 352) (i32.const 1)) (i32.const 1))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))
(assert_return (invoke "word" (i32.const 192)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 336)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 480)) (i32.const 324478056))
