;; Guest counterparts of c-engine-caller-instance.c. Real pipe/read/write
;; imports must use the memory of the executing callee, including nested calls.
;; C callback identity, memory pointer identity and decode-once lifetimes remain C gates.
(module $a
  (import "env" "pipe" (func $pipe (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (memory 1)
  (data (i32.const 0) "\de\ad\be\ef")
  (func $roundtrip (param $offset i32) (result i32)
    (if (call $pipe (i32.const 64)) (then unreachable))
    (if (i32.ne (call $write (i32.load (i32.const 68)) (local.get $offset) (i32.const 4))
                (i32.const 4)) (then unreachable))
    (if (i32.ne (call $read (i32.load (i32.const 64)) (i32.const 32) (i32.const 4))
                (i32.const 4)) (then unreachable))
    (if (call $close (i32.load (i32.const 64))) (then unreachable))
    (if (call $close (i32.load (i32.const 68))) (then unreachable))
    (i32.load (i32.const 32)))
  (func (export "peek") (result i32) (i32.load (i32.const 16)))
  (func (export "read_initial") (result i32) (call $roundtrip (i32.const 0)))
  (func (export "store_and_read") (param $value i32) (result i32)
    (i32.store (i32.const 16) (local.get $value))
    (call $roundtrip (i32.const 16)))
)
(register "modA" $a)
(module $b
  (import "env" "pipe" (func $pipe (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (import "modA" "store_and_read" (func $store_a (param i32) (result i32)))
  (memory 1)
  (data (i32.const 0) "\ca\fe\ba\be")
  (func $roundtrip (param $offset i32) (result i32)
    (if (call $pipe (i32.const 64)) (then unreachable))
    (if (i32.ne (call $write (i32.load (i32.const 68)) (local.get $offset) (i32.const 4))
                (i32.const 4)) (then unreachable))
    (if (i32.ne (call $read (i32.load (i32.const 64)) (i32.const 32) (i32.const 4))
                (i32.const 4)) (then unreachable))
    (if (call $close (i32.load (i32.const 64))) (then unreachable))
    (if (call $close (i32.load (i32.const 68))) (then unreachable))
    (i32.load (i32.const 32)))
  (func (export "peek") (result i32) (i32.load (i32.const 16)))
  (func (export "read_own") (result i32) (call $roundtrip (i32.const 0)))
  (func (export "nested_through_a") (param i32) (result i32) (call $store_a (local.get 0)))
)
(assert_return (invoke $a "read_initial") (i32.const 0xefbeadde))
(assert_return (invoke $a "store_and_read" (i32.const 0x42424242)) (i32.const 0x42424242))
(assert_return (invoke $b "read_own") (i32.const 0xbebafeca))
(assert_return (invoke $b "nested_through_a" (i32.const 0x99887766)) (i32.const 0x99887766))
(assert_return (invoke $a "peek") (i32.const 0x99887766))
(assert_return (invoke $b "peek") (i32.const 0))
(module $second
  (import "env" "pipe" (func $pipe (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (memory 1)
  (data (i32.const 0) "\de\ad\be\ef")
  (func $roundtrip (param $offset i32) (result i32)
    (if (call $pipe (i32.const 64)) (then unreachable))
    (if (i32.ne (call $write (i32.load (i32.const 68)) (local.get $offset) (i32.const 4))
                (i32.const 4)) (then unreachable))
    (if (i32.ne (call $read (i32.load (i32.const 64)) (i32.const 32) (i32.const 4))
                (i32.const 4)) (then unreachable))
    (if (call $close (i32.load (i32.const 64))) (then unreachable))
    (if (call $close (i32.load (i32.const 68))) (then unreachable))
    (i32.load (i32.const 32)))
  (func (export "peek") (result i32) (i32.load (i32.const 16)))
  (func (export "read_initial") (result i32) (call $roundtrip (i32.const 0)))
  (func (export "store_and_read") (param $value i32) (result i32)
    (i32.store (i32.const 16) (local.get $value))
    (call $roundtrip (i32.const 16)))
)
(assert_return (invoke $a "read_initial") (i32.const 0xefbeadde))
(assert_return (invoke $second "read_initial") (i32.const 0xefbeadde))
(assert_return (invoke $a "store_and_read" (i32.const 0x11111111)) (i32.const 0x11111111))
(assert_return (invoke $second "store_and_read" (i32.const 0x22222222)) (i32.const 0x22222222))
(assert_return (invoke $a "peek") (i32.const 0x11111111))
(assert_return (invoke $second "peek") (i32.const 0x22222222))
