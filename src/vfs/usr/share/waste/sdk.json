    "capability_notes": {
      "assert": "Default assert uses compiler trap; no diagnostic text or SIGABRT delivery. NDEBUG omits evaluation. Legacy package abort remains unchanged.",
      "default": "Existing partial WASTE application ABI; availability and Wasm signatures do not imply full C/POSIX conformance.",
      "dynamic_loading": "Existing engine-owned handles and installed Wasm DSO loader; no native host-library loading.",
      "filesystem": "Engine-owned in-memory namespace and descriptors; adapters enforce their supported flags and errno. No host filesystem access.",
      "locale": "Fixed C.UTF-8 facade; setlocale ignores the requested locale/category, uselocale is a compatibility stub. No locale object lifecycle API.",
      "mapping": "Existing engine mappings, i64 offsets and bounded permissions; MAP_FIXED unsupported. No claim of host mmap semantics.",
      "ncurses": "Configured pinned DSO, unsigned four-byte NCURSES_BOOL. Missing optional/debug/SP entry points are compile-time unavailable.",
      "network": "Current syscall wrappers are unsupported without a capability provider; no raw socket or DNS capability is added by headers.",
      "processes": "Existing browser engine fork/exec/wait model; native guest execution parity remains Stage 6. posix_spawn and vfork unavailable.",
      "signals": "Engine-owned 128-bit signal sets, block/unblock/setmask and blocked-pending queries; SIGKILL/SIGSTOP cannot be blocked. Caught handlers are serviced at the existing pselect boundary, whose handler slot uses an engine function index; arbitrary compiled C function-pointer and sigaction flag conformance is not established.",
      "stdio": "Guest-owned opaque FILE; formatting/scanning implement the existing subset, not all standard conversions.",
      "threads": "Guest mutex helpers are single-threaded compatibility stubs; pthread creation, conditions, rwlocks and TLS APIs are unavailable.",
      "wide_characters": "Existing limited classification/conversion subset; no claim of complete Unicode classification or stateful encodings."
    },
    "compatibility_stubs": [
      {
        "behavior": "Browser compatibility no-op returning zero; no callback registration, delay or signal-set state.",
