;; Guest-observable cases formerly asserted in c-engine-i32-smoke.c:main.
;; See docs/techniques.md for guest-test boundaries and retained C invariants.
(module
  (type $pair-type (func (param i32 i32) (result i32 i32)))
  (memory 1 2)
  (data (i32.const 8) "\78\56\34\12\80")
  (global $value (mut i32) (i32.const 5))
  (global $wide (mut i64) (i64.const 0x1122334455667788))
  (global $single (mut f32) (f32.const -3.5))
  (global $double (mut f64) (f64.const 9.25))
  (global $null-func (mut funcref) (ref.null func))
  (func $pair (type $pair-type)
    local.get 0 local.get 1)
  (func $sum (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.add)
  (func (export "add") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.add)
  (func (export "rotl") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.rotl)
  (func (export "div_s") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.div_s)
  (func (export "div_u") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.div_u)
  (func (export "locals") (param i32 i32) (result i32) (local i32)
    local.get 0 local.set 2
    local.get 1 local.tee 2 drop
    local.get 2)
  (func (export "choose") (param i32 i32) (result i32)
    local.get 0 local.get 1 local.get 0 select)
  (func (export "call") (param i32 i32) (result i32)
    local.get 0 local.get 1 call $sum)
  (func (export "early") (param i32 i32) (result i32)
    local.get 0 return local.get 1)
  (func (export "ifelse") (param i32 i32) (result i32)
    local.get 0 if (result i32) local.get 0 else local.get 1 end)
  (func (export "branch") (param i32 i32) (result i32)
    block (result i32) local.get 0 br 0 local.get 1 end)
  (func (export "branch-if") (param i32 i32) (result i32)
    block (result i32)
      local.get 0 local.get 1 br_if 0 drop local.get 1
    end)
  (func (export "countdown") (param i32 i32) (result i32)
    loop
      local.get 0 i32.const 1 i32.sub local.tee 0 br_if 0
    end
    local.get 0)
  (func (export "branch-table") (param i32 i32) (result i32)
    block (result i32)
      block (result i32)
        local.get 0 local.get 1 br_table 0 1
      end
    end)
  (func (export "multi-call") (param i32 i32) (result i32)
    local.get 0 local.get 1 call $pair i32.sub)
  (func (export "multi-block") (param i32 i32) (result i32)
    local.get 0 local.get 1
    block (type $pair-type) br 0 end
    i32.sub)
  (func (export "pair") (param i32 i32) (result i32 i32)
    local.get 0 local.get 1)
  (func (export "load-data") (param i32 i32) (result i32)
    local.get 0 i32.load)
  (func (export "load8-s") (param i32 i32) (result i32)
    local.get 0 i32.load8_s)
  (func (export "store-load") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.store
    local.get 0 i32.load)
  (func (export "global") (param i32 i32) (result i32)
    local.get 0 global.set $value global.get $value)
  (func (export "read-global") (param i32 i32) (result i32)
    global.get $value)
  (func (export "grow") (param i32 i32) (result i32)
    local.get 0 memory.grow)
  (func (export "size") (param i32 i32) (result i32)
    memory.size)
  (func (export "global-i64") (param i32 i32) (result i64) global.get $wide)
  (func (export "global-f32") (param i32 i32) (result f32) global.get $single)
  (func (export "global-f64") (param i32 i32) (result f64) global.get $double)
  (func (export "global-null") (param i32 i32) (result i32)
    global.get $null-func ref.is_null))

(assert_return (invoke "add" (i32.const 2147483647) (i32.const 1)) (i32.const -2147483648))
(assert_return (invoke "rotl" (i32.const 1) (i32.const 31)) (i32.const -2147483648))
(assert_return (invoke "locals" (i32.const 11) (i32.const 22)) (i32.const 22))
(assert_return (invoke "choose" (i32.const 7) (i32.const 9)) (i32.const 7))
(assert_return (invoke "call" (i32.const 20) (i32.const 22)) (i32.const 42))
(assert_return (invoke "early" (i32.const 7) (i32.const 9)) (i32.const 7))
(assert_return (invoke "ifelse" (i32.const 1) (i32.const 9)) (i32.const 1))
(assert_return (invoke "ifelse" (i32.const 0) (i32.const 9)) (i32.const 9))
(assert_return (invoke "branch" (i32.const 7) (i32.const 9)) (i32.const 7))
(assert_return (invoke "branch-if" (i32.const 7) (i32.const 1)) (i32.const 7))
(assert_return (invoke "branch-if" (i32.const 7) (i32.const 0)) (i32.const 0))
(assert_return (invoke "countdown" (i32.const 5) (i32.const 0)) (i32.const 0))
(assert_return (invoke "branch-table" (i32.const 33) (i32.const 0)) (i32.const 33))
(assert_return (invoke "branch-table" (i32.const 44) (i32.const 9)) (i32.const 44))
(assert_return (invoke "multi-call" (i32.const 44) (i32.const 9)) (i32.const 35))
(assert_return (invoke "multi-block" (i32.const 44) (i32.const 9)) (i32.const 35))
(assert_return (invoke "pair" (i32.const 11) (i32.const 22)) (i32.const 11) (i32.const 22))
(assert_return (invoke "global-i64" (i32.const 0) (i32.const 0)) (i64.const 0x1122334455667788))
(assert_return (invoke "global-f32" (i32.const 0) (i32.const 0)) (f32.const -3.5))
(assert_return (invoke "global-f64" (i32.const 0) (i32.const 0)) (f64.const 9.25))
(assert_return (invoke "global-null" (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "load-data" (i32.const 8) (i32.const 0)) (i32.const 305419896))
(assert_return (invoke "load8-s" (i32.const 12) (i32.const 0)) (i32.const -128))
(assert_return (invoke "store-load" (i32.const 16) (i32.const 1985229328)) (i32.const 1985229328))
(assert_return (invoke "global" (i32.const 91) (i32.const 0)) (i32.const 91))
(assert_return (invoke "size" (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "grow" (i32.const 1) (i32.const 0)) (i32.const 1))
(assert_return (invoke "size" (i32.const 0) (i32.const 0)) (i32.const 2))
(assert_return (invoke "grow" (i32.const 1) (i32.const 0)) (i32.const -1))
(assert_trap (invoke "load-data" (i32.const 131071) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "div_s" (i32.const -2147483648) (i32.const -1)) "integer overflow")
(assert_trap (invoke "div_u" (i32.const 1) (i32.const 0)) "integer divide by zero")
