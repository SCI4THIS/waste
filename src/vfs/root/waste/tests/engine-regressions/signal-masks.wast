;; Real signal-set/mask/query imports and pselect handler delivery. The first
;; defined function is handler index 14 (fourteen imports), matching the engine's
;; existing function-index handler ABI. This is not a compiled C pointer probe.
(module
  (import "env" "sigemptyset" (func $empty (param i32) (result i32)))
  (import "env" "sigfillset" (func $fill (param i32) (result i32)))
  (import "env" "sigaddset" (func $add (param i32 i32) (result i32)))
  (import "env" "sigdelset" (func $del (param i32 i32) (result i32)))
  (import "env" "sigismember" (func $member (param i32 i32) (result i32)))
  (import "env" "sigprocmask" (func $mask (param i32 i32 i32) (result i32)))
  (import "env" "sigpending" (func $pending (param i32) (result i32)))
  (import "env" "sigaction" (func $action (param i32 i32 i32) (result i32)))
  (import "env" "raise" (func $raise (param i32) (result i32)))
  (import "env" "pselect" (func $poll (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "env" "pipe" (func $pipe (param i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "select" (func $select (param i32 i32 i32 i32 i32) (result i32)))
  (memory 1)
  (global $calls (mut i32) (i32.const 0))
  (global $signal (mut i32) (i32.const 0))
  (data (i32.const 344) "x")
  (func $handler (param $signal i32)
    (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
    (global.set $signal (local.get $signal))
    (if (call $mask (i32.const 99) (i32.const 0) (i32.const 512)) (then unreachable))
    (if (call $pending (i32.const 528)) (then unreachable)))
  (func (export "__errno_location") (result i32) (i32.const 8))
  (func (export "errno") (result i32) (i32.load (i32.const 8)))
  (func $reset (i32.store (i32.const 8) (i32.const 0)))
  (func (export "word") (param i32) (result i32) (i32.load (local.get 0)))
  (func (export "store") (param i32 i32) (i32.store (local.get 0) (local.get 1)))
  (func (export "empty") (param i32) (result i32) (call $reset) (call $empty (local.get 0)))
  (func (export "fill") (param i32) (result i32) (call $reset) (call $fill (local.get 0)))
  (func (export "add") (param i32 i32) (result i32)
    (call $reset) (call $add (local.get 0) (local.get 1)))
  (func (export "del") (param i32 i32) (result i32)
    (call $reset) (call $del (local.get 0) (local.get 1)))
  (func (export "member") (param i32 i32) (result i32)
    (call $reset) (call $member (local.get 0) (local.get 1)))
  (func (export "mask") (param i32 i32 i32) (result i32)
    (call $reset) (call $mask (local.get 0) (local.get 1) (local.get 2)))
  (func (export "pending") (param i32) (result i32) (call $reset) (call $pending (local.get 0)))
  (func (export "action") (param i32 i32 i32) (result i32)
    (call $action (local.get 0) (local.get 1) (local.get 2)))
  (func (export "raise") (result i32) (call $raise (i32.const 2)))
  (func (export "calls") (result i32) (global.get $calls))
  (func (export "signal") (result i32) (global.get $signal))
  (func (export "poll") (param i32) (result i32)
    (call $poll (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
      (i32.const 352) (local.get 0)))
  (func (export "select") (result i32)
    (call $select (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 352)))
  (func (export "ready_pipe") (result i32)
    (if (call $pipe (i32.const 320)) (then unreachable))
    (call $write (i32.load (i32.const 324)) (i32.const 344) (i32.const 1)))
  (func (export "poll_ready") (param i32) (result i32) (local $fd i32)
    (local.set $fd (i32.load (i32.const 324)))
    (memory.fill (i32.const 384) (i32.const 0) (i32.const 128))
    (i32.store (i32.add (i32.const 384) (i32.mul (i32.div_u (local.get $fd) (i32.const 32)) (i32.const 4)))
      (i32.shl (i32.const 1) (local.get $fd)))
    (call $poll (i32.add (local.get $fd) (i32.const 1)) (i32.const 0)
      (i32.const 384) (i32.const 0) (i32.const 352) (local.get 0)))
  (func (export "close_pipe") (result i32)
    (i32.or (call $close (i32.load (i32.const 320))) (call $close (i32.load (i32.const 324)))))
)

;; All four words and cross-word bit positions of the 128-bit ABI.
(assert_return (invoke "empty" (i32.const 64)) (i32.const 0))
(assert_return (invoke "word" (i32.const 64)) (i32.const 0))
(assert_return (invoke "word" (i32.const 68)) (i32.const 0))
(assert_return (invoke "word" (i32.const 72)) (i32.const 0))
(assert_return (invoke "word" (i32.const 76)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 1)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 32)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 33)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 64)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 65)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 128)) (i32.const 0))
(assert_return (invoke "word" (i32.const 64)) (i32.const 0x80000001))
(assert_return (invoke "word" (i32.const 68)) (i32.const 0x80000001))
(assert_return (invoke "word" (i32.const 72)) (i32.const 1))
(assert_return (invoke "word" (i32.const 76)) (i32.const 0x80000000))
(assert_return (invoke "member" (i32.const 64) (i32.const 128)) (i32.const 1))
(assert_return (invoke "del" (i32.const 64) (i32.const 32)) (i32.const 0))
(assert_return (invoke "member" (i32.const 64) (i32.const 32)) (i32.const 0))
(assert_return (invoke "member" (i32.const 64) (i32.const 1)) (i32.const 1))
(assert_return (invoke "fill" (i32.const 64)) (i32.const 0))
(assert_return (invoke "word" (i32.const 64)) (i32.const -1))
(assert_return (invoke "word" (i32.const 68)) (i32.const -1))
(assert_return (invoke "word" (i32.const 72)) (i32.const -1))
(assert_return (invoke "word" (i32.const 76)) (i32.const -1))
(assert_return (invoke "add" (i32.const 64) (i32.const 0)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "del" (i32.const 64) (i32.const 129)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "empty" (i32.const 0)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 14))

;; Set/unblock/block, unmaskable signals, query with ignored how, aliasing.
(assert_return (invoke "mask" (i32.const 2) (i32.const 64) (i32.const 96)) (i32.const 0))
(assert_return (invoke "word" (i32.const 96)) (i32.const 0))
(assert_return (invoke "mask" (i32.const 99) (i32.const 0) (i32.const 96)) (i32.const 0))
(assert_return (invoke "word" (i32.const 96)) (i32.const 0xfffbfeff))
(assert_return (invoke "word" (i32.const 100)) (i32.const -1))
(assert_return (invoke "word" (i32.const 104)) (i32.const -1))
(assert_return (invoke "word" (i32.const 108)) (i32.const -1))
(assert_return (invoke "mask" (i32.const 1) (i32.const 64) (i32.const 0)) (i32.const 0))
(assert_return (invoke "mask" (i32.const 0) (i32.const 0) (i32.const 96)) (i32.const 0))
(assert_return (invoke "word" (i32.const 96)) (i32.const 0))
(assert_return (invoke "empty" (i32.const 64)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 2)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 15)) (i32.const 0))
(assert_return (invoke "mask" (i32.const 0) (i32.const 64) (i32.const 96)) (i32.const 0))
(assert_return (invoke "word" (i32.const 96)) (i32.const 0))
(assert_return (invoke "empty" (i32.const 144)) (i32.const 0))
(assert_return (invoke "add" (i32.const 144) (i32.const 15)) (i32.const 0))
(assert_return (invoke "mask" (i32.const 1) (i32.const 144) (i32.const 96)) (i32.const 0))
(assert_return (invoke "word" (i32.const 96)) (i32.const 16386))
(assert_return (invoke "mask" (i32.const 2) (i32.const 144) (i32.const 144)) (i32.const 0))
(assert_return (invoke "word" (i32.const 144)) (i32.const 2))
(assert_return (invoke "mask" (i32.const 99) (i32.const 0) (i32.const 96)) (i32.const 0))
(assert_return (invoke "word" (i32.const 96)) (i32.const 16384))

;; Rejected operations preserve output canaries and the process mask.
(assert_return (invoke "store" (i32.const 96) (i32.const 0xaabbccdd)))
(assert_return (invoke "mask" (i32.const 99) (i32.const 64) (i32.const 96)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "word" (i32.const 96)) (i32.const 0xaabbccdd))
(assert_return (invoke "mask" (i32.const 2) (i32.const 65528) (i32.const 96)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 14))
(assert_return (invoke "word" (i32.const 96)) (i32.const 0xaabbccdd))
(assert_return (invoke "store" (i32.const 65528) (i32.const 0x13572468)))
(assert_return (invoke "mask" (i32.const 2) (i32.const 64) (i32.const 65528)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 14))
(assert_return (invoke "word" (i32.const 65528)) (i32.const 0x13572468))
(assert_return (invoke "mask" (i32.const 0) (i32.const 0) (i32.const 96)) (i32.const 0))
(assert_return (invoke "word" (i32.const 96)) (i32.const 16384))
(assert_return (invoke "pending" (i32.const 0)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 14))
(assert_return (invoke "pending" (i32.const 65528)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 14))
(assert_return (invoke "word" (i32.const 65528)) (i32.const 0x13572468))

;; Install a real handler with SIGTERM in its action mask; block SIGINT.
(assert_return (invoke "empty" (i32.const 64)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 2)) (i32.const 0))
(assert_return (invoke "mask" (i32.const 2) (i32.const 64) (i32.const 0)) (i32.const 0))
(assert_return (invoke "store" (i32.const 256) (i32.const 14)))
(assert_return (invoke "store" (i32.const 260) (i32.const 16384)))
(assert_return (invoke "action" (i32.const 2) (i32.const 256) (i32.const 288)) (i32.const 0))
(assert_return (invoke "word" (i32.const 288)) (i32.const 0))
(assert_return (invoke "action" (i32.const 2) (i32.const 0) (i32.const 288)) (i32.const 0))
(assert_return (invoke "word" (i32.const 288)) (i32.const 14))
(assert_return (invoke "word" (i32.const 292)) (i32.const 16384))
(assert_return (invoke "raise") (i32.const 0))
(assert_return (invoke "pending" (i32.const 128)) (i32.const 0))
(assert_return (invoke "word" (i32.const 128)) (i32.const 2))
(assert_return (invoke "poll" (i32.const 0)) (i32.const 0))
(assert_return (invoke "pending" (i32.const 128)) (i32.const 0))
(assert_return (invoke "word" (i32.const 128)) (i32.const 2))
(assert_return (invoke "empty" (i32.const 144)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 144)) (i32.const -4))
(assert_return (invoke "calls") (i32.const 1))
(assert_return (invoke "signal") (i32.const 2))
(assert_return (invoke "word" (i32.const 512)) (i32.const 16386))
(assert_return (invoke "word" (i32.const 528)) (i32.const 0))
(assert_return (invoke "mask" (i32.const 0) (i32.const 0) (i32.const 96)) (i32.const 0))
(assert_return (invoke "word" (i32.const 96)) (i32.const 2))
(assert_return (invoke "pending" (i32.const 128)) (i32.const 0))
(assert_return (invoke "word" (i32.const 128)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 144)) (i32.const 0))
(assert_return (invoke "calls") (i32.const 1))

;; Ignoring clears a blocked pending signal and later raises stay discarded.
(assert_return (invoke "raise") (i32.const 0))
(assert_return (invoke "pending" (i32.const 128)) (i32.const 0))
(assert_return (invoke "word" (i32.const 128)) (i32.const 2))
(assert_return (invoke "store" (i32.const 256) (i32.const 1)))
(assert_return (invoke "action" (i32.const 2) (i32.const 256) (i32.const 0)) (i32.const 0))
(assert_return (invoke "pending" (i32.const 128)) (i32.const 0))
(assert_return (invoke "word" (i32.const 128)) (i32.const 0))
(assert_return (invoke "raise") (i32.const 0))
(assert_return (invoke "pending" (i32.const 128)) (i32.const 0))
(assert_return (invoke "word" (i32.const 128)) (i32.const 0))
(assert_return (invoke "action" (i32.const 9) (i32.const 256) (i32.const 0)) (i32.const -22))
(assert_return (invoke "store" (i32.const 256) (i32.const 14)))
(assert_return (invoke "action" (i32.const 19) (i32.const 256) (i32.const 0)) (i32.const -22))

;; Readiness also restores the original SIGTERM mask after temporary SIGINT.
(assert_return (invoke "empty" (i32.const 64)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 15)) (i32.const 0))
(assert_return (invoke "mask" (i32.const 2) (i32.const 64) (i32.const 0)) (i32.const 0))
(assert_return (invoke "add" (i32.const 144) (i32.const 2)) (i32.const 0))
(assert_return (invoke "ready_pipe") (i32.const 1))
(assert_return (invoke "poll_ready" (i32.const 144)) (i32.const 1))
(assert_return (invoke "mask" (i32.const 0) (i32.const 0) (i32.const 96)) (i32.const 0))
(assert_return (invoke "word" (i32.const 96)) (i32.const 16384))
(assert_return (invoke "close_pipe") (i32.const 0))

;; Exact blocked-signal C counterpart: unblock, select EINTR, reblock/query.
;; Existing select consumes pending signals; handler invocation is pselect's
;; existing boundary. Handler dispatch from select remains separate work.
(assert_return (invoke "empty" (i32.const 64)) (i32.const 0))
(assert_return (invoke "add" (i32.const 64) (i32.const 2)) (i32.const 0))
(assert_return (invoke "mask" (i32.const 2) (i32.const 64) (i32.const 0)) (i32.const 0))
(assert_return (invoke "action" (i32.const 2) (i32.const 256) (i32.const 0)) (i32.const 0))
(assert_return (invoke "raise") (i32.const 0))
(assert_return (invoke "poll" (i32.const 0)) (i32.const 0))
(assert_return (invoke "pending" (i32.const 128)) (i32.const 0))
(assert_return (invoke "word" (i32.const 128)) (i32.const 2))
(assert_return (invoke "mask" (i32.const 1) (i32.const 64) (i32.const 0)) (i32.const 0))
(assert_return (invoke "select") (i32.const -4))
(assert_return (invoke "mask" (i32.const 2) (i32.const 64) (i32.const 0)) (i32.const 0))
(assert_return (invoke "pending" (i32.const 128)) (i32.const 0))
(assert_return (invoke "word" (i32.const 128)) (i32.const 0))
