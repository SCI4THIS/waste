;; Raw waitpid status distinguishes signal 6 from normal exit(134).
;; probe.c observes each child; the surviving Bash captures this output.
(module $abort
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $memcmp (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/abort-observations.txt\00")
  (data (i32.const 180064) "0 1 6 0\0a1 1 6 0\0a2 1 6 0\0a3 1 6 6\0a4 1 6 6\0a5 1 6 0\0aparent-alive\0a")
  (func (export "capture") (result i32) (local $fd i32) (local $bytes i32)
    i32.const 180000 i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd i32.const 180256 i32.const 128 call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "default") (result i32)
    i32.const 180256 i32.const 180064 i32.const 8 call $memcmp)
  (func (export "ignored") (result i32)
    i32.const 180264 i32.const 180072 i32.const 8 call $memcmp)
  (func (export "blocked") (result i32)
    i32.const 180272 i32.const 180080 i32.const 8 call $memcmp)
  (func (export "caught-blocked-returning") (result i32)
    i32.const 180280 i32.const 180088 i32.const 8 call $memcmp)
  (func (export "recursive-handler") (result i32)
    i32.const 180288 i32.const 180096 i32.const 8 call $memcmp)
  (func (export "legacy-import") (result i32)
    i32.const 180296 i32.const 180104 i32.const 8 call $memcmp)
  (func (export "parent-alive") (result i32)
    i32.const 180304 i32.const 180112 i32.const 13 call $memcmp))
(assert_return (invoke $abort "capture") (i32.const 61))
(assert_return (invoke $abort "default") (i32.const 0))
(assert_return (invoke $abort "ignored") (i32.const 0))
(assert_return (invoke $abort "blocked") (i32.const 0))
(assert_return (invoke $abort "caught-blocked-returning") (i32.const 0))
(assert_return (invoke $abort "recursive-handler") (i32.const 0))
(assert_return (invoke $abort "legacy-import") (i32.const 0))
(assert_return (invoke $abort "parent-alive") (i32.const 0))
