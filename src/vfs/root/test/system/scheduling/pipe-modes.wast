;; Full process-driver checks: status flags survive fork through a shared OFD.
;; A child switches nonblocking reads back to blocking, then waits for its peer.
(module
  (import "env" "pipe" (func $pipe (param i32) (result i32)))
  (import "env" "dup" (func $dup (param i32) (result i32)))
  (import "env" "fork" (func $fork (result i32)))
  (import "env" "exit" (func $exit (param i32)))
  (import "env" "waitpid" (func $wait (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (import "env" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "unlink" (func $unlink (param i32) (result i32)))
  (import "env" "lseek" (func $seek (param i32 i32 i32) (result i32)))
  (import "waste_kernel" "fcntl_v1" (func $fcntl (param i32 i32 i32) (result i32)))
  (memory 1)
  (data (i32.const 64) "Xabc")
  (data (i32.const 512) "/tmp/pipe-mode-append\00")
  (func $reap (param $pid i32) (param $status i32)
    (if (i32.ne (call $wait (local.get $pid) (i32.const 192) (i32.const 0)) (local.get $pid))
      (then unreachable))
    (if (i32.ne (i32.load (i32.const 192)) (local.get $status)) (then unreachable)))
  (func (export "restore_blocking") (result i32)
    (local $reader i32) (local $writer i32) (local $alias i32) (local $pid i32)
    (if (call $pipe (i32.const 128)) (then unreachable))
    (local.set $reader (i32.load (i32.const 128)))
    (local.set $writer (i32.load (i32.const 132)))
    (if (call $pipe (i32.const 136)) (then unreachable))
    (local.set $alias (call $dup (local.get $reader)))
    (if (i32.lt_s (local.get $alias) (i32.const 0)) (then unreachable))
    (local.set $pid (call $fork))
    (if (i32.eqz (local.get $pid)) (then
      (if (call $fcntl (local.get $alias) (i32.const 4) (i32.const 2048)) (then unreachable))
      (if (i32.ne (call $fcntl (local.get $reader) (i32.const 3) (i32.const 0))
          (i32.const 2048)) (then unreachable))
      (if (i32.ne (call $read (local.get $reader) (i32.const 256) (i32.const 1))
          (i32.const -11)) (then unreachable))
      (if (call $fcntl (local.get $alias) (i32.const 4) (i32.const 0)) (then unreachable))
      (if (i32.ne (call $write (i32.load (i32.const 140)) (i32.const 64) (i32.const 1))
          (i32.const 1)) (then unreachable))
      (if (call $close (local.get $writer)) (then unreachable))
      (if (i32.ne (call $read (local.get $alias) (i32.const 256) (i32.const 1))
          (i32.const 1)) (then unreachable))
      (if (i32.ne (i32.load8_u (i32.const 256)) (i32.const 88)) (then unreachable))
      (call $exit (i32.const 7))))
    (if (i32.ne (call $read (i32.load (i32.const 136)) (i32.const 256) (i32.const 1))
        (i32.const 1)) (then unreachable))
    (if (call $fcntl (local.get $reader) (i32.const 3) (i32.const 0)) (then unreachable))
    (if (i32.ne (call $write (local.get $writer) (i32.const 64) (i32.const 1))
        (i32.const 1)) (then unreachable))
    (if (call $close (local.get $writer)) (then unreachable))
    (call $reap (local.get $pid) (i32.const 1792))
    (drop (call $close (local.get $reader)))
    (drop (call $close (local.get $alias)))
    (drop (call $close (i32.load (i32.const 136))))
    (drop (call $close (i32.load (i32.const 140))))
    (i32.const 1))
  (func (export "blocking_eof") (result i32) (local $pid i32)
    (if (call $pipe (i32.const 128)) (then unreachable))
    (local.set $pid (call $fork))
    (if (i32.eqz (local.get $pid)) (then
      (drop (call $close (i32.load (i32.const 132))))
      (if (call $read (i32.load (i32.const 128)) (i32.const 256) (i32.const 1))
        (then unreachable))
      (call $exit (i32.const 8))))
    (drop (call $close (i32.load (i32.const 132))))
    (drop (call $close (i32.load (i32.const 128))))
    (call $reap (local.get $pid) (i32.const 2048))
    (i32.const 1))
  ;; A regular file keeps its access mode and ignores creation bits in F_SETFL.
  ;; O_APPEND changes write placement through every alias, then can be cleared.
  (func (export "append_alias") (result i32) (local $fd i32) (local $alias i32)
    (local.set $fd (call $open (i32.const 512) (i32.const 578) (i32.const 384)))
    (if (i32.lt_s (local.get $fd) (i32.const 0)) (then unreachable))
    (if (i32.ne (call $fcntl (local.get $fd) (i32.const 3) (i32.const 0))
        (i32.const 2)) (then unreachable))
    (local.set $alias (call $dup (local.get $fd)))
    (if (i32.ne (call $write (local.get $fd) (i32.const 65) (i32.const 3)) (i32.const 3))
      (then unreachable))
    (if (call $seek (local.get $fd) (i32.const 0) (i32.const 0)) (then unreachable))
    (if (call $fcntl (local.get $alias) (i32.const 4) (i32.const 1601)) (then unreachable))
    (if (i32.ne (call $fcntl (local.get $fd) (i32.const 3) (i32.const 0))
        (i32.const 1026)) (then unreachable))
    (if (i32.ne (call $write (local.get $fd) (i32.const 64) (i32.const 1)) (i32.const 1))
      (then unreachable))
    (if (call $fcntl (local.get $fd) (i32.const 4) (i32.const 0)) (then unreachable))
    (if (i32.ne (call $fcntl (local.get $alias) (i32.const 3) (i32.const 0))
        (i32.const 2)) (then unreachable))
    (if (call $seek (local.get $alias) (i32.const 0) (i32.const 0)) (then unreachable))
    (if (i32.ne (call $write (local.get $alias) (i32.const 64) (i32.const 1)) (i32.const 1))
      (then unreachable))
    (if (call $seek (local.get $fd) (i32.const 0) (i32.const 0)) (then unreachable))
    (if (i32.ne (call $read (local.get $fd) (i32.const 256) (i32.const 8)) (i32.const 4))
      (then unreachable))
    (if (i32.ne (i32.load (i32.const 256)) (i32.const 0x58636258)) (then unreachable))
    (drop (call $close (local.get $fd)))
    (drop (call $close (local.get $alias)))
    (if (call $unlink (i32.const 512)) (then unreachable))
    (i32.const 1))
  (func (export "fork_append") (result i32) (local $fd i32) (local $pid i32)
    (local.set $fd (call $open (i32.const 512) (i32.const 578) (i32.const 384)))
    (if (i32.lt_s (local.get $fd) (i32.const 0)) (then unreachable))
    (if (i32.ne (call $write (local.get $fd) (i32.const 65) (i32.const 3)) (i32.const 3))
      (then unreachable))
    (if (call $seek (local.get $fd) (i32.const 0) (i32.const 0)) (then unreachable))
    (local.set $pid (call $fork))
    (if (i32.eqz (local.get $pid)) (then
      (if (call $fcntl (local.get $fd) (i32.const 4) (i32.const 1024)) (then unreachable))
      (call $exit (i32.const 9))))
    (call $reap (local.get $pid) (i32.const 2304))
    (if (i32.ne (call $fcntl (local.get $fd) (i32.const 3) (i32.const 0))
        (i32.const 1026)) (then unreachable))
    (if (i32.ne (call $write (local.get $fd) (i32.const 64) (i32.const 1)) (i32.const 1))
      (then unreachable))
    (if (call $seek (local.get $fd) (i32.const 0) (i32.const 0)) (then unreachable))
    (if (i32.ne (call $read (local.get $fd) (i32.const 256) (i32.const 8)) (i32.const 4))
      (then unreachable))
    (if (i32.ne (i32.load (i32.const 256)) (i32.const 0x58636261)) (then unreachable))
    (drop (call $close (local.get $fd)))
    (if (call $unlink (i32.const 512)) (then unreachable))
    (i32.const 1)))
(assert_return (invoke "restore_blocking") (i32.const 1))
(assert_return (invoke "blocking_eof") (i32.const 1))
(assert_return (invoke "append_alias") (i32.const 1))
(assert_return (invoke "fork_append") (i32.const 1))
