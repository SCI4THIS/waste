;; Actual LLVM DWARF aggregator; C++ observes, WAST owns every expectation.
(module $verifier
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/dwarf-verifier.bin\00")
  (data (i32.const 180128) "/tmp/dwarf-verifier-status.txt\00")
  (data (i32.const 180256) "/tmp/dwarf-categories.txt\00")
  (data (i32.const 180384) "/tmp/dwarf-subcategories.txt\00")
  (data (i32.const 200000) "=1\0aalpha=5\0abeta=1\0acategory-owned-beyond-small-string-storage=1\0aomega=1\0a\00")
  (data (i32.const 200256) "alpha/cold=1\0aalpha/hot=3\0acategory-owned-beyond-small-string-storage/subcategory-owned-beyond-small-string-storage=1\0a/zero=1\0a\00")
  (func $capture (param $path i32) (param $output i32) (param $capacity i32) (result i32)
    (local $fd i32) (local $count i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $output local.get $capacity call $read local.set $count
    local.get $fd call $close drop local.get $count)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 184000 i32.const 4096 call $capture)
  (func (export "status") (result i32)
    i32.const 180128 i32.const 190000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 190000 i32.load16_u i32.const 0x3133 i32.eq i32.and
    i32.const 190002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i64)
    i32.const 184000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func $bytes (param $path i32) (param $expected i32) (param $size i32) (result i32)
    local.get $path i32.const 210000 i32.const 4096 call $capture local.get $size i32.eq
    i32.const 210000 local.get $expected local.get $size call $compare i32.eqz i32.and)
  (func (export "category-order-and-owned-keys") (result i32)
    i32.const 180256 i32.const 200000 i32.const 71 call $bytes)
  (func (export "subcategory-counts-and-owned-keys") (result i32)
    i32.const 180384 i32.const 200256 i32.const 124 call $bytes)
)
(assert_return (invoke $verifier "capture") (i32.const 248))
(assert_return (invoke $verifier "status") (i32.const 1))
;; Profile, default aggregation, enabled/yielding callbacks, disabled callbacks,
;; ordered enumeration, file transport and a fresh owner after destruction.
(assert_return (invoke $verifier "value" (i32.const 0)) (i64.const 1))
(assert_return (invoke $verifier "value" (i32.const 1)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 2)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 3)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 4)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 5)) (i64.const 1))
(assert_return (invoke $verifier "value" (i32.const 6)) (i64.const 1))
(assert_return (invoke $verifier "value" (i32.const 7)) (i64.const 5))
(assert_return (invoke $verifier "value" (i32.const 8)) (i64.const 3))
(assert_return (invoke $verifier "value" (i32.const 9)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 10)) (i64.const 6))
(assert_return (invoke $verifier "value" (i32.const 11)) (i64.const 3))
(assert_return (invoke $verifier "value" (i32.const 12)) (i64.const 1))
(assert_return (invoke $verifier "value" (i32.const 13)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 14)) (i64.const 1))
(assert_return (invoke $verifier "value" (i32.const 15)) (i64.const 2))
(assert_return (invoke $verifier "value" (i32.const 16)) (i64.const 9))
(assert_return (invoke $verifier "value" (i32.const 17)) (i64.const 5))
(assert_return (invoke $verifier "value" (i32.const 18)) (i64.const 2))
(assert_return (invoke $verifier "value" (i32.const 19)) (i64.const 5))
(assert_return (invoke $verifier "value" (i32.const 20)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 21)) (i64.const 1))
(assert_return (invoke $verifier "value" (i32.const 22)) (i64.const 71))
(assert_return (invoke $verifier "value" (i32.const 23)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 24)) (i64.const 1))
(assert_return (invoke $verifier "value" (i32.const 25)) (i64.const 124))
(assert_return (invoke $verifier "value" (i32.const 26)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 27)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 28)) (i64.const 0))
(assert_return (invoke $verifier "value" (i32.const 29)) (i64.const 1))
(assert_return (invoke $verifier "value" (i32.const 30)) (i64.const 3))
(assert_return (invoke $verifier "category-order-and-owned-keys") (i32.const 1))
(assert_return (invoke $verifier "subcategory-counts-and-owned-keys") (i32.const 1))
