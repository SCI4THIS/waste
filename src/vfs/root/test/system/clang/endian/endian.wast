;; Compiled LLVM header observations, not a substitute guest compiler.
;; Eight metadata i32s followed by three records of four i64s: 128 bytes.
(module $endian
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/endian.bin\00")
  (data (i32.const 180032) "/tmp/endian-status.txt\00")
  (data (i32.const 180064) "\d2\04\00\00\d2\04\00\00\d2\04\00\00\e1\10\00\00\01\00\00\00\01\00\00\00\00\00\00\00\08\00\00\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 1024 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180032 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "metadata") (result i32)
    i32.const 182000 i32.const 180064 i32.const 32 call $compare i32.eqz)
  (func (export "value") (param $record i32) (param $field i32) (result i64)
    i32.const 182032 local.get $record i32.const 32 i32.mul i32.add
    local.get $field i32.const 8 i32.mul i32.add i64.load)
  (func (export "stored-byte") (param $offset i32) (result i32)
    i32.const 182000 local.get $offset i32.add i32.load8_u)
)
(assert_return (invoke $endian "capture") (i32.const 128))
(assert_return (invoke $endian "exit-status") (i32.const 1))
(assert_return (invoke $endian "metadata") (i32.const 1))
(assert_return (invoke $endian "value" (i32.const 0) (i32.const 0)) (i64.const 0x1234))
(assert_return (invoke $endian "value" (i32.const 0) (i32.const 1)) (i64.const 0x3412))
(assert_return (invoke $endian "value" (i32.const 0) (i32.const 2)) (i64.const 0x3412))
(assert_return (invoke $endian "value" (i32.const 0) (i32.const 3)) (i64.const 0x1234))
(assert_return (invoke $endian "value" (i32.const 1) (i32.const 0)) (i64.const 0x12345678))
(assert_return (invoke $endian "value" (i32.const 1) (i32.const 1)) (i64.const 0x78563412))
(assert_return (invoke $endian "value" (i32.const 1) (i32.const 2)) (i64.const 0x78563412))
(assert_return (invoke $endian "value" (i32.const 1) (i32.const 3)) (i64.const 0x12345678))
(assert_return (invoke $endian "value" (i32.const 2) (i32.const 0)) (i64.const 0x0123456789abcdef))
(assert_return (invoke $endian "value" (i32.const 2) (i32.const 1)) (i64.const 0xefcdab8967452301))
(assert_return (invoke $endian "value" (i32.const 2) (i32.const 2)) (i64.const 0xefcdab8967452301))
(assert_return (invoke $endian "value" (i32.const 2) (i32.const 3)) (i64.const 0x0123456789abcdef))
(assert_return (invoke $endian "stored-byte" (i32.const 32)) (i32.const 0x34))
(assert_return (invoke $endian "stored-byte" (i32.const 33)) (i32.const 0x12))
(assert_return (invoke $endian "stored-byte" (i32.const 64)) (i32.const 0x78))
(assert_return (invoke $endian "stored-byte" (i32.const 67)) (i32.const 0x12))
(assert_return (invoke $endian "stored-byte" (i32.const 96)) (i32.const 0xef))
(assert_return (invoke $endian "stored-byte" (i32.const 103)) (i32.const 0x01))
