;; Actual MC/DC coverage strings retained after record destruction and a yield.
(module $assignment
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/coverage-format.bin\00")
  (data (i32.const 180128) "/tmp/coverage-format-status.txt\00")
  (data (i32.const 200000) "C1, C2, C3    Result\0aCondition C1 --> (4294967295:4294967294)\0aCondition C2 --> (0:9)\0a  C1-Pair: covered: (1,2)\0a  C2-Pair: not covered\0a  C3-Pair: constant folded\0a  1 { F,  T,  C  = F      }\0a  2 { T,  T,  C  = T      }\0a  3 { -,  F,  C  = F      }\0aNone.\0aC1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12    Result\0a")
  (func $capture (param $path i32) (param $output i32) (param $capacity i32) (result i32)
    (local $fd i32) (local $length i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $output local.get $capacity call $read local.set $length
    local.get $fd call $close drop local.get $length)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 184000 i32.const 8192 call $capture)
  (func (export "status") (result i32)
    i32.const 180128 i32.const 193000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 193000 i32.load16_u i32.const 0x3633 i32.eq i32.and
    i32.const 193002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i64)
    i32.const 184000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func (export "text") (param $offset i32) (param $length i32) (result i32)
    i32.const 184096 local.get $offset i32.add
    i32.const 200000 local.get $offset i32.add
    local.get $length call $compare i32.eqz)
)
(assert_return (invoke "capture") (i32.const 407))
(assert_return (invoke "status") (i32.const 1))
(assert_return (invoke "value" (i32.const 0)) (i64.const 11))
(assert_return (invoke "value" (i32.const 1)) (i64.const 21))
(assert_return (invoke "text" (i32.const 0) (i32.const 21)) (i32.const 1))
(assert_return (invoke "value" (i32.const 2)) (i64.const 41))
(assert_return (invoke "text" (i32.const 21) (i32.const 41)) (i32.const 1))
(assert_return (invoke "value" (i32.const 3)) (i64.const 23))
(assert_return (invoke "text" (i32.const 62) (i32.const 23)) (i32.const 1))
(assert_return (invoke "value" (i32.const 4)) (i64.const 26))
(assert_return (invoke "text" (i32.const 85) (i32.const 26)) (i32.const 1))
(assert_return (invoke "value" (i32.const 5)) (i64.const 23))
(assert_return (invoke "text" (i32.const 111) (i32.const 23)) (i32.const 1))
(assert_return (invoke "value" (i32.const 6)) (i64.const 27))
(assert_return (invoke "text" (i32.const 134) (i32.const 27)) (i32.const 1))
(assert_return (invoke "value" (i32.const 7)) (i64.const 28))
(assert_return (invoke "text" (i32.const 161) (i32.const 28)) (i32.const 1))
(assert_return (invoke "value" (i32.const 8)) (i64.const 28))
(assert_return (invoke "text" (i32.const 189) (i32.const 28)) (i32.const 1))
(assert_return (invoke "value" (i32.const 9)) (i64.const 28))
(assert_return (invoke "text" (i32.const 217) (i32.const 28)) (i32.const 1))
(assert_return (invoke "value" (i32.const 10)) (i64.const 6))
(assert_return (invoke "text" (i32.const 245) (i32.const 6)) (i32.const 1))
(assert_return (invoke "value" (i32.const 11)) (i64.const 60))
(assert_return (invoke "text" (i32.const 251) (i32.const 60)) (i32.const 1))
