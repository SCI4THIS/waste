(assert_return (invoke $finite "value" (i32.const 119)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 120)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 121)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 122)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 123)) (i64.const 0))
(assert_return (invoke $finite "elapsed" (i32.const 124) (i64.const 10000000)) (i32.const 1))

;; ExecuteAndWait maximum seconds (words 125..136)
(assert_return (invoke $finite "value" (i32.const 125)) (i64.const 37))
(assert_return (invoke $finite "value" (i32.const 126)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 127)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 128)) (i64.const 0))
