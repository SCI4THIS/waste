(assert_return (invoke $finite "value" (i32.const 57)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 58)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 59)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 60)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 61)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 62)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 63)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 64)) (i64.const 73))
(assert_return (invoke $finite "elapsed" (i32.const 65) (i64.const 10000000)) (i32.const 1))
(assert_return (invoke $finite "value" (i32.const 66)) (i64.const -1))
(assert_return (invoke $finite "value" (i32.const 67)) (i64.const 3))

;; maximum unsigned seconds (words 68..82)
(assert_return (invoke $finite "value" (i32.const 68)) (i64.const 1))
(assert_return (invoke $finite "value" (i32.const 69)) (i64.const 43))
(assert_return (invoke $finite "value" (i32.const 70)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 71)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 72)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 73)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 74)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 75)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 76)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 77)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 78)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 79)) (i64.const 73))
(assert_return (invoke $finite "elapsed" (i32.const 80) (i64.const 10000000)) (i32.const 1))
(assert_return (invoke $finite "value" (i32.const 81)) (i64.const -1))
(assert_return (invoke $finite "value" (i32.const 82)) (i64.const 3))

;; caught signal restart=0 (words 83..97)
(assert_return (invoke $finite "value" (i32.const 83)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 84)) (i64.const 1))
(assert_return (invoke $finite "value" (i32.const 85)) (i64.const 41))
(assert_return (invoke $finite "value" (i32.const 86)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 87)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 88)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 89)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 90)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 91)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 92)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 93)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 94)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 95)) (i64.const 4))
(assert_return (invoke $finite "value" (i32.const 96)) (i64.const 1))
(assert_return (invoke $finite "elapsed" (i32.const 97) (i64.const 10000000)) (i32.const 1))

;; caught signal restart=1 (words 98..112)
(assert_return (invoke $finite "value" (i32.const 98)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 99)) (i64.const 1))
(assert_return (invoke $finite "value" (i32.const 100)) (i64.const 41))
(assert_return (invoke $finite "value" (i32.const 101)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 102)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 103)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 104)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 105)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 106)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 107)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 108)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 109)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 110)) (i64.const 73))
(assert_return (invoke $finite "value" (i32.const 111)) (i64.const 1))
