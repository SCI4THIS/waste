(assert_return (invoke $finite "value" (i32.const 155)) (i64.const 10))
(assert_return (invoke $finite "value" (i32.const 156)) (i64.const -1))
(assert_return (invoke $finite "value" (i32.const 157)) (i64.const 2))

;; ExecuteAndWait CPU-bound timeout (words 158..178)
