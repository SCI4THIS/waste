(assert_return (invoke $finite "value" (i32.const 132)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 133)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 134)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 135)) (i64.const 0))
(assert_return (invoke $finite "elapsed" (i32.const 136) (i64.const 10000000)) (i32.const 1))

;; ExecuteAndWait sleeping timeout (words 137..157)
(assert_return (invoke $finite "value" (i32.const 137)) (i64.const -2))
(assert_return (invoke $finite "value" (i32.const 138)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 139)) (i64.const 17))
(assert_return (invoke $finite "value" (i32.const 140)) (i64.const 7598734086968535107))
(assert_return (invoke $finite "value" (i32.const 141)) (i64.const 4212120671643526509))
(assert_return (invoke $finite "value" (i32.const 142)) (i64.const 32))
(assert_return (invoke $finite "value" (i32.const 143)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 144)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 145)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 146)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 147)) (i64.const 0))
(assert_return (invoke $finite "elapsed" (i32.const 148) (i64.const 1000000000)) (i32.const 1))
(assert_return (invoke $finite "value" (i32.const 149)) (i64.const 1))
(assert_return (invoke $finite "value" (i32.const 150)) (i64.const 4))
