;; ExecuteAndWait finite success (words 113..124)
(assert_return (invoke $finite "value" (i32.const 113)) (i64.const 37))
(assert_return (invoke $finite "value" (i32.const 114)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 115)) (i64.const 0))
