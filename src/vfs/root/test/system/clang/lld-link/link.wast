;; Real guest LLD resolves a compiled object against an archive and writes a
;; runnable module. Bash records command observations; WAST owns expectations.
(module $link
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/lld-link-status.txt\00")
  (data (i32.const 180064) "/tmp/lld-chmod-status.txt\00")
  (data (i32.const 180128) "/tmp/lld-run-status.txt\00")
  (data (i32.const 180192) "/tmp/linked.wasm\00")
  (func $capture (param $path i32) (result i32)
    (local $fd i32) (local $bytes i32)
    i32.const 184000 i64.const 0 i64.store
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd i32.const 184000 i32.const 8 call $read local.set $bytes
    local.get $fd call $close drop local.get $bytes)
  (func (export "link-status-bytes") (result i32) i32.const 180000 call $capture)
  (func (export "chmod-status-bytes") (result i32) i32.const 180064 call $capture)
  (func (export "run-status-bytes") (result i32) i32.const 180128 call $capture)
  (func (export "header-bytes") (result i32) i32.const 180192 call $capture)
  (func (export "status-word") (result i32) i32.const 184000 i32.load16_u)
  (func (export "newline") (result i32) i32.const 184002 i32.load8_u)
  (func (export "magic") (result i32) i32.const 184000 i32.load)
  (func (export "version") (result i32) i32.const 184004 i32.load))
(assert_return (invoke $link "link-status-bytes") (i32.const 2))
(assert_return (invoke $link "status-word") (i32.const 0x0a30))
(assert_return (invoke $link "chmod-status-bytes") (i32.const 2))
(assert_return (invoke $link "status-word") (i32.const 0x0a30))
(assert_return (invoke $link "run-status-bytes") (i32.const 3))
(assert_return (invoke $link "status-word") (i32.const 0x3733))
(assert_return (invoke $link "newline") (i32.const 10))
(assert_return (invoke $link "header-bytes") (i32.const 8))
(assert_return (invoke $link "magic") (i32.const 0x6d736100))
(assert_return (invoke $link "version") (i32.const 1))
