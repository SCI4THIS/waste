  (import "env" "close" (func $close (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "waste_kernel" "realpath_v1" (func $raw (param i32 i32 i32) (result i32)))
  (global $first (mut i32) (i32.const 0))
  (global $second (mut i32) (i32.const 0))
