  (func $reset
    (memory.fill (i32.const 196000) (i32.const 33) (i32.const 256))
    (i32.store (call $errno-pointer) (i32.const 73)))
  (func (export "errno") (result i32) (i32.load (call $errno-pointer)))
  (func (export "unchanged") (result i32)
    (local $i i32)
    (loop $next
      (if (i32.ne (i32.load8_u (i32.add (i32.const 196000) (local.get $i))) (i32.const 33))
        (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $next (i32.lt_u (local.get $i) (i32.const 256))))
    (i32.const 1))
  (func (export "resolve") (param $path i32) (result i32)
    (call $reset)
    (call $resolve (local.get $path) (i32.const 196000)))
  (func (export "raw") (param $path i32) (param $output i32) (param $capacity i32) (result i32)
    (call $reset) (call $raw (local.get $path) (local.get $output) (local.get $capacity)))
  (func (export "compare") (param $expected i32) (result i32)
    (call $compare (i32.const 196000) (local.get $expected)))
  (func (export "byte") (param $index i32) (result i32)
    (i32.load8_u (i32.add (i32.const 196000) (local.get $index))))
  (func (export "mkdir") (param $path i32) (result i32)
    (call $mkdir (local.get $path) (i32.const 493)))
  (func (export "link") (param $target i32) (param $path i32) (result i32)
    (call $symlink (local.get $target) (local.get $path)))
  (func (export "file") (result i32)
    (local $fd i32)
    (local.set $fd (call $open (i32.const 181280) (i32.const 66) (i32.const 384)))
    (if (result i32) (i32.ge_s (local.get $fd) (i32.const 0))
      (then (call $close (local.get $fd))) (else (local.get $fd))))
  (func (export "chmod") (result i32) (call $chmod (i32.const 181280) (i32.const 0)))
  (func (export "chdir") (param $path i32) (result i32) (call $chdir (local.get $path)))
  (func (export "cwd") (param $expected i32) (result i32)
    (drop (call $getcwd (i32.const 196000) (i32.const 256)))
    (call $compare (i32.const 196000) (local.get $expected)))
  (func (export "alloc-first") (param $path i32) (result i32)
    (call $reset) (global.set $first (call $resolve (local.get $path) (i32.const 0)))
    (i32.ne (global.get $first) (i32.const 0)))
  (func (export "alloc-second") (param $path i32) (result i32)
    (global.set $second (call $resolve (local.get $path) (i32.const 0)))
    (i32.and (i32.ne (global.get $second) (i32.const 0))
      (i32.ne (global.get $second) (global.get $first))))
  (func (export "owned") (param $expected i32) (result i32)
    (call $compare (global.get $first) (local.get $expected)))
  (func (export "free-second") (call $free (global.get $second)))
  (func (export "free-first") (call $free (global.get $first)))
  (func (export "alloc-error") (param $path i32) (result i32)
    (call $reset) (call $resolve (local.get $path) (i32.const 0)))
  (func (export "unterminated") (result i32)
    (memory.fill (i32.const 210000) (i32.const 47) (i32.const 4096))
    (call $reset) (call $resolve (i32.const 210000) (i32.const 196000)))
  (func (export "long-input") (result i32)
    (memory.fill (i32.const 210000) (i32.const 47) (i32.const 4095))
    (i32.store8 (i32.const 214095) (i32.const 0))
    (call $reset) (call $resolve (i32.const 210000) (i32.const 196000)))
  (func (export "load") (result i32)
    (local $fd i32) (local $count i32)
    (local.set $fd (call $open (i32.const 188960) (i32.const 0) (i32.const 0)))
    (drop (call $read (local.get $fd) (i32.const 201000) (i32.const 16)))
    (drop (call $close (local.get $fd)))
    (local.set $fd (call $open (i32.const 189216) (i32.const 0) (i32.const 0)))
    (local.set $count (call $read (local.get $fd) (i32.const 202000) (i32.const 769)))
    (drop (call $close (local.get $fd))) (local.get $count))
  (func (export "exit") (result i32) (i32.load16_u (i32.const 201000)))
  (func (export "value") (param $index i32) (result i32)
    (i32.load (i32.add (i32.const 202000) (i32.mul (local.get $index) (i32.const 4)))))
  (func (export "string") (param $index i32) (param $expected i32) (result i32)
    (call $compare (i32.add (i32.const 202256) (i32.mul (local.get $index) (i32.const 128)))
      (local.get $expected))))
