;; Canonical namespace lookup and compiled C++ calls. All expectations live here.
(module $paths
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "realpath" (func $resolve (param i32 i32) (result i32)))
  (import "libc" "__errno_location" (func $errno-pointer (result i32)))
  (import "libc" "strcmp" (func $compare (param i32 i32) (result i32)))
  (import "libc" "free" (func $free (param i32)))
  (import "libc" "symlink" (func $symlink (param i32 i32) (result i32)))
  (import "libc" "chdir" (func $chdir (param i32) (result i32)))
  (import "libc" "getcwd" (func $getcwd (param i32 i32) (result i32)))
