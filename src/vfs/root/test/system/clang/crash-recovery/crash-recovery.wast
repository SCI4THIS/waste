;; Actual LLVMSupport archive observations; no substituted recovery implementation.
(module $recovery
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/crash-recovery.bin\00")
  (data (i32.const 180064) "/tmp/crash-recovery-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 1024 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180064 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i32)
    i32.const 182000 local.get $index i32.const 4 i32.mul i32.add i32.load))
(assert_return (invoke $recovery "capture") (i32.const 492))
(assert_return (invoke $recovery "exit-status") (i32.const 1))
;; disabled recovery and ordinary setup.
(assert_return (invoke $recovery "value" (i32.const 0)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 1)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 2)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 3)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 4)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 5)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 6)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 7)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 8)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 9)) (i32.const 0))
;; normal completion, unregister and reverse cleanup.
(assert_return (invoke $recovery "value" (i32.const 10)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 11)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 12)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 13)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 14)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 15)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 16)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 17)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 18)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 19)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 20)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 21)) (i32.const 2))
(assert_return (invoke $recovery "value" (i32.const 22)) (i32.const 3))
(assert_return (invoke $recovery "value" (i32.const 23)) (i32.const 21))
(assert_return (invoke $recovery "value" (i32.const 24)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 25)) (i32.const 0))
;; caught signal 6 recovers with the mask unblocked.
(assert_return (invoke $recovery "value" (i32.const 26)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 27)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 28)) (i32.const 134))
(assert_return (invoke $recovery "value" (i32.const 29)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 30)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 31)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 32)) (i32.const 1))
;; caught signal 7 recovers with the mask unblocked.
(assert_return (invoke $recovery "value" (i32.const 33)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 34)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 35)) (i32.const 135))
(assert_return (invoke $recovery "value" (i32.const 36)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 37)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 38)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 39)) (i32.const 1))
;; caught signal 8 recovers with the mask unblocked.
(assert_return (invoke $recovery "value" (i32.const 40)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 41)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 42)) (i32.const 136))
(assert_return (invoke $recovery "value" (i32.const 43)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 44)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 45)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 46)) (i32.const 1))
;; caught signal 4 recovers with the mask unblocked.
(assert_return (invoke $recovery "value" (i32.const 47)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 48)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 49)) (i32.const 132))
(assert_return (invoke $recovery "value" (i32.const 50)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 51)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 52)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 53)) (i32.const 1))
;; caught signal 11 recovers with the mask unblocked.
(assert_return (invoke $recovery "value" (i32.const 54)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 55)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 56)) (i32.const 139))
(assert_return (invoke $recovery "value" (i32.const 57)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 58)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 59)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 60)) (i32.const 1))
;; caught signal 5 recovers with the mask unblocked.
(assert_return (invoke $recovery "value" (i32.const 61)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 62)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 63)) (i32.const 133))
(assert_return (invoke $recovery "value" (i32.const 64)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 65)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 66)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 67)) (i32.const 1))
;; nested explicit exits recover to the matching context.
(assert_return (invoke $recovery "value" (i32.const 68)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 69)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 70)) (i32.const 37))
(assert_return (invoke $recovery "value" (i32.const 71)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 72)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 73)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 74)) (i32.const 63))
(assert_return (invoke $recovery "value" (i32.const 75)) (i32.const 1))
;; context survives sleep yield and normalizes a zero jump internally.
(assert_return (invoke $recovery "value" (i32.const 76)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 77)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 78)) (i32.const 0))
;; crash status classification and noncrash rethrow.
(assert_return (invoke $recovery "value" (i32.const 79)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 80)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 81)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 82)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 83)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 84)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 85)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 86)) (i32.const 0))
;; disable restores the previous action, flags and mask.
(assert_return (invoke $recovery "value" (i32.const 87)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 88)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 89)) (i32.const 268435456))
(assert_return (invoke $recovery "value" (i32.const 90)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 91)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 92)) (i32.const 1))
;; actual LLVM Process Exit and resource cleanup after recovery.
(assert_return (invoke $recovery "value" (i32.const 93)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 94)) (i32.const 55))
(assert_return (invoke $recovery "value" (i32.const 95)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 96)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 97)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 98)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 99)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 100)) (i32.const 2))
(assert_return (invoke $recovery "value" (i32.const 101)) (i32.const 2))
(assert_return (invoke $recovery "value" (i32.const 102)) (i32.const 21))
;; real Signals cleanup removes the registered file and runs its callback.
(assert_return (invoke $recovery "value" (i32.const 103)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 104)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 105)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 106)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 107)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 108)) (i32.const 134))
(assert_return (invoke $recovery "value" (i32.const 109)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 110)) (i32.const -1))
;; utility install and uninstall preserve ignored dispositions and flags.
(assert_return (invoke $recovery "value" (i32.const 111)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 112)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 113)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 114)) (i32.const 268435456))
(assert_return (invoke $recovery "value" (i32.const 115)) (i32.const 0))
(assert_return (invoke $recovery "value" (i32.const 116)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 117)) (i32.const 268435456))
(assert_return (invoke $recovery "value" (i32.const 118)) (i32.const 0))
;; signal outside a current context terminates only the forked child.
(assert_return (invoke $recovery "value" (i32.const 119)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 120)) (i32.const 1))
(assert_return (invoke $recovery "value" (i32.const 121)) (i32.const 4))
(assert_return (invoke $recovery "value" (i32.const 122)) (i32.const 1))

