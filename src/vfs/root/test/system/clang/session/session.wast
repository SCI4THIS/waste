(assert_return (invoke $session "value" (i32.const 41)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 42)) (i64.const -1))
(assert_return (invoke $session "value" (i32.const 43)) (i64.const 25))
(assert_return (invoke $session "value" (i32.const 44)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 45)) (i64.const -1))
(assert_return (invoke $session "value" (i32.const 46)) (i64.const -1))
(assert_return (invoke $session "value" (i32.const 47)) (i64.const -1))
(assert_return (invoke $session "value" (i32.const 48)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 49)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 50)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 51)) (i64.const 0))
(assert_return (invoke $session "value" (i32.const 52)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 53)) (i64.const 104))

;; Actual exec retains detached identity; the grandchild can create its own session
(assert_return (invoke $session "value" (i32.const 54)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 55)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 56)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 57)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 58)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 59)) (i64.const -1))
(assert_return (invoke $session "value" (i32.const 60)) (i64.const 25))
(assert_return (invoke $session "value" (i32.const 61)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 62)) (i64.const 73))
(assert_return (invoke $session "value" (i32.const 63)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 64)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 65)) (i64.const -1))
(assert_return (invoke $session "value" (i32.const 66)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 67)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 68)) (i64.const 4864))
(assert_return (invoke $session "value" (i32.const 69)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 70)) (i64.const 1))

;; Zombie query, one reap, ESRCH afterward and unchanged parent terminal
(assert_return (invoke $session "value" (i32.const 71)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 72)) (i64.const 73))
(assert_return (invoke $session "value" (i32.const 73)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 74)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 75)) (i64.const 9472))
(assert_return (invoke $session "value" (i32.const 76)) (i64.const -1))
(assert_return (invoke $session "value" (i32.const 77)) (i64.const 3))
(assert_return (invoke $session "value" (i32.const 78)) (i64.const -1))
(assert_return (invoke $session "value" (i32.const 79)) (i64.const 3))
(assert_return (invoke $session "value" (i32.const 80)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 81)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 82)) (i64.const 1))
(assert_return (invoke $session "value" (i32.const 83)) (i64.const 1))
