;; Compiled C++ startup observations through the production CRT and archives.
(module $startup
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/startup.bin\00")
  (data (i32.const 180064) "/tmp/startup-status.txt\00")
  (data (i32.const 180128) "/tmp/startup-out.txt\00")
  (data (i32.const 180192) "/tmp/startup-err.txt\00")
  (data (i32.const 186000) "ctor-out:12\0amain-out:123\0areturn-write\0a")
  (data (i32.const 186064) "ctor-err:12\0amain-err:123\0a")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 1024 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180064 i32.const 184000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x3332 i32.eq i32.and
    i32.const 184002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func $equal (param $first i32) (param $second i32) (param $count i32) (result i32)
    (local $at i32)
    (loop $next
      local.get $first local.get $at i32.add i32.load8_u
      local.get $second local.get $at i32.add i32.load8_u
      i32.ne if i32.const 0 return end
      local.get $at i32.const 1 i32.add local.tee $at
      local.get $count i32.lt_u br_if $next)
    i32.const 1)
  (func (export "stdout") (result i32)
    i32.const 180128 i32.const 184064 i32.const 64 call $capture i32.const 38 i32.eq
    i32.const 184064 i32.const 186000 i32.const 38 call $equal i32.and)
  (func (export "stderr") (result i32)
    i32.const 180192 i32.const 184128 i32.const 64 call $capture i32.const 25 i32.eq
    i32.const 184128 i32.const 186064 i32.const 25 call $equal i32.and)
  (func (export "value") (param $index i32) (result i32)
    i32.const 182000 local.get $index i32.const 4 i32.mul i32.add i32.load))
(assert_return (invoke $startup "capture") (i32.const 328))
(assert_return (invoke $startup "exit-status") (i32.const 1))
(assert_return (invoke $startup "stdout") (i32.const 1))
(assert_return (invoke $startup "stderr") (i32.const 1))
;; Early constructor: initialized streams, descriptors and environment.
(assert_return (invoke $startup "value" (i32.const 0)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 1)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 2)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 3)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 4)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 5)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 6)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 7)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 8)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 9)) (i32.const 2))
(assert_return (invoke $startup "value" (i32.const 10)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 11)) (i32.const 1))
;; Local lifetime, actual heap-backed string/vector ownership.
(assert_return (invoke $startup "value" (i32.const 12)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 13)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 14)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 15)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 16)) (i32.const 85))
(assert_return (invoke $startup "value" (i32.const 17)) (i32.const 85))
(assert_return (invoke $startup "value" (i32.const 18)) (i32.const 120))
(assert_return (invoke $startup "value" (i32.const 19)) (i32.const 115))
(assert_return (invoke $startup "value" (i32.const 20)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 21)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 22)) (i32.const 17))
(assert_return (invoke $startup "value" (i32.const 23)) (i32.const 1496))
(assert_return (invoke $startup "value" (i32.const 24)) (i32.const 1))
;; Local destruction and over-aligned array/explicit new storage.
(assert_return (invoke $startup "value" (i32.const 25)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 26)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 27)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 28)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 29)) (i32.const 64))
(assert_return (invoke $startup "value" (i32.const 30)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 31)) (i32.const 165))
(assert_return (invoke $startup "value" (i32.const 32)) (i32.const 165))
;; Input and the shared sleep continuation before main.
(assert_return (invoke $startup "value" (i32.const 33)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 34)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 35)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 36)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 37)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 38)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 39)) (i32.const 1))
;; Priority order, stream output and ordinary C++ global construction.
(assert_return (invoke $startup "value" (i32.const 40)) (i32.const 12))
(assert_return (invoke $startup "value" (i32.const 41)) (i32.const 12))
(assert_return (invoke $startup "value" (i32.const 42)) (i32.const 12))
(assert_return (invoke $startup "value" (i32.const 43)) (i32.const 123))
(assert_return (invoke $startup "value" (i32.const 44)) (i32.const 85))
(assert_return (invoke $startup "value" (i32.const 45)) (i32.const 115))
(assert_return (invoke $startup "value" (i32.const 46)) (i32.const 114))
(assert_return (invoke $startup "value" (i32.const 47)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 48)) (i32.const 100))
(assert_return (invoke $startup "value" (i32.const 49)) (i32.const 101))
(assert_return (invoke $startup "value" (i32.const 50)) (i32.const 102))
;; Main receives production argv/environment and retained constructor allocations.
(assert_return (invoke $startup "value" (i32.const 51)) (i32.const 123))
(assert_return (invoke $startup "value" (i32.const 52)) (i32.const 3))
(assert_return (invoke $startup "value" (i32.const 53)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 54)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 55)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 56)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 57)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 58)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 59)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 60)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 61)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 62)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 63)) (i32.const 100))
(assert_return (invoke $startup "value" (i32.const 64)) (i32.const 101))
(assert_return (invoke $startup "value" (i32.const 65)) (i32.const 102))
(assert_return (invoke $startup "value" (i32.const 66)) (i32.const 85))
(assert_return (invoke $startup "value" (i32.const 67)) (i32.const 115))
(assert_return (invoke $startup "value" (i32.const 68)) (i32.const 58))
(assert_return (invoke $startup "value" (i32.const 69)) (i32.const 0))
;; Remaining input, EOF, direct descriptor output and local destruction.
(assert_return (invoke $startup "value" (i32.const 70)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 71)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 72)) (i32.const -1))
(assert_return (invoke $startup "value" (i32.const 73)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 74)) (i32.const 13))
(assert_return (invoke $startup "value" (i32.const 75)) (i32.const 13))
(assert_return (invoke $startup "value" (i32.const 76)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 77)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 78)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 79)) (i32.const 1))
(assert_return (invoke $startup "value" (i32.const 80)) (i32.const 0))
(assert_return (invoke $startup "value" (i32.const 81)) (i32.const 2))
