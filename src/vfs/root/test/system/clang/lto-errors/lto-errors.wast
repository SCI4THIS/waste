;; Production ThinBackendProc error owner, real queued tasks and profile context formatters.
;; C++ observes; every functional expectation is authored here.
(module $errors
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/lto-errors.bin\00")
  (data (i32.const 180128) "/tmp/lto-errors-status.txt\00")
  (data (i32.const 180256) "/tmp/lto-single.txt\00")
  (data (i32.const 210000) "1:captured backend\0a")
  (data (i32.const 180384) "/tmp/lto-notify.txt\00")
  (data (i32.const 210027) "index:first.bc\0a")
  (data (i32.const 180512) "/tmp/lto-joined.txt\00")
  (data (i32.const 210050) "2:first\0a3:nul\00payload\0a4:last\0a5:nested\0a")
  (data (i32.const 180640) "/tmp/lto-reentrant.txt\00")
  (data (i32.const 210096) "6:reentrant\0a")
  (data (i32.const 180768) "/tmp/lto-reused.txt\00")
  (data (i32.const 210116) "7:reused\0a")
  (data (i32.const 180896) "/tmp/lto-sleep.txt\00")
  (data (i32.const 210133) "8:before sleep\0a9:after sleep\0a10:after resume\0a")
  (data (i32.const 181024) "/tmp/lto-contexts.txt\00")
  (data (i32.const 210186) "frame\0aframe:17.9\0azero:0\0awide:4294967295.4294967295\0a18446744073709551615:7\0anul\00name\0anul\00name:3.4\0a\0a:0\0a\0aframe\0aframe:17.9\0acaller:1.2 @ frame\0acaller:1.2 @ frame:17.9\0acaller:1.2 @ frame\0achanged:1.2 @ frame\0a")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 184000 i32.const 2048 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180128 i32.const 186000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 186000 i32.load16_u i32.const 0x3932 i32.eq i32.and
    i32.const 186002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func $value (export "value") (param $index i32) (result i64)
    i32.const 184000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func (export "bytes") (param $path i32) (param $expected i32) (param $size i32) (result i32)
    (local $index i32)
    local.get $path i32.const 190000 i32.const 8192 call $capture
    local.get $size i32.ne if i32.const 0 return end
    block $done
      loop $bytes
        local.get $index local.get $size i32.ge_u br_if $done
        i32.const 190000 local.get $index i32.add i32.load8_u
        local.get $expected local.get $index i32.add i32.load8_u
        i32.ne if i32.const 0 return end
        local.get $index i32.const 1 i32.add local.set $index br $bytes
      end
    end i32.const 1)
)
(assert_return (invoke $errors "capture") (i32.const 1296))
(assert_return (invoke $errors "exit-status") (i32.const 1))
;; Profile and actual empty owner
(assert_return (invoke $errors "value" (i32.const 0)) (i64.const 1))
(assert_return (invoke $errors "value" (i32.const 1)) (i64.const 0))
(assert_return (invoke $errors "value" (i32.const 2)) (i64.const 0))
(assert_return (invoke $errors "value" (i32.const 3)) (i64.const 1))
(assert_return (invoke $errors "value" (i32.const 4)) (i64.const 1))
(assert_return (invoke $errors "value" (i32.const 5)) (i64.const 1))
(assert_return (invoke $errors "value" (i32.const 6)) (i64.const 1))
