;; Compiled C/C++ inputs only observe. WAST asserts the real shared libc ABI.
;; Observation: four i32 fields, then two 80-byte buffers = 176 guest bytes.
(module $format
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/format-c.bin\00")
  (data (i32.const 180032) "/tmp/format-cxx.bin\00")
  (data (i32.const 180064) "/tmp/format-c-status.txt\00")
  (data (i32.const 180096) "/tmp/format-cxx-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture-c-and-cxx") (result i32)
    i32.const 180000 i32.const 182000 i32.const 4096 call $capture i32.const 3168 i32.eq
    i32.const 180032 i32.const 187000 i32.const 4096 call $capture i32.const 3168 i32.eq i32.and)
  (func $status (param $path i32) (result i32)
    local.get $path i32.const 194200 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 194200 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "c-exit") (result i32) i32.const 180064 call $status)
  (func (export "cxx-exit") (result i32) i32.const 180096 call $status)
  (func $buffer (param $output i32) (param $expected i32) (param $written i32) (result i32)
    (local $offset i32)
    local.get $output i32.const 8 i32.add local.get $expected local.get $written call $compare
    if i32.const 0 return end
    loop $canaries
      local.get $offset i32.const 8 i32.lt_u
      local.get $offset local.get $written i32.const 8 i32.add i32.ge_u i32.or
      if
        local.get $output local.get $offset i32.add i32.load8_u i32.const 0xa5 i32.ne
        if i32.const 0 return end
      end
      local.get $offset i32.const 1 i32.add local.tee $offset i32.const 80 i32.lt_u br_if $canaries
    end
    i32.const 1)
  (func $record (param $base i32) (param $index i32) (param $full_length i32)
                (param $expected i32) (param $written i32) (result i32)
    (local $record i32)
    local.get $base local.get $index i32.const 176 i32.mul i32.add local.set $record
    local.get $record i32.load local.get $full_length i32.eq
    local.get $record i32.load offset=4 local.get $full_length i32.eq i32.and
    local.get $record i32.load offset=8 i32.const 42 i32.eq i32.and
    local.get $record i32.load offset=12 i32.const 17 i32.eq i32.and
    local.get $record i32.const 16 i32.add local.get $expected local.get $written call $buffer i32.and
    local.get $record i32.const 96 i32.add local.get $expected local.get $written call $buffer i32.and)
  (data (i32.const 181000) "\34\32\7c\67\75\65\73\74\7c\2d\34\32\39\34\39\36\37\32\39\37\7c\51\7c\31\37\7c\32\61\7c\25\00")
  (func (export "c-mixed-promotions") (result i32)
    i32.const 182000 i32.const 0 i32.const 30 i32.const 181000 i32.const 31 call $record)
  (func (export "cxx-mixed-promotions") (result i32)
    i32.const 187000 i32.const 0 i32.const 30 i32.const 181000 i32.const 31 call $record)
  (data (i32.const 181064) "\34\32\2d\61\62\63\00")
  (func (export "c-truncated") (result i32)
    i32.const 182000 i32.const 1 i32.const 9 i32.const 181064 i32.const 7 call $record)
  (func (export "cxx-truncated") (result i32)
    i32.const 187000 i32.const 1 i32.const 9 i32.const 181064 i32.const 7 call $record)
  (data (i32.const 181128) "\34\32\2d\61\62\63\64\65\66\00")
  (func (export "c-exact-fit") (result i32)
    i32.const 182000 i32.const 2 i32.const 9 i32.const 181128 i32.const 10 call $record)
  (func (export "cxx-exact-fit") (result i32)
    i32.const 187000 i32.const 2 i32.const 9 i32.const 181128 i32.const 10 call $record)
  (data (i32.const 181192) "\00")
  (func (export "c-one-byte") (result i32)
    i32.const 182000 i32.const 3 i32.const 9 i32.const 181192 i32.const 1 call $record)
  (func (export "cxx-one-byte") (result i32)
    i32.const 187000 i32.const 3 i32.const 9 i32.const 181192 i32.const 1 call $record)
  (data (i32.const 181256) "")
  (func (export "c-zero-size") (result i32)
    i32.const 182000 i32.const 4 i32.const 9 i32.const 181256 i32.const 0 call $record)
  (func (export "cxx-zero-size") (result i32)
    i32.const 187000 i32.const 4 i32.const 9 i32.const 181256 i32.const 0 call $record)
  (data (i32.const 181320) "")
  (func (export "c-null-sizing") (result i32)
    i32.const 182000 i32.const 5 i32.const 9 i32.const 181320 i32.const 0 call $record)
  (func (export "cxx-null-sizing") (result i32)
    i32.const 187000 i32.const 5 i32.const 9 i32.const 181320 i32.const 0 call $record)
  (data (i32.const 181384) "\00")
  (func (export "c-empty") (result i32)
    i32.const 182000 i32.const 6 i32.const 0 i32.const 181384 i32.const 1 call $record)
  (func (export "cxx-empty") (result i32)
    i32.const 187000 i32.const 6 i32.const 0 i32.const 181384 i32.const 1 call $record)
  (data (i32.const 181448) "\34\32\3a\c3\a9\00")
  (func (export "c-utf8-byte-length") (result i32)
    i32.const 182000 i32.const 7 i32.const 6 i32.const 181448 i32.const 6 call $record)
  (func (export "cxx-utf8-byte-length") (result i32)
    i32.const 187000 i32.const 7 i32.const 6 i32.const 181448 i32.const 6 call $record)
  (data (i32.const 192000) "\34\32\3a\30\2f\46\46\00")
  (func (export "c-prix8-promotions") (result i32)
    i32.const 182000 i32.const 8 i32.const 7 i32.const 192000 i32.const 8 call $record)
  (func (export "cxx-prix8-promotions") (result i32)
    i32.const 187000 i32.const 8 i32.const 7 i32.const 192000 i32.const 8 call $record)
  (data (i32.const 192128) "\34\32\3a\30\2f\46\46\46\46\00")
  (func (export "c-prix16-promotions") (result i32)
    i32.const 182000 i32.const 9 i32.const 9 i32.const 192128 i32.const 10 call $record)
  (func (export "cxx-prix16-promotions") (result i32)
    i32.const 187000 i32.const 9 i32.const 9 i32.const 192128 i32.const 10 call $record)
  (data (i32.const 192256) "\34\32\3a\30\2f\46\46\46\46\46\46\46\46\00")
  (func (export "c-prix32-unsigned") (result i32)
    i32.const 182000 i32.const 10 i32.const 13 i32.const 192256 i32.const 14 call $record)
  (func (export "cxx-prix32-unsigned") (result i32)
    i32.const 187000 i32.const 10 i32.const 13 i32.const 192256 i32.const 14 call $record)
  (data (i32.const 192384) "\34\32\3a\30\2f\46\46\46\46\46\46\46\46\46\46\46\46\46\46\46\46\00")
  (func (export "c-prix64-unsigned") (result i32)
    i32.const 182000 i32.const 11 i32.const 21 i32.const 192384 i32.const 22 call $record)
  (func (export "cxx-prix64-unsigned") (result i32)
    i32.const 187000 i32.const 11 i32.const 21 i32.const 192384 i32.const 22 call $record)
  (data (i32.const 192512) "\34\32\3a\38\30\2f\38\30\30\30\2f\38\30\30\30\30\30\30\30\2f\38\30\30\30\30\30\30\30\30\30\30\30\30\30\30\30\2f\37\33\2f\31\32\33\34\35\36\37\38\39\41\42\43\44\45\46\2f\44\45\41\44\42\45\45\46\00")
  (func (export "c-prix-mixed-alignment") (result i32)
    i32.const 182000 i32.const 12 i32.const 64 i32.const 192512 i32.const 65 call $record)
  (func (export "cxx-prix-mixed-alignment") (result i32)
    i32.const 187000 i32.const 12 i32.const 64 i32.const 192512 i32.const 65 call $record)
  (data (i32.const 192640) "\34\32\3a\30\41\2f\30\30\42\43\2f\30\30\30\30\30\44\45\46\2f\30\30\30\30\30\30\30\30\30\30\30\30\30\31\32\33\00")
  (func (export "c-prix-zero-padding") (result i32)
