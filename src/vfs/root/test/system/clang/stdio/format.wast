  (data (i32.const 192896) "\34\32\3a\64\65\61\64\62\65\65\66\2f\44\45\41\44\42\45\45\46\2f\66\65\64\63\62\61\39\38\37\36\35\34\33\32\31\30\2f\46\45\44\43\42\41\39\38\37\36\35\34\33\32\31\30\00")
  (func (export "c-prix-uppercase-lowercase") (result i32)
