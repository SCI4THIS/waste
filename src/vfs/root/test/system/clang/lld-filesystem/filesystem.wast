(assert_return (invoke $files "bytes" (i32.const 180256) (i32.const 210000) (i32.const 11)) (i32.const 1))
(assert_return (invoke $files "bytes" (i32.const 180384) (i32.const 210019) (i32.const 11)) (i32.const 1))
