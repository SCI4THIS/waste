(assert_return (invoke $files "bytes" (i32.const 181792) (i32.const 210209) (i32.const 161)) (i32.const 1))
(assert_return (invoke $files "bytes" (i32.const 181920) (i32.const 210378) (i32.const 72)) (i32.const 1))
(assert_return (invoke $files "bytes" (i32.const 182048) (i32.const 210458) (i32.const 72)) (i32.const 1))
(assert_return (invoke $files "bytes" (i32.const 182176) (i32.const 210538) (i32.const 37)) (i32.const 1))
(assert_return (invoke $files "absent" (i32.const 182000)) (i32.const 1))
