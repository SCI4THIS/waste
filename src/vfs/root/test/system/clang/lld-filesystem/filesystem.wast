;; Preflight leaves the original inode; commit creates a different target inode.
(assert_return (invoke $files "positive" (i32.const 8)) (i32.const 1))
(assert_return (invoke $files "same" (i32.const 8) (i32.const 40)) (i32.const 1))
(assert_return (invoke $files "same" (i32.const 8) (i32.const 77)) (i32.const 1))
