;; Actual LLD filesystem helpers, output commit and retained inode ownership.
;; Only observations come from C++; every functional expectation is here.
(module $files
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (data (i32.const 180000) "/tmp/lld-filesystem.bin\00")
  (data (i32.const 180128) "/tmp/lld-filesystem-status.txt\00")
  (data (i32.const 182000) "/tmp/lld-files/absent.wasm\00")
  (data (i32.const 180256) "/tmp/lld-before.txt\00")
  (data (i32.const 210000) "old-output\0a")
  (data (i32.const 180384) "/tmp/lld-preflight.txt\00")
  (data (i32.const 210019) "old-output\0a")
  (data (i32.const 180512) "/tmp/lld-abandoned.txt\00")
  (data (i32.const 210038) "old-output\0a")
  (data (i32.const 180640) "/tmp/lld-pending.txt\00")
  (data (i32.const 210057) "old-output\0a")
  (data (i32.const 180768) "/tmp/lld-committed.txt\00")
  (data (i32.const 210076) "new\00wasm-output\0a")
  (data (i32.const 180896) "/tmp/lld-held.txt\00")
  (data (i32.const 210100) "old-output\0a")
  (data (i32.const 181024) "/tmp/lld-discarded.txt\00")
  (data (i32.const 210119) "new\00wasm-output\0a")
  (data (i32.const 181152) "/tmp/lld-memory.txt\00")
  (data (i32.const 210143) "MEM\00!\0a")
  (data (i32.const 181280) "/tmp/lld-empty.txt\00")
  (data (i32.const 210157) "")
  (data (i32.const 181408) "/tmp/lld-ordinary.txt\00")
  (data (i32.const 210165) "abXYef!\0a")
  (data (i32.const 181536) "/tmp/lld-lto-prefix.txt\00")
  (data (i32.const 210181) "bit")
  (data (i32.const 181664) "/tmp/lld-lto.txt\00")
  (data (i32.const 210192) "BCtXode!\0a")
  (data (i32.const 181792) "/tmp/lld-file-errors.txt\00")
  (data (i32.const 210209) "wasm-ld: error: cannot open /tmp/lld-no-parent/ordinary: No such file or directory\0awasm-ld: error: cannot open /tmp/lld-no-parent/lto: No such file or directory\0a")
  (data (i32.const 181920) "/tmp/lld-pointer-c.txt\00")
  (data (i32.const 210378) "-2147483648 -17 4294967295 37667135230 fedcba98 FEDCBA98 -4294967298 73\0a")
  (data (i32.const 182048) "/tmp/lld-pointer-cxx.txt\00")
  (data (i32.const 210458) "-2147483648 -17 4294967295 37667135230 fedcba98 FEDCBA98 -4294967298 73\0a")
  (data (i32.const 182176) "/tmp/lld-pointer-llvm.txt\00")
  (data (i32.const 210538) "(0xfedcba98 (0xfedcba98, 0x00000000))")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 184000 i32.const 2048 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180128 i32.const 186000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 186000 i32.load16_u i32.const 0x3732 i32.eq i32.and
    i32.const 186002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func $value (export "value") (param $index i32) (result i64)
    i32.const 184000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func (export "positive") (param $index i32) (result i32)
    local.get $index call $value i64.const 0 i64.gt_u)
  (func (export "same") (param $first i32) (param $second i32) (result i32)
    local.get $first call $value local.get $second call $value i64.eq)
  (func (export "bytes") (param $path i32) (param $expected i32) (param $size i32) (result i32)
    (local $index i32)
    local.get $path i32.const 190000 i32.const 8192 call $capture
    local.get $size i32.ne if i32.const 0 return end
    block $done
      loop $bytes
        local.get $index local.get $size i32.ge_u br_if $done
        i32.const 190000 local.get $index i32.add i32.load8_u
        local.get $expected local.get $index i32.add i32.load8_u
        i32.ne if i32.const 0 return end
        local.get $index i32.const 1 i32.add local.set $index br $bytes
      end
    end i32.const 1)
  (func (export "absent") (param $path i32) (result i32)
    (local $fd i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd i32.const -1 i32.eq
    if (result i32) call $errno i32.load i32.const 2 i32.eq
    else local.get $fd call $close drop i32.const 0 end)
)
(assert_return (invoke $files "capture") (i32.const 1416))
(assert_return (invoke $files "exit-status") (i32.const 1))
;; Guest profile, original file and retained descriptor
(assert_return (invoke $files "value" (i32.const 0)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 1)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 2)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 3)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 4)) (i64.const 11))
(assert_return (invoke $files "value" (i32.const 5)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 6)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 7)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 9)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 10)) (i64.const 11))
(assert_return (invoke $files "value" (i32.const 11)) (i64.const 384))
(assert_return (invoke $files "value" (i32.const 12)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 13)) (i64.const 1))
;; No async removal at requested counts 1, 0 and 8
(assert_return (invoke $files "value" (i32.const 14)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 15)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 16)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 17)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 18)) (i64.const 8))
(assert_return (invoke $files "value" (i32.const 19)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 20)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 21)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 22)) (i64.const 11))
(assert_return (invoke $files "value" (i32.const 23)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 24)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 25)) (i64.const 1))
;; Real output preflight preserves bytes, inode and directory entries
(assert_return (invoke $files "value" (i32.const 26)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 27)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 28)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 29)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 30)) (i64.const -1))
(assert_return (invoke $files "value" (i32.const 31)) (i64.const 21))
(assert_return (invoke $files "value" (i32.const 32)) (i64.const 2))
(assert_return (invoke $files "value" (i32.const 33)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 34)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 35)) (i64.const 11))
(assert_return (invoke $files "value" (i32.const 36)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 37)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 38)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 39)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 41)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 42)) (i64.const 11))
(assert_return (invoke $files "value" (i32.const 43)) (i64.const 384))
;; Uncommitted mapped output is removed on destruction
(assert_return (invoke $files "value" (i32.const 44)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 45)) (i64.const 16))
(assert_return (invoke $files "value" (i32.const 46)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 47)) (i64.const 2))
(assert_return (invoke $files "value" (i32.const 48)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 49)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 50)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 51)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 52)) (i64.const 11))
(assert_return (invoke $files "value" (i32.const 53)) (i64.const 0))
;; Mapped executable output commits after shared sleep
(assert_return (invoke $files "value" (i32.const 54)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 55)) (i64.const 16))
(assert_return (invoke $files "value" (i32.const 56)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 57)) (i64.const 2))
(assert_return (invoke $files "value" (i32.const 58)) (i64.const 1))
