(assert_return (invoke $files "value" (i32.const 60)) (i64.const 11))
(assert_return (invoke $files "value" (i32.const 61)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 62)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 63)) (i64.const 110))
(assert_return (invoke $files "value" (i32.const 64)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 65)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 66)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 67)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 68)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 69)) (i64.const 16))
(assert_return (invoke $files "value" (i32.const 70)) (i64.const 0))
;; Replacement retains the old descriptor bytes and unlinked inode
(assert_return (invoke $files "value" (i32.const 71)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 72)) (i64.const 11))
(assert_return (invoke $files "value" (i32.const 73)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 74)) (i64.const 11))
(assert_return (invoke $files "value" (i32.const 75)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 76)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 78)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 79)) (i64.const 11))
(assert_return (invoke $files "value" (i32.const 80)) (i64.const 384))
(assert_return (invoke $files "value" (i32.const 81)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 82)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 84)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 85)) (i64.const 16))
(assert_return (invoke $files "value" (i32.const 86)) (i64.const 493))
(assert_return (invoke $files "value" (i32.const 87)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 88)) (i64.const 0))
;; Explicit/repeated discard retains live mapped memory
(assert_return (invoke $files "value" (i32.const 89)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 90)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 91)) (i64.const 2))
(assert_return (invoke $files "value" (i32.const 92)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 93)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 94)) (i64.const 100))
(assert_return (invoke $files "value" (i32.const 95)) (i64.const 100))
(assert_return (invoke $files "value" (i32.const 96)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 97)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 98)) (i64.const 0))
