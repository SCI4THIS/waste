(assert_return (invoke $files "value" (i32.const 129)) (i64.const 6))
(assert_return (invoke $files "value" (i32.const 130)) (i64.const 8))
(assert_return (invoke $files "value" (i32.const 131)) (i64.const 0))
(assert_return (invoke $files "value" (i32.const 132)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 133)) (i64.const 1))
(assert_return (invoke $files "value" (i32.const 134)) (i64.const 8))
