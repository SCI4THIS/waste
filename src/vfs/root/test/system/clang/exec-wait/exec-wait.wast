(assert_return (invoke $exec-wait "value" (i32.const 5)) (i64.const -1))
(assert_return (invoke $exec-wait "value" (i32.const 6)) (i64.const 14))
(assert_return (invoke $exec-wait "value" (i32.const 7)) (i64.const -1))
(assert_return (invoke $exec-wait "value" (i32.const 8)) (i64.const 2))
(assert_return (invoke $exec-wait "value" (i32.const 9)) (i64.const -1))
(assert_return (invoke $exec-wait "value" (i32.const 10)) (i64.const 2))
(assert_return (invoke $exec-wait "value" (i32.const 11)) (i64.const -1))
(assert_return (invoke $exec-wait "value" (i32.const 12)) (i64.const 14))
(assert_return (invoke $exec-wait "value" (i32.const 13)) (i64.const -1))
(assert_return (invoke $exec-wait "value" (i32.const 14)) (i64.const 14))
(assert_return (invoke $exec-wait "value" (i32.const 15)) (i64.const -1))
(assert_return (invoke $exec-wait "value" (i32.const 16)) (i64.const 14))
(assert_return (invoke $exec-wait "value" (i32.const 17)) (i64.const 7310584035177688681))
(assert_return (invoke $exec-wait "value" (i32.const 18)) (i64.const 100))
(assert_return (invoke $exec-wait "value" (i32.const 19)) (i64.const 0))
(assert_return (invoke $exec-wait "value" (i32.const 20)) (i64.const 0))

