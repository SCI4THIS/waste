;; Actual compiled LLVM SmartMutex and bootstrap libc++ call_once observations.
;; Eight profile i32s, two sets of twelve lock observations, six once values.
(module $mutex
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/mutex.bin\00")
  (data (i32.const 180032) "/tmp/mutex-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 1024 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180032 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i32)
    i32.const 182000 local.get $index i32.const 4 i32.mul i32.add i32.load)
)
(assert_return (invoke $mutex "capture") (i32.const 152))
(assert_return (invoke $mutex "exit-status") (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 0)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 1)) (i32.const 0))
(assert_return (invoke $mutex "value" (i32.const 2)) (i32.const 0))
(assert_return (invoke $mutex "value" (i32.const 3)) (i32.const 0))
(assert_return (invoke $mutex "value" (i32.const 4)) (i32.const 0))
(assert_return (invoke $mutex "value" (i32.const 5)) (i32.const 0))
(assert_return (invoke $mutex "value" (i32.const 6)) (i32.const 0))
(assert_return (invoke $mutex "value" (i32.const 7)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 8)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 9)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 10)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 11)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 12)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 13)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 14)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 15)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 16)) (i32.const 17))
(assert_return (invoke $mutex "value" (i32.const 17)) (i32.const 0))
(assert_return (invoke $mutex "value" (i32.const 18)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 19)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 20)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 21)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 22)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 23)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 24)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 25)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 26)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 27)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 28)) (i32.const 17))
(assert_return (invoke $mutex "value" (i32.const 29)) (i32.const 0))
(assert_return (invoke $mutex "value" (i32.const 30)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 31)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 32)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 33)) (i32.const 42))
(assert_return (invoke $mutex "value" (i32.const 34)) (i32.const 1))
(assert_return (invoke $mutex "value" (i32.const 35)) (i32.const 42))
(assert_return (invoke $mutex "value" (i32.const 36)) (i32.const 2))
(assert_return (invoke $mutex "value" (i32.const 37)) (i32.const 77))
