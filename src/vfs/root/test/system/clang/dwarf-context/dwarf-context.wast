;; Actual LLVM context and unit caches; the observer only records values.
(module $context
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/dwarf-context.bin\00")
  (data (i32.const 180128) "/tmp/dwarf-context-status.txt\00")
  (data (i32.const 180256) "/tmp/dwarf-context-names.txt\00")
  (data (i32.const 180384) "/tmp/dwarf-context-pseudo.txt\00")
  (data (i32.const 200000) "unit.c\0asplit.c\0asplit.c\0a")
  (data (i32.const 200256) "empty=[]\0aouter=[outer:0]\0anested=[outer:0 @ inner-with-owned-name:4294967295]\0aretained=[outer:0 @ inner-with-owned-name:4294967295]\0achanged=[after:0 @ other:4294967295]\0a")
  (func $capture (param $path i32) (param $output i32) (param $capacity i32) (result i32)
    (local $fd i32) (local $count i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $output local.get $capacity call $read local.set $count
    local.get $fd call $close drop local.get $count)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 184000 i32.const 4096 call $capture)
  (func (export "status") (result i32)
    i32.const 180128 i32.const 190000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 190000 i32.load16_u i32.const 0x3932 i32.eq i32.and
    i32.const 190002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i64)
    i32.const 184000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func (export "normal-and-split-unit-names") (result i32)
    i32.const 180256 i32.const 210000 i32.const 4096 call $capture i32.const 23 i32.eq
    i32.const 210000 i32.const 200000 i32.const 23 call $compare i32.eqz i32.and)
  (func (export "pseudo-probe-order-index-and-owned-output") (result i32)
    i32.const 180384 i32.const 210000 i32.const 4096 call $capture i32.const 168 i32.eq
    i32.const 210000 i32.const 200256 i32.const 168 call $compare i32.eqz i32.and)
)
(assert_return (invoke $context "capture") (i32.const 376))
(assert_return (invoke $context "status") (i32.const 1))
;; Profile; real unit/DIE parsing and recursive cache access across shared sleep.
(assert_return (invoke $context "value" (i32.const 0)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 1)) (i64.const 0))
(assert_return (invoke $context "value" (i32.const 2)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 3)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 4)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 5)) (i64.const 0))
(assert_return (invoke $context "value" (i32.const 6)) (i64.const 4))
(assert_return (invoke $context "value" (i32.const 7)) (i64.const 4))
(assert_return (invoke $context "value" (i32.const 8)) (i64.const 17))
(assert_return (invoke $context "value" (i32.const 9)) (i64.const 4096))
(assert_return (invoke $context "value" (i32.const 10)) (i64.const 32))
(assert_return (invoke $context "value" (i32.const 11)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 12)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 13)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 14)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 15)) (i64.const 1))
;; DWO units, index caches, location/arange/macinfo caches and range boundary.
(assert_return (invoke $context "value" (i32.const 16)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 17)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 18)) (i64.const 4))
(assert_return (invoke $context "value" (i32.const 19)) (i64.const 8192))
(assert_return (invoke $context "value" (i32.const 20)) (i64.const 48))
(assert_return (invoke $context "value" (i32.const 21)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 22)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 23)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 24)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 25)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 26)) (i64.const 0))
(assert_return (invoke $context "value" (i32.const 27)) (i64.const -1))
(assert_return (invoke $context "value" (i32.const 28)) (i64.const 1))
;; The locking-mode state eagerly parses even a lazy request; the other state
;; keeps the upstream lazy mode. These labels do not establish thread exclusion.
(assert_return (invoke $context "value" (i32.const 29)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 30)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 31)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 32)) (i64.const 0))
(assert_return (invoke $context "value" (i32.const 33)) (i64.const 0))
(assert_return (invoke $context "value" (i32.const 34)) (i64.const 0))
(assert_return (invoke $context "value" (i32.const 35)) (i64.const 0))
(assert_return (invoke $context "value" (i32.const 36)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 37)) (i64.const 0))
;; Destroyed object ownership, fresh empty caches, and exact file transport.
(assert_return (invoke $context "value" (i32.const 38)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 39)) (i64.const 0))
(assert_return (invoke $context "value" (i32.const 40)) (i64.const 0))
(assert_return (invoke $context "value" (i32.const 41)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 42)) (i64.const 0))
(assert_return (invoke $context "value" (i32.const 43)) (i64.const 2))
(assert_return (invoke $context "value" (i32.const 44)) (i64.const 1))
(assert_return (invoke $context "value" (i32.const 45)) (i64.const 23))
(assert_return (invoke $context "value" (i32.const 46)) (i64.const 0))
(assert_return (invoke $context "normal-and-split-unit-names") (i32.const 1))
(assert_return (invoke $context "pseudo-probe-order-index-and-owned-output") (i32.const 1))
