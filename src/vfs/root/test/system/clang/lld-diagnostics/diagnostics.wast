;; Actual LLD context, diagnostics, fatal recovery and shared process cleanup.
;; Observer records only; these are all explicit functional expectations.
(module $lld
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (data (i32.const 180000) "/tmp/lld-diagnostics.bin\00")
  (data (i32.const 180128) "/tmp/lld-diagnostics-status.txt\00")
  (data (i32.const 181900) "/tmp/lld-uncommitted.wasm\00")
  (data (i32.const 180256) "/tmp/lld-normal.stdout\00")
  (data (i32.const 210000) "ready\0aa\00b\0a")
  (data (i32.const 180384) "/tmp/lld-normal.stderr\00")
  (data (i32.const 210018) "wasm-ld: details\0awasm-ld: warning: careful\0awasm-ld: error: promoted\0awasm-ld: error: missing\0awasm-ld: error: multi\0aline\0a\0awasm-ld: warning: after\0awasm-ld: error: owned failure\0awasm-ld: error: tagged error\0a")
  (data (i32.const 180512) "/tmp/lld-limits.stderr\00")
  (data (i32.const 210229) "wasm-ld: error: A\0awasm-ld: error: B\0awasm-ld: error: too many errors emitted, stopping now\0awasm-ld: warning: still warn\0awasm-ld: error: E\0awasm-ld: error: limit reached\0a")
  (data (i32.const 180640) "/tmp/lld-vs.stderr\00")
  (data (i32.const 210404) "src/a.c(12): error: undefined symbol: x\0a>>> referenced by a.o(src/a.c:12)\0a\0asrc/b.c(34): error: undefined hidden symbol: x\0a>>> referenced by src/b.c:34\0a\0aarchive member: error: undefined symbol: x\0a>>> referenced by archive member:\0a\0aone.o: error: duplicate symbol: x\0a>>> defined in one.o\0a>>> defined in two.o\0a\0asrc/c.c(56): error: duplicate symbol: x\0a>>> defined at a.o(src/c.c:56)\0a\0asrc/d.c(78): error: duplicate symbol: x\0a>>> defined at src/d.c:78\0a\0asrc/e.c(90): error: relocation overflow\0a>>> defined in x.o\0a>>> referenced by b.o(src/e.c:90)\0a\0asrc/f.c(11): error: relocation overflow\0a>>> defined in x.o\0a>>> referenced by src/f.c:11\0a\0asrc/g.c(22): error: src/g.c:22: unclosed quote\0awasm-ld: error: unrecognized location\0asrc/one.c(10): error: duplicate symbol: split\0a>>> defined at src/one.c:10\0a>>> first definition\0a\0asrc/two.c(20): error: duplicate symbol: split\0a>>> defined at src/two.c:20\0a>>> second definition\0a")
  (data (i32.const 180768) "/tmp/lld-sync.stdout\00")
  (data (i32.const 211318) "sync message\0a")
  (data (i32.const 180896) "/tmp/lld-sync.stderr\00")
  (data (i32.const 211339) "\0awasm-ld: sync log\0awasm-ld: warning: sync warning\0awasm-ld: error: sync error\0awasm-ld: error: moved error\0awasm-ld: error: \0a")
  (data (i32.const 181024) "/tmp/lld-script.stderr\00")
  (data (i32.const 211469) "wasm-ld: error: script source\0awasm-ld: error: error handling script '/usr/bin/false' exited with code 1\0a")
  (data (i32.const 181152) "/tmp/lld-recovery.stderr\00")
  (data (i32.const 211581) "wasm-ld: error: bad module\0a")
  (data (i32.const 181280) "/tmp/lld-fatal-exit.txt\00")
  (data (i32.const 211616) "child stdout\0awasm-ld: error: corrupt input\0a")
  (data (i32.const 181408) "/tmp/lld-fatal-cleanup.txt\00")
  (data (i32.const 211667) "managed\0a")
  (data (i32.const 181536) "/tmp/lld-limit-exit.txt\00")
  (data (i32.const 211683) "child stdout\0awasm-ld: error: first\0awasm-ld: error: too many errors emitted, stopping now\0a")
  (data (i32.const 181664) "/tmp/lld-limit-cleanup.txt\00")
  (data (i32.const 211780) "managed\0a")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 2048 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180128 i32.const 184000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x3332 i32.eq i32.and
    i32.const 184002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i64)
    i32.const 182000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func (export "bytes") (param $path i32) (param $expected i32) (param $size i32) (result i32)
    (local $index i32)
    local.get $path i32.const 190000 i32.const 8192 call $capture
    local.get $size i32.ne if i32.const 0 return end
    block $done
      loop $bytes
        local.get $index local.get $size i32.ge_u br_if $done
        i32.const 190000 local.get $index i32.add i32.load8_u
        local.get $expected local.get $index i32.add i32.load8_u
        i32.ne if i32.const 0 return end
        local.get $index i32.const 1 i32.add local.set $index br $bytes
      end
    end i32.const 1)
  (func (export "absent") (param $path i32) (result i32)
    (local $fd i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd i32.const -1 i32.eq
    if (result i32) call $errno i32.load i32.const 2 i32.eq
    else local.get $fd call $close drop i32.const 0 end)
)
(assert_return (invoke $lld "capture") (i32.const 600))
(assert_return (invoke $lld "exit-status") (i32.const 1))
;; Actual guest profile, context installation and ordinary diagnostics
(assert_return (invoke $lld "value" (i32.const 0)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 1)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 2)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 3)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 4)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 5)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 6)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 7)) (i64.const 20))
(assert_return (invoke $lld "value" (i32.const 8)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 9)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 10)) (i64.const 5))
(assert_return (invoke $lld "value" (i32.const 11)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 12)) (i64.const 10))
(assert_return (invoke $lld "value" (i32.const 13)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 14)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 15)) (i64.const 203))
(assert_return (invoke $lld "value" (i32.const 16)) (i64.const 0))
;; Error limits, muted output and counters
(assert_return (invoke $lld "value" (i32.const 17)) (i64.const 4))
(assert_return (invoke $lld "value" (i32.const 18)) (i64.const 5))
(assert_return (invoke $lld "value" (i32.const 19)) (i64.const 3))
(assert_return (invoke $lld "value" (i32.const 20)) (i64.const 4))
(assert_return (invoke $lld "value" (i32.const 21)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 22)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 23)) (i64.const 167))
(assert_return (invoke $lld "value" (i32.const 24)) (i64.const 0))
;; All nine location patterns, fallback and duplicate splitting
(assert_return (invoke $lld "value" (i32.const 25)) (i64.const 12))
(assert_return (invoke $lld "value" (i32.const 26)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 27)) (i64.const 906))
(assert_return (invoke $lld "value" (i32.const 28)) (i64.const 0))
;; Actual synchronized stream levels and move ownership
(assert_return (invoke $lld "value" (i32.const 29)) (i64.const 8))
(assert_return (invoke $lld "value" (i32.const 30)) (i64.const 11))
(assert_return (invoke $lld "value" (i32.const 31)) (i64.const 3))
(assert_return (invoke $lld "value" (i32.const 32)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 33)) (i64.const 13))
(assert_return (invoke $lld "value" (i32.const 34)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 35)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 36)) (i64.const 122))
(assert_return (invoke $lld "value" (i32.const 37)) (i64.const 0))
;; Error handling script uses the real shared child execution path
(assert_return (invoke $lld "value" (i32.const 38)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 39)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 40)) (i64.const 104))
(assert_return (invoke $lld "value" (i32.const 41)) (i64.const 0))
;; Fatal recovery discards output while keeping its mapping alive
(assert_return (invoke $lld "value" (i32.const 42)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 43)) (i64.const 16))
(assert_return (invoke $lld "value" (i32.const 44)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 45)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 46)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 47)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 48)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 49)) (i64.const 90))
(assert_return (invoke $lld "value" (i32.const 50)) (i64.const -1))
(assert_return (invoke $lld "value" (i32.const 51)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 52)) (i64.const 27))
(assert_return (invoke $lld "value" (i32.const 53)) (i64.const 0))
;; Context destroys arena owners before its yielding cleanup callback
(assert_return (invoke $lld "value" (i32.const 54)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 55)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 56)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 57)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 58)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 59)) (i64.const 1))
;; Reused context and real static CodeGen/MC registration
(assert_return (invoke $lld "value" (i32.const 60)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 61)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 62)) (i64.const 0))
;; Actual fatal/limit children flush and reap; parent context stays cleared
(assert_return (invoke $lld "value" (i32.const 63)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 64)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 65)) (i64.const 256))
(assert_return (invoke $lld "value" (i32.const 66)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 67)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 68)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 69)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 70)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 71)) (i64.const 256))
(assert_return (invoke $lld "value" (i32.const 72)) (i64.const 0))
(assert_return (invoke $lld "value" (i32.const 73)) (i64.const 1))
(assert_return (invoke $lld "value" (i32.const 74)) (i64.const 1))
;; Exact binary/text bytes, newline separation, location prefixes and cleanup.
(assert_return (invoke $lld "bytes" (i32.const 180256) (i32.const 210000) (i32.const 10)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 180384) (i32.const 210018) (i32.const 203)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 180512) (i32.const 210229) (i32.const 167)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 180640) (i32.const 210404) (i32.const 906)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 180768) (i32.const 211318) (i32.const 13)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 180896) (i32.const 211339) (i32.const 122)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 181024) (i32.const 211469) (i32.const 104)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 181152) (i32.const 211581) (i32.const 27)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 181280) (i32.const 211616) (i32.const 43)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 181408) (i32.const 211667) (i32.const 8)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 181536) (i32.const 211683) (i32.const 89)) (i32.const 1))
(assert_return (invoke $lld "bytes" (i32.const 181664) (i32.const 211780) (i32.const 8)) (i32.const 1))
(assert_return (invoke $lld "absent" (i32.const 181900)) (i32.const 1))
