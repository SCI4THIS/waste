;; Observations from compiled C++ and unchanged LLVM mapping methods.
(module $advice
  (import "waste-runtime" "memory" (memory 4))
  (import "env" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/advice.bin\00")
  (data (i32.const 180064) "/tmp/advice-status.txt\00")
  (func $read-file (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    (local.set $fd (call $open (local.get $path) (i32.const 0) (i32.const 0)))
    (local.set $bytes (call $read (local.get $fd) (local.get $output) (local.get $count)))
    (drop (call $close (local.get $fd))) (local.get $bytes))
  (func (export "capture") (result i32)
    (call $read-file (i32.const 180000) (i32.const 182000) (i32.const 160)))
  (func (export "exit") (result i32)
    (drop (call $read-file (i32.const 180064) (i32.const 181000) (i32.const 16)))
    (i32.load16_u (i32.const 181000)))
  (func (export "value") (param $index i32) (result i32)
    (i32.load (i32.add (i32.const 182000) (i32.mul (local.get $index) (i32.const 4))))))
(assert_return (invoke $advice "capture") (i32.const 160))
(assert_return (invoke $advice "exit") (i32.const 2608))
(assert_return (invoke $advice "value" (i32.const 0)) (i32.const 0))
(assert_return (invoke $advice "value" (i32.const 1)) (i32.const 1))
(assert_return (invoke $advice "value" (i32.const 2)) (i32.const 2))
(assert_return (invoke $advice "value" (i32.const 3)) (i32.const 3))
(assert_return (invoke $advice "value" (i32.const 4)) (i32.const 4))
(assert_return (invoke $advice "value" (i32.const 5)) (i32.const 1))
(assert_return (invoke $advice "value" (i32.const 6)) (i32.const 0))
(assert_return (invoke $advice "value" (i32.const 7)) (i32.const 4))
(assert_return (invoke $advice "value" (i32.const 8)) (i32.const 0))
(assert_return (invoke $advice "value" (i32.const 9)) (i32.const 1))
(assert_return (invoke $advice "value" (i32.const 10)) (i32.const 65537))
(assert_return (invoke $advice "value" (i32.const 11)) (i32.const 0))
(assert_return (invoke $advice "value" (i32.const 12)) (i32.const 0))
(assert_return (invoke $advice "value" (i32.const 13)) (i32.const 81))
