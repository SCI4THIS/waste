;; Process-VM observations from ranges.cpp; WAST owns every expectation.
;; The ordinary CRT process owns the mapping state. WAST handlers have no VM capsule.
(module $ranges
  (import "waste-runtime" "memory" (memory 4))
  (import "env" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "lseek" (func $seek (param i32 i64 i32) (result i64)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/advice.bin\00")
  (func (export "capture") (result i32)
    (local $fd i32) (local $bytes i32)
    (local.set $fd (call $open (i32.const 180000) (i32.const 0) (i32.const 0)))
    (drop (call $seek (local.get $fd) (i64.const 160) (i32.const 0)))
    (local.set $bytes (call $read (local.get $fd) (i32.const 182000) (i32.const 1025)))
    (drop (call $close (local.get $fd))) (local.get $bytes))
  (func (export "value") (param $index i32) (result i32)
    (i32.load (i32.add (i32.const 182000) (i32.mul (local.get $index) (i32.const 4))))))
(assert_return (invoke $ranges "capture") (i32.const 1024))
;; Anonymous allocation
(assert_return (invoke $ranges "value" (i32.const 0)) (i32.const 1))
;; Five hints, rounded lengths, unchanged boundary bytes and legacy adapter
(assert_return (invoke $ranges "value" (i32.const 1)) (i32.const 0))
(assert_return (invoke $ranges "value" (i32.const 2)) (i32.const 71))
(assert_return (invoke $ranges "value" (i32.const 3)) (i32.const 0))
(assert_return (invoke $ranges "value" (i32.const 4)) (i32.const 71))
(assert_return (invoke $ranges "value" (i32.const 5)) (i32.const 0))
(assert_return (invoke $ranges "value" (i32.const 6)) (i32.const 71))
(assert_return (invoke $ranges "value" (i32.const 7)) (i32.const 17))
(assert_return (invoke $ranges "value" (i32.const 8)) (i32.const 35))
(assert_return (invoke $ranges "value" (i32.const 9)) (i32.const 36))
(assert_return (invoke $ranges "value" (i32.const 10)) (i32.const 51))
