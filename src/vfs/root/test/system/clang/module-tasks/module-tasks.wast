;; Actual production Clang module task owner, recursive ownership and shared sleep.
;; Controlled clock/signal events are shared by both runtimes in browser.json.
(module $tasks
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/module-tasks.bin\00")
  (data (i32.const 180128) "/tmp/module-tasks-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 2048 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180128 i32.const 184000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x3931 i32.eq i32.and
    i32.const 184002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i64)
    i32.const 182000 local.get $index i32.const 8 i32.mul i32.add i64.load)
)
(assert_return (invoke $tasks "capture") (i32.const 816))
(assert_return (invoke $tasks "exit-status") (i32.const 1))
;; Explicit compiler profile; empty owner
(assert_return (invoke $tasks "value" (i32.const 0)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 1)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 2)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 3)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 4)) (i64.const 0))
;; Inline recursive callbacks and move-only capture cleanup
(assert_return (invoke $tasks "value" (i32.const 5)) (i64.const 10))
(assert_return (invoke $tasks "value" (i32.const 6)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 7)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 8)) (i64.const 20))
(assert_return (invoke $tasks "value" (i32.const 9)) (i64.const 2))
(assert_return (invoke $tasks "value" (i32.const 10)) (i64.const 2))
(assert_return (invoke $tasks "value" (i32.const 11)) (i64.const 30))
(assert_return (invoke $tasks "value" (i32.const 12)) (i64.const 102))
(assert_return (invoke $tasks "value" (i32.const 13)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 14)) (i64.const 40))
(assert_return (invoke $tasks "value" (i32.const 15)) (i64.const 101))
(assert_return (invoke $tasks "value" (i32.const 16)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 17)) (i64.const 50))
(assert_return (invoke $tasks "value" (i32.const 18)) (i64.const 2))
(assert_return (invoke $tasks "value" (i32.const 19)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 20)) (i64.const 2))
;; Three recursive discovery levels finish before add returns
(assert_return (invoke $tasks "value" (i32.const 21)) (i64.const 203))
(assert_return (invoke $tasks "value" (i32.const 22)) (i64.const 23))
(assert_return (invoke $tasks "value" (i32.const 23)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 24)) (i64.const 202))
(assert_return (invoke $tasks "value" (i32.const 25)) (i64.const 22))
(assert_return (invoke $tasks "value" (i32.const 26)) (i64.const 2))
(assert_return (invoke $tasks "value" (i32.const 27)) (i64.const 201))
(assert_return (invoke $tasks "value" (i32.const 28)) (i64.const 21))
(assert_return (invoke $tasks "value" (i32.const 29)) (i64.const 3))
(assert_return (invoke $tasks "value" (i32.const 30)) (i64.const 200))
(assert_return (invoke $tasks "value" (i32.const 31)) (i64.const 20))
(assert_return (invoke $tasks "value" (i32.const 32)) (i64.const 4))
(assert_return (invoke $tasks "value" (i32.const 33)) (i64.const 300))
(assert_return (invoke $tasks "value" (i32.const 34)) (i64.const 120))
(assert_return (invoke $tasks "value" (i32.const 35)) (i64.const 301))
(assert_return (invoke $tasks "value" (i32.const 36)) (i64.const 121))
(assert_return (invoke $tasks "value" (i32.const 37)) (i64.const 302))
(assert_return (invoke $tasks "value" (i32.const 38)) (i64.const 122))
(assert_return (invoke $tasks "value" (i32.const 39)) (i64.const 303))
(assert_return (invoke $tasks "value" (i32.const 40)) (i64.const 123))
(assert_return (invoke $tasks "value" (i32.const 41)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 42)) (i64.const 6))
(assert_return (invoke $tasks "value" (i32.const 43)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 44)) (i64.const 6))
;; Capture destruction can submit work while its owner is alive
(assert_return (invoke $tasks "value" (i32.const 45)) (i64.const 900))
(assert_return (invoke $tasks "value" (i32.const 46)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 47)) (i64.const 190))
(assert_return (invoke $tasks "value" (i32.const 48)) (i64.const 901))
(assert_return (invoke $tasks "value" (i32.const 49)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 50)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 51)) (i64.const 8))
(assert_return (invoke $tasks "value" (i32.const 52)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 53)) (i64.const 8))
;; Real cache lock outlives its temporary cache and owns compiler captures
(assert_return (invoke $tasks "value" (i32.const 54)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 55)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 56)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 57)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 58)) (i64.const 3))
(assert_return (invoke $tasks "value" (i32.const 59)) (i64.const 4))
(assert_return (invoke $tasks "value" (i32.const 60)) (i64.const 5))
(assert_return (invoke $tasks "value" (i32.const 61)) (i64.const 3))
(assert_return (invoke $tasks "value" (i32.const 62)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 63)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 64)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 65)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 66)) (i64.const 6))
(assert_return (invoke $tasks "value" (i32.const 67)) (i64.const 4))
(assert_return (invoke $tasks "value" (i32.const 68)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 69)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 70)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 71)) (i64.const 0))
;; Interrupted shared sleep retains both cache locks and all live captures
(assert_return (invoke $tasks "value" (i32.const 72)) (i64.const -1))
(assert_return (invoke $tasks "value" (i32.const 73)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 74)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 75)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 76)) (i64.const 4))
(assert_return (invoke $tasks "value" (i32.const 77)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 78)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 79)) (i64.const 10000000))
(assert_return (invoke $tasks "value" (i32.const 80)) (i64.const 6))
(assert_return (invoke $tasks "value" (i32.const 81)) (i64.const 106))
(assert_return (invoke $tasks "value" (i32.const 82)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 83)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 84)) (i64.const 3))
(assert_return (invoke $tasks "value" (i32.const 85)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 86)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 87)) (i64.const 10))
;; Callback return and destruction release actual advisory locks once
(assert_return (invoke $tasks "value" (i32.const 88)) (i64.const 105))
(assert_return (invoke $tasks "value" (i32.const 89)) (i64.const 104))
(assert_return (invoke $tasks "value" (i32.const 90)) (i64.const 103))
(assert_return (invoke $tasks "value" (i32.const 91)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 92)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 93)) (i64.const 10))
(assert_return (invoke $tasks "value" (i32.const 94)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 95)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 96)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 97)) (i64.const 1))
(assert_return (invoke $tasks "value" (i32.const 98)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 99)) (i64.const 1000))
(assert_return (invoke $tasks "value" (i32.const 100)) (i64.const 0))
(assert_return (invoke $tasks "value" (i32.const 101)) (i64.const 11))
