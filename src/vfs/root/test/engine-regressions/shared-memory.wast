(assert_return (invoke "word") (i32.const 0))
(assert_return (invoke "tail" (i32.const 4)) (i32.const 1))
(assert_return (invoke "canaries") (i32.const 1))
(assert_return (invoke "seek" (i32.const 0) (i64.const 0) (i32.const 0)) (i64.const 0))
(assert_return (invoke "write" (i32.const 0) (i32.const 256) (i32.const 4)) (i32.const 4))
;; Separate opens share bytes with independent offsets; dup shares its cursor.
(assert_return (invoke "open" (i32.const 1) (i32.const 32) (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "stat_prepare") (i32.const 1))
(assert_return (invoke "stat" (i32.const 1)) (i32.const 0))
