;; A final generation starts empty and all created descriptors/names are released.
(assert_return (invoke "open" (i32.const 6) (i32.const 32) (i32.const 194) (i32.const 384)) (i32.const 0))
(assert_return (invoke "stat_prepare") (i32.const 1))
(assert_return (invoke "stat" (i32.const 6)) (i32.const 0))
(assert_return (invoke "size") (i64.const 0))
(assert_return (invoke "stat_canaries") (i32.const 1))
(assert_return (invoke "truncate" (i32.const 6) (i64.const 4)) (i32.const 0))
(assert_return (invoke "prepare") (i32.const 1))
(assert_return (invoke "read" (i32.const 6) (i32.const 4)) (i32.const 4))
(assert_return (invoke "word") (i32.const 0))
(assert_return (invoke "tail" (i32.const 4)) (i32.const 1))
(assert_return (invoke "canaries") (i32.const 1))
(assert_return (invoke "unlink" (i32.const 32)) (i32.const 0))
(assert_return (invoke "close" (i32.const 6)) (i32.const 0))
