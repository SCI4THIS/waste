(assert_return (invoke "read" (i32.const 1) (i32.const 1)) (i32.const 1))
(assert_return (invoke "byte") (i32.const 83))
(assert_return (invoke "tail" (i32.const 1)) (i32.const 1))
(assert_return (invoke "canaries") (i32.const 1))
(assert_return (invoke "dup" (i32.const 0) (i32.const 2)) (i32.const 0))
(assert_return (invoke "seek" (i32.const 2) (i64.const -4) (i32.const 1)) (i64.const 0))
