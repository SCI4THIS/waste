;; Guest-visible named shared-memory creation, sizing and unlink lifetimes.
;; Namespace attachment, credentials, offset-independent object APIs and clones
;; remain direct C gates. Every object below comes from real guest imports.
;; shm_open/ftruncate return raw negative errno on kernel errors; malformed
;; guest input and legacy unlink/read/write/close use -1 plus guest errno.
(module
  (import "env" "shm_open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "shm_unlink" (func $unlink (param i32) (result i32)))
  (import "env" "ftruncate" (func $truncate (param i32 i64) (result i32)))
  (import "env" "fstat" (func $stat (param i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "lseek" (func $seek (param i32 i64 i32) (result i64)))
  (import "env" "dup" (func $dup (param i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (memory 1)
  ;; errno 8; eight descriptor handles 128..159; read buffer 512..543;
  ;; public Wasm32 stat record 1024..1151. Canaries bound both output ranges.
  (data (i32.const 32) "/shm-audit-object\00")
  (data (i32.const 64) "/shm-audit-exclusive\00")
  (data (i32.const 96) "/shm-audit/nested\00")
  (data (i32.const 128) "\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff")
  (data (i32.const 160) "/\00")
  (data (i32.const 168) "relative\00")
  (data (i32.const 184) "\00")
  (data (i32.const 256) "Solo")
  (data (i32.const 272) "New!")
  (data (i32.const 288) "ABCD")
  (func (export "__errno_location") (result i32) (i32.const 8))
  (func (export "errno") (result i32) (i32.load (i32.const 8)))
  (func $reset_errno (i32.store (i32.const 8) (i32.const 0)))
  (func $address (param i32) (result i32)
    (if (i32.gt_u (local.get 0) (i32.const 7)) (then unreachable))
    (i32.add (i32.const 128) (i32.mul (local.get 0) (i32.const 4))))
  (func $fd (param i32) (result i32) (i32.load (call $address (local.get 0))))
  (func $save_fd (param $slot i32) (param $result i32) (result i32)
    ;; A failed open must not discard an earlier live descriptor in this client.
    (if (i32.lt_s (local.get $result) (i32.const 0)) (then (return (local.get $result))))
    (i32.store (call $address (local.get $slot)) (local.get $result))
    (i32.const 0))
  (func (export "open") (param i32 i32 i32 i32) (result i32)
    (call $reset_errno)
    (call $save_fd (local.get 0) (call $open (local.get 1) (local.get 2) (local.get 3))))
  (func (export "unlink") (param i32) (result i32)
    (call $reset_errno) (call $unlink (local.get 0)))
  (func (export "truncate") (param i32 i64) (result i32)
    (call $reset_errno) (call $truncate (call $fd (local.get 0)) (local.get 1)))
  (func (export "truncate_fd") (param i32 i64) (result i32)
    (call $reset_errno) (call $truncate (local.get 0) (local.get 1)))
  (func (export "stat") (param i32) (result i32)
    (call $reset_errno) (call $stat (call $fd (local.get 0)) (i32.const 1024)))
  (func (export "size") (result i64) (i64.load (i32.const 1064)))
  (func (export "mode") (result i32)
    (i32.and (i32.load (i32.const 1040)) (i32.const 4095)))
  (func (export "read") (param i32 i32) (result i32)
    (call $reset_errno) (call $read (call $fd (local.get 0)) (i32.const 512) (local.get 1)))
  (func (export "write") (param i32 i32 i32) (result i32)
    (call $reset_errno) (call $write (call $fd (local.get 0)) (local.get 1) (local.get 2)))
  (func (export "seek") (param i32 i64 i32) (result i64)
    (call $reset_errno) (call $seek (call $fd (local.get 0)) (local.get 1) (local.get 2)))
  (func (export "dup") (param i32 i32) (result i32)
    (call $reset_errno) (call $save_fd (local.get 1) (call $dup (call $fd (local.get 0)))))
  (func (export "close") (param i32) (result i32) (local $result i32)
    (call $reset_errno) (local.set $result (call $close (call $fd (local.get 0))))
    (if (i32.eqz (local.get $result))
      (then (i32.store (call $address (local.get 0)) (i32.const -1))))
    (local.get $result))
  (func (export "prepare") (result i32)
    (memory.fill (i32.const 512) (i32.const 165) (i32.const 32))
    (i32.store (i32.const 508) (i32.const 0x13579bdf))
    (i32.store (i32.const 544) (i32.const 0x13579bdf))
    (i32.const 1))
  (func (export "stat_prepare") (result i32)
    (memory.fill (i32.const 1024) (i32.const 165) (i32.const 128))
    (i32.store (i32.const 1020) (i32.const 0x13579bdf))
    (i32.store (i32.const 1152) (i32.const 0x13579bdf))
    (i32.const 1))
  (func (export "stat_canaries") (result i32)
    (i32.and (i32.eq (i32.load (i32.const 1020)) (i32.const 0x13579bdf))
      (i32.eq (i32.load (i32.const 1152)) (i32.const 0x13579bdf))))
  (func (export "canaries") (result i32)
    (i32.and (i32.eq (i32.load (i32.const 508)) (i32.const 0x13579bdf))
      (i32.eq (i32.load (i32.const 544)) (i32.const 0x13579bdf))))
  (func (export "tail") (param $count i32) (result i32) (local $i i32)
    (if (i32.gt_u (local.get $count) (i32.const 32)) (then unreachable))
    (local.set $i (local.get $count))
    (block $done (loop $next
      (br_if $done (i32.eq (local.get $i) (i32.const 32)))
      (if (i32.ne (i32.load8_u (i32.add (i32.const 512) (local.get $i))) (i32.const 165))
        (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $next)))
    (i32.const 1))
  (func (export "word") (result i32) (i32.load (i32.const 512)))
  (func (export "half") (result i32) (i32.load16_u (i32.const 512)))
  (func (export "byte") (result i32) (i32.load8_u (i32.const 512)))
  (func (export "three") (result i32) (i32.and (i32.load (i32.const 512)) (i32.const 0xffffff))))

;; Missing and malformed names exercise raw open errors and legacy unlink errors.
(assert_return (invoke "open" (i32.const 7) (i32.const 32) (i32.const 0) (i32.const 0)) (i32.const -2))
(assert_return (invoke "errno") (i32.const 2))
(assert_return (invoke "unlink" (i32.const 32)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 2))
(assert_return (invoke "open" (i32.const 7) (i32.const 160) (i32.const 66) (i32.const 384)) (i32.const -22))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "unlink" (i32.const 160)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "open" (i32.const 7) (i32.const 168) (i32.const 66) (i32.const 384)) (i32.const -22))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "unlink" (i32.const 168)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "open" (i32.const 7) (i32.const 184) (i32.const 66) (i32.const 384)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 14))
(assert_return (invoke "unlink" (i32.const 184)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 14))
(assert_return (invoke "open" (i32.const 7) (i32.const 96) (i32.const 66) (i32.const 384)) (i32.const -22))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "unlink" (i32.const 96)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "open" (i32.const 7) (i32.const 65536) (i32.const 66) (i32.const 384)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 14))
;; Create and resize; new storage is zero-filled and bounded.
(assert_return (invoke "open" (i32.const 0) (i32.const 32) (i32.const 66) (i32.const 384)) (i32.const 0))
(assert_return (invoke "stat_prepare") (i32.const 1))
(assert_return (invoke "stat" (i32.const 0)) (i32.const 0))
(assert_return (invoke "size") (i64.const 0))
(assert_return (invoke "stat_canaries") (i32.const 1))
(assert_return (invoke "mode") (i32.const 384))
(assert_return (invoke "truncate" (i32.const 0) (i64.const 4)) (i32.const 0))
(assert_return (invoke "stat_prepare") (i32.const 1))
(assert_return (invoke "stat" (i32.const 0)) (i32.const 0))
