;; Guest counterparts of the pipe/descriptor checks in posix-kernel.c.
;; Descriptor selectors: 0 reader, 1 writer, 2 duplicate, 3 target fd 10,
;; 4 fd 0, 5 closed fd 50, 6 invalid -1, 7 out-of-range 64.
;; Raw HUP/ERR flags, OFD ownership and deterministic capacity remain C gates.
(module
  (import "env" "pipe" (func $pipe (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (import "env" "dup" (func $dup (param i32) (result i32)))
  (import "env" "dup2" (func $dup2 (param i32 i32) (result i32)))
  (import "waste_kernel" "fcntl_v1" (func $fcntl (param i32 i32 i32) (result i32)))
  (import "env" "select" (func $select (param i32 i32 i32 i32 i32) (result i32)))
  (memory 1)
  (global $reader (mut i32) (i32.const -1))
  (global $writer (mut i32) (i32.const -1))
  (global $duplicate (mut i32) (i32.const -1))
  (data (i32.const 512) "test")
  (data (i32.const 528) "abc")
  ;; errno at 8, pipe pair at 16, zero timeval at 32; 128-byte fd sets at
  ;; 64 and 192, read buffer at 768, fill block at 4096.
  (func (export "__errno_location") (result i32) (i32.const 8))
  (func (export "errno") (result i32) (i32.load (i32.const 8)))
  (func $reset_errno (i32.store (i32.const 8) (i32.const 0)))
  (func $fd (param $which i32) (result i32)
    (if (i32.eq (local.get $which) (i32.const 0)) (then (return (global.get $reader))))
    (if (i32.eq (local.get $which) (i32.const 1)) (then (return (global.get $writer))))
    (if (i32.eq (local.get $which) (i32.const 2)) (then (return (global.get $duplicate))))
    (if (i32.eq (local.get $which) (i32.const 3)) (then (return (i32.const 10))))
    (if (i32.eq (local.get $which) (i32.const 4)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $which) (i32.const 5)) (then (return (i32.const 50))))
    (if (i32.eq (local.get $which) (i32.const 6)) (then (return (i32.const -1))))
    (i32.const 64))
  (func (export "pipe") (result i32) (local $result i32)
    (local.set $result (call $pipe (i32.const 16)))
    (global.set $reader (i32.load (i32.const 16)))
    (global.set $writer (i32.load (i32.const 20)))
    (local.get $result))
  (func (export "valid_pair") (result i32)
    (i32.and (i32.ne (global.get $reader) (global.get $writer))
      (i32.and (i32.lt_u (global.get $reader) (i32.const 64))
        (i32.lt_u (global.get $writer) (i32.const 64)))))
  (func (export "read") (param i32 i32) (result i32)
    (call $read (call $fd (local.get 0)) (i32.const 768) (local.get 1)))
  ;; Separate guarded reads preserve the original read/zero-count assertions.
  ;; Both canaries and the entire untouched 64-byte tail are guest-observable.
  (func (export "guarded_read") (param i32 i32) (result i32)
    (if (i32.gt_u (local.get 1) (i32.const 64)) (then unreachable))
    (memory.fill (i32.const 768) (i32.const 165) (i32.const 64))
    (i32.store (i32.const 764) (i32.const 0x13579bdf))
    (i32.store (i32.const 832) (i32.const 0x13579bdf))
    (call $read (call $fd (local.get 0)) (i32.const 768) (local.get 1)))
  (func (export "bounds") (param $count i32) (result i32) (local $i i32)
    (if (i32.gt_u (local.get $count) (i32.const 64)) (then unreachable))
    (if (i32.ne (i32.load (i32.const 764)) (i32.const 0x13579bdf))
      (then (return (i32.const 0))))
    (if (i32.ne (i32.load (i32.const 832)) (i32.const 0x13579bdf))
      (then (return (i32.const 0))))
    (local.set $i (local.get $count))
    (block $done (loop $next
      (br_if $done (i32.eq (local.get $i) (i32.const 64)))
      (if (i32.ne (i32.load8_u (i32.add (i32.const 768) (local.get $i)))
          (i32.const 165)) (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $next)))
    (i32.const 1))
  (func (export "source_bytes") (result i32)
    (i32.and (i32.load (i32.const 528)) (i32.const 0xffffff)))
  (func (export "write") (param i32 i32 i32) (result i32)
    (call $write (call $fd (local.get 0)) (local.get 1) (local.get 2)))
  (func (export "bytes") (result i32) (i32.load (i32.const 768)))
  (func (export "three_bytes") (result i32)
    (i32.and (i32.load (i32.const 768)) (i32.const 0xffffff)))
  (func (export "close") (param i32) (result i32)
    (call $reset_errno) (call $close (call $fd (local.get 0))))
  (func (export "dup") (param i32) (result i32)
    (call $reset_errno)
    (global.set $duplicate (call $dup (call $fd (local.get 0))))
    (if (result i32) (i32.lt_s (global.get $duplicate) (i32.const 0))
      (then (global.get $duplicate)) (else (i32.const 0))))
  (func (export "dup2") (param i32 i32) (result i32)
    (call $reset_errno) (call $dup2 (call $fd (local.get 0)) (call $fd (local.get 1))))
  (func (export "dup2_same") (param i32) (result i32) (local $fd i32)
    (local.set $fd (call $fd (local.get 0)))
    (i32.eq (call $dup2 (local.get $fd) (local.get $fd)) (local.get $fd)))
  (func (export "dup2_to_reader") (param i32) (result i32)
    (i32.eq (call $dup2 (call $fd (local.get 0)) (global.get $reader))
      (global.get $reader)))
  (func (export "get_flags") (param i32) (result i32)
    (call $fcntl (call $fd (local.get 0)) (i32.const 1) (i32.const 0)))
  (func (export "set_flags") (param i32 i32) (result i32)
    (call $fcntl (call $fd (local.get 0)) (i32.const 2) (local.get 1)))
  (func $set_address (param $fd i32) (param $base i32) (result i32)
    (i32.add (local.get $base) (i32.mul (i32.div_u (local.get $fd) (i32.const 32)) (i32.const 4))))
  (func $bit (param $fd i32) (result i32)
    (i32.shl (i32.const 1) (i32.rem_u (local.get $fd) (i32.const 32))))
  (func (export "poll") (param $which i32) (param $writing i32) (result i32)
    (local $fd i32) (local $base i32)
    (local.set $fd (call $fd (local.get $which)))
    (local.set $base (select (i32.const 192) (i32.const 64) (local.get $writing)))
    (memory.fill (local.get $base) (i32.const 0) (i32.const 128))
    (i32.store (call $set_address (local.get $fd) (local.get $base)) (call $bit (local.get $fd)))
    (call $select (i32.add (local.get $fd) (i32.const 1))
      (select (i32.const 0) (local.get $base) (local.get $writing))
      (select (local.get $base) (i32.const 0) (local.get $writing))
      (i32.const 0) (i32.const 32)))
  (func (export "poll_bit") (param $which i32) (param $writing i32) (result i32)
    (local $fd i32)
    (local.set $fd (call $fd (local.get $which)))
    (i32.ne (i32.and
      (i32.load (call $set_address (local.get $fd)
        (select (i32.const 192) (i32.const 64) (local.get $writing))))
      (call $bit (local.get $fd))) (i32.const 0)))
  (func (export "fill") (result i32)
    (memory.fill (i32.const 4096) (i32.const 120) (i32.const 4096))
    (call $write (global.get $writer) (i32.const 4096) (i32.const 4096)))
)

;; Initial readiness, byte round trip, empty pipe and zero-count operations.
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "valid_pair") (i32.const 1))
(assert_return (invoke "poll" (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "poll_bit" (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1)) (i32.const 1))
(assert_return (invoke "poll_bit" (i32.const 1) (i32.const 1)) (i32.const 1))
(assert_return (invoke "write" (i32.const 1) (i32.const 512) (i32.const 4)) (i32.const 4))
(assert_return (invoke "poll" (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "poll_bit" (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "read" (i32.const 0) (i32.const 32)) (i32.const 4))
(assert_return (invoke "bytes") (i32.const 0x74736574))
(assert_return (invoke "poll" (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "read" (i32.const 0) (i32.const 32)) (i32.const -11))
(assert_return (invoke "read" (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "write" (i32.const 1) (i32.const 512) (i32.const 0)) (i32.const 0))
(assert_return (invoke "bytes") (i32.const 0x74736574))
(assert_return (invoke "poll_bit" (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "read" (i32.const 1) (i32.const 8)) (i32.const -9))
(assert_return (invoke "write" (i32.const 0) (i32.const 512) (i32.const 8)) (i32.const -9))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))

;; Buffered bytes survive writer close; EOF is readable after the final drain.
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "write" (i32.const 1) (i32.const 528) (i32.const 3)) (i32.const 3))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "read" (i32.const 0) (i32.const 32)) (i32.const 3))
(assert_return (invoke "three_bytes") (i32.const 0x636261))
(assert_return (invoke "poll" (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "read" (i32.const 0) (i32.const 32)) (i32.const 0))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1)) (i32.const 0))
(assert_return (invoke "write" (i32.const 1) (i32.const 528) (i32.const 3)) (i32.const -32))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))

;; Capacity and recovery are visible through write/read/SELECT.
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "fill") (i32.const 4096))
(assert_return (invoke "write" (i32.const 1) (i32.const 512) (i32.const 1)) (i32.const -11))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1)) (i32.const 0))
(assert_return (invoke "read" (i32.const 0) (i32.const 64)) (i32.const 64))
(assert_return (invoke "bytes") (i32.const 0x78787878))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1)) (i32.const 1))
(assert_return (invoke "write" (i32.const 1) (i32.const 4096) (i32.const 64)) (i32.const 64))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))

;; dup2 target, same-fd no-op and replacement of the original reader.
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "dup2" (i32.const 0) (i32.const 3)) (i32.const 10))
(assert_return (invoke "get_flags" (i32.const 3)) (i32.const 0))
(assert_return (invoke "dup2_same" (i32.const 0)) (i32.const 1))
(assert_return (invoke "dup2_same" (i32.const 3)) (i32.const 1))
(assert_return (invoke "set_flags" (i32.const 0) (i32.const 1)) (i32.const 0))
(assert_return (invoke "get_flags" (i32.const 0)) (i32.const 1))
(assert_return (invoke "dup2" (i32.const 1) (i32.const 3)) (i32.const 10))
(assert_return (invoke "get_flags" (i32.const 3)) (i32.const 0))
(assert_return (invoke "dup2_same" (i32.const 0)) (i32.const 1))
(assert_return (invoke "get_flags" (i32.const 0)) (i32.const 1))
(assert_return (invoke "write" (i32.const 3) (i32.const 512) (i32.const 4)) (i32.const 4))
(assert_return (invoke "read" (i32.const 0) (i32.const 4)) (i32.const 4))
(assert_return (invoke "bytes") (i32.const 0x74736574))
(assert_return (invoke "dup2" (i32.const 0) (i32.const 3)) (i32.const 10))
(assert_return (invoke "get_flags" (i32.const 3)) (i32.const 0))
;; Replace the reader with its writer. fd 10 still retains the read endpoint.
;; Return equality is allocation-independent because dup2 returns the target.
(assert_return (invoke "dup2_to_reader" (i32.const 1)) (i32.const 1))
(assert_return (invoke "get_flags" (i32.const 0)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 0) (i32.const 1)) (i32.const 1))
(assert_return (invoke "write" (i32.const 0) (i32.const 512) (i32.const 4)) (i32.const 4))
(assert_return (invoke "read" (i32.const 3) (i32.const 4)) (i32.const 4))
(assert_return (invoke "bytes") (i32.const 0x74736574))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))
(assert_return (invoke "close" (i32.const 3)) (i32.const 0))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))

;; A duplicate writer keeps the read endpoint live after the original closes.
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "set_flags" (i32.const 1) (i32.const 1)) (i32.const 0))
(assert_return (invoke "dup" (i32.const 1)) (i32.const 0))
(assert_return (invoke "get_flags" (i32.const 2)) (i32.const 0))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "write" (i32.const 2) (i32.const 512) (i32.const 4)) (i32.const 4))
(assert_return (invoke "read" (i32.const 0) (i32.const 4)) (i32.const 4))
(assert_return (invoke "bytes") (i32.const 0x74736574))
(assert_return (invoke "close" (i32.const 2)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "read" (i32.const 0) (i32.const 4)) (i32.const 0))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))

;; Closed and invalid descriptor errors; errno is reset before close/dup calls.
(assert_return (invoke "read" (i32.const 4) (i32.const 8)) (i32.const -9))
(assert_return (invoke "write" (i32.const 4) (i32.const 512) (i32.const 8)) (i32.const -9))
(assert_return (invoke "read" (i32.const 6) (i32.const 0)) (i32.const -22))
(assert_return (invoke "write" (i32.const 6) (i32.const 512) (i32.const 0)) (i32.const -22))
(assert_return (invoke "read" (i32.const 7) (i32.const 0)) (i32.const -22))
(assert_return (invoke "write" (i32.const 7) (i32.const 512) (i32.const 0)) (i32.const -22))
(assert_return (invoke "close" (i32.const 0)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 9))
(assert_return (invoke "dup" (i32.const 5)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 9))
(assert_return (invoke "dup" (i32.const 6)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "close" (i32.const 6)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "close" (i32.const 7)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))

;; Round trip, empty-pipe EAGAIN and wrong-end EBADF preserve read bounds.
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "write" (i32.const 1) (i32.const 512) (i32.const 4)) (i32.const 4))
(assert_return (invoke "guarded_read" (i32.const 0) (i32.const 32)) (i32.const 4))
(assert_return (invoke "bytes") (i32.const 0x74736574))
(assert_return (invoke "bounds" (i32.const 4)) (i32.const 1))
(assert_return (invoke "guarded_read" (i32.const 0) (i32.const 32)) (i32.const -11))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "guarded_read" (i32.const 1) (i32.const 32)) (i32.const -9))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))
(assert_return (invoke "guarded_read" (i32.const 0) (i32.const 32)) (i32.const 0))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))

;; Buffered bytes survive close; repeated EOF never changes the read buffer.
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "write" (i32.const 1) (i32.const 528) (i32.const 3)) (i32.const 3))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))
(assert_return (invoke "guarded_read" (i32.const 0) (i32.const 32)) (i32.const 3))
(assert_return (invoke "three_bytes") (i32.const 0x636261))
(assert_return (invoke "bounds" (i32.const 3)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "guarded_read" (i32.const 0) (i32.const 32)) (i32.const 0))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "guarded_read" (i32.const 0) (i32.const 32)) (i32.const 0))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))

;; Broken-pipe write preserves its source; wrong-end/closed reads preserve all bytes.
(assert_return (invoke "pipe") (i32.const 0))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))
(assert_return (invoke "write" (i32.const 1) (i32.const 528) (i32.const 3)) (i32.const -32))
(assert_return (invoke "source_bytes") (i32.const 0x636261))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1)) (i32.const 0))
(assert_return (invoke "guarded_read" (i32.const 1) (i32.const 32)) (i32.const -9))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))
(assert_return (invoke "guarded_read" (i32.const 0) (i32.const 32)) (i32.const -9))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "guarded_read" (i32.const 1) (i32.const 32)) (i32.const -9))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
