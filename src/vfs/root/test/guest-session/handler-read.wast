#!/bin/wast
(module $reader
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  ;; This module owns private memory; use the kernel ABI rather than libc's
  ;; pointer-taking exports, which operate on libc's imported shared memory.
  (import "waste_kernel" "tcgetattr_v1" (func $get (param i32 i32) (result i32)))
  (import "waste_kernel" "tcsetattr_v1" (func $set (param i32 i32 i32) (result i32)))
  (import "waste_kernel" "select_v1" (func $select (param i32 i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 64) "HANDLER_FIRST\0aHANDLER_SECOND\0aHANDLER_TRAP\0a")
  (data (i32.const 128) "HANDLER_SELECT\0a")
  (func (export "raw") (result i32)
    (drop (call $get (i32.const 0) (i32.const 256)))
    (drop (call $get (i32.const 0) (i32.const 320)))
    (i32.store (i32.const 256) (i32.const 0))
    (i32.store (i32.const 260) (i32.const 0))
    (i32.store (i32.const 268) (i32.const 0))
    (i32.store8 (i32.const 279) (i32.const 1))
    (call $set (i32.const 0) (i32.const 0) (i32.const 256)))
  (func (export "pair") (result i32)
    (drop (call $write (i32.const 1) (i32.const 64) (i32.const 14)))
    (drop (call $read (i32.const 0) (i32.const 512) (i32.const 1)))
    (drop (call $write (i32.const 1) (i32.const 78) (i32.const 15)))
    (drop (call $read (i32.const 0) (i32.const 513) (i32.const 1)))
    (i32.load16_u (i32.const 512)))
  (func (export "trap")
    (drop (call $write (i32.const 1) (i32.const 93) (i32.const 13)))
    (drop (call $read (i32.const 0) (i32.const 514) (i32.const 1)))
    unreachable)
  (func (export "ready") (result i32)
    (drop (call $write (i32.const 1) (i32.const 128) (i32.const 15)))
    (i32.store (i32.const 640) (i32.const 1))
    (drop (call $select (i32.const 1) (i32.const 640) (i32.const 0) (i32.const 0) (i32.const 0)))
    (drop (call $read (i32.const 0) (i32.const 512) (i32.const 1)))
    (i32.load8_u (i32.const 512)))
  (func (export "restore") (result i32)
    (call $set (i32.const 0) (i32.const 0) (i32.const 320))))
(assert_return (invoke $reader "raw") (i32.const 0))
(assert_return (invoke $reader "pair") (i32.const 16961))
(assert_trap (invoke $reader "trap") "unreachable")
(assert_return (invoke $reader "ready") (i32.const 90))
(assert_return (invoke $reader "restore") (i32.const 0))
