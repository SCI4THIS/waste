;; One fixture, identical engine guest ABI and expected results in both runtimes.
(module
  (import "env" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "tcgetattr" (func $get (param i32 i32) (result i32)))
  (import "env" "tcsetattr" (func $set (param i32 i32 i32) (result i32)))
  (import "env" "exit" (func $exit (param i32)))
  (memory (export "memory") 1)
  (data (i32.const 64) "FIRST\0aSECOND\0aEOF\0a")
  (data (i32.const 128) "/tmp/session-io\00")
  (data (i32.const 160) "/definitely-not-a-mounted-path\00")
  (data (i32.const 200) "\00\ff\80A")
  (func (export "__errno_location") (result i32) (i32.const 0))
  (func (export "raw") (result i32)
    (drop (call $get (i32.const 0) (i32.const 256)))
    (i32.store (i32.const 256) (i32.const 0))
    (i32.store (i32.const 260) (i32.const 0))
    (i32.store (i32.const 268) (i32.const 0))
    (i32.store8 (i32.const 279) (i32.const 1))
    (call $set (i32.const 0) (i32.const 0) (i32.const 256)))
  (func (export "missing") (result i32)
    (drop (call $open (i32.const 160) (i32.const 0) (i32.const 0)))
    (i32.load (i32.const 0)))
  (func (export "file") (result i32) (local $fd i32)
    (local.set $fd (call $open (i32.const 128) (i32.const 66) (i32.const 384)))
    (if (i32.lt_s (local.get $fd) (i32.const 0)) (then (return (i32.const -1))))
    (if (i32.ne (call $write (local.get $fd) (i32.const 200) (i32.const 4)) (i32.const 4))
      (then (return (i32.const -2))))
    (drop (call $close (local.get $fd)))
    (local.set $fd (call $open (i32.const 128) (i32.const 0) (i32.const 0)))
    (if (i32.ne (call $read (local.get $fd) (i32.const 512) (i32.const 4)) (i32.const 4))
      (then (return (i32.const -3))))
    (drop (call $close (local.get $fd)))
    (i32.load (i32.const 512)))
  (func (export "first") (result i32)
    (drop (call $write (i32.const 1) (i32.const 64) (i32.const 6)))
    (drop (call $read (i32.const 0) (i32.const 520) (i32.const 1)))
    (i32.load8_u (i32.const 520)))
  (func (export "second") (result i32)
    (drop (call $write (i32.const 1) (i32.const 70) (i32.const 7)))
    (drop (call $read (i32.const 0) (i32.const 521) (i32.const 1)))
    (i32.load8_u (i32.const 521)))
  (func (export "eof") (result i32)
    (drop (call $write (i32.const 1) (i32.const 77) (i32.const 4)))
    (call $read (i32.const 0) (i32.const 522) (i32.const 1)))
  (func (export "done") (call $exit (i32.const 7))))
(assert_return (invoke "raw") (i32.const 0))
(assert_return (invoke "missing") (i32.const 2))
(assert_return (invoke "file") (i32.const 1098972928))
(assert_return (invoke "first") (i32.const 0))
(assert_return (invoke "second") (i32.const 255))
(assert_return (invoke "eof") (i32.const 0))
(invoke "done")
