;; Run from guest Bash after setup.sh. All functional assertions live here.
(module $clipboard
 (import "waste-runtime" "memory" (memory 4))
 (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
 (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
 (import "libc" "close" (func $close (param i32) (result i32)))
 (import "libc" "memcmp" (func $memcmp (param i32 i32 i32) (result i32)))
 (import "waste_kernel" "host_clipboard_copy_v1" (func $copy (param i32 i32 i32) (result i32)))
 (func (export "invalid-pointer") (result i32) i32.const -1 i32.const 4 i32.const 0 call $copy)
 (func (export "reserved-flags") (result i32) i32.const 0 i32.const 0 i32.const 1 call $copy)
 (func (export "invalid-length") (result i32) i32.const 0 i32.const -1 i32.const 0 call $copy)

 (func $matches (param $path i32) (param $expected i32) (param $length i32) (result i32)
  (local $fd i32) (local $ok i32)
  local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
  i32.const 0 i32.lt_s if i32.const 0 return end
  local.get $fd i32.const 200000 local.get $length i32.const 1 i32.add call $read
  local.get $length i32.eq
  i32.const 200000 local.get $expected local.get $length call $memcmp i32.eqz
  i32.and local.set $ok
  local.get $fd call $close drop local.get $ok)
 (data (i32.const 180000) "/tmp/clipboard-no-arguments-status\00")
 (data (i32.const 180128) "\31\0a")
 (func (export "no-arguments") (result i32) i32.const 180000 i32.const 180128 i32.const 2 call $matches)
 (data (i32.const 180256) "/tmp/clipboard-missing-file-argument-status\00")
 (data (i32.const 180384) "\31\0a")
 (func (export "missing-file-argument") (result i32) i32.const 180256 i32.const 180384 i32.const 2 call $matches)
 (data (i32.const 180512) "/tmp/clipboard-unknown-subcommand-status\00")
 (data (i32.const 180640) "\31\0a")
 (func (export "unknown-subcommand") (result i32) i32.const 180512 i32.const 180640 i32.const 2 call $matches)
 (data (i32.const 180768) "/tmp/clipboard-unknown-option-status\00")
 (data (i32.const 180896) "\31\0a")
 (func (export "unknown-option") (result i32) i32.const 180768 i32.const 180896 i32.const 2 call $matches)
 (data (i32.const 181024) "/tmp/clipboard-extra-argument-status\00")
 (data (i32.const 181152) "\31\0a")
 (func (export "extra-argument") (result i32) i32.const 181024 i32.const 181152 i32.const 2 call $matches)
 (data (i32.const 181280) "/tmp/clipboard-missing-file-status\00")
 (data (i32.const 181408) "\31\0a")
 (func (export "missing-file") (result i32) i32.const 181280 i32.const 181408 i32.const 2 call $matches)
 (data (i32.const 181536) "/tmp/clipboard-directory-status\00")
 (data (i32.const 181664) "\31\0a")
 (func (export "directory") (result i32) i32.const 181536 i32.const 181664 i32.const 2 call $matches)
 (data (i32.const 181792) "/tmp/clipboard-help-status\00")
 (data (i32.const 181920) "\30\0a")
 (func (export "help") (result i32) i32.const 181792 i32.const 181920 i32.const 2 call $matches)
)
(assert_return (invoke $clipboard "no-arguments") (i32.const 1))
(assert_return (invoke $clipboard "missing-file-argument") (i32.const 1))
(assert_return (invoke $clipboard "unknown-subcommand") (i32.const 1))
(assert_return (invoke $clipboard "unknown-option") (i32.const 1))
(assert_return (invoke $clipboard "extra-argument") (i32.const 1))
(assert_return (invoke $clipboard "missing-file") (i32.const 1))
(assert_return (invoke $clipboard "directory") (i32.const 1))
(assert_return (invoke $clipboard "help") (i32.const 1))
(assert_return (invoke $clipboard "invalid-pointer") (i32.const -1))
(assert_return (invoke $clipboard "reserved-flags") (i32.const -1))
(assert_return (invoke $clipboard "invalid-length") (i32.const -1))
