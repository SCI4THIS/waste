;; Run from guest Bash after setup.sh. All functional assertions live here.
(module $clipboard
 (import "waste-runtime" "memory" (memory 4))
 (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
 (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
 (import "libc" "close" (func $close (param i32) (result i32)))
 (import "libc" "memcmp" (func $memcmp (param i32 i32 i32) (result i32)))

 (func $matches (param $path i32) (param $expected i32) (param $length i32) (result i32)
  (local $fd i32) (local $ok i32)
  local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
  i32.const 0 i32.lt_s if i32.const 0 return end
  local.get $fd i32.const 200000 local.get $length i32.const 1 i32.add call $read
  local.get $length i32.eq
  i32.const 200000 local.get $expected local.get $length call $memcmp i32.eqz
  i32.and local.set $ok
  local.get $fd call $close drop local.get $ok)
 (data (i32.const 180000) "/tmp/clipboard-text-copy-status\00")
 (data (i32.const 180128) "\30\0a")
 (func (export "text-status") (result i32) i32.const 180000 i32.const 180128 i32.const 2 call $matches)
 (data (i32.const 180256) "/tmp/clipboard-text-captured\00")
 (data (i32.const 180384) "\48\65\6c\6c\6f\20\66\72\6f\6d\20\57\41\53\54\45\21\0a")
 (func (export "text-payload") (result i32) i32.const 180256 i32.const 180384 i32.const 18 call $matches)
 (data (i32.const 180512) "/tmp/clipboard-binary-copy-status\00")
 (data (i32.const 180640) "\30\0a")
 (func (export "binary-status") (result i32) i32.const 180512 i32.const 180640 i32.const 2 call $matches)
 (data (i32.const 180768) "/tmp/clipboard-binary-captured\00")
 (data (i32.const 180896) "\41\49\44\2f\51\51\3d\3d")
 (func (export "binary-payload") (result i32) i32.const 180768 i32.const 180896 i32.const 8 call $matches)
 (data (i32.const 181024) "/tmp/clipboard-empty-copy-status\00")
 (data (i32.const 181152) "\30\0a")
 (func (export "empty-status") (result i32) i32.const 181024 i32.const 181152 i32.const 2 call $matches)
 (data (i32.const 181280) "/tmp/clipboard-empty-captured\00")
 (data (i32.const 181408) "")
 (func (export "empty-payload") (result i32) i32.const 181280 i32.const 181408 i32.const 0 call $matches)
 (data (i32.const 181536) "/tmp/clipboard-one-copy-status\00")
 (data (i32.const 181664) "\30\0a")
 (func (export "one-status") (result i32) i32.const 181536 i32.const 181664 i32.const 2 call $matches)
 (data (i32.const 181792) "/tmp/clipboard-one-captured\00")
 (data (i32.const 181920) "\5a\67\3d\3d")
 (func (export "one-payload") (result i32) i32.const 181792 i32.const 181920 i32.const 4 call $matches)
 (data (i32.const 182048) "/tmp/clipboard-two-copy-status\00")
 (data (i32.const 182176) "\30\0a")
 (func (export "two-status") (result i32) i32.const 182048 i32.const 182176 i32.const 2 call $matches)
 (data (i32.const 182304) "/tmp/clipboard-two-captured\00")
 (data (i32.const 182432) "\5a\6d\38\3d")
 (func (export "two-payload") (result i32) i32.const 182304 i32.const 182432 i32.const 4 call $matches)
 (data (i32.const 182560) "/tmp/clipboard-three-copy-status\00")
 (data (i32.const 182688) "\30\0a")
 (func (export "three-status") (result i32) i32.const 182560 i32.const 182688 i32.const 2 call $matches)
 (data (i32.const 182816) "/tmp/clipboard-three-captured\00")
 (data (i32.const 182944) "\5a\6d\39\76")
 (func (export "three-payload") (result i32) i32.const 182816 i32.const 182944 i32.const 4 call $matches)
 (data (i32.const 183072) "/tmp/clipboard-utf8-copy-status\00")
 (data (i32.const 183200) "\30\0a")
 (func (export "utf8-status") (result i32) i32.const 183072 i32.const 183200 i32.const 2 call $matches)
 (data (i32.const 183328) "/tmp/clipboard-utf8-captured\00")
 (data (i32.const 183456) "\63\61\66\c3\a9")
 (func (export "utf8-payload") (result i32) i32.const 183328 i32.const 183456 i32.const 5 call $matches)
 (data (i32.const 183584) "/tmp/clipboard-raw-binary-copy-status\00")
 (data (i32.const 183712) "\30\0a")
 (func (export "raw-binary-status") (result i32) i32.const 183584 i32.const 183712 i32.const 2 call $matches)
 (data (i32.const 183840) "/tmp/clipboard-raw-binary-captured\00")
 (data (i32.const 183968) "\00\80\ff\41")
 (func (export "raw-binary-payload") (result i32) i32.const 183840 i32.const 183968 i32.const 4 call $matches)
 (data (i32.const 184096) "/tmp/clipboard-cancel-status\00")
 (data (i32.const 184224) "\31\0a")
 (func (export "cancel-status") (result i32) i32.const 184096 i32.const 184224 i32.const 2 call $matches)
)
(assert_return (invoke $clipboard "text-status") (i32.const 1))
(assert_return (invoke $clipboard "text-payload") (i32.const 1))
(assert_return (invoke $clipboard "binary-status") (i32.const 1))
(assert_return (invoke $clipboard "binary-payload") (i32.const 1))
(assert_return (invoke $clipboard "empty-status") (i32.const 1))
(assert_return (invoke $clipboard "empty-payload") (i32.const 1))
(assert_return (invoke $clipboard "one-status") (i32.const 1))
(assert_return (invoke $clipboard "one-payload") (i32.const 1))
(assert_return (invoke $clipboard "two-status") (i32.const 1))
(assert_return (invoke $clipboard "two-payload") (i32.const 1))
(assert_return (invoke $clipboard "three-status") (i32.const 1))
(assert_return (invoke $clipboard "three-payload") (i32.const 1))
(assert_return (invoke $clipboard "utf8-status") (i32.const 1))
(assert_return (invoke $clipboard "utf8-payload") (i32.const 1))
(assert_return (invoke $clipboard "raw-binary-status") (i32.const 1))
(assert_return (invoke $clipboard "raw-binary-payload") (i32.const 1))
(assert_return (invoke $clipboard "cancel-status") (i32.const 1))
