;; Run after the package setup in guest Bash; real installed tools are required.
(module $linker
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $memcmp (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/windows-version-status.txt\00")
  (data (i32.const 180128) "/tmp/windows-compile-status.txt\00")
  (data (i32.const 180256) "/tmp/windows-link-status.txt\00")
  (data (i32.const 180384) "/tmp/windows-entry-status.txt\00")
  (data (i32.const 180512) "/tmp/windows-unresolved-status.txt\00")
  (data (i32.const 180640) "/tmp/windows-library-status.txt\00")
  (data (i32.const 180768) "/tmp/windows-malformed-status.txt\00")
  (data (i32.const 180896) "/tmp/windows-bitcode-compile-status.txt\00")
  (data (i32.const 181024) "/tmp/windows-bitcode-status.txt\00")
  (data (i32.const 181152) "/tmp/windows-debug-status.txt\00")
  (data (i32.const 181280) "/tmp/windows-response-status.txt\00")
  (data (i32.const 181408) "/tmp/windows-lto-status.txt\00")
  (data (i32.const 181536) "/tmp/windows-recovery-status.txt\00")
  (data (i32.const 181664) "/tmp/windows-changed-compile-status.txt\00")
  (data (i32.const 181792) "/tmp/windows-changed-link-status.txt\00")
  (data (i32.const 182000) "/tmp/windows-opt-lto-status.txt\00")
  (data (i32.const 187000) "/tmp/windows-opt-lto-output.txt\00")
  (data (i32.const 187128) "LLVM bitcode/LTO support is disabled")
  (data (i32.const 182128) "/tmp/windows-fat-lto-status.txt\00")
  (data (i32.const 187256) "/tmp/windows-fat-lto-output.txt\00")
  (data (i32.const 187384) "LLVM bitcode/LTO support is disabled")
  (data (i32.const 182256) "/tmp/windows-save-temps-status.txt\00")
  (data (i32.const 187512) "/tmp/windows-save-temps-output.txt\00")
  (data (i32.const 187640) "LLVM bitcode/LTO support is disabled")
  (data (i32.const 182384) "/tmp/windows-emit-llvm-status.txt\00")
  (data (i32.const 187768) "/tmp/windows-emit-llvm-output.txt\00")
  (data (i32.const 187896) "LLVM bitcode/LTO support is disabled")
  (data (i32.const 182512) "/tmp/windows-alt-prefix-lto-status.txt\00")
  (data (i32.const 188024) "/tmp/windows-alt-prefix-lto-output.txt\00")
  (data (i32.const 188152) "LLVM bitcode/LTO support is disabled")
  (data (i32.const 182640) "/tmp/windows-archive-status.txt\00")
  (data (i32.const 188280) "/tmp/windows-archive-output.txt\00")
  (data (i32.const 188408) "archive creation (/lib) is unsupported")
  (data (i32.const 182768) "/tmp/windows-invalid-compile-status.txt\00")
  (data (i32.const 188536) "/tmp/windows-invalid-compile-output.txt\00")
  (data (i32.const 188664) "WINDOWS_DEMO_EXPECTED_COMPILE_FAILURE")
  (func $status (param $path i32) (param $expected i32) (result i32)
    (local $fd i32) (local $got i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const 0 return end
    local.get $fd i32.const 200000 i32.const 3 call $read local.set $got
    local.get $fd call $close drop
    local.get $got i32.const 2 i32.eq
    i32.const 200000 i32.load8_u local.get $expected i32.const 48 i32.add i32.eq i32.and
    i32.const 200001 i32.load8_u i32.const 10 i32.eq i32.and)
  (func (export "version-status") (result i32)
    i32.const 180000 i32.const 0 call $status)
  (func (export "compile-status") (result i32)
    i32.const 180128 i32.const 0 call $status)
  (func (export "link-status") (result i32)
    i32.const 180256 i32.const 0 call $status)
  (func (export "entry-status") (result i32)
    i32.const 180384 i32.const 1 call $status)
  (func (export "unresolved-status") (result i32)
    i32.const 180512 i32.const 1 call $status)
  (func (export "library-status") (result i32)
    i32.const 180640 i32.const 1 call $status)
  (func (export "malformed-status") (result i32)
    i32.const 180768 i32.const 1 call $status)
  (func (export "bitcode-compile-status") (result i32)
    i32.const 180896 i32.const 0 call $status)
  (func (export "bitcode-status") (result i32)
    i32.const 181024 i32.const 1 call $status)
  (func (export "debug-status") (result i32)
    i32.const 181152 i32.const 1 call $status)
  (func (export "response-status") (result i32)
    i32.const 181280 i32.const 1 call $status)
  (func (export "lto-status") (result i32)
    i32.const 181408 i32.const 1 call $status)
  (func (export "recovery-status") (result i32)
    i32.const 181536 i32.const 0 call $status)
  (data (i32.const 184000) "/tmp/windows-link-version.txt\00")
  (data (i32.const 184128) "LLD")
  (data (i32.const 184256) "/tmp/windows-entry-output.txt\00")
  (data (i32.const 184384) "undefined symbol")
  (data (i32.const 184512) "/tmp/windows-unresolved-output.txt\00")
  (data (i32.const 184640) "undefined symbol")
  (data (i32.const 184768) "/tmp/windows-library-output.txt\00")
  (data (i32.const 184896) "could not open")
  (data (i32.const 185024) "/tmp/windows-bitcode-output.txt\00")
  (data (i32.const 185152) "bitcode/LTO support is disabled")
  (data (i32.const 185280) "/tmp/windows-debug-output.txt\00")
  (data (i32.const 185408) "debug/PDB generation is disabled")
  (data (i32.const 185536) "/tmp/windows-response-output.txt\00")
  (data (i32.const 185664) "debug/PDB generation is disabled")
  (data (i32.const 185792) "/tmp/windows-lto-output.txt\00")
  (data (i32.const 185920) "bitcode/LTO support is disabled")
  (data (i32.const 186048) "/tmp/windows-recovery-output.txt\00")
  (data (i32.const 186176) "LLD")
  (func $contains (param $path i32) (param $text i32) (param $length i32) (result i32)
    (local $fd i32) (local $got i32) (local $offset i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const 0 return end
    local.get $fd i32.const 200000 i32.const 8192 call $read local.set $got
    local.get $fd call $close drop
    local.get $got i32.const 0 i32.lt_s if i32.const 0 return end
    block $end
      loop $scan
        local.get $offset local.get $length i32.add local.get $got i32.gt_u br_if $end
        i32.const 200000 local.get $offset i32.add local.get $text local.get $length
        call $memcmp i32.eqz if i32.const 1 return end
        local.get $offset i32.const 1 i32.add local.set $offset
        br $scan
      end
    end
    i32.const 0)
  (func (export "version-diagnostic") (result i32)
    i32.const 184000 i32.const 184128 i32.const 3 call $contains)
  (func (export "entry-diagnostic") (result i32)
    i32.const 184256 i32.const 184384 i32.const 16 call $contains)
  (func (export "unresolved-diagnostic") (result i32)
    i32.const 184512 i32.const 184640 i32.const 16 call $contains)
  (func (export "library-diagnostic") (result i32)
    i32.const 184768 i32.const 184896 i32.const 14 call $contains)
  (func (export "bitcode-diagnostic") (result i32)
    i32.const 185024 i32.const 185152 i32.const 31 call $contains)
  (func (export "debug-diagnostic") (result i32)
    i32.const 185280 i32.const 185408 i32.const 32 call $contains)
  (func (export "response-diagnostic") (result i32)
    i32.const 185536 i32.const 185664 i32.const 32 call $contains)
  (func (export "lto-diagnostic") (result i32)
    i32.const 185792 i32.const 185920 i32.const 31 call $contains)
  (func (export "recovery-diagnostic") (result i32)
    i32.const 186048 i32.const 186176 i32.const 3 call $contains)
  (func (export "changed-compile-status") (result i32)
    i32.const 181664 i32.const 0 call $status)
  (func (export "changed-link-status") (result i32)
    i32.const 181792 i32.const 0 call $status)
  (func (export "opt-lto-status") (result i32)
    i32.const 182000 i32.const 1 call $status)
  (func (export "opt-lto-diagnostic") (result i32)
    i32.const 187000 i32.const 187128 i32.const 36 call $contains)
  (func (export "fat-lto-status") (result i32)
    i32.const 182128 i32.const 1 call $status)
  (func (export "fat-lto-diagnostic") (result i32)
    i32.const 187256 i32.const 187384 i32.const 36 call $contains)
  (func (export "save-temps-status") (result i32)
    i32.const 182256 i32.const 1 call $status)
  (func (export "save-temps-diagnostic") (result i32)
    i32.const 187512 i32.const 187640 i32.const 36 call $contains)
  (func (export "emit-llvm-status") (result i32)
    i32.const 182384 i32.const 1 call $status)
  (func (export "emit-llvm-diagnostic") (result i32)
    i32.const 187768 i32.const 187896 i32.const 36 call $contains)
  (func (export "alt-prefix-lto-status") (result i32)
    i32.const 182512 i32.const 1 call $status)
  (func (export "alt-prefix-lto-diagnostic") (result i32)
    i32.const 188024 i32.const 188152 i32.const 36 call $contains)
  (func (export "archive-status") (result i32)
    i32.const 182640 i32.const 1 call $status)
  (func (export "invalid-compile-status") (result i32)
    i32.const 182768 i32.const 1 call $status)
  (func (export "invalid-compile-diagnostic") (result i32)
    i32.const 188536 i32.const 188664 i32.const 37 call $contains)
  (func (export "archive-diagnostic") (result i32)
    i32.const 188280 i32.const 188408 i32.const 38 call $contains)
)
(assert_return (invoke $linker "version-status") (i32.const 1))
(assert_return (invoke $linker "compile-status") (i32.const 1))
(assert_return (invoke $linker "link-status") (i32.const 1))
