;; Run setup.sh first; all checks load the installed Graphviz command's observations.
(module $dot
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "access" (func $access (param i32 i32) (result i32)))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "strstr" (func $find (param i32 i32) (result i32)))
  (import "libc" "strlen" (func $strlen (param i32) (result i32)))
  (import "libc" "strtod" (func $number (param i32 i32) (result f64)))
  (import "libc" "atoi" (func $atoi (param i32) (result i32)))
  (func $load (param $path i32) (result i32)
    (local $fd i32) (local $n i32)
    (local.set $fd (call $open (local.get $path) (i32.const 0) (i32.const 0)))
    (if (i32.lt_s (local.get $fd) (i32.const 0)) (then (return (i32.const -1))))
    (local.set $n (call $read (local.get $fd) (i32.const 240000) (i32.const 16383)))
    (drop (call $close (local.get $fd)))
    (if (i32.ge_s (local.get $n) (i32.const 0))
      (then (i32.store8 (i32.add (i32.const 240000) (local.get $n)) (i32.const 0))))
    (local.get $n))
  (func (export "contains") (param $path i32) (param $needle i32) (result i32)
    (if (i32.lt_s (call $load (local.get $path)) (i32.const 0)) (then (return (i32.const 0))))
    (i32.ne (call $find (i32.const 240000) (local.get $needle)) (i32.const 0)))
  (func (export "status") (param $path i32) (param $success i32) (result i32)
    (if (i32.le_s (call $load (local.get $path)) (i32.const 0)) (then (return (i32.const 0))))
    (i32.eq (i32.eqz (call $atoi (i32.const 240000))) (local.get $success)))
  (func (export "empty") (param $path i32) (result i32)
    (i32.eqz (call $load (local.get $path))))
  (func (export "executable") (param $path i32) (result i32)
    (i32.eqz (call $access (local.get $path) (i32.const 1))))
  (func $coordinate (param $needle i32) (param $horizontal i32) (result f64)
    (local $p i32) (local $x f64) (local $y f64)
    (local.set $p (call $find (i32.const 240000) (local.get $needle)))
    (if (i32.eqz (local.get $p)) (then (return (f64.const nan))))
    (local.set $p (i32.add (local.get $p) (call $strlen (local.get $needle))))
    (local.set $x (call $number (local.get $p) (i32.const 210000)))
    (local.set $y (call $number (i32.load (i32.const 210000)) (i32.const 210000)))
    (select (local.get $x) (local.get $y) (local.get $horizontal)))
  (func (export "rank-order") (param $path i32) (param $first i32) (param $second i32) (param $horizontal i32) (result i32)
    (if (i32.le_s (call $load (local.get $path)) (i32.const 0)) (then (return (i32.const 0))))
    (if (result i32) (local.get $horizontal)
      (then (f64.lt (call $coordinate (local.get $first) (i32.const 1)) (call $coordinate (local.get $second) (i32.const 1))))
      (else (f64.gt (call $coordinate (local.get $first) (i32.const 0)) (call $coordinate (local.get $second) (i32.const 0))))))
  (data (i32.const 180000) "/usr/bin/dot\00")
  (data (i32.const 180032) "/tmp/dot-svg-status\00")
  (data (i32.const 180064) "/tmp/dot-plain-status\00")
  (data (i32.const 180096) "/tmp/dot-lr-status\00")
  (data (i32.const 180128) "/tmp/dot-canon-status\00")
  (data (i32.const 180160) "/tmp/dot-layout-status\00")
  (data (i32.const 180192) "/tmp/dot-json-status\00")
  (data (i32.const 180224) "/tmp/dot-xdot-status\00")
  (data (i32.const 180256) "/tmp/dot-output-status\00")
  (data (i32.const 180288) "/tmp/dot-cluster-status\00")
  (data (i32.const 180320) "/tmp/dot-undirected-status\00")
  (data (i32.const 180352) "/tmp/dot-multiple-status\00")
  (data (i32.const 180384) "/tmp/dot-version-status\00")
  (data (i32.const 180416) "/tmp/dot-invalid-status\00")
  (data (i32.const 180448) "/tmp/dot-format-status\00")
  (data (i32.const 180480) "/tmp/dot-missing-status\00")
  (data (i32.const 180512) "/tmp/dot-svg\00")
  (data (i32.const 180544) "<svg\00")
  (data (i32.const 180576) "class=\22node\22\00")
  (data (i32.const 180608) "class=\22edge\22\00")
  (data (i32.const 180640) "<polygon\00")
  (data (i32.const 180672) "one &amp; two\00")
  (data (i32.const 180704) "fill=\22red\22\00")
  (data (i32.const 180736) "link\00")
  (data (i32.const 180768) "/tmp/dot-plain\00")
  (data (i32.const 180800) "graph \00")
  (data (i32.const 180832) "node a \00")
  (data (i32.const 180864) "node b \00")
  (data (i32.const 180896) "edge a b \00")
  (data (i32.const 180928) "stop\00")
  (data (i32.const 180960) "/tmp/dot-canon\00")
  (data (i32.const 180992) "digraph sample\00")
  (data (i32.const 181024) "a -> b\00")
  (data (i32.const 181056) "/tmp/dot-layout\00")
  (data (i32.const 181088) "bb=\00")
  (data (i32.const 181120) "pos=\00")
  (data (i32.const 181152) "/tmp/dot-json\00")
  (data (i32.const 181184) "\22name\22: \22sample\22\00")
  (data (i32.const 181216) "\22edges\22:\00")
  (data (i32.const 181248) "\22_draw_\22:\00")
  (data (i32.const 181280) "/tmp/dot-xdot\00")
  (data (i32.const 181312) "xdotversion\00")
  (data (i32.const 181344) "_draw_\00")
  (data (i32.const 181376) "/tmp/dot-output\00")
  (data (i32.const 181408) "/tmp/dot-cluster\00")
  (data (i32.const 181440) "class=\22cluster\22\00")
  (data (i32.const 181472) "group\00")
  (data (i32.const 181504) "/tmp/dot-undirected\00")
  (data (i32.const 181536) "edge left right \00")
  (data (i32.const 181568) "/tmp/dot-multiple\00")
  (data (i32.const 181600) "first\00")
  (data (i32.const 181632) "second\00")
  (data (i32.const 181664) "/tmp/dot-version\00")
  (data (i32.const 181696) "graphviz version 16.1.1\00")
  (data (i32.const 181728) "/tmp/dot-invalid-error\00")
  (data (i32.const 181760) "syntax error\00")
  (data (i32.const 181792) "/tmp/dot-format-error\00")
  (data (i32.const 181824) "not recognized\00")
  (data (i32.const 181856) "/tmp/dot-missing-error\00")
  (data (i32.const 181888) "/tmp/dot-missing-input\00")
  (data (i32.const 181920) "/tmp/dot-lr\00")
  (data (i32.const 181952) "/tmp/dot-svg-error\00")
  (data (i32.const 181984) "/tmp/dot-output-stdout\00")
)
(assert_return (invoke $dot "executable" (i32.const 180000)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180032) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180064) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180096) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180128) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180160) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180192) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180224) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180256) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180288) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180320) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180352) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180384) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180416) (i32.const 0)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180448) (i32.const 0)) (i32.const 1))
(assert_return (invoke $dot "status" (i32.const 180480) (i32.const 0)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180512) (i32.const 180544)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180512) (i32.const 180576)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180512) (i32.const 180608)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180512) (i32.const 180640)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180512) (i32.const 180672)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180512) (i32.const 180704)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180512) (i32.const 180736)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180768) (i32.const 180800)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180768) (i32.const 180832)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180768) (i32.const 180864)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180768) (i32.const 180896)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180768) (i32.const 180928)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180960) (i32.const 180992)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 180960) (i32.const 181024)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181056) (i32.const 181088)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181056) (i32.const 181120)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181152) (i32.const 181184)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181152) (i32.const 181216)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181152) (i32.const 181248)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181280) (i32.const 181312)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181280) (i32.const 181344)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181376) (i32.const 180544)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181376) (i32.const 180672)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181408) (i32.const 181440)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181408) (i32.const 181472)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181504) (i32.const 181536)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181568) (i32.const 181600)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181568) (i32.const 181632)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181664) (i32.const 181696)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181728) (i32.const 181760)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181792) (i32.const 181824)) (i32.const 1))
(assert_return (invoke $dot "contains" (i32.const 181856) (i32.const 181888)) (i32.const 1))
(assert_return (invoke $dot "rank-order" (i32.const 180768) (i32.const 180832) (i32.const 180864) (i32.const 0)) (i32.const 1))
(assert_return (invoke $dot "rank-order" (i32.const 181920) (i32.const 180832) (i32.const 180864) (i32.const 1)) (i32.const 1))
(assert_return (invoke $dot "empty" (i32.const 181952)) (i32.const 1))
(assert_return (invoke $dot "empty" (i32.const 181984)) (i32.const 1))
