;; Unsupported CPU accounting must not report success or access caller memory.
(module $usage
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "getrusage" (func $usage (param i32 i32) (result i32)))
  (import "env" "getrusage" (func $legacy (param i32 i32) (result i32)))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (func (export "call") (param $who i32) (param $pointer i32) (param $legacy i32) (result i32)
    i32.const 190000 i32.const 165 i32.const 104 memory.fill
    call $errno i32.const 73 i32.store
    (if (result i32) (local.get $legacy)
      (then (call $legacy (local.get $who) (local.get $pointer)))
      (else (call $usage (local.get $who) (local.get $pointer)))))
  (func (export "errno") (result i32) call $errno i32.load)
  (func (export "unchanged") (result i32)
    (local $index i32) (local $ok i32)
    i32.const 1 local.set $ok
    (loop $bytes
      local.get $ok i32.const 190000 local.get $index i32.add i32.load8_u
      i32.const 165 i32.eq i32.and local.set $ok
      local.get $index i32.const 1 i32.add local.tee $index i32.const 104 i32.lt_u br_if $bytes)
    local.get $ok))
(assert_return (invoke $usage "call" (i32.const 0) (i32.const 190008) (i32.const 0)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 38))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const -1) (i32.const 190008) (i32.const 0)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 38))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const 123) (i32.const 190008) (i32.const 0)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 22))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const 0) (i32.const 0) (i32.const 0)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 38))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const -1) (i32.const -1) (i32.const 0)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 38))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const 0) (i32.const -8) (i32.const 0)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 38))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const -2) (i32.const 0) (i32.const 0)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 22))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const 0) (i32.const 190008) (i32.const 1)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 38))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const -1) (i32.const 190008) (i32.const 1)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 38))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const 123) (i32.const 190008) (i32.const 1)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 22))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const 0) (i32.const 0) (i32.const 1)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 38))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const -1) (i32.const -1) (i32.const 1)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 38))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const 0) (i32.const -8) (i32.const 1)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 38))
(assert_return (invoke $usage "unchanged") (i32.const 1))
(assert_return (invoke $usage "call" (i32.const -2) (i32.const 0) (i32.const 1)) (i32.const -1))
(assert_return (invoke $usage "errno") (i32.const 22))
(assert_return (invoke $usage "unchanged") (i32.const 1))
