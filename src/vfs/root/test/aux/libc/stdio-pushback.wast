;; Shared one-byte pushback, including non-seekable-style buffered consumption.
(module $push
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "waste_fmemopen" (func $open (param i32 i32 i32 i32) (result i32)))
  (import "libc" "fclose" (func $close (param i32) (result i32)))
  (import "libc" "fgetc" (func $get (param i32) (result i32)))
  (import "libc" "ungetc" (func $unget (param i32 i32) (result i32)))
  (import "libc" "fread" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "libc" "fgets" (func $line (param i32 i32 i32) (result i32)))
  (import "libc" "feof" (func $eof (param i32) (result i32)))
  (import "libc" "fseek" (func $seek (param i32 i32 i32) (result i32)))
  (import "libc" "fpurge" (func $purge (param i32) (result i32)))
  (import "libc" "__freadahead" (func $ahead (param i32) (result i32)))
  (import "libc" "pipe" (func $pipe (param i32) (result i32)))
  (import "libc" "fdopen" (func $fdopen (param i32 i32) (result i32)))
  (import "libc" "ferror" (func $error (param i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $fdclose (param i32) (result i32)))
  (global $f (mut i32) (i32.const 0))
  (data (i32.const 180100) "ab\0acd")
  (data (i32.const 180110) "r\00")
  (func $start (param $flags i32)
    (global.set $f (call $open (i32.const 180100) (i32.const 5) (i32.const 5) (local.get $flags))))
  (func $finish (param $ok i32) (result i32)
    (drop (call $close (global.get $f))) (local.get $ok))
  (func (export "replacement") (result i32)
    (call $start (i32.const 1))
    (drop (call $get (global.get $f)))
    (call $finish (i32.and
      (i32.eq (call $unget (i32.const 88) (global.get $f)) (i32.const 88))
      (i32.and (i32.eq (call $get (global.get $f)) (i32.const 88))
               (i32.eq (call $get (global.get $f)) (i32.const 98))))))
  (func (export "fread") (result i32)
    (call $start (i32.const 1))
    (drop (call $unget (i32.const 90) (global.get $f)))
    (call $finish (i32.and
      (i32.eq (call $read (i32.const 181000) (i32.const 1) (i32.const 3) (global.get $f)) (i32.const 3))
      (i32.eq (i32.and (i32.load (i32.const 181000)) (i32.const 0xffffff)) (i32.const 0x62615a)))))
  (func (export "unsigned-byte") (result i32)
    (call $start (i32.const 1))
    (call $finish (i32.and
      (i32.eq (call $unget (i32.const 511) (global.get $f)) (i32.const 255))
      (i32.eq (call $get (global.get $f)) (i32.const 255)))))
  (func (export "reject-eof") (result i32)
    (call $start (i32.const 1))
    (call $finish (i32.and
      (i32.eq (call $unget (i32.const -1) (global.get $f)) (i32.const -1))
      (i32.eq (call $ahead (global.get $f)) (i32.const 5)))))
  (func (export "clear-eof") (result i32)
    (local $ok i32)
    (call $start (i32.const 1))
    (drop (call $read (i32.const 181000) (i32.const 1) (i32.const 6) (global.get $f)))
    (local.set $ok (call $eof (global.get $f)))
    (drop (call $unget (i32.const 113) (global.get $f)))
    (call $finish (i32.and (local.get $ok) (i32.and
      (i32.eqz (call $eof (global.get $f)))
      (i32.and (i32.eq (call $get (global.get $f)) (i32.const 113))
               (i32.eq (call $get (global.get $f)) (i32.const -1)))))))
  (func (export "full-slot") (result i32)
    (call $start (i32.const 1))
    (drop (call $unget (i32.const 88) (global.get $f)))
    (call $finish (i32.and
      (i32.eq (call $unget (i32.const 89) (global.get $f)) (i32.const -1))
      (i32.and (i32.eq (call $get (global.get $f)) (i32.const 88))
               (i32.eq (call $get (global.get $f)) (i32.const 97))))))
  (func (export "fgets") (result i32)
    (call $start (i32.const 1))
    (drop (call $unget (i32.const 88) (global.get $f)))
    (drop (call $line (i32.const 181000) (i32.const 8) (global.get $f)))
    (call $finish (i32.eq (i32.load (i32.const 181000)) (i32.const 0x0a626158))))
  (func (export "seek-discards") (result i32)
    (call $start (i32.const 1))
    (drop (call $unget (i32.const 88) (global.get $f)))
    (drop (call $seek (global.get $f) (i32.const 0) (i32.const 0)))
    (call $finish (i32.eq (call $get (global.get $f)) (i32.const 97))))
  (func (export "purge-discards") (result i32)
    (call $start (i32.const 1))
    (drop (call $unget (i32.const 88) (global.get $f)))
    (drop (call $purge (global.get $f)))
    (call $finish (i32.and (i32.eqz (call $ahead (global.get $f)))
      (i32.eq (call $get (global.get $f)) (i32.const -1)))))
  (func (export "write-stream") (result i32)
    (call $start (i32.const 2))
    (call $finish (i32.eq (call $unget (i32.const 88) (global.get $f)) (i32.const -1))))
  (func (export "pipe-seek-probe") (result i32)
    (if (call $pipe (i32.const 181100)) (then (return (i32.const 0))))
    (drop (call $write (i32.load (i32.const 181104)) (i32.const 180100) (i32.const 5)))
    (drop (call $fdclose (i32.load (i32.const 181104))))
    (global.set $f (call $fdopen (i32.load (i32.const 181100)) (i32.const 180110)))
    (if (i32.eqz (global.get $f)) (then (return (i32.const 0))))
    (drop (call $get (global.get $f)))
    (drop (call $unget (i32.const 88) (global.get $f)))
    (call $finish (i32.and
      (i32.eq (call $seek (global.get $f) (i32.const 0) (i32.const 1)) (i32.const -1))
      (i32.and (i32.eqz (call $error (global.get $f)))
               (i32.eq (call $get (global.get $f)) (i32.const 88)))))))
(assert_return (invoke $push "replacement") (i32.const 1))
(assert_return (invoke $push "fread") (i32.const 1))
(assert_return (invoke $push "unsigned-byte") (i32.const 1))
(assert_return (invoke $push "reject-eof") (i32.const 1))
(assert_return (invoke $push "clear-eof") (i32.const 1))
(assert_return (invoke $push "full-slot") (i32.const 1))
(assert_return (invoke $push "fgets") (i32.const 1))
(assert_return (invoke $push "seek-discards") (i32.const 1))
(assert_return (invoke $push "purge-discards") (i32.const 1))
(assert_return (invoke $push "write-stream") (i32.const 1))
(assert_return (invoke $push "pipe-seek-probe") (i32.const 1))
