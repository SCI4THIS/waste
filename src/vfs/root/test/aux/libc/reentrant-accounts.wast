;; Shared account data, caller-owned reentrant results; run in Bash.
(module $accounts
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "waste_passwd_set" (func $set (param i32 i32 i32 i32 i32 i32 i32)))
  (import "libc" "getpwnam_r" (func $name (param i32 i32 i32 i32 i32) (result i32)))
  (import "libc" "getpwuid_r" (func $uid (param i32 i32 i32 i32 i32) (result i32)))
  (import "libc" "getpwent" (func $next (result i32)))
  (import "libc" "setpwent" (func $rewind))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (import "libc" "memset" (func $fill (param i32 i32 i32) (result i32)))
  (import "libc" "strcmp" (func $compare (param i32 i32) (result i32)))
  (import "libc" "strlen" (func $length (param i32) (result i32)))
  (import "libc" "sysconf" (func $sysconf (param i32) (result i32)))
  (data (i32.const 180000) "alice\00x\00Alice\00/home/alice\00/bin/bash\00")
  (data (i32.const 180064) "root\00x\00root\00/root\00/usr/bin/bash\00missing\00")
  (func (export "configure")
    (call $set (i32.const 180000) (i32.const 180006) (i32.const 1000) (i32.const 100)
      (i32.const 180008) (i32.const 180014) (i32.const 180026)))
  (func (export "empty-fields")
    (call $set (i32.const 180000) (i32.const 0) (i32.const 1000) (i32.const 100)
      (i32.const 0) (i32.const 0) (i32.const 0)))
  (func (export "no-account")
    (call $set (i32.const 0) (i32.const 0) (i32.const 1000) (i32.const 100)
      (i32.const 0) (i32.const 0) (i32.const 0)))
  (func (export "restore")
    (call $set (i32.const 180064) (i32.const 180069) (i32.const 0) (i32.const 0)
      (i32.const 180071) (i32.const 180076) (i32.const 180082)))
  (func (export "word") (param $address i32) (result i32) (i32.load (local.get $address)))
  (func (export "byte") (param $address i32) (result i32) (i32.load8_u (local.get $address)))
  (func (export "error") (result i32) (i32.load (call $errno)))
  (func (export "string") (param $offset i32) (param $expected i32) (result i32)
    (call $compare (i32.load (i32.add (i32.const 181000) (local.get $offset))) (local.get $expected)))
  (func (export "lookup") (param $capacity i32) (result i32)
    (drop (call $fill (i32.const 181000) (i32.const 165) (i32.const 28)))
    (drop (call $fill (i32.const 182000) (i32.const 165) (i32.const 40)))
    (i32.store (i32.const 181040) (i32.const -1))
    (i32.store (call $errno) (i32.const 77))
    (call $name (i32.const 180000) (i32.const 181000) (i32.const 182001)
      (local.get $capacity) (i32.const 181040)))
  (func (export "by-uid") (param $id i32) (result i32)
    (i32.store (i32.const 181140) (i32.const -1))
    (call $uid (local.get $id) (i32.const 181100) (i32.const 183001)
      (i32.const 36) (i32.const 181140)))
  (func (export "missing-name") (result i32)
    (i32.store (i32.const 181040) (i32.const -1))
    (call $name (i32.const 180096) (i32.const 181000) (i32.const 182001)
      (i32.const 0) (i32.const 181040)))
  (func (export "bad-pointer") (param $which i32) (result i32)
    (i32.store (i32.const 181040) (i32.const -1))
    (call $name
      (select (i32.const 0) (i32.const 180000) (i32.eqz (local.get $which)))
      (select (i32.const 0) (i32.const 181000) (i32.eq (local.get $which) (i32.const 1)))
      (select (i32.const 0) (i32.const 182001) (i32.eq (local.get $which) (i32.const 2)))
      (i32.const 36)
      (select (i32.const 0) (i32.const 181040) (i32.eq (local.get $which) (i32.const 3)))))
  (func (export "cursor") (result i32)
    (call $rewind)
    (drop (call $name (i32.const 180000) (i32.const 181000) (i32.const 182001)
      (i32.const 36) (i32.const 181040)))
    (i32.eqz (i32.eqz (call $next))))
  (func (export "long-account")
    (drop (call $fill (i32.const 194000) (i32.const 97) (i32.const 20000)))
    (i32.store8 (i32.const 214000) (i32.const 0))
    (call $set (i32.const 180000) (i32.const 180006) (i32.const 1000) (i32.const 100)
      (i32.const 180008) (i32.const 194000) (i32.const 180026)))
  (func (export "long-lookup") (param $capacity i32) (result i32)
    (i32.store (i32.const 181040) (i32.const -1))
    (call $uid (i32.const 1000) (i32.const 181000) (i32.const 220000)
      (local.get $capacity) (i32.const 181040)))
  (func (export "directory-length") (result i32)
    (call $length (i32.load (i32.const 181020))))
  (func (export "query") (param $selector i32) (result i32)
    (i32.store (call $errno) (i32.const 77)) (call $sysconf (local.get $selector))))
(assert_return (invoke $accounts "configure"))
(assert_return (invoke $accounts "lookup" (i32.const 0)) (i32.const 34))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 0))
(assert_return (invoke $accounts "word" (i32.const 181000)) (i32.const -1515870811))
(assert_return (invoke $accounts "word" (i32.const 182001)) (i32.const -1515870811))
(assert_return (invoke $accounts "byte" (i32.const 182000)) (i32.const 165))
(assert_return (invoke $accounts "byte" (i32.const 182037)) (i32.const 165))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "lookup" (i32.const 1)) (i32.const 34))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 0))
(assert_return (invoke $accounts "word" (i32.const 181000)) (i32.const -1515870811))
(assert_return (invoke $accounts "word" (i32.const 182001)) (i32.const -1515870811))
(assert_return (invoke $accounts "byte" (i32.const 182000)) (i32.const 165))
(assert_return (invoke $accounts "byte" (i32.const 182037)) (i32.const 165))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "lookup" (i32.const 35)) (i32.const 34))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 0))
(assert_return (invoke $accounts "word" (i32.const 181000)) (i32.const -1515870811))
(assert_return (invoke $accounts "word" (i32.const 182001)) (i32.const -1515870811))
(assert_return (invoke $accounts "byte" (i32.const 182000)) (i32.const 165))
(assert_return (invoke $accounts "byte" (i32.const 182037)) (i32.const 165))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "lookup" (i32.const 36)) (i32.const 0))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 181000))
(assert_return (invoke $accounts "word" (i32.const 181000)) (i32.const 182001))
(assert_return (invoke $accounts "word" (i32.const 181004)) (i32.const 182007))
(assert_return (invoke $accounts "word" (i32.const 181008)) (i32.const 1000))
(assert_return (invoke $accounts "word" (i32.const 181012)) (i32.const 100))
(assert_return (invoke $accounts "word" (i32.const 181016)) (i32.const 182009))
(assert_return (invoke $accounts "word" (i32.const 181020)) (i32.const 182015))
(assert_return (invoke $accounts "word" (i32.const 181024)) (i32.const 182027))
(assert_return (invoke $accounts "string" (i32.const 0) (i32.const 180000)) (i32.const 0))
(assert_return (invoke $accounts "string" (i32.const 4) (i32.const 180006)) (i32.const 0))
(assert_return (invoke $accounts "string" (i32.const 16) (i32.const 180008)) (i32.const 0))
(assert_return (invoke $accounts "string" (i32.const 20) (i32.const 180014)) (i32.const 0))
(assert_return (invoke $accounts "string" (i32.const 24) (i32.const 180026)) (i32.const 0))
(assert_return (invoke $accounts "byte" (i32.const 182000)) (i32.const 165))
(assert_return (invoke $accounts "byte" (i32.const 182037)) (i32.const 165))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "by-uid" (i32.const 1000)) (i32.const 0))
(assert_return (invoke $accounts "word" (i32.const 181140)) (i32.const 181100))
(assert_return (invoke $accounts "word" (i32.const 181100)) (i32.const 183001))
(assert_return (invoke $accounts "string" (i32.const 20) (i32.const 180014)) (i32.const 0))
(assert_return (invoke $accounts "by-uid" (i32.const 999)) (i32.const 0))
(assert_return (invoke $accounts "word" (i32.const 181140)) (i32.const 0))
(assert_return (invoke $accounts "missing-name") (i32.const 0))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 0))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "bad-pointer" (i32.const 0)) (i32.const 14))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 0))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "bad-pointer" (i32.const 1)) (i32.const 14))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 0))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "bad-pointer" (i32.const 2)) (i32.const 14))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 0))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "bad-pointer" (i32.const 3)) (i32.const 14))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "cursor") (i32.const 1))
(assert_return (invoke $accounts "empty-fields"))
(assert_return (invoke $accounts "lookup" (i32.const 10)) (i32.const 0))
(assert_return (invoke $accounts "word" (i32.const 181004)) (i32.const 182007))
(assert_return (invoke $accounts "word" (i32.const 181016)) (i32.const 182008))
(assert_return (invoke $accounts "word" (i32.const 181020)) (i32.const 182009))
(assert_return (invoke $accounts "word" (i32.const 181024)) (i32.const 182010))
(assert_return (invoke $accounts "word" (i32.const 182007)) (i32.const 0))
(assert_return (invoke $accounts "byte" (i32.const 182011)) (i32.const 165))
(assert_return (invoke $accounts "no-account"))
(assert_return (invoke $accounts "lookup" (i32.const 0)) (i32.const 0))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 0))
(assert_return (invoke $accounts "long-account"))
(assert_return (invoke $accounts "long-lookup" (i32.const 16384)) (i32.const 34))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 0))
(assert_return (invoke $accounts "long-lookup" (i32.const 20025)) (i32.const 0))
(assert_return (invoke $accounts "directory-length") (i32.const 20000))
(assert_return (invoke $accounts "word" (i32.const 181040)) (i32.const 181000))
(assert_return (invoke $accounts "query" (i32.const 70)) (i32.const -1))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "query" (i32.const 30)) (i32.const 65536))
(assert_return (invoke $accounts "error") (i32.const 77))
(assert_return (invoke $accounts "query" (i32.const -123)) (i32.const -1))
(assert_return (invoke $accounts "error") (i32.const 22))
(assert_return (invoke $accounts "restore"))
