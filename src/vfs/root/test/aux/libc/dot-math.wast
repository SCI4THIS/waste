;; Shared portable binary64 providers needed by Graphviz.
(module $dot_math
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "fmin" (func $min (param f64 f64) (result f64)))
  (import "libc" "fmax" (func $max (param f64 f64) (result f64)))
  (import "libc" "acos" (func $acos (param f64) (result f64)))
  (import "libc" "atan" (func $atan (param f64) (result f64)))
  (import "libc" "tan" (func $tan (param f64) (result f64)))
  (import "libc" "cbrt" (func $cbrt (param f64) (result f64)))
  (import "libc" "hypot" (func $hypot (param f64 f64) (result f64)))
  (import "libc" "log10" (func $log10 (param f64) (result f64)))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (func (export "near") (param $which i32) (param $x f64) (param $y f64) (param $expected f64) (result i32)
    (local $value f64)
    (if (i32.eq (local.get $which) (i32.const 0)) (then (local.set $value (call $acos (local.get $x)))))
    (if (i32.eq (local.get $which) (i32.const 1)) (then (local.set $value (call $atan (local.get $x)))))
    (if (i32.eq (local.get $which) (i32.const 2)) (then (local.set $value (call $tan (local.get $x)))))
    (if (i32.eq (local.get $which) (i32.const 3)) (then (local.set $value (call $cbrt (local.get $x)))))
    (if (i32.eq (local.get $which) (i32.const 4)) (then (local.set $value (call $hypot (local.get $x) (local.get $y)))))
    (if (i32.eq (local.get $which) (i32.const 5)) (then (local.set $value (call $log10 (local.get $x)))))
    (f64.le (f64.abs (f64.sub (local.get $value) (local.get $expected)))
      (f64.mul (f64.const 1e-12) (f64.max (f64.const 1e-298) (f64.abs (local.get $expected))))))
  (export "min" (func $min))
  (export "max" (func $max))
  (export "acos" (func $acos))
  (export "atan" (func $atan))
  (export "tan" (func $tan))
  (export "cbrt" (func $cbrt))
  (export "hypot" (func $hypot))
  (export "log10" (func $log10))
)
(assert_return (invoke $dot_math "near" (i32.const 0) (f64.const 1) (f64.const 0) (f64.const 0)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 0) (f64.const 0) (f64.const 0) (f64.const 1.5707963267948966)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 0) (f64.const -1) (f64.const 0) (f64.const 3.141592653589793)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 1) (f64.const 0) (f64.const 0) (f64.const 0)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 1) (f64.const 1) (f64.const 0) (f64.const 0.7853981633974483)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 1) (f64.const -1e+300) (f64.const 0) (f64.const -1.5707963267948966)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 2) (f64.const 0) (f64.const 0) (f64.const 0)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 2) (f64.const 1) (f64.const 0) (f64.const 1.5574077246549023)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 2) (f64.const -1) (f64.const 0) (f64.const -1.5574077246549023)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 3) (f64.const 8) (f64.const 0) (f64.const 2)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 3) (f64.const -27) (f64.const 0) (f64.const -3)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 3) (f64.const 1e+300) (f64.const 0) (f64.const 1e+100)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 4) (f64.const 3) (f64.const 4) (f64.const 5)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 4) (f64.const 1e+300) (f64.const 1e+300) (f64.const 1.4142135623730952e+300)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 4) (f64.const 1e-300) (f64.const 1e-300) (f64.const 1.4142135623730952e-300)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 5) (f64.const 1) (f64.const 0) (f64.const 0)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 5) (f64.const 1000) (f64.const 0) (f64.const 3)) (i32.const 1))
(assert_return (invoke $dot_math "near" (i32.const 5) (f64.const 1e-300) (f64.const 0) (f64.const -300)) (i32.const 1))
(assert_return (invoke $dot_math "acos" (f64.const 2)) (f64.const nan:arithmetic))
(assert_return (invoke $dot_math "tan" (f64.const inf)) (f64.const nan:arithmetic))
(assert_return (invoke $dot_math "cbrt" (f64.const -0)) (f64.const -0))
(assert_return (invoke $dot_math "hypot" (f64.const inf) (f64.const nan)) (f64.const inf))
(assert_return (invoke $dot_math "log10" (f64.const 0)) (f64.const -inf))
(assert_return (invoke $dot_math "min" (f64.const 3) (f64.const 4)) (f64.const 3))
(assert_return (invoke $dot_math "min" (f64.const 4) (f64.const 3)) (f64.const 3))
(assert_return (invoke $dot_math "min" (f64.const nan) (f64.const 4)) (f64.const 4))
(assert_return (invoke $dot_math "min" (f64.const 4) (f64.const nan)) (f64.const 4))
(assert_return (invoke $dot_math "min" (f64.const nan) (f64.const nan)) (f64.const nan:arithmetic))
(assert_return (invoke $dot_math "min" (f64.const 0) (f64.const -0)) (f64.const -0))
(assert_return (invoke $dot_math "min" (f64.const -0) (f64.const 0)) (f64.const -0))
(assert_return (invoke $dot_math "min" (f64.const inf) (f64.const 2)) (f64.const 2))
(assert_return (invoke $dot_math "max" (f64.const 3) (f64.const 4)) (f64.const 4))
(assert_return (invoke $dot_math "max" (f64.const 4) (f64.const 3)) (f64.const 4))
(assert_return (invoke $dot_math "max" (f64.const nan) (f64.const 4)) (f64.const 4))
(assert_return (invoke $dot_math "max" (f64.const 4) (f64.const nan)) (f64.const 4))
(assert_return (invoke $dot_math "max" (f64.const nan) (f64.const nan)) (f64.const nan:arithmetic))
(assert_return (invoke $dot_math "max" (f64.const 0) (f64.const -0)) (f64.const 0))
(assert_return (invoke $dot_math "max" (f64.const -0) (f64.const 0)) (f64.const 0))
(assert_return (invoke $dot_math "max" (f64.const -inf) (f64.const 2)) (f64.const 2))
