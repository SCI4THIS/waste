;; Shared portable binary64 providers needed by GNU Awk.
(module $math
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "exp" (func $exp (param f64) (result f64)))
  (import "libc" "log" (func $log (param f64) (result f64)))
  (import "libc" "sin" (func $sin (param f64) (result f64)))
  (import "libc" "cos" (func $cos (param f64) (result f64)))
  (import "libc" "pow" (func $pow (param f64 f64) (result f64)))
  (import "libc" "atan2" (func $atan2 (param f64 f64) (result f64)))
  (import "libc" "fmod" (func $fmod (param f64 f64) (result f64)))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (func (export "error") (param $which i32) (result i32)
    (i32.store (call $errno) (i32.const 0))
    (if (i32.eqz (local.get $which))
      (then (drop (call $log (f64.const -1))))
      (else (drop (call $exp (f64.const 1000)))))
    (i32.load (call $errno)))
  (func (export "near") (param $which i32) (param $x f64) (param $y f64) (param $expected f64) (result i32)
    (local $value f64)
    (if (i32.eq (local.get $which) (i32.const 0)) (then (local.set $value (call $exp (local.get $x)))))
    (if (i32.eq (local.get $which) (i32.const 1)) (then (local.set $value (call $log (local.get $x)))))
    (if (i32.eq (local.get $which) (i32.const 2)) (then (local.set $value (call $sin (local.get $x)))))
    (if (i32.eq (local.get $which) (i32.const 3)) (then (local.set $value (call $cos (local.get $x)))))
    (if (i32.eq (local.get $which) (i32.const 4)) (then (local.set $value (call $pow (local.get $x) (local.get $y)))))
    (if (i32.eq (local.get $which) (i32.const 5)) (then (local.set $value (call $atan2 (local.get $x) (local.get $y)))))
    (if (i32.eq (local.get $which) (i32.const 6)) (then (local.set $value (call $fmod (local.get $x) (local.get $y)))))
    (f64.le (f64.abs (f64.sub (local.get $value) (local.get $expected)))
      (f64.mul (f64.const 1e-12) (f64.max (f64.const 1) (f64.abs (local.get $expected))))))
  (export "exp" (func $exp))
  (export "log" (func $log))
  (export "sin" (func $sin))
  (export "cos" (func $cos))
  (export "pow" (func $pow))
  (export "atan2" (func $atan2))
  (export "fmod" (func $fmod))
)
(assert_return (invoke $math "near" (i32.const 0) (f64.const 0) (f64.const 0) (f64.const 1)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 0) (f64.const 1) (f64.const 0) (f64.const 2.718281828459045)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 0) (f64.const -1) (f64.const 0) (f64.const 0.36787944117144233)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 1) (f64.const 1) (f64.const 0) (f64.const 0)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 1) (f64.const 2) (f64.const 0) (f64.const 0.6931471805599453)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 1) (f64.const 1e-300) (f64.const 0) (f64.const -690.7755278982137)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 2) (f64.const 0) (f64.const 0) (f64.const 0)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 2) (f64.const 1) (f64.const 0) (f64.const 0.8414709848078965)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 2) (f64.const 1e+300) (f64.const 0) (f64.const -0.8178819121159085)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 3) (f64.const 0) (f64.const 0) (f64.const 1)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 3) (f64.const 1) (f64.const 0) (f64.const 0.5403023058681398)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 3) (f64.const 1e+300) (f64.const 0) (f64.const -0.5753861119575491)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 4) (f64.const 2) (f64.const 10) (f64.const 1024)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 4) (f64.const -2) (f64.const 3) (f64.const -8)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 4) (f64.const 9) (f64.const 0.5) (f64.const 3)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 5) (f64.const 1) (f64.const 1) (f64.const 0.7853981633974483)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 5) (f64.const 1) (f64.const -1) (f64.const 2.356194490192345)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 5) (f64.const -1) (f64.const -1) (f64.const -2.356194490192345)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 6) (f64.const 5.5) (f64.const 2) (f64.const 1.5)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 6) (f64.const -5.5) (f64.const 2) (f64.const -1.5)) (i32.const 1))
(assert_return (invoke $math "near" (i32.const 6) (f64.const 1e+300) (f64.const 3) (f64.const 0)) (i32.const 1))
(assert_return (invoke $math "exp" (f64.const -inf)) (f64.const 0))
(assert_return (invoke $math "exp" (f64.const inf)) (f64.const inf))
(assert_return (invoke $math "log" (f64.const 0)) (f64.const -inf))
(assert_return (invoke $math "log" (f64.const -1)) (f64.const nan:canonical))
(assert_return (invoke $math "sin" (f64.const -0)) (f64.const -0))
(assert_return (invoke $math "cos" (f64.const inf)) (f64.const nan:canonical))
(assert_return (invoke $math "atan2" (f64.const -0) (f64.const 1)) (f64.const -0))
(assert_return (invoke $math "fmod" (f64.const -4) (f64.const 2)) (f64.const -0))
(assert_return (invoke $math "fmod" (f64.const 1) (f64.const 0)) (f64.const nan:canonical))
(assert_return (invoke $math "pow" (f64.const nan) (f64.const 0)) (f64.const 1))
(assert_return (invoke $math "error" (i32.const 0)) (i32.const 33))
(assert_return (invoke $math "error" (i32.const 1)) (i32.const 34))
