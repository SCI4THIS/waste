;; Bounded duplication uses owned storage and stops at either NUL or the limit.
(module $dup
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "strndup" (func $dup (param i32 i32) (result i32)))
  (import "libc" "free" (func $free (param i32)))
  (import "libc" "strlen" (func $len (param i32) (result i32)))
  (import "libc" "memcmp" (func $cmp (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "abcdef\00")
  (data (i32.const 180016) "a\00b")
  (func (export "bounded") (param $src i32) (param $limit i32) (param $length i32) (result i32)
    (local $copy i32) (local $ok i32)
    (local.set $copy (call $dup (local.get $src) (local.get $limit)))
    (if (i32.eqz (local.get $copy)) (then (return (i32.const 0))))
    (local.set $ok (i32.and
      (i32.eq (call $len (local.get $copy)) (local.get $length))
      (i32.eqz (call $cmp (local.get $copy) (local.get $src) (local.get $length)))))
    (i32.store8 (local.get $copy) (i32.const 90))
    (local.set $ok (i32.and (local.get $ok) (i32.eq (i32.load8_u (local.get $src)) (i32.const 97))))
    (call $free (local.get $copy))
    (local.get $ok)))
(assert_return (invoke $dup "bounded" (i32.const 180000) (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke $dup "bounded" (i32.const 180000) (i32.const 3) (i32.const 3)) (i32.const 1))
(assert_return (invoke $dup "bounded" (i32.const 180000) (i32.const 6) (i32.const 6)) (i32.const 1))
(assert_return (invoke $dup "bounded" (i32.const 180000) (i32.const 100) (i32.const 6)) (i32.const 1))
(assert_return (invoke $dup "bounded" (i32.const 180016) (i32.const 3) (i32.const 1)) (i32.const 1))
