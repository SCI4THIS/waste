;; Signed wasm32 wchar elements, zero counts, overlap, embedded NUL and canaries.
;; All calls use the installed shared provider, including C++'s required APIs.
(module $wide
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (import "libc" "wmemcmp" (func $compare (param i32 i32 i32) (result i32)))
  (import "libc" "wmemcpy" (func $copy (param i32 i32 i32) (result i32)))
  (import "libc" "wmemmove" (func $move (param i32 i32 i32) (result i32)))
  (import "libc" "wmemset" (func $fill (param i32 i32 i32) (result i32)))
  (import "libc" "wmemchr" (func $find (param i32 i32 i32) (result i32)))
  (import "libc" "wcslen" (func $length (param i32) (result i32)))
  (import "libc" "wcscmp" (func $string-compare (param i32 i32) (result i32)))
  (import "libc" "wcsncmp" (func $prefix-compare (param i32 i32 i32) (result i32)))
  (import "libc" "wcscoll" (func $collate (param i32 i32) (result i32)))
  (import "libc" "wcschr" (func $string-find (param i32 i32) (result i32)))
  (import "libc" "wcsrchr" (func $reverse-find (param i32 i32) (result i32)))
  (import "libc" "wcspbrk" (func $set-find (param i32 i32) (result i32)))
  (import "libc" "wcsstr" (func $substring-find (param i32 i32) (result i32)))
  (data (i32.const 180000) "\41\00\00\00\00\00\00\00\00\f6\01\00\ff\ff\ff\ff\00\00\00\80\ff\ff\ff\7f")
  (data (i32.const 180032) "\00\00\00\80\00\00\00\00\ff\ff\ff\7f\00\00\00\00")
  (data (i32.const 180064) "\61\00\00\00\62\00\00\00\61\00\00\00\62\00\00\00\61\00\00\00\00\00\00\00")
  (data (i32.const 180096) "\62\00\00\00\61\00\00\00\00\00\00\00\5a\00\00\00\00\00\00\00")
  (func (export "compare") (param i32 i32 i32) (result i32)
    local.get 0 local.get 1 local.get 2 call $compare)
  (func (export "reset") (result i32)
    call $errno i32.const 71 i32.store
    i32.const 181000 i32.const 0x12345678 i32.store
    i32.const 181028 i32.const 0x76543210 i32.store
    i32.const 181004 i32.const 180000 i32.const 6 call $copy)
  (func (export "move") (param i32 i32 i32) (result i32)
    local.get 0 local.get 1 local.get 2 call $move)
  (func (export "copy") (param i32 i32 i32) (result i32)
    local.get 0 local.get 1 local.get 2 call $copy)
  (func (export "fill") (param i32 i32 i32) (result i32)
    local.get 0 local.get 1 local.get 2 call $fill)
  (func (export "cell") (param i32) (result i32) local.get 0 i32.load)
  (func (export "errno") (result i32) call $errno i32.load)
  (func (export "find") (param i32 i32 i32) (result i32)
    local.get 0 local.get 1 local.get 2 call $find)
  (func (export "reverse") (param i32 i32) (result i32)
    local.get 0 local.get 1 call $reverse-find)
  (func (export "set-find") (param i32 i32) (result i32)
    local.get 0 local.get 1 call $set-find)
  (func (export "substring") (param i32 i32) (result i32)
    local.get 0 local.get 1 call $substring-find)
  (func (export "string-checks") (result i32)
    i32.const 180000 call $length i32.const 1 i32.eq
    i32.const 180032 i32.const 180040 call $string-compare i32.const 0 i32.lt_s i32.and
    i32.const 180040 i32.const 180032 call $collate i32.const 0 i32.gt_s i32.and
    i32.const 180032 i32.const 180040 i32.const 0 call $prefix-compare i32.eqz i32.and
    i32.const 180032 i32.const 180040 i32.const 1 call $prefix-compare i32.const 0 i32.lt_s i32.and
    i32.const 180000 i32.const 0 call $string-find i32.const 180004 i32.eq i32.and
    i32.const 180000 i32.const 0x1f600 call $string-find i32.eqz i32.and)
)
(assert_return (invoke $wide "compare" (i32.const 1) (i32.const 3) (i32.const 0)) (i32.const 0))
(assert_return (invoke $wide "compare" (i32.const 180000) (i32.const 180000) (i32.const 6)) (i32.const 0))
(assert_return (invoke $wide "compare" (i32.const 180032) (i32.const 180040) (i32.const 1)) (i32.const -1))
(assert_return (invoke $wide "compare" (i32.const 180040) (i32.const 180032) (i32.const 1)) (i32.const 1))
(assert_return (invoke $wide "compare" (i32.const 180012) (i32.const 180016) (i32.const 1)) (i32.const 1))
(assert_return (invoke $wide "string-checks") (i32.const 1))
(assert_return (invoke $wide "find" (i32.const 180000) (i32.const 0) (i32.const 6)) (i32.const 180004))
(assert_return (invoke $wide "find" (i32.const 180000) (i32.const 0x1f600) (i32.const 2)) (i32.const 0))
(assert_return (invoke $wide "find" (i32.const 180000) (i32.const 0x1f600) (i32.const 3)) (i32.const 180008))
(assert_return (invoke $wide "find" (i32.const 180000) (i32.const -1) (i32.const 6)) (i32.const 180012))
(assert_return (invoke $wide "find" (i32.const 1) (i32.const -1) (i32.const 0)) (i32.const 0))
(assert_return (invoke $wide "copy" (i32.const 1) (i32.const 3) (i32.const 0)) (i32.const 1))
(assert_return (invoke $wide "move" (i32.const 1) (i32.const 3) (i32.const 0)) (i32.const 1))
(assert_return (invoke $wide "fill" (i32.const 1) (i32.const -1) (i32.const 0)) (i32.const 1))
(assert_return (invoke $wide "reset") (i32.const 181004))
(assert_return (invoke $wide "compare" (i32.const 181004) (i32.const 180000) (i32.const 6)) (i32.const 0))
(assert_return (invoke $wide "cell" (i32.const 181000)) (i32.const 0x12345678))
(assert_return (invoke $wide "cell" (i32.const 181028)) (i32.const 0x76543210))
;; Right-overlap: A,NUL,emoji,-1,min,max -> A,A,NUL,emoji,-1,min.
(assert_return (invoke $wide "move" (i32.const 181008) (i32.const 181004) (i32.const 5)) (i32.const 181008))
(assert_return (invoke $wide "cell" (i32.const 181004)) (i32.const 65))
(assert_return (invoke $wide "cell" (i32.const 181008)) (i32.const 65))
(assert_return (invoke $wide "cell" (i32.const 181012)) (i32.const 0))
(assert_return (invoke $wide "cell" (i32.const 181016)) (i32.const 0x1f600))
(assert_return (invoke $wide "cell" (i32.const 181020)) (i32.const -1))
(assert_return (invoke $wide "cell" (i32.const 181024)) (i32.const 0x80000000))
(assert_return (invoke $wide "cell" (i32.const 181028)) (i32.const 0x76543210))
(assert_return (invoke $wide "reset") (i32.const 181004))
;; Left-overlap preserves elements that have not yet been read.
(assert_return (invoke $wide "move" (i32.const 181004) (i32.const 181008) (i32.const 5)) (i32.const 181004))
(assert_return (invoke $wide "cell" (i32.const 181004)) (i32.const 0))
(assert_return (invoke $wide "cell" (i32.const 181008)) (i32.const 0x1f600))
(assert_return (invoke $wide "cell" (i32.const 181012)) (i32.const -1))
(assert_return (invoke $wide "cell" (i32.const 181016)) (i32.const 0x80000000))
(assert_return (invoke $wide "cell" (i32.const 181020)) (i32.const 0x7fffffff))
(assert_return (invoke $wide "cell" (i32.const 181024)) (i32.const 0x7fffffff))
(assert_return (invoke $wide "move" (i32.const 181004) (i32.const 181004) (i32.const 6)) (i32.const 181004))
(assert_return (invoke $wide "cell" (i32.const 181008)) (i32.const 0x1f600))
(assert_return (invoke $wide "fill" (i32.const 181008) (i32.const 0x1234abcd) (i32.const 3)) (i32.const 181008))
(assert_return (invoke $wide "cell" (i32.const 181004)) (i32.const 0))
(assert_return (invoke $wide "cell" (i32.const 181008)) (i32.const 0x1234abcd))
(assert_return (invoke $wide "cell" (i32.const 181012)) (i32.const 0x1234abcd))
(assert_return (invoke $wide "cell" (i32.const 181016)) (i32.const 0x1234abcd))
(assert_return (invoke $wide "cell" (i32.const 181020)) (i32.const 0x7fffffff))
(assert_return (invoke $wide "cell" (i32.const 181000)) (i32.const 0x12345678))
(assert_return (invoke $wide "cell" (i32.const 181028)) (i32.const 0x76543210))
(assert_return (invoke $wide "errno") (i32.const 71))
(assert_return (invoke $wide "reverse" (i32.const 180064) (i32.const 97)) (i32.const 180080))
(assert_return (invoke $wide "reverse" (i32.const 180064) (i32.const 0)) (i32.const 180084))
(assert_return (invoke $wide "reverse" (i32.const 180064) (i32.const 90)) (i32.const 0))
(assert_return (invoke $wide "reverse" (i32.const 180084) (i32.const 0)) (i32.const 180084))
(assert_return (invoke $wide "reverse" (i32.const 180000) (i32.const 0x1f600)) (i32.const 0))
(assert_return (invoke $wide "set-find" (i32.const 180064) (i32.const 180096)) (i32.const 180064))
(assert_return (invoke $wide "set-find" (i32.const 180064) (i32.const 180100)) (i32.const 180064))
(assert_return (invoke $wide "set-find" (i32.const 180064) (i32.const 180108)) (i32.const 0))
(assert_return (invoke $wide "set-find" (i32.const 180064) (i32.const 180084)) (i32.const 0))
(assert_return (invoke $wide "set-find" (i32.const 180084) (i32.const 180096)) (i32.const 0))
(assert_return (invoke $wide "substring" (i32.const 180064) (i32.const 180096)) (i32.const 180068))
(assert_return (invoke $wide "substring" (i32.const 180064) (i32.const 180064)) (i32.const 180064))
(assert_return (invoke $wide "substring" (i32.const 180068) (i32.const 180064)) (i32.const 0))
(assert_return (invoke $wide "substring" (i32.const 180064) (i32.const 180084)) (i32.const 180064))
(assert_return (invoke $wide "substring" (i32.const 180084) (i32.const 180064)) (i32.const 0))
(assert_return (invoke $wide "substring" (i32.const 180064) (i32.const 180108)) (i32.const 0))
