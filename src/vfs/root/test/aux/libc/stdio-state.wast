;; Opaque stream queries used by Gnulib, against the installed shared provider.
(module $stdio
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "fopen" (func $open (param i32 i32) (result i32)))
  (import "libc" "fclose" (func $close (param i32) (result i32)))
  (import "libc" "fwrite" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "libc" "fgetc" (func $get (param i32) (result i32)))
  (import "libc" "fseek" (func $seek (param i32 i32 i32) (result i32)))
  (import "libc" "fpurge" (func $purge (param i32) (result i32)))
  (import "libc" "__freadahead" (func $ahead (param i32) (result i32)))
  (import "libc" "__freading" (func $reading (param i32) (result i32)))
  (import "libc" "__fwriting" (func $writing (param i32) (result i32)))
  (import "libc" "__fpending" (func $pending (param i32) (result i32)))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (global $stream (mut i32) (i32.const 0))
  (data (i32.const 180000) "/tmp/stdio-state\00")
  (data (i32.const 180032) "w\00r\00abcdef")
  (func (export "open") (param $mode i32) (result i32)
    (global.set $stream (call $open (i32.const 180000) (local.get $mode)))
    (i32.ne (global.get $stream) (i32.const 0)))
  (func (export "write") (result i32)
    (call $write (i32.const 180036) (i32.const 1) (i32.const 6) (global.get $stream)))
  (func (export "get") (result i32) (call $get (global.get $stream)))
  (func (export "ahead") (result i32) (call $ahead (global.get $stream)))
  (func (export "pending") (result i32) (call $pending (global.get $stream)))
  (func (export "reading") (result i32) (call $reading (global.get $stream)))
  (func (export "writing") (result i32) (call $writing (global.get $stream)))
  (func (export "rewind") (result i32)
    (call $seek (global.get $stream) (i32.const 0) (i32.const 0)))
  (func (export "purge") (result i32) (call $purge (global.get $stream)))
  (func (export "errno-preserved") (result i32)
    (i32.store (call $errno) (i32.const 123))
    (drop (call $ahead (global.get $stream)))
    (drop (call $pending (global.get $stream)))
    (drop (call $reading (global.get $stream)))
    (drop (call $writing (global.get $stream)))
    (i32.load (call $errno)))
  (func (export "null-queries") (result i32)
    (i32.or (i32.or (call $ahead (i32.const 0)) (call $pending (i32.const 0)))
            (i32.or (call $reading (i32.const 0)) (call $writing (i32.const 0)))))
  (func (export "close") (result i32)
    (local $result i32)
    (local.set $result (call $close (global.get $stream)))
    (global.set $stream (i32.const 0))
    (local.get $result)))
(assert_return (invoke $stdio "open" (i32.const 180032)) (i32.const 1))
(assert_return (invoke $stdio "reading") (i32.const 0))
(assert_return (invoke $stdio "writing") (i32.const 1))
(assert_return (invoke $stdio "ahead") (i32.const 0))
(assert_return (invoke $stdio "pending") (i32.const 0))
(assert_return (invoke $stdio "write") (i32.const 6))
(assert_return (invoke $stdio "pending") (i32.const 0))
(assert_return (invoke $stdio "errno-preserved") (i32.const 123))
(assert_return (invoke $stdio "close") (i32.const 0))
(assert_return (invoke $stdio "open" (i32.const 180034)) (i32.const 1))
(assert_return (invoke $stdio "reading") (i32.const 1))
(assert_return (invoke $stdio "writing") (i32.const 0))
(assert_return (invoke $stdio "ahead") (i32.const 0))
(assert_return (invoke $stdio "get") (i32.const 97))
(assert_return (invoke $stdio "ahead") (i32.const 5))
(assert_return (invoke $stdio "get") (i32.const 98))
(assert_return (invoke $stdio "ahead") (i32.const 4))
;; This backend retains its six-byte input buffer when seeking to its start.
(assert_return (invoke $stdio "rewind") (i32.const 0))
(assert_return (invoke $stdio "ahead") (i32.const 6))
(assert_return (invoke $stdio "get") (i32.const 97))
(assert_return (invoke $stdio "ahead") (i32.const 5))
(assert_return (invoke $stdio "purge") (i32.const 0))
(assert_return (invoke $stdio "ahead") (i32.const 0))
(assert_return (invoke $stdio "errno-preserved") (i32.const 123))
(assert_return (invoke $stdio "close") (i32.const 0))
(assert_return (invoke $stdio "null-queries") (i32.const 0))
