;; Guest libc reports cryptographic entropy failures and unsupported sockets.
(module $abi
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "getrandom" (func $random (param i32 i32 i32) (result i32)))
  (import "libc" "getentropy" (func $entropy (param i32 i32) (result i32)))
  (import "libc" "socket" (func $socket (param i32 i32 i32) (result i32)))
  (import "libc" "connect" (func $connect (param i32 i32 i32) (result i32)))
  (import "libc" "recv" (func $recv (param i32 i32 i32 i32) (result i32)))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (func (export "invalid-flags") (result i32)
    (i32.and (i32.eq (call $random (i32.const 180000) (i32.const 16) (i32.const 8)) (i32.const -1))
             (i32.eq (i32.load (call $errno)) (i32.const 22))))
  (func (export "entropy-too-long") (result i32)
    (i32.and (i32.eq (call $entropy (i32.const 180000) (i32.const 257)) (i32.const -1))
             (i32.eq (i32.load (call $errno)) (i32.const 5))))
  (func (export "entropy") (result i32)
    (call $entropy (i32.const 180000) (i32.const 256)))
  (func (export "socket") (result i32)
    (i32.and (i32.eq (call $socket (i32.const 2) (i32.const 1) (i32.const 0)) (i32.const -1))
             (i32.eq (i32.load (call $errno)) (i32.const 95))))
  (func (export "connect") (result i32)
    (i32.and (i32.eq (call $connect (i32.const -1) (i32.const 0) (i32.const 16)) (i32.const -1))
             (i32.eq (i32.load (call $errno)) (i32.const 95))))
  (func (export "recv") (result i32)
    (i32.and (i32.eq (call $recv (i32.const -1) (i32.const 0) (i32.const 16) (i32.const 0)) (i32.const -1))
             (i32.eq (i32.load (call $errno)) (i32.const 95)))))
(assert_return (invoke $abi "invalid-flags") (i32.const 1))
(assert_return (invoke $abi "entropy-too-long") (i32.const 1))
(assert_return (invoke $abi "entropy") (i32.const 0))
(assert_return (invoke $abi "socket") (i32.const 1))
(assert_return (invoke $abi "connect") (i32.const 1))
(assert_return (invoke $abi "recv") (i32.const 1))
