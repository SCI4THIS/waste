# WASTE cross-configuration answers.  Keep each answer paired with a reason
# explaining the guest ABI assumption.
#
# The source checkout does not contain generated configure output.  This file
# is consumed only after a local, reproducible bootstrap has produced it in
# build/aux/coreutils/source; it never changes the coreutils submodule.

# The wrapper targets wasm32 and cannot execute target probes on the host.
ac_cv_prog_cc_cross=yes
ac_cv_c_cross=yes
# WebAssembly linear memory is little-endian by specification.
ac_cv_c_bigendian=no
# The current WASTE socket ABI uses 32-bit lengths; validate this declaration
# against the public sys/socket.h declaration.
gl_cv_socklen_t_equiv=int
# The guest libc supplies the stdio_ext entry points; configure must not
# select the host-struct fallback implementation of gnulib/fpending.c.
ac_cv_header_stdio_ext_h=yes
ac_cv_have_decl___fpending=yes
# The MSVC invalid-parameter runtime is not part of the freestanding guest.
ac_cv_func__set_invalid_parameter_handler=no
# CPU affinity and HP-UX pstat APIs are not part of the guest kernel ABI.
ac_cv_func_sched_getaffinity=no
ac_cv_func_sched_getaffinity_np=no
ac_cv_func_pstat_getdynamic=no
ac_cv_func_pstat_getstatic=no
ac_cv_func_pstat_getprocvm=no
# waste-libc's allocator guarantees 16-byte alignment. Let gnulib provide its
# portable over-allocation shim for larger alignments such as cat's page-sized
# I/O buffers instead of selecting the limited POSIX entry point.
ac_cv_func_posix_memalign=no
# The guest implements timed waits through nanosleep/pselect; pause is not a
# separate kernel capability and must not leave an unresolved import in sleep.
ac_cv_func_pause=no
# Cross-configuration cannot execute the guest nanosleep probe. Trust the
# runtime implementation so Coreutils does not bundle Gnulib's fallback.
gl_cv_func_nanosleep=yes
