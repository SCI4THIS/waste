 #define AUTHORS proper_name_utf8 ("Rene' Seindal", "Ren\xC3\xA9 Seindal")
 
 static _Noreturn void usage (int);
+
+/* WASTE extension: print the installed notice without macro expansion.  */
+static int
+print_copying (void)
+{
+  const char *path = "/usr/share/licenses/m4/COPYING";
+  char buffer[1024];
+  int status = EXIT_SUCCESS;
+  int fd = open (path, O_RDONLY, 0);
+  if (fd < 0)
+    {
+      error (0, errno, _("cannot open `%s'"), path);
+      return EXIT_FAILURE;
+    }
+  for (;;)
+    {
+      ssize_t count = read (fd, buffer, sizeof buffer);
+      if (count < 0)
+        {
+          if (errno == EINTR)
+            continue;
+          error (0, errno, _("cannot read `%s'"), path);
+          status = EXIT_FAILURE;
+          break;
+        }
+      if (count == 0)
+        break;
+      for (size_t at = 0; at < (size_t) count; )
+        {
+          ssize_t written = write (STDOUT_FILENO, buffer + at, count - at);
+          if (written < 0 && errno == EINTR)
+            continue;
+          if (written <= 0)
+            {
+              error (0, written < 0 ? errno : EIO, _("write error"));
+              status = EXIT_FAILURE;
+              break;
+            }
+          at += written;
+        }
+      if (status != EXIT_SUCCESS)
+        break;
+    }
+  if (close (fd) < 0 && status == EXIT_SUCCESS)
+    {
+      error (0, errno, _("cannot close `%s'"), path);
+      status = EXIT_FAILURE;
+    }
+  return status;
+}
