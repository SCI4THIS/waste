WASTE guest adjustments for Vim.

The wasm32 SDK marks libm's pow() unavailable. linematch.c only uses pow()
to compute 2^ndiffs on a size_t result, which is exactly a left shift. Keep
the behavior but drop the libm dependency.

--- a/src/linematch.c
+++ b/src/linematch.c
@@ -414,7 +414,7 @@ linematch_nbuffers(
 	return 0;

     // allocate memory here
-    size_t n = (size_t)pow(2.0, (double)ndiffs);
+    size_t n = ((size_t)1) << ndiffs;
     for (size_t i = 0; i < memsize; i++)
     {
 	diffcmppath[i].df_lev_score = 0;

--- a/src/strings.c
+++ b/src/strings.c
@@ -4482,7 +4482,15 @@
 				// have room for.
 				if ((fmt_spec == 'f' || fmt_spec == 'F')
 								&& abs_f > 1.0)
-				    max_prec -= (size_t)log10(abs_f);
+				{
+				    // Only the decimal digit count is needed here.
+				    double magnitude = abs_f;
+				    while (magnitude >= 10.0)
+				    {
+					--max_prec;
+					magnitude /= 10.0;
+				    }
+				}
 				if (precision > max_prec)
 				    precision = max_prec;
 				l += sprintf(format + l, ".%d", (int)precision);
