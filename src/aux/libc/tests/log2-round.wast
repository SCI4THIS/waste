;; Shared binary64 log2 and ties-away round; WAST owns the expectations.
(module $math
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "log2" (func $log2 (param f64) (result f64)))
  (import "libc" "round" (func $round (param f64) (result f64)))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (export "log2" (func $log2))
  (export "round" (func $round))
  (func (export "log2-error") (param $x f64) (result i32)
    call $errno i32.const 0 i32.store
    local.get $x call $log2 drop call $errno i32.load)
  (func (export "log2-preserves-error") (param $x f64) (result i32)
    call $errno i32.const 73 i32.store
    local.get $x call $log2 drop call $errno i32.load)
  (func (export "round-preserves-error") (param $x f64) (result i32)
    call $errno i32.const 73 i32.store
    local.get $x call $round drop call $errno i32.load)
  (func (export "round-bits") (param $x f64) (result i64)
    local.get $x call $round i64.reinterpret_f64)
  (func (export "log2-quiets-nan") (param $bits i64) (result i32)
    local.get $bits f64.reinterpret_i64 call $log2 i64.reinterpret_f64
    i64.const 0x7ff8000000000000 i64.and
    i64.const 0x7ff8000000000000 i64.eq)
  (func (export "round-quiets-nan") (param $bits i64) (result i32)
    local.get $bits f64.reinterpret_i64 call $round i64.reinterpret_f64
    i64.const 0x7ff8000000000000 i64.and
    i64.const 0x7ff8000000000000 i64.eq)
  (func (export "log2-near") (param $x f64) (param $expected f64) (param $tolerance f64) (result i32)
    call $errno i32.const 73 i32.store
    local.get $x call $log2 local.get $expected f64.sub f64.abs
    local.get $tolerance f64.le
    call $errno i32.load i32.const 73 i32.eq i32.and)
)

;; Exact powers include subnormal and extreme normal values.
(assert_return (invoke "log2" (f64.const 0x1p-1074)) (f64.const -1074))
(assert_return (invoke "log2" (f64.const 0x1p-1073)) (f64.const -1073))
(assert_return (invoke "log2" (f64.const 0x1p-1022)) (f64.const -1022))
(assert_return (invoke "log2" (f64.const 0x1p-1021)) (f64.const -1021))
(assert_return (invoke "log2" (f64.const 0x1p-100)) (f64.const -100))
(assert_return (invoke "log2" (f64.const 0x1p-53)) (f64.const -53))
(assert_return (invoke "log2" (f64.const 0x1p-10)) (f64.const -10))
(assert_return (invoke "log2" (f64.const 0x1p-1)) (f64.const -1))
(assert_return (invoke "log2" (f64.const 0x1p0)) (f64.const 0))
(assert_return (invoke "log2" (f64.const 0x1p1)) (f64.const 1))
(assert_return (invoke "log2" (f64.const 0x1p10)) (f64.const 10))
(assert_return (invoke "log2" (f64.const 0x1p53)) (f64.const 53))
(assert_return (invoke "log2" (f64.const 0x1p100)) (f64.const 100))
(assert_return (invoke "log2" (f64.const 0x1p1023)) (f64.const 1023))

;; References computed with 100 decimal digits, bounded to four ULPs.
(assert_return (invoke "log2-near" (f64.const 0x1.999999999999ap-4) (f64.const -0x1.a934f0979a371p+1) (f64.const 0x1.0000000000000p-49)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.999999999999ap-3) (f64.const -0x1.2934f0979a371p+1) (f64.const 0x1.0000000000000p-49)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.3333333333333p-2) (f64.const -0x1.bca9c6f53897bp+0) (f64.const 0x1.0000000000000p-50)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.0000000000001p-1) (f64.const -0x1.ffffffffffffdp-1) (f64.const 0x1.0000000000000p-51)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.6666666666666p-1) (f64.const -0x1.0776228967d13p-1) (f64.const 0x1.0000000000000p-51)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.ccccccccccccdp-1) (f64.const -0x1.374d65d9e608dp-3) (f64.const 0x1.0000000000000p-53)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.ffffffffffffep-1) (f64.const -0x1.71547652b82ffp-52) (f64.const 0x1.0000000000000p-102)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.fffffffffffffp-1) (f64.const -0x1.71547652b82fep-53) (f64.const 0x1.0000000000000p-103)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.0000000000001p+0) (f64.const 0x1.71547652b82fdp-52) (f64.const 0x1.0000000000000p-102)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.0000000000002p+0) (f64.const 0x1.71547652b82fdp-51) (f64.const 0x1.0000000000000p-101)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.0000a7c5ac472p+0) (f64.const 0x1.e415f0d4c3be2p-17) (f64.const 0x1.0000000000000p-67)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.028f5c28f5c29p+0) (f64.const 0x1.d664ecee35b7fp-7) (f64.const 0x1.0000000000000p-57)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.2000000000000p+0) (f64.const 0x1.5c01a39fbd688p-3) (f64.const 0x1.0000000000000p-53)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.4000000000000p+0) (f64.const 0x1.49a784bcd1b8bp-2) (f64.const 0x1.0000000000000p-52)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.6666666666666p+0) (f64.const 0x1.f113baed305dap-2) (f64.const 0x1.0000000000000p-52)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.6a09e667f3bccp+0) (f64.const 0x1.ffffffffffffep-2) (f64.const 0x1.0000000000000p-52)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.6a09e667f3bcdp+0) (f64.const 0x1.0000000000001p-1) (f64.const 0x1.0000000000000p-51)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.6a09e667f3bcep+0) (f64.const 0x1.0000000000003p-1) (f64.const 0x1.0000000000000p-51)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.8000000000000p+0) (f64.const 0x1.2b803473f7ad1p-1) (f64.const 0x1.0000000000000p-51)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.c000000000000p+0) (f64.const 0x1.9d5d9fd5010b3p-1) (f64.const 0x1.0000000000000p-51)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.921fb54442d18p+1) (f64.const 0x1.a6c873498ddf7p+0) (f64.const 0x1.0000000000000p-50)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.5bf0a8b145769p+1) (f64.const 0x1.71547652b82fep+0) (f64.const 0x1.0000000000000p-50)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.4000000000000p+3) (f64.const 0x1.a934f0979a371p+1) (f64.const 0x1.0000000000000p-49)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.9000000000000p+6) (f64.const 0x1.a934f0979a371p+2) (f64.const 0x1.0000000000000p-48)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.56e1fc2f8f359p-997) (f64.const -0x1.f24a09f1a8b89p+9) (f64.const 0x1.0000000000000p-41)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.7e43c8800759cp+996) (f64.const 0x1.f24a09f1a8b89p+9) (f64.const 0x1.0000000000000p-41)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x0.fffffffffffffp-1022) (f64.const -0x1.ff00000000000p+9) (f64.const 0x1.0000000000000p-41)) (i32.const 1))
(assert_return (invoke "log2-near" (f64.const 0x1.fffffffffffffp+1023) (f64.const 0x1.0000000000000p+10) (f64.const 0x1.0000000000000p-40)) (i32.const 1))

;; Domain, poles and non-finite values with independent errno assertions.
(assert_return (invoke "log2" (f64.const 0)) (f64.const -inf))
(assert_return (invoke "log2" (f64.const -0)) (f64.const -inf))
(assert_return (invoke "log2" (f64.const -1)) (f64.const nan:arithmetic))
(assert_return (invoke "log2" (f64.const -inf)) (f64.const nan:arithmetic))
(assert_return (invoke "log2" (f64.const inf)) (f64.const inf))
(assert_return (invoke "log2" (f64.const nan)) (f64.const nan:arithmetic))
(assert_return (invoke "log2-quiets-nan" (i64.const 0x7ff0000000000001)) (i32.const 1))
(assert_return (invoke "log2-error" (f64.const 0)) (i32.const 34))
(assert_return (invoke "log2-error" (f64.const -0)) (i32.const 34))
(assert_return (invoke "log2-error" (f64.const -1)) (i32.const 33))
(assert_return (invoke "log2-error" (f64.const -inf)) (i32.const 33))
(assert_return (invoke "log2-preserves-error" (f64.const 2)) (i32.const 73))
(assert_return (invoke "log2-preserves-error" (f64.const inf)) (i32.const 73))
(assert_return (invoke "log2-preserves-error" (f64.const nan)) (i32.const 73))

;; Half-integer neighbors detect premature rounding of x + 0.5.
(assert_return (invoke "round" (f64.const 0x0.0p+0)) (f64.const 0x0.0p+0))
(assert_return (invoke "round" (f64.const -0x0.0p+0)) (f64.const -0x0.0p+0))
(assert_return (invoke "round" (f64.const 0x1.f5c28f5c28f5cp-2)) (f64.const 0x0.0p+0))
(assert_return (invoke "round" (f64.const -0x1.f5c28f5c28f5cp-2)) (f64.const -0x0.0p+0))
(assert_return (invoke "round" (f64.const 0x1.0000000000000p-1)) (f64.const 0x1.0000000000000p+0))
(assert_return (invoke "round" (f64.const -0x1.0000000000000p-1)) (f64.const -0x1.0000000000000p+0))
(assert_return (invoke "round" (f64.const 0x1.fffffffffffffp-2)) (f64.const 0x0.0p+0))
(assert_return (invoke "round" (f64.const 0x1.0000000000001p-1)) (f64.const 0x1.0000000000000p+0))
(assert_return (invoke "round" (f64.const -0x1.fffffffffffffp-2)) (f64.const -0x0.0p+0))
(assert_return (invoke "round" (f64.const -0x1.0000000000001p-1)) (f64.const -0x1.0000000000000p+0))
(assert_return (invoke "round" (f64.const 0x1.8000000000000p+0)) (f64.const 0x1.0000000000000p+1))
(assert_return (invoke "round" (f64.const -0x1.8000000000000p+0)) (f64.const -0x1.0000000000000p+1))
(assert_return (invoke "round" (f64.const 0x1.7ffffffffffffp+0)) (f64.const 0x1.0000000000000p+0))
(assert_return (invoke "round" (f64.const 0x1.8000000000001p+0)) (f64.const 0x1.0000000000000p+1))
(assert_return (invoke "round" (f64.const -0x1.7ffffffffffffp+0)) (f64.const -0x1.0000000000000p+0))
(assert_return (invoke "round" (f64.const 0x1.4000000000000p+1)) (f64.const 0x1.8000000000000p+1))
(assert_return (invoke "round" (f64.const -0x1.4000000000000p+1)) (f64.const -0x1.8000000000000p+1))
(assert_return (invoke "round" (f64.const 0x1.fffffffffffffp+51)) (f64.const 0x1.0000000000000p+52))
(assert_return (invoke "round" (f64.const -0x1.fffffffffffffp+51)) (f64.const -0x1.0000000000000p+52))
(assert_return (invoke "round" (f64.const 0x1.0000000000000p+52)) (f64.const 0x1.0000000000000p+52))
(assert_return (invoke "round" (f64.const -0x1.0000000000000p+52)) (f64.const -0x1.0000000000000p+52))
(assert_return (invoke "round" (f64.const 0x1.fffffffffffffp+1023)) (f64.const 0x1.fffffffffffffp+1023))

(assert_return (invoke "round-bits" (f64.const -0.49)) (i64.const 0x8000000000000000))
(assert_return (invoke "round-bits" (f64.const -0)) (i64.const 0x8000000000000000))
(assert_return (invoke "round-bits" (f64.const 0x1p-1074)) (i64.const 0))
(assert_return (invoke "round-bits" (f64.const -0x1p-1074)) (i64.const 0x8000000000000000))
(assert_return (invoke "round" (f64.const inf)) (f64.const inf))
(assert_return (invoke "round" (f64.const -inf)) (f64.const -inf))
(assert_return (invoke "round" (f64.const nan)) (f64.const nan:arithmetic))
(assert_return (invoke "round-quiets-nan" (i64.const 0x7ff0000000000001)) (i32.const 1))
(assert_return (invoke "round-preserves-error" (f64.const 1.5)) (i32.const 73))
(assert_return (invoke "round-preserves-error" (f64.const inf)) (i32.const 73))
(assert_return (invoke "round-preserves-error" (f64.const nan)) (i32.const 73))
