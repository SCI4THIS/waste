# Cross-build answers for the selected wasm32 guest and shared-libc profile.
ac_cv_c_bigendian=no
ac_cv_func_alloca_works=yes
ac_cv_func_malloc_0_nonnull=yes
ac_cv_func_realloc_0_nonnull=yes
ac_cv_func_getpgrp_void=yes
ac_cv_func_setvbuf_reversed=no
ac_cv_header_stdc=yes
ac_cv_func___fpurge=no
ac_cv_func_sigaction=yes
ac_cv_func_sigprocmask=yes
# Descriptor and process operations supplied directly by the engine.
ac_cv_func_dup2=yes
ac_cv_func_getdtablesize=yes
ac_cv_func_getpgrp=yes
ac_cv_func_waitpid=yes
ac_cv_func_fork=yes
ac_cv_func_setpgid=yes
ac_cv_func_tcsetpgrp=yes
ac_cv_func_dlopen=no
ac_cv_func_clock_gettime=no
ac_cv_func_arc4random=no
ac_cv_func_arc4random_uniform=no
ac_cv_func_mmap=no
ac_cv_func_pselect=no
ac_cv_func_poll=no
ac_cv_func_nanosleep=no
ac_cv_func_putenv=no
ac_cv_func_strtoul=no
ac_cv_func_strtoll=no
ac_cv_func_strtoull=no
ac_cv_func_gethostbyname=no
ac_cv_func_getpeername=no
# Provider exports lacking the selected public SDK declarations/layouts.
ac_cv_func_getrusage=no
ac_cv_func_getservent=no
ac_cv_func_imaxdiv=no
# rename is implemented by the engine kernel.
ac_cv_func_rename=yes
bash_cv_termcap_lib=libc
bash_cv_func_sigsetjmp=present
bash_cv_getenv_redef=no
bash_cv_getcwd_malloc=yes
bash_cv_getcwd_calls_popen=no
bash_cv_job_control_missing=present
bash_cv_signal_vintage=posix
bash_cv_sys_siglist=no
bash_cv_under_sys_siglist=no
bash_cv_decl_under_sys_siglist=no
bash_cv_unusable_rtsigs=no
bash_cv_func_strcoll_broken=no
bash_cv_func_snprintf=yes
bash_cv_func_vsnprintf=yes
bash_cv_printf_a_format=yes
bash_cv_wexitstatus_offset=8
bash_cv_wcontinued_broken=no
bash_cv_dev_fd=absent
bash_cv_dev_stdin=absent
bash_cv_sys_named_pipes=present
bash_cv_sys_restartable_syscalls=no
bash_cv_type_rlimit=rlim_t
bash_cv_type_clock_t=yes
bash_cv_decl_strtoimax=yes
bash_cv_decl_strtoumax=yes
bash_cv_struct_winsize_header=ioctl_h
bash_cv_struct_winsize_in_ioctl=yes
bash_cv_pgrp_pipe=no
