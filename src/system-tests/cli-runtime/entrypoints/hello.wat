(module
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "exit" (func $exit (param i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "hello\0a")
  (data (i32.const 16) "error\0a")
  (data (i32.const 32) "ctor\0a")
  (data (i32.const 48) "probe\0a")
  (func $constructor (drop (call $write (i32.const 1) (i32.const 32) (i32.const 5))))
  (start $constructor)
  (func (export "_start")
    (drop (call $write (i32.const 1) (i32.const 0) (i32.const 6)))
    (drop (call $write (i32.const 2) (i32.const 16) (i32.const 6)))
    (call $exit (i32.const 7)))
  (func (export "probe")
    (drop (call $write (i32.const 1) (i32.const 48) (i32.const 6)))))
