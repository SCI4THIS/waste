;; Actual Mach-O UUIDs parsed from 32/64-bit little/big-endian images; owned strings survive a yield.
(module $assignment
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/dylib-uuid.bin\00")
  (data (i32.const 180128) "/tmp/dylib-uuid-status.txt\00")
  (data (i32.const 200000) "00000000-0000-0000-0000-00000000000000000000-0000-0000-0000-00000000000000000000-0000-0000-0000-00000000000000000000-0000-0000-0000-000000000000FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFFFFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFFFFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFFFFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF0001020F-107F-80FF-ABCD-EFFE203040500001020F-107F-80FF-ABCD-EFFE203040500001020F-107F-80FF-ABCD-EFFE203040500001020F-107F-80FF-ABCD-EFFE20304050")
  (func $capture (param $path i32) (param $output i32) (param $capacity i32) (result i32)
    (local $fd i32) (local $length i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $output local.get $capacity call $read local.set $length
    local.get $fd call $close drop local.get $length)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 184000 i32.const 8192 call $capture)
  (func (export "status") (result i32)
    i32.const 180128 i32.const 193000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 193000 i32.load16_u i32.const 0x3633 i32.eq i32.and
    i32.const 193002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i64)
    i32.const 184000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func (export "text") (param $offset i32) (param $length i32) (result i32)
    i32.const 184136 local.get $offset i32.add
    i32.const 200000 local.get $offset i32.add
    local.get $length call $compare i32.eqz)
)
(assert_return (invoke "capture") (i32.const 568))
(assert_return (invoke "status") (i32.const 1))
(assert_return (invoke "value" (i32.const 0)) (i64.const 16))
(assert_return (invoke "value" (i32.const 1)) (i64.const 36))
(assert_return (invoke "text" (i32.const 0) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 2)) (i64.const 36))
(assert_return (invoke "text" (i32.const 36) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 3)) (i64.const 36))
(assert_return (invoke "text" (i32.const 72) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 4)) (i64.const 36))
(assert_return (invoke "text" (i32.const 108) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 5)) (i64.const 36))
(assert_return (invoke "text" (i32.const 144) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 6)) (i64.const 36))
(assert_return (invoke "text" (i32.const 180) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 7)) (i64.const 36))
(assert_return (invoke "text" (i32.const 216) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 8)) (i64.const 36))
(assert_return (invoke "text" (i32.const 252) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 9)) (i64.const 36))
(assert_return (invoke "text" (i32.const 288) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 10)) (i64.const 36))
(assert_return (invoke "text" (i32.const 324) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 11)) (i64.const 36))
(assert_return (invoke "text" (i32.const 360) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 12)) (i64.const 36))
(assert_return (invoke "text" (i32.const 396) (i32.const 36)) (i32.const 1))
(assert_return (invoke "value" (i32.const 13)) (i64.const 0))
(assert_return (invoke "text" (i32.const 432) (i32.const 0)) (i32.const 1))
(assert_return (invoke "value" (i32.const 14)) (i64.const 0))
(assert_return (invoke "text" (i32.const 432) (i32.const 0)) (i32.const 1))
(assert_return (invoke "value" (i32.const 15)) (i64.const 0))
(assert_return (invoke "text" (i32.const 432) (i32.const 0)) (i32.const 1))
(assert_return (invoke "value" (i32.const 16)) (i64.const 0))
(assert_return (invoke "text" (i32.const 432) (i32.const 0)) (i32.const 1))
