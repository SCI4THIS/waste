;; Compiled C/C++ constants and real LLVM APFloat-profile intlogb observations.
;; Twelve metadata i32s followed by (int result, long result, errno) per input.
(module $logb
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/logb.bin\00")
  (data (i32.const 180032) "/tmp/logb-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 1024 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180032 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i32)
    i32.const 182000 local.get $index i32.const 4 i32.mul i32.add i32.load)
)
(assert_return (invoke $logb "capture") (i32.const 516))
(assert_return (invoke $logb "exit-status") (i32.const 1))
;; Public C/C++ integer constants, their types, and LLVM int/long sentinels.
(assert_return (invoke $logb "value" (i32.const 0)) (i32.const -2147483648))
(assert_return (invoke $logb "value" (i32.const 1)) (i32.const 2147483647))
(assert_return (invoke $logb "value" (i32.const 2)) (i32.const 1))
(assert_return (invoke $logb "value" (i32.const 3)) (i32.const 1))
(assert_return (invoke $logb "value" (i32.const 4)) (i32.const -2147483648))
(assert_return (invoke $logb "value" (i32.const 5)) (i32.const 2147483647))
(assert_return (invoke $logb "value" (i32.const 6)) (i32.const 1))
(assert_return (invoke $logb "value" (i32.const 7)) (i32.const 1))
(assert_return (invoke $logb "value" (i32.const 8)) (i32.const -2147483648))
(assert_return (invoke $logb "value" (i32.const 9)) (i32.const 2147483647))
(assert_return (invoke $logb "value" (i32.const 10)) (i32.const -2147483648))
(assert_return (invoke $logb "value" (i32.const 11)) (i32.const 2147483647))
