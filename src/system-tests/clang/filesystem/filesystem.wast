;; Compiled guest stat calls and actual LLVM inline metadata; assertions only.
;; The observer uses 64-bit synthetic sizes to exercise header storage, not
;; to claim the VFS supports files larger than its configured byte limit.
(module $filesystem
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/filesystem.bin\00")
  (data (i32.const 180032) "/tmp/filesystem-status.txt\00")
  (data (i32.const 180064) "\01\00\00\00\01\00\00\00\00\00\00\00\00\00\00\00\01\00\00\00\80\00\00\00\08\00\00\00\04\00\00\00\04\00\00\00\04\00\00\00\08\00\00\00\08\00\00\00\08\00\00\00\7b\00\00\00\c8\01\00\00\80\01\00\00")
  (data (i32.const 180128) "\01\00\00\00\09\00\00\00\00\00\00\00\00\00\00\00\01\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00")
  (data (i32.const 180160) "\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5\a5")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 2048 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180032 i32.const 185000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 185000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "metadata") (result i32)
    i32.const 182000 i32.const 180064 i32.const 64 call $compare i32.eqz)
  (func (export "llvm-value") (param $field i32) (result i64)
    i32.const 182064 local.get $field i32.const 8 i32.mul i32.add i64.load)
  (func (export "operations") (result i32)
    i32.const 182128 i32.const 180128 i32.const 32 call $compare i32.eqz)
  (func $record (param $index i32) (result i32)
    i32.const 182192 local.get $index i32.const 152 i32.mul i32.add)
  (func (export "guards") (param $index i32) (result i32)
    local.get $index call $record i64.load i64.const 0x0123456789abcdef i64.eq
    local.get $index call $record i64.load offset=136 i64.const 0xfedcba9876543210 i64.eq
    i32.and)
  (func (export "result") (param $index i32) (result i32)
    local.get $index call $record i32.load offset=144)
  (func (export "errno") (param $index i32) (result i32)
    local.get $index call $record i32.load offset=148)
  (func (export "stat-i32") (param $index i32) (param $offset i32) (result i32)
    local.get $index call $record local.get $offset i32.add i32.load offset=8)
  (func (export "stat-i64") (param $index i32) (param $offset i32) (result i64)
    local.get $index call $record local.get $offset i32.add i64.load offset=8)
  (func (export "has-inode") (param $index i32) (result i32)
    local.get $index call $record i64.load offset=16 i64.const 0 i64.gt_u)
  (func (export "same-stat") (param $index i32) (result i32)
    i32.const 182200 local.get $index call $record i32.const 8 i32.add
    i32.const 128 call $compare i32.eqz)
  (func (export "untouched-stat") (param $index i32) (result i32)
    i32.const 180160 local.get $index call $record i32.const 8 i32.add
    i32.const 128 call $compare i32.eqz)
  (func (export "mtime-in-range") (param $index i32) (result i32)
    (local $mtime i64)
    local.get $index call $record i64.load offset=88 i64.const 1000000000 i64.mul
    local.get $index call $record i64.load offset=96 i64.add local.set $mtime
    local.get $mtime
    i32.const 182160 i64.load i64.const 1000000000 i64.mul
    i32.const 182168 i64.load i64.add i64.ge_s
    local.get $mtime
    i32.const 182176 i64.load i64.const 1000000000 i64.mul
    i32.const 182184 i64.load i64.add i64.le_s i32.and)
  (func (export "valid-nanoseconds") (param $index i32) (result i32)
    local.get $index call $record i64.load offset=96
    i64.const 1000000000 i64.lt_u)
)
(assert_return (invoke $filesystem "capture") (i32.const 1104))
(assert_return (invoke $filesystem "exit-status") (i32.const 1))
(assert_return (invoke $filesystem "metadata") (i32.const 1))
(assert_return (invoke $filesystem "llvm-value" (i32.const 0)) (i64.const 4294967298))
(assert_return (invoke $filesystem "llvm-value" (i32.const 1)) (i64.const 4294967298))
(assert_return (invoke $filesystem "llvm-value" (i32.const 2)) (i64.const 4294967299))
(assert_return (invoke $filesystem "llvm-value" (i32.const 3)) (i64.const 4294967300))
(assert_return (invoke $filesystem "llvm-value" (i32.const 4)) (i64.const 123456789))
(assert_return (invoke $filesystem "llvm-value" (i32.const 5)) (i64.const 987654321))
(assert_return (invoke $filesystem "llvm-value" (i32.const 6)) (i64.const 0))
(assert_return (invoke $filesystem "llvm-value" (i32.const 7)) (i64.const 1))
(assert_return (invoke $filesystem "operations") (i32.const 1))
;; stat: same real file metadata.
(assert_return (invoke $filesystem "guards" (i32.const 0)) (i32.const 1))
(assert_return (invoke $filesystem "result" (i32.const 0)) (i32.const 0))
(assert_return (invoke $filesystem "errno" (i32.const 0)) (i32.const 17))
(assert_return (invoke $filesystem "stat-i32" (i32.const 0) (i32.const 16)) (i32.const 33152))
(assert_return (invoke $filesystem "stat-i32" (i32.const 0) (i32.const 20)) (i32.const 1))
(assert_return (invoke $filesystem "stat-i64" (i32.const 0) (i32.const 24)) (i64.const 0))
(assert_return (invoke $filesystem "stat-i64" (i32.const 0) (i32.const 40)) (i64.const 9))
(assert_return (invoke $filesystem "mtime-in-range" (i32.const 0)) (i32.const 1))
(assert_return (invoke $filesystem "valid-nanoseconds" (i32.const 0)) (i32.const 1))
(assert_return (invoke $filesystem "has-inode" (i32.const 0)) (i32.const 1))
;; lstat: same real file metadata.
(assert_return (invoke $filesystem "guards" (i32.const 1)) (i32.const 1))
(assert_return (invoke $filesystem "result" (i32.const 1)) (i32.const 0))
(assert_return (invoke $filesystem "errno" (i32.const 1)) (i32.const 17))
(assert_return (invoke $filesystem "stat-i32" (i32.const 1) (i32.const 16)) (i32.const 33152))
(assert_return (invoke $filesystem "stat-i32" (i32.const 1) (i32.const 20)) (i32.const 1))
(assert_return (invoke $filesystem "stat-i64" (i32.const 1) (i32.const 24)) (i64.const 0))
(assert_return (invoke $filesystem "stat-i64" (i32.const 1) (i32.const 40)) (i64.const 9))
(assert_return (invoke $filesystem "mtime-in-range" (i32.const 1)) (i32.const 1))
(assert_return (invoke $filesystem "valid-nanoseconds" (i32.const 1)) (i32.const 1))
(assert_return (invoke $filesystem "has-inode" (i32.const 1)) (i32.const 1))
(assert_return (invoke $filesystem "same-stat" (i32.const 1)) (i32.const 1))
;; fstat: same real file metadata.
(assert_return (invoke $filesystem "guards" (i32.const 2)) (i32.const 1))
(assert_return (invoke $filesystem "result" (i32.const 2)) (i32.const 0))
(assert_return (invoke $filesystem "errno" (i32.const 2)) (i32.const 17))
(assert_return (invoke $filesystem "stat-i32" (i32.const 2) (i32.const 16)) (i32.const 33152))
(assert_return (invoke $filesystem "stat-i32" (i32.const 2) (i32.const 20)) (i32.const 1))
(assert_return (invoke $filesystem "stat-i64" (i32.const 2) (i32.const 24)) (i64.const 0))
(assert_return (invoke $filesystem "stat-i64" (i32.const 2) (i32.const 40)) (i64.const 9))
(assert_return (invoke $filesystem "mtime-in-range" (i32.const 2)) (i32.const 1))
(assert_return (invoke $filesystem "valid-nanoseconds" (i32.const 2)) (i32.const 1))
(assert_return (invoke $filesystem "has-inode" (i32.const 2)) (i32.const 1))
(assert_return (invoke $filesystem "same-stat" (i32.const 2)) (i32.const 1))
;; directory-relative fstatat: same real file metadata.
(assert_return (invoke $filesystem "guards" (i32.const 3)) (i32.const 1))
(assert_return (invoke $filesystem "result" (i32.const 3)) (i32.const 0))
(assert_return (invoke $filesystem "errno" (i32.const 3)) (i32.const 17))
(assert_return (invoke $filesystem "stat-i32" (i32.const 3) (i32.const 16)) (i32.const 33152))
(assert_return (invoke $filesystem "stat-i32" (i32.const 3) (i32.const 20)) (i32.const 1))
(assert_return (invoke $filesystem "stat-i64" (i32.const 3) (i32.const 24)) (i64.const 0))
(assert_return (invoke $filesystem "stat-i64" (i32.const 3) (i32.const 40)) (i64.const 9))
(assert_return (invoke $filesystem "mtime-in-range" (i32.const 3)) (i32.const 1))
(assert_return (invoke $filesystem "valid-nanoseconds" (i32.const 3)) (i32.const 1))
(assert_return (invoke $filesystem "has-inode" (i32.const 3)) (i32.const 1))
(assert_return (invoke $filesystem "same-stat" (i32.const 3)) (i32.const 1))
;; ENOENT preserves all 128 output bytes and both canaries.
(assert_return (invoke $filesystem "guards" (i32.const 4)) (i32.const 1))
(assert_return (invoke $filesystem "result" (i32.const 4)) (i32.const -1))
(assert_return (invoke $filesystem "errno" (i32.const 4)) (i32.const 2))
(assert_return (invoke $filesystem "untouched-stat" (i32.const 4)) (i32.const 1))
;; EBADF preserves all 128 output bytes and both canaries.
(assert_return (invoke $filesystem "guards" (i32.const 5)) (i32.const 1))
(assert_return (invoke $filesystem "result" (i32.const 5)) (i32.const -1))
(assert_return (invoke $filesystem "errno" (i32.const 5)) (i32.const 9))
(assert_return (invoke $filesystem "untouched-stat" (i32.const 5)) (i32.const 1))
