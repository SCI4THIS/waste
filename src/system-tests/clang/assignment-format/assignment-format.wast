;; Actual assignment interval formatting with IR/formatter ownership destroyed.
(module $assignment
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/assignment-format.bin\00")
  (data (i32.const 180128) "/tmp/assignment-format-status.txt\00")
  (data (i32.const 200000) "invalid iterator (end)\0ainvalid iterator (end)[0, 8): None\0a[0, 8): None[4294967294, 4294967295): edge[1000000000, 2000000000): LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL\0a[16, 24): n\00x\0a\7f\0a[32, 64): \0a[4294967294, 4294967295): renamed\0ainvalid iterator (end)\0a")
  (func $capture (param $path i32) (param $output i32) (param $capacity i32) (result i32)
    (local $fd i32) (local $length i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $output local.get $capacity call $read local.set $length
    local.get $fd call $close drop local.get $length)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 184000 i32.const 8192 call $capture)
  (func (export "status") (result i32)
    i32.const 180128 i32.const 193000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 193000 i32.load16_u i32.const 0x3633 i32.eq i32.and
    i32.const 193002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i64)
    i32.const 184000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func (export "text") (param $offset i32) (param $length i32) (result i32)
    i32.const 184088 local.get $offset i32.add
    i32.const 200000 local.get $offset i32.add
    local.get $length call $compare i32.eqz)
)
(assert_return (invoke "capture") (i32.const 459))
(assert_return (invoke "status") (i32.const 1))
(assert_return (invoke "value" (i32.const 0)) (i64.const 10))
(assert_return (invoke "value" (i32.const 1)) (i64.const 23))
(assert_return (invoke "text" (i32.const 0) (i32.const 23)) (i32.const 1))
(assert_return (invoke "value" (i32.const 2)) (i64.const 22))
(assert_return (invoke "text" (i32.const 23) (i32.const 22)) (i32.const 1))
(assert_return (invoke "value" (i32.const 3)) (i64.const 13))
(assert_return (invoke "text" (i32.const 45) (i32.const 13)) (i32.const 1))
(assert_return (invoke "value" (i32.const 4)) (i64.const 12))
(assert_return (invoke "text" (i32.const 58) (i32.const 12)) (i32.const 1))
(assert_return (invoke "value" (i32.const 5)) (i64.const 30))
(assert_return (invoke "text" (i32.const 70) (i32.const 30)) (i32.const 1))
(assert_return (invoke "value" (i32.const 6)) (i64.const 187))
(assert_return (invoke "text" (i32.const 100) (i32.const 187)) (i32.const 1))
(assert_return (invoke "value" (i32.const 7)) (i64.const 16))
(assert_return (invoke "text" (i32.const 287) (i32.const 16)) (i32.const 1))
(assert_return (invoke "value" (i32.const 8)) (i64.const 11))
(assert_return (invoke "text" (i32.const 303) (i32.const 11)) (i32.const 1))
(assert_return (invoke "value" (i32.const 9)) (i64.const 34))
(assert_return (invoke "text" (i32.const 314) (i32.const 34)) (i32.const 1))
(assert_return (invoke "value" (i32.const 10)) (i64.const 23))
(assert_return (invoke "text" (i32.const 348) (i32.const 23)) (i32.const 1))
