;; Actual archive-linked LLVM finite wait observations.
(module $finite
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/finite-wait-controlled.bin\00")
  (data (i32.const 180064) "/tmp/finite-wait-controlled-status.txt\00")
  (func $capture (param $path i32) (param $out i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $out local.get $count call $read local.set $bytes
    local.get $fd call $close drop local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 4096 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180064 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func $value (export "value") (param $index i32) (result i64)
    i32.const 182000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func (export "range") (param $index i32) (param $low i64) (param $high i64) (result i32)
    local.get $index call $value local.get $low i64.ge_u
    local.get $index call $value local.get $high i64.le_u i32.and)
  (func (export "elapsed") (param $index i32) (param $minimum i64) (result i32)
    local.get $index call $value local.get $minimum i64.ge_u
    local.get $index call $value i64.const 30000000000 i64.lt_u i32.and)
)

(assert_return (invoke $finite "capture") (i32.const 1064))
(assert_return (invoke $finite "exit-status") (i32.const 1))

;; signal and held child (words 0..2)
(assert_return (invoke $finite "value" (i32.const 0)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 1)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 2)) (i64.const 1))

;; poll exact expiry (words 3..17)
(assert_return (invoke $finite "value" (i32.const 3)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 4)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 5)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 6)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 7)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 8)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 9)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 10)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 11)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 12)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 13)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 14)) (i64.const 73))
(assert_return (invoke $finite "value" (i32.const 15)) (i64.const 1000000000))
(assert_return (invoke $finite "value" (i32.const 16)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 17)) (i64.const 0))

;; masked alarm remains pending (words 18..38)
(assert_return (invoke $finite "value" (i32.const 18)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 19)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 20)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 21)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 22)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 23)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 24)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 25)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 26)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 27)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 28)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 29)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 30)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 31)) (i64.const 73))
(assert_return (invoke $finite "value" (i32.const 32)) (i64.const 2000000000))
(assert_return (invoke $finite "value" (i32.const 33)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 34)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 35)) (i64.const 1))
(assert_return (invoke $finite "value" (i32.const 36)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 37)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 38)) (i64.const 1))

;; caught alarm retries original deadline restart=0 (words 39..54)
(assert_return (invoke $finite "value" (i32.const 39)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 40)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 41)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 42)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 43)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 44)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 45)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 46)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 47)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 48)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 49)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 50)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 51)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 52)) (i64.const 4))
(assert_return (invoke $finite "value" (i32.const 53)) (i64.const 3000000000))
(assert_return (invoke $finite "value" (i32.const 54)) (i64.const 1))

;; caught alarm retries original deadline restart=1 (words 55..70)
(assert_return (invoke $finite "value" (i32.const 55)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 56)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 57)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 58)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 59)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 60)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 61)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 62)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 63)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 64)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 65)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 66)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 67)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 68)) (i64.const 73))
(assert_return (invoke $finite "value" (i32.const 69)) (i64.const 3000000000))
(assert_return (invoke $finite "value" (i32.const 70)) (i64.const 1))

;; active alarm and handler are preserved (words 71..87)
(assert_return (invoke $finite "value" (i32.const 71)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 72)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 73)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 74)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 75)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 76)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 77)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 78)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 79)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 80)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 81)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 82)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 83)) (i64.const 1000000000))
(assert_return (invoke $finite "value" (i32.const 84)) (i64.const 3))
(assert_return (invoke $finite "value" (i32.const 85)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 86)) (i64.const 1))
(assert_return (invoke $finite "value" (i32.const 87)) (i64.const 268435456))

;; kill exact target and retain ready sibling (words 88..104)
(assert_return (invoke $finite "value" (i32.const 88)) (i64.const 1))
(assert_return (invoke $finite "value" (i32.const 89)) (i64.const -2))
(assert_return (invoke $finite "value" (i32.const 90)) (i64.const 17))
(assert_return (invoke $finite "value" (i32.const 91)) (i64.const 7598734086968535107))
(assert_return (invoke $finite "value" (i32.const 92)) (i64.const 4212120671643526509))
(assert_return (invoke $finite "value" (i32.const 93)) (i64.const 32))
(assert_return (invoke $finite "value" (i32.const 94)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 95)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 96)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 97)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 98)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 99)) (i64.const 1000000000))
(assert_return (invoke $finite "value" (i32.const 100)) (i64.const -1))
(assert_return (invoke $finite "value" (i32.const 101)) (i64.const 3))
(assert_return (invoke $finite "value" (i32.const 102)) (i64.const 1))
(assert_return (invoke $finite "value" (i32.const 103)) (i64.const 7424))
(assert_return (invoke $finite "value" (i32.const 104)) (i64.const 0))

;; ExecuteAndWait early child (words 105..116)
(assert_return (invoke $finite "value" (i32.const 105)) (i64.const 37))
(assert_return (invoke $finite "value" (i32.const 106)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 107)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 108)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 109)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 110)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 111)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 112)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 113)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 114)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 115)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 116)) (i64.const 1000000000))

;; ExecuteAndWait timeout (words 117..128)
(assert_return (invoke $finite "value" (i32.const 117)) (i64.const -2))
(assert_return (invoke $finite "value" (i32.const 118)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 119)) (i64.const 17))
(assert_return (invoke $finite "value" (i32.const 120)) (i64.const 7598734086968535107))
(assert_return (invoke $finite "value" (i32.const 121)) (i64.const 4212120671643526509))
(assert_return (invoke $finite "value" (i32.const 122)) (i64.const 32))
(assert_return (invoke $finite "value" (i32.const 123)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 124)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 125)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 126)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 127)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 128)) (i64.const 1000000000))

;; cleanup before later sleep (words 129..132)
(assert_return (invoke $finite "value" (i32.const 129)) (i64.const 0))
(assert_return (invoke $finite "value" (i32.const 130)) (i64.const 2000000000))
(assert_return (invoke $finite "value" (i32.const 131)) (i64.const -1))
(assert_return (invoke $finite "value" (i32.const 132)) (i64.const 10))
