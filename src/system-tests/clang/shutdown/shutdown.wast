;; Actual compiler C++ ABI, libc cleanup and LLVM cache observations.
(module $shutdown
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "atoi" (func $atoi (param i32) (result i32)))
  (global $bytes (mut i32) (i32.const 0))
  (data (i32.const 180000) "/tmp/shutdown-return.bin\00")
  (data (i32.const 187000) "/tmp/shutdown-return-status.txt\00")
  (data (i32.const 180064) "/tmp/shutdown-exit.bin\00")
  (data (i32.const 187064) "/tmp/shutdown-exit-status.txt\00")
  (data (i32.const 180128) "/tmp/shutdown-immediate.bin\00")
  (data (i32.const 187128) "/tmp/shutdown-immediate-status.txt\00")
  (data (i32.const 180192) "/tmp/shutdown-abort.bin\00")
  (data (i32.const 187192) "/tmp/shutdown-abort-status.txt\00")
  (data (i32.const 180256) "/tmp/shutdown-exec.bin\00")
  (data (i32.const 187256) "/tmp/shutdown-exec-status.txt\00")
  (data (i32.const 180320) "/tmp/shutdown-fork.bin\00")
  (data (i32.const 187320) "/tmp/shutdown-fork-status.txt\00")
  (data (i32.const 180384) "/tmp/shutdown-cache.bin\00")
  (data (i32.const 187384) "/tmp/shutdown-cache-status.txt\00")
  (data (i32.const 180448) "/tmp/shutdown-groups.bin\00")
  (data (i32.const 187448) "/tmp/shutdown-groups-status.txt\00")
  (data (i32.const 180512) "/tmp/shutdown-child.bin\00")
  (data (i32.const 180576) "/tmp/shutdown-exec-fail.bin\00")
  (data (i32.const 187576) "/tmp/shutdown-exec-fail-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop local.get $bytes)
  (func (export "capture") (param $index i32) (result i32)
    i32.const 180000 local.get $index i32.const 64 i32.mul i32.add
    i32.const 182000 i32.const 1024 call $capture)
  (func (export "status") (param $index i32) (result i32)
    i32.const 184000 i32.const 0 i32.store
    i32.const 184004 i32.const 0 i32.store
    i32.const 187000 local.get $index i32.const 64 i32.mul i32.add
    i32.const 184000 i32.const 7 call $capture global.set $bytes
    i32.const 184000 call $atoi)
  (func (export "status-bytes") (result i32) global.get $bytes)
  (func (export "value") (param $index i32) (result i32)
    i32.const 182000 local.get $index i32.const 4 i32.mul i32.add i32.load))

;; return: recorded events, exact byte count and Bash exit status.
(assert_return (invoke $shutdown "capture" (i32.const 0)) (i32.const 100))
(assert_return (invoke $shutdown "status" (i32.const 0)) (i32.const 23))
(assert_return (invoke $shutdown "status-bytes") (i32.const 3))
(assert_return (invoke $shutdown "value" (i32.const 0)) (i32.const 101))
