;; Hard-link provider, inode lifetime, stat versioning and compiled C++ fork observations.
;; Run once in a fresh Bash session; this script creates namespace entries.
(module $hardlinks
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "__errno_location" (func $errno (result i32)))
  (import "libc" "link" (func $link (param i32 i32) (result i32)))
  (import "libc" "linkat" (func $linkat (param i32 i32 i32 i32 i32) (result i32)))
  (import "waste_kernel" "linkat_v1" (func $raw (param i32 i32 i32 i32 i32) (result i32)))
  (import "libc" "symlink" (func $symlink (param i32 i32) (result i32)))
  (import "libc" "stat" (func $stat (param i32 i32) (result i32)))
  (import "libc" "lstat" (func $lstat (param i32 i32) (result i32)))
  (import "libc" "fstatat" (func $statat (param i32 i32 i32 i32) (result i32)))
  (import "waste_kernel" "fstatat_v1" (func $v1 (param i32 i32 i32 i32 i32) (result i32)))
  (import "waste_kernel" "fstatat_v2" (func $v2 (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "fstat" (func $fstat (param i32 i32) (result i32)))
  (import "env" "mkdir" (func $mkdir (param i32 i32) (result i32)))
  (import "env" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (import "env" "dup" (func $dup (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "chmod" (func $chmod (param i32 i32) (result i32)))
  (import "env" "rename" (func $rename (param i32 i32) (result i32)))
  (import "env" "unlink" (func $unlink (param i32) (result i32)))
  (import "libc" "readlink" (func $readlink (param i32 i32 i32) (result i32)))
  (import "waste_kernel" "lseek" (func $seek (param i32 i64 i32) (result i64)))
  (import "waste_kernel" "ftruncate_v1" (func $truncate (param i32 i64) (result i32)))
  (global $fd (mut i32) (i32.const -1))
  (global $directory (mut i32) (i32.const -1))
  (global $alias (mut i32) (i32.const -1))
  (global $duplicate (mut i32) (i32.const -1))
  (global $inode (mut i64) (i64.const 0))
  (data (i32.const 180000) "/tmp/hardlink-test\00")
  (data (i32.const 180128) "/tmp/hardlink-test/sub\00")
  (data (i32.const 180256) "/tmp/hardlink-test/file\00")
  (data (i32.const 180384) "/tmp/hardlink-test/a\00")
  (data (i32.const 180512) "/tmp/hardlink-test/sub/b\00")
  (data (i32.const 180640) "../file\00")
  (data (i32.const 180768) "b\00")
  (data (i32.const 180896) "/tmp/hardlink-test/soft\00")
  (data (i32.const 181024) "/tmp/hardlink-test/soft-copy\00")
  (data (i32.const 181152) "file\00")
  (data (i32.const 181280) "/tmp/hardlink-test/dangling\00")
  (data (i32.const 181408) "absent\00")
  (data (i32.const 181536) "/tmp/hardlink-test/dangling-copy\00")
  (data (i32.const 181664) "/tmp/hardlink-test/follow\00")
  (data (i32.const 181792) "/tmp/hardlink-test/absent\00")
  (data (i32.const 181920) "/tmp/hardlink-test/new\00")
  (data (i32.const 182048) "/tmp/hardlink-test/renamed\00")
  (data (i32.const 182176) "/tmp/hardlink-test/missing/new\00")
  (data (i32.const 182304) "/tmp/hardlink-test/file/new\00")
  (data (i32.const 182432) "/tmp/hardlink-test/slash/\00")
  (data (i32.const 182560) "/tmp/hardlink-test/file/\00")
  (data (i32.const 182688) "\00")
  (data (i32.const 182816) "/tmp/hardlink-test/dirlink\00")
  (data (i32.const 182944) "sub\00")
  (data (i32.const 183072) "/tmp/hardlink-test/dirlink/indirect\00")
  (data (i32.const 183200) "/tmp/hardlink-test/loop\00")
  (data (i32.const 183328) "loop\00")
  (data (i32.const 183456) "/tmp/hardlink.bin\00")
  (data (i32.const 183584) "/tmp/hardlink-status.txt\00")
  (data (i32.const 183712) "/tmp/hardlink-child.bin\00")
  (data (i32.const 183840) "/tmp/hardlink-cxx/file\00")
  (data (i32.const 183968) "/tmp/hardlink-cxx/child-alias\00")
  (data (i32.const 184096) "/tmp/hardlink-cxx/soft-copy\00")
  (data (i32.const 189000) "ABCDwxyz")
  (func $reset (i32.store (call $errno) (i32.const 73)))
  (func (export "errno") (result i32) (i32.load (call $errno)))
  (func (export "link") (param i32 i32) (result i32)
    (call $reset) (call $link (local.get 0) (local.get 1)))
  (func (export "at") (param i32 i32 i32 i32 i32) (result i32)
    (call $reset) (call $linkat (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4)))
  (func (export "raw") (param i32 i32 i32 i32 i32) (result i32)
    (call $reset) (call $raw (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4)))
  (func (export "mkdir") (param i32) (result i32) (call $mkdir (local.get 0) (i32.const 448)))
  (func (export "symlink") (param i32 i32) (result i32) (call $symlink (local.get 0) (local.get 1)))
  (func (export "open") (param i32 i32) (result i32)
    (global.set $fd (call $open (local.get 0) (local.get 1) (i32.const 420)))
    (if (result i32) (i32.ge_s (global.get $fd) (i32.const 0)) (then (i32.const 0)) (else (global.get $fd))))
  (func (export "directory") (param i32) (result i32)
    (global.set $directory (call $open (local.get 0) (i32.const 65536) (i32.const 0)))
    (if (result i32) (i32.ge_s (global.get $directory) (i32.const 0)) (then (i32.const 0)) (else (global.get $directory))))
  (func (export "at-from-directory") (param i32 i32) (result i32)
    (call $reset) (call $linkat (global.get $directory) (local.get 0) (i32.const -100) (local.get 1) (i32.const 0)))
  (func (export "at-to-directory") (param i32 i32) (result i32)
    (call $reset) (call $linkat (i32.const -100) (local.get 0) (global.get $directory) (local.get 1) (i32.const 0)))
  (func (export "at-from-file") (param i32 i32) (result i32)
    (call $reset) (call $linkat (global.get $fd) (local.get 0) (i32.const -100) (local.get 1) (i32.const 0)))
  (func $last-byte (result i32)
    (i32.sub (i32.mul (memory.size) (i32.const 65536)) (i32.const 1)))
  (func (export "unterminated") (param i32) (result i32)
    (i32.store8 (call $last-byte) (i32.const 120))
    (call $reset) (call $link (local.get 0) (call $last-byte)))
  (func (export "directory-fd") (result i32) (global.get $directory))
  (func (export "fd") (result i32) (global.get $fd))
  (func (export "alias-open") (param i32 i32) (result i32)
    (global.set $alias (call $open (local.get 0) (local.get 1) (i32.const 0)))
    (if (result i32) (i32.ge_s (global.get $alias) (i32.const 0)) (then (i32.const 0)) (else (global.get $alias))))
  (func (export "alias-close") (result i32) (call $close (global.get $alias)))
  (func (export "dup") (result i32)
    (global.set $duplicate (call $dup (global.get $fd)))
    (if (result i32) (i32.ge_s (global.get $duplicate) (i32.const 0)) (then (i32.const 0)) (else (global.get $duplicate))))
  (func (export "close-dup") (result i32) (call $close (global.get $duplicate)))
  (func (export "write") (param i32 i32) (result i32)
    (call $write (global.get $fd) (local.get 0) (local.get 1)))
  (func (export "alias-write") (param i32 i32) (result i32)
    (call $write (global.get $alias) (local.get 0) (local.get 1)))
  (func (export "read-fd") (result i32)
    (drop (call $seek (global.get $fd) (i64.const 0) (i32.const 0)))
    (call $read (global.get $fd) (i32.const 190000) (i32.const 4)))
  (func (export "read-file") (param i32 i32 i32) (result i32) (local $input i32) (local $result i32)
    (local.set $input (call $open (local.get 0) (i32.const 0) (i32.const 0)))
    (local.set $result (call $read (local.get $input) (local.get 1) (local.get 2)))
    (drop (call $close (local.get $input))) (local.get $result))
  (func (export "stat") (param i32) (result i32)
    (call $stat (local.get 0) (i32.const 192000)))
  (func (export "lstat") (param i32) (result i32)
    (call $lstat (local.get 0) (i32.const 192000)))
  (func (export "statat") (param i32 i32 i32) (result i32)
    (call $statat (local.get 0) (local.get 1) (i32.const 192000) (local.get 2)))
  (func (export "fstat") (result i32) (call $fstat (global.get $fd) (i32.const 192000)))
  (func (export "chmod") (param i32 i32) (result i32) (call $chmod (local.get 0) (local.get 1)))
  (func (export "unlink") (param i32) (result i32) (call $unlink (local.get 0)))
  (func (export "rename") (param i32 i32) (result i32) (call $rename (local.get 0) (local.get 1)))
  (func (export "readlink") (param i32) (result i32) (call $readlink (local.get 0) (i32.const 190000) (i32.const 16)))
  (func (export "truncate") (param i64) (result i32) (call $truncate (global.get $fd) (local.get 0)))
  (func (export "close") (result i32) (call $close (global.get $fd)))
  (func (export "close-directory") (result i32) (call $close (global.get $directory)))
  (func (export "peek") (param i32) (result i32) (i32.load (local.get 0)))
  (func (export "peek64") (param i32) (result i64) (i64.load (local.get 0)))
  (func (export "poke") (param i32 i32) (i32.store (local.get 0) (local.get 1)))
  (func (export "fill") (param i32 i32 i32) (memory.fill (local.get 0) (local.get 1) (local.get 2)))
  (func (export "last-byte") (result i32)
    (i32.sub (i32.mul (memory.size) (i32.const 65536)) (i32.const 1)))
  (func (export "save-inode") (global.set $inode (i64.load (i32.const 192008))))
  (func (export "same-inode") (result i32) (i64.eq (global.get $inode) (i64.load (i32.const 192008))))
  (func (export "child-inode-distinct") (result i32)
    (i32.ne (i32.load (i32.const 194128)) (i32.load (i32.const 195012))))
  (export "v1" (func $v1))
  (export "v2" (func $v2))
)

;; Regular names share an inode, content and attributes; fd aliases are not names.
(assert_return (invoke $hardlinks "mkdir" (i32.const 180000)) (i32.const 0))
(assert_return (invoke $hardlinks "mkdir" (i32.const 180128)) (i32.const 0))
(assert_return (invoke $hardlinks "open" (i32.const 180256) (i32.const 66)) (i32.const 0))
(assert_return (invoke $hardlinks "write" (i32.const 189000) (i32.const 4)) (i32.const 4))
(assert_return (invoke $hardlinks "link" (i32.const 180256) (i32.const 180384)) (i32.const 0))
(assert_return (invoke $hardlinks "errno") (i32.const 73))
(assert_return (invoke $hardlinks "directory" (i32.const 180128)) (i32.const 0))
(assert_return (invoke $hardlinks "at-to-directory" (i32.const 180256) (i32.const 180768)) (i32.const 0))
(assert_return (invoke $hardlinks "errno") (i32.const 73))
(assert_return (invoke $hardlinks "stat" (i32.const 180256)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 4))
(assert_return (invoke $hardlinks "peek" (i32.const 192016)) (i32.const 33188))
(invoke $hardlinks "save-inode")
(assert_return (invoke $hardlinks "stat" (i32.const 180384)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 4))
(assert_return (invoke $hardlinks "same-inode") (i32.const 1))
(assert_return (invoke $hardlinks "stat" (i32.const 180512)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 4))
(assert_return (invoke $hardlinks "same-inode") (i32.const 1))
(assert_return (invoke $hardlinks "dup") (i32.const 0))
(assert_return (invoke $hardlinks "fstat") (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "close-dup") (i32.const 0))
(assert_return (invoke $hardlinks "chmod" (i32.const 180384) (i32.const 384)) (i32.const 0))
(assert_return (invoke $hardlinks "stat" (i32.const 180512)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 4))
(assert_return (invoke $hardlinks "peek" (i32.const 192016)) (i32.const 33152))
(assert_return (invoke $hardlinks "fstat") (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192016)) (i32.const 33152))
(assert_return (invoke $hardlinks "alias-open" (i32.const 180512) (i32.const 1)) (i32.const 0))
(assert_return (invoke $hardlinks "alias-write" (i32.const 189004) (i32.const 4)) (i32.const 4))
(assert_return (invoke $hardlinks "alias-close") (i32.const 0))
(assert_return (invoke $hardlinks "read-fd") (i32.const 4))
(assert_return (invoke $hardlinks "peek" (i32.const 190000)) (i32.const 2054781047))

;; ABI v1 writes only 48 bytes; v2 writes the stable 128-byte stat and leaves failures untouched.
(invoke $hardlinks "fill" (i32.const 193000) (i32.const 90) (i32.const 132))
(assert_return (invoke $hardlinks "v1" (i32.const -100) (i32.const 180256) (i32.const 23) (i32.const 0) (i32.const 193000)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 193048)) (i32.const 1515870810))
(assert_return (invoke $hardlinks "peek" (i32.const 193000)) (i32.const 1))
(assert_return (invoke $hardlinks "peek64" (i32.const 193016)) (i64.const 4))
(assert_return (invoke $hardlinks "v2" (i32.const -100) (i32.const 180256) (i32.const 23) (i32.const 0) (i32.const 193000)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 193020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek" (i32.const 193128)) (i32.const 1515870810))
(assert_return (invoke $hardlinks "peek64" (i32.const 193112)) (i64.const 0))
(invoke $hardlinks "fill" (i32.const 193000) (i32.const 90) (i32.const 128))
(assert_return (invoke $hardlinks "v2" (i32.const -100) (i32.const 181792) (i32.const 25) (i32.const 0) (i32.const 193000)) (i32.const -2))
(assert_return (invoke $hardlinks "peek" (i32.const 193000)) (i32.const 1515870810))
(assert_return (invoke $hardlinks "v2" (i32.const -100) (i32.const 180256) (i32.const 23) (i32.const 0) (i32.const 2147483647)) (i32.const -14))
(assert_return (invoke $hardlinks "v2" (i32.const -100) (i32.const 2147483647) (i32.const 4) (i32.const 0) (i32.const 193000)) (i32.const -14))
(assert_return (invoke $hardlinks "peek" (i32.const 193000)) (i32.const 1515870810))
(assert_return (invoke $hardlinks "v2" (i32.const -100) (i32.const 180256) (i32.const 23) (i32.const 256) (i32.const 193000)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 193020)) (i32.const 3))

;; Truncation and rename to the same inode retain all aliases.
(assert_return (invoke $hardlinks "truncate" (i64.const 2)) (i32.const 0))
(assert_return (invoke $hardlinks "stat" (i32.const 180384)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 2))
(assert_return (invoke $hardlinks "alias-open" (i32.const 180384) (i32.const 513)) (i32.const 0))
(assert_return (invoke $hardlinks "alias-close") (i32.const 0))
(assert_return (invoke $hardlinks "stat" (i32.const 180256)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 0))
(assert_return (invoke $hardlinks "write" (i32.const 189000) (i32.const 4)) (i32.const 4))
(assert_return (invoke $hardlinks "stat" (i32.const 180256)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 8))
(assert_return (invoke $hardlinks "rename" (i32.const 180256) (i32.const 180384)) (i32.const 0))
(assert_return (invoke $hardlinks "stat" (i32.const 180256)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 8))
(assert_return (invoke $hardlinks "stat" (i32.const 180384)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 8))
(assert_return (invoke $hardlinks "rename" (i32.const 180384) (i32.const 182048)) (i32.const 0))
(assert_return (invoke $hardlinks "stat" (i32.const 182048)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 3))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 8))
(assert_return (invoke $hardlinks "same-inode") (i32.const 1))

;; An open unlinked inode preserves metadata and reads until its last fd closes.
(assert_return (invoke $hardlinks "unlink" (i32.const 180256)) (i32.const 0))
(assert_return (invoke $hardlinks "fstat") (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 2))
(assert_return (invoke $hardlinks "peek" (i32.const 192016)) (i32.const 33152))
(assert_return (invoke $hardlinks "unlink" (i32.const 180512)) (i32.const 0))
(assert_return (invoke $hardlinks "fstat") (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 1))
(assert_return (invoke $hardlinks "unlink" (i32.const 182048)) (i32.const 0))
(assert_return (invoke $hardlinks "fstat") (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192016)) (i32.const 33152))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 8))
(assert_return (invoke $hardlinks "alias-open" (i32.const 181920) (i32.const 66)) (i32.const 0))
(assert_return (invoke $hardlinks "alias-close") (i32.const 0))
(assert_return (invoke $hardlinks "stat" (i32.const 181920)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 1))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 0))
(assert_return (invoke $hardlinks "same-inode") (i32.const 0))
(assert_return (invoke $hardlinks "close") (i32.const 0))

;; No-follow links duplicate symlink inodes; FOLLOW links the final referent.
(assert_return (invoke $hardlinks "symlink" (i32.const 181152) (i32.const 180896)) (i32.const 0))
(assert_return (invoke $hardlinks "link" (i32.const 180896) (i32.const 181024)) (i32.const 0))
(assert_return (invoke $hardlinks "errno") (i32.const 73))
(assert_return (invoke $hardlinks "lstat" (i32.const 180896)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 2))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 4))
(assert_return (invoke $hardlinks "peek" (i32.const 192016)) (i32.const 41471))
(invoke $hardlinks "save-inode")
(assert_return (invoke $hardlinks "lstat" (i32.const 181024)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 2))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 4))
(assert_return (invoke $hardlinks "peek" (i32.const 192016)) (i32.const 41471))
(assert_return (invoke $hardlinks "same-inode") (i32.const 1))
(assert_return (invoke $hardlinks "readlink" (i32.const 181024)) (i32.const 4))
(assert_return (invoke $hardlinks "peek" (i32.const 190000)) (i32.const 1701603686))
(assert_return (invoke $hardlinks "at" (i32.const -100) (i32.const 180896) (i32.const -100) (i32.const 181664) (i32.const 1024)) (i32.const -1))
(assert_return (invoke $hardlinks "errno") (i32.const 2))
(assert_return (invoke $hardlinks "lstat" (i32.const 181664)) (i32.const -1))
(assert_return (invoke $hardlinks "open" (i32.const 180256) (i32.const 66)) (i32.const 0))
(assert_return (invoke $hardlinks "write" (i32.const 189000) (i32.const 4)) (i32.const 4))
(assert_return (invoke $hardlinks "at" (i32.const -999) (i32.const 180896) (i32.const -999) (i32.const 181664) (i32.const 1024)) (i32.const 0))
(assert_return (invoke $hardlinks "errno") (i32.const 73))
(assert_return (invoke $hardlinks "stat" (i32.const 180256)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 2))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 4))
(assert_return (invoke $hardlinks "peek" (i32.const 192016)) (i32.const 33188))
(invoke $hardlinks "save-inode")
(assert_return (invoke $hardlinks "stat" (i32.const 181664)) (i32.const 0))
(assert_return (invoke $hardlinks "peek" (i32.const 192020)) (i32.const 2))
(assert_return (invoke $hardlinks "peek64" (i32.const 192040)) (i64.const 4))
