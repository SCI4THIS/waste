;; Actual LLVM managed registry, real C++ archives and shared guest allocation.
(module $managed-static
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/managed-static.bin\00")
  (data (i32.const 180064) "/tmp/managed-static-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 1024 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180064 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i32)
    i32.const 182000 local.get $index i32.const 4 i32.mul i32.add i32.load)
)
(assert_return (invoke $managed-static "capture") (i32.const 356))
(assert_return (invoke $managed-static "exit-status") (i32.const 1))
;; Explicit guest profile and trivial handle destruction.
(assert_return (invoke $managed-static "value" (i32.const 0)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 1)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 2)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 3)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 4)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 5)) (i32.const 1))
;; Repeated empty shutdown and unconstructed handles.
(assert_return (invoke $managed-static "value" (i32.const 6)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 7)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 8)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 9)) (i32.const 0))
;; Nested lazy registration constructs the dependency first.
(assert_return (invoke $managed-static "value" (i32.const 10)) (i32.const 41))
(assert_return (invoke $managed-static "value" (i32.const 11)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 12)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 13)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 14)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 15)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 16)) (i32.const 2))
(assert_return (invoke $managed-static "value" (i32.const 17)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 18)) (i32.const 2))
;; Const/mutable accesses reuse the same objects.
(assert_return (invoke $managed-static "value" (i32.const 19)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 20)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 21)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 22)) (i32.const 1))
;; Explicit last-registration destruction and recreation.
(assert_return (invoke $managed-static "value" (i32.const 23)) (i32.const 73))
(assert_return (invoke $managed-static "value" (i32.const 24)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 25)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 26)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 27)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 28)) (i32.const 73))
(assert_return (invoke $managed-static "value" (i32.const 29)) (i32.const 2))
(assert_return (invoke $managed-static "value" (i32.const 30)) (i32.const 5))
;; Shutdown destroys leaf then owner then dependency; repeated shutdown is inert.
(assert_return (invoke $managed-static "value" (i32.const 31)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 32)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 33)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 34)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 35)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 36)) (i32.const 2))
(assert_return (invoke $managed-static "value" (i32.const 37)) (i32.const 42))
(assert_return (invoke $managed-static "value" (i32.const 38)) (i32.const 8))
(assert_return (invoke $managed-static "value" (i32.const 39)) (i32.const 5))
(assert_return (invoke $managed-static "value" (i32.const 40)) (i32.const 6))
(assert_return (invoke $managed-static "value" (i32.const 41)) (i32.const 5))
(assert_return (invoke $managed-static "value" (i32.const 42)) (i32.const 6))
(assert_return (invoke $managed-static "value" (i32.const 43)) (i32.const 4))
(assert_return (invoke $managed-static "value" (i32.const 44)) (i32.const 3))
(assert_return (invoke $managed-static "value" (i32.const 45)) (i32.const 8))
;; Reinitialization and scoped shutdown preserve dependency lifetime.
(assert_return (invoke $managed-static "value" (i32.const 46)) (i32.const 41))
(assert_return (invoke $managed-static "value" (i32.const 47)) (i32.const 2))
(assert_return (invoke $managed-static "value" (i32.const 48)) (i32.const 2))
(assert_return (invoke $managed-static "value" (i32.const 49)) (i32.const 2))
(assert_return (invoke $managed-static "value" (i32.const 50)) (i32.const 2))
(assert_return (invoke $managed-static "value" (i32.const 51)) (i32.const 42))
(assert_return (invoke $managed-static "value" (i32.const 52)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 53)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 54)) (i32.const 12))
(assert_return (invoke $managed-static "value" (i32.const 55)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 56)) (i32.const 2))
(assert_return (invoke $managed-static "value" (i32.const 57)) (i32.const 4))
(assert_return (invoke $managed-static "value" (i32.const 58)) (i32.const 3))
;; Custom allocator/deleter and real array element destruction.
(assert_return (invoke $managed-static "value" (i32.const 59)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 60)) (i32.const 97))
(assert_return (invoke $managed-static "value" (i32.const 61)) (i32.const 97))
(assert_return (invoke $managed-static "value" (i32.const 62)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 63)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 64)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 65)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 66)) (i32.const 2))
(assert_return (invoke $managed-static "value" (i32.const 67)) (i32.const 3))
(assert_return (invoke $managed-static "value" (i32.const 68)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 69)) (i32.const 3))
(assert_return (invoke $managed-static "value" (i32.const 70)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 71)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 72)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 73)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 74)) (i32.const 3))
(assert_return (invoke $managed-static "value" (i32.const 75)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 76)) (i32.const 1))
;; Claimed object is deleted by its new owner exactly once; handle is reusable after shutdown.
(assert_return (invoke $managed-static "value" (i32.const 77)) (i32.const 3))
(assert_return (invoke $managed-static "value" (i32.const 78)) (i32.const 1))
(assert_return (invoke $managed-static "value" (i32.const 79)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 80)) (i32.const 73))
(assert_return (invoke $managed-static "value" (i32.const 81)) (i32.const 2))
(assert_return (invoke $managed-static "value" (i32.const 82)) (i32.const 3))
(assert_return (invoke $managed-static "value" (i32.const 83)) (i32.const 3))
(assert_return (invoke $managed-static "value" (i32.const 84)) (i32.const 0))
(assert_return (invoke $managed-static "value" (i32.const 85)) (i32.const 73))
(assert_return (invoke $managed-static "value" (i32.const 86)) (i32.const 4))
(assert_return (invoke $managed-static "value" (i32.const 87)) (i32.const 4))
(assert_return (invoke $managed-static "value" (i32.const 88)) (i32.const 0))
