;; Actual LLVM TimeProfiler entry storage; public lifecycle is in lifecycle.wast.
(module $time-profiler
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/time-profiler.bin\00")
  (data (i32.const 180064) "/tmp/time-profiler-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 1024 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180064 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i32)
    i32.const 182000 local.get $index i32.const 4 i32.mul i32.add i32.load)
)
(assert_return (invoke $time-profiler "capture") (i32.const 288))
(assert_return (invoke $time-profiler "exit-status") (i32.const 1))
;; Explicit guest profile, actual registry field type and entry ownership.
(assert_return (invoke $time-profiler "value" (i32.const 0)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 1)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 2)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 3)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 4)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 5)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 6)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 7)) (i32.const 0))
;; Scoped local registry field uses its real recursive counter.
(assert_return (invoke $time-profiler "value" (i32.const 8)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 9)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 10)) (i32.const 0))
;; Flame-graph point conversion at fractional, negative and full-width timestamps.
(assert_return (invoke $time-profiler "value" (i32.const 11)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 12)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 13)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 14)) (i32.const -1))
(assert_return (invoke $time-profiler "value" (i32.const 15)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 16)) (i32.const -1))
(assert_return (invoke $time-profiler "value" (i32.const 17)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 18)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 19)) (i32.const 2))
(assert_return (invoke $time-profiler "value" (i32.const 20)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 21)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 22)) (i32.const 1))
;; Heap-backed names/details retain ownership after input mutation.
(assert_return (invoke $time-profiler "value" (i32.const 23)) (i32.const 160))
(assert_return (invoke $time-profiler "value" (i32.const 24)) (i32.const 78))
(assert_return (invoke $time-profiler "value" (i32.const 25)) (i32.const 78))
(assert_return (invoke $time-profiler "value" (i32.const 26)) (i32.const 192))
(assert_return (invoke $time-profiler "value" (i32.const 27)) (i32.const 68))
(assert_return (invoke $time-profiler "value" (i32.const 28)) (i32.const 68))
(assert_return (invoke $time-profiler "value" (i32.const 29)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 30)) (i32.const 9))
(assert_return (invoke $time-profiler "value" (i32.const 31)) (i32.const 2))
;; Independent copies, metadata mutation and moved heap storage.
(assert_return (invoke $time-profiler "value" (i32.const 32)) (i32.const 68))
(assert_return (invoke $time-profiler "value" (i32.const 33)) (i32.const 67))
(assert_return (invoke $time-profiler "value" (i32.const 34)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 35)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 36)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 37)) (i32.const 160))
(assert_return (invoke $time-profiler "value" (i32.const 38)) (i32.const 192))
(assert_return (invoke $time-profiler "value" (i32.const 39)) (i32.const 67))
(assert_return (invoke $time-profiler "value" (i32.const 40)) (i32.const 68))
;; Metadata file/line/detail ownership and exact emptiness rule.
(assert_return (invoke $time-profiler "value" (i32.const 41)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 42)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 43)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 44)) (i32.const 7))
(assert_return (invoke $time-profiler "value" (i32.const 45)) (i32.const 12))
(assert_return (invoke $time-profiler "value" (i32.const 46)) (i32.const 47))
(assert_return (invoke $time-profiler "value" (i32.const 47)) (i32.const 99))
(assert_return (invoke $time-profiler "value" (i32.const 48)) (i32.const 8))
(assert_return (invoke $time-profiler "value" (i32.const 49)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 50)) (i32.const 109))
(assert_return (invoke $time-profiler "value" (i32.const 51)) (i32.const 88))
(assert_return (invoke $time-profiler "value" (i32.const 52)) (i32.const 47))
(assert_return (invoke $time-profiler "value" (i32.const 53)) (i32.const 89))
;; Instant-event vector growth, snapshots after owner destruction and moved storage.
(assert_return (invoke $time-profiler "value" (i32.const 54)) (i32.const 6))
(assert_return (invoke $time-profiler "value" (i32.const 55)) (i32.const 13))
(assert_return (invoke $time-profiler "value" (i32.const 56)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 57)) (i32.const 257))
(assert_return (invoke $time-profiler "value" (i32.const 58)) (i32.const 97))
(assert_return (invoke $time-profiler "value" (i32.const 59)) (i32.const 90))
(assert_return (invoke $time-profiler "value" (i32.const 60)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 61)) (i32.const 0))
(assert_return (invoke $time-profiler "value" (i32.const 62)) (i32.const 257))
(assert_return (invoke $time-profiler "value" (i32.const 63)) (i32.const 7))
(assert_return (invoke $time-profiler "value" (i32.const 64)) (i32.const 64))
(assert_return (invoke $time-profiler "value" (i32.const 65)) (i32.const 97))
(assert_return (invoke $time-profiler "value" (i32.const 66)) (i32.const 119))
(assert_return (invoke $time-profiler "value" (i32.const 67)) (i32.const 256))
(assert_return (invoke $time-profiler "value" (i32.const 68)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 69)) (i32.const 1))
(assert_return (invoke $time-profiler "value" (i32.const 70)) (i32.const 257))
(assert_return (invoke $time-profiler "value" (i32.const 71)) (i32.const 121))
