 (data (i32.const 180100) "/tmp/locks.bin\00")
 (data (i32.const 180200) "/tmp/locks-status.txt\00")
 (data (i32.const 180300) "/tmp\00")
 (func (export "open") (param $flags i32) (result i32)
  (global.set $fd (call $open (i32.const 180000) (local.get $flags) (i32.const 384)))
  (i32.ge_s (global.get $fd) (i32.const 0)))
 (func (export "close") (result i32) (call $close (global.get $fd)))
 (func (export "errno") (result i32) (i32.load (call $errno)))
 (func $call (param $fd i32) (param $command i32) (param $pointer i32) (param $adapter i32) (result i32)
  (i32.store (i32.const 190100) (local.get $pointer))
  (if (result i32) (i32.eqz (local.get $adapter))
   (then (call $raw (local.get $fd) (local.get $command) (local.get $pointer)))
   (else (if (result i32) (i32.eq (local.get $adapter) (i32.const 1))
    (then (call $libc (local.get $fd) (local.get $command) (i32.const 190100)))
    (else (if (result i32) (i32.eq (local.get $adapter) (i32.const 2))
     (then (call $legacy (local.get $fd) (local.get $command) (local.get $pointer)))
     (else (call $varargs (local.get $fd) (local.get $command) (i32.const 190100)))))))))
 (func (export "run") (param $command i32) (param $type i32) (param $whence i32)
  (param $start i32) (param $length i32) (param $adapter i32) (result i32)
  (i32.store (call $errno) (i32.const 73))
  (i32.store16 (i32.const 190000) (local.get $type))
  (i32.store16 (i32.const 190002) (local.get $whence))
  (i32.store (i32.const 190004) (local.get $start))
  (i32.store (i32.const 190008) (local.get $length))
  (i32.store (i32.const 190012) (i32.const 77))
  (call $call (global.get $fd) (local.get $command) (i32.const 190000) (local.get $adapter)))
 (func (export "field") (param $offset i32) (result i32)
  (i32.load (i32.add (i32.const 190000) (local.get $offset))))
 (func (export "fault") (param $pointer i32) (param $adapter i32) (result i32)
  (i32.store (call $errno) (i32.const 73))
  (call $call (global.get $fd) (i32.const 5) (local.get $pointer) (local.get $adapter)))
 (func (export "slot-fault") (param $pointer i32) (result i32)
  (i32.store (call $errno) (i32.const 73))
  (call $varargs (global.get $fd) (i32.const 7) (local.get $pointer)))
 (func (export "invalid-fd") (result i32)
  (i32.store (call $errno) (i32.const 73))
  (call $raw (i32.const -1) (i32.const 5) (i32.const 190000)))
 (func (export "directory") (result i32)
  (local $directory i32) (local $result i32)
  (local.set $directory (call $open (i32.const 180300) (i32.const 0) (i32.const 0)))
  (local.set $result (call $raw (local.get $directory) (i32.const 6) (i32.const 190000)))
  (drop (call $close (local.get $directory))) (local.get $result))
 (func (export "load-observations") (result i32)
  (local $input i32) (local $size i32)
  (local.set $input (call $open (i32.const 180100) (i32.const 0) (i32.const 0)))
  (local.set $size (call $read (local.get $input) (i32.const 200000) (i32.const 2048)))
  (drop (call $close (local.get $input)))
  (local.set $input (call $open (i32.const 180200) (i32.const 0) (i32.const 0)))
  (drop (call $read (local.get $input) (i32.const 203000) (i32.const 16)))
  (drop (call $close (local.get $input))) (local.get $size))
 (func (export "status") (result i32) (i32.load8_u (i32.const 203000)))
 (func $value (export "value") (param $row i32) (param $column i32) (result i32)
  (i32.load (i32.add (i32.const 200000)
   (i32.mul (i32.add (i32.mul (local.get $row) (i32.const 16)) (local.get $column)) (i32.const 4)))))
 (func (export "pid") (param $row i32) (param $column i32) (param $owner i32) (param $owner-column i32) (result i32)
  (i32.eq (call $value (local.get $row) (local.get $column))
    (call $value (local.get $owner) (local.get $owner-column)))))
