;; Record-lock ABI, errors, ranges and actual compiled LLVM/process observations.
(module $locks
 (import "waste-runtime" "memory" (memory 4))
 (import "waste_kernel" "fcntl_v1" (func $raw (param i32 i32 i32) (result i32)))
 (import "waste_kernel" "fcntl_varargs_v1" (func $varargs (param i32 i32 i32) (result i32)))
 (import "libc" "fcntl" (func $libc (param i32 i32 i32) (result i32)))
 (import "env" "fcntl" (func $legacy (param i32 i32 i32) (result i32)))
