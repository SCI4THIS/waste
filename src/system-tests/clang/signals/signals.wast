;; Actual LLVM ordinary signal observations; WAST owns all runtime expectations.
(module $signals
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/signals.bin\00")
  (data (i32.const 180064) "/tmp/signals-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 4096 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180064 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i64)
    i32.const 182000 local.get $index i32.const 8 i32.mul i32.add i64.load)
)

(assert_return (invoke $signals "capture") (i32.const 888))
(assert_return (invoke $signals "exit-status") (i32.const 1))

;; Guest profile, original action, public signal registration and persistent callbacks
(assert_return (invoke $signals "value" (i32.const 0)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 1)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 2)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 3)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 4)) (i64.const 73))
(assert_return (invoke $signals "value" (i32.const 5)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 6)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 7)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 8)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 9)) (i64.const 10))
(assert_return (invoke $signals "value" (i32.const 10)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 11)) (i64.const 20))
(assert_return (invoke $signals "value" (i32.const 12)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 13)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 14)) (i64.const 20))
(assert_return (invoke $signals "value" (i32.const 15)) (i64.const 1))

;; Invalid public signal registrations preserve the installed action
(assert_return (invoke $signals "value" (i32.const 16)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 17)) (i64.const 22))
(assert_return (invoke $signals "value" (i32.const 18)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 19)) (i64.const 22))
(assert_return (invoke $signals "value" (i32.const 20)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 21)) (i64.const 22))
(assert_return (invoke $signals "value" (i32.const 22)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 23)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 24)) (i64.const 1))

;; Unsupported flags reject before output/state mutation; action masks preserved
(assert_return (invoke $signals "value" (i32.const 25)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 26)) (i64.const -1))
(assert_return (invoke $signals "value" (i32.const 27)) (i64.const 22))
(assert_return (invoke $signals "value" (i32.const 28)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 29)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 30)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 31)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 32)) (i64.const 1))

;; Invalid input/output ranges preserve action; aliased input decoded before writes
(assert_return (invoke $signals "value" (i32.const 33)) (i64.const -1))
(assert_return (invoke $signals "value" (i32.const 34)) (i64.const 14))
(assert_return (invoke $signals "value" (i32.const 35)) (i64.const -1))
(assert_return (invoke $signals "value" (i32.const 36)) (i64.const 14))
(assert_return (invoke $signals "value" (i32.const 37)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 38)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 39)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 40)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 41)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 42)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 43)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 44)) (i64.const 0))

;; Actual persistent LLVM info callbacks preserve errno and restore aliased SIGINFO registration
(assert_return (invoke $signals "value" (i32.const 45)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 46)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 47)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 48)) (i64.const 73))
(assert_return (invoke $signals "value" (i32.const 49)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 50)) (i64.const 2))
(assert_return (invoke $signals "value" (i32.const 51)) (i64.const 73))
(assert_return (invoke $signals "value" (i32.const 52)) (i64.const 3))
(assert_return (invoke $signals "value" (i32.const 53)) (i64.const 73))
(assert_return (invoke $signals "value" (i32.const 54)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 55)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 56)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 57)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 58)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 59)) (i64.const 0))

;; Actual file cleanup erases/reuses nodes and retains cancelled paths/directories
(assert_return (invoke $signals "value" (i32.const 60)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 61)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 62)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 63)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 64)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 65)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 66)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 67)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 68)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 69)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 70)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 71)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 72)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 73)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 74)) (i64.const 1))

;; One-shot pipe callback and restoration
(assert_return (invoke $signals "value" (i32.const 75)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 76)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 77)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 78)) (i64.const 1))

;; Utility registration preserves ignored action on install and unregister
(assert_return (invoke $signals "value" (i32.const 79)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 80)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 81)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 82)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 83)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 84)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 85)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 86)) (i64.const 1))

;; Child signal 15, explicit termination/default-pipe exit, reaped identity
(assert_return (invoke $signals "value" (i32.const 87)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 88)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 89)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 90)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 91)) (i64.const 15))
(assert_return (invoke $signals "value" (i32.const 92)) (i64.const -1))

;; Child signal 11, explicit termination/default-pipe exit, reaped identity
(assert_return (invoke $signals "value" (i32.const 93)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 94)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 95)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 96)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 97)) (i64.const 11))
(assert_return (invoke $signals "value" (i32.const 98)) (i64.const -1))

;; Child signal 10, explicit termination/default-pipe exit, reaped identity
(assert_return (invoke $signals "value" (i32.const 99)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 100)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 101)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 102)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 103)) (i64.const 10))
(assert_return (invoke $signals "value" (i32.const 104)) (i64.const -1))

;; Child signal 13, explicit termination/default-pipe exit, reaped identity
(assert_return (invoke $signals "value" (i32.const 105)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 106)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 107)) (i64.const 0))
(assert_return (invoke $signals "value" (i32.const 108)) (i64.const 1))
(assert_return (invoke $signals "value" (i32.const 109)) (i64.const 18944))
(assert_return (invoke $signals "value" (i32.const 110)) (i64.const -1))

;; A table-free module exercises the fixed versioned layout and retains the
;; legacy 20-byte output convention. Restore the shell's action afterwards.
(module $actions
  (import "waste-runtime" "memory" (memory 4))
  (import "waste_kernel" "sigaction_v1" (func $versioned (param i32 i32 i32) (result i32)))
  (import "env" "sigaction" (func $legacy (param i32 i32 i32) (result i32)))
  (data (i32.const 180512) "\01\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\10")
  (data (i32.const 180544) "ZZZZZZZZZZZZZZZZZZZZZZZZ")
  (func (export "save") (result i32)
    i32.const 30 i32.const 0 i32.const 180576 call $versioned)
  (func (export "install") (result i32)
    i32.const 30 i32.const 180512 i32.const 0 call $versioned)
  (func (export "legacy-query") (result i32)
    i32.const 30 i32.const 0 i32.const 180544 call $legacy)
  (func (export "query") (result i32)
    i32.const 30 i32.const 0 i32.const 180544 call $versioned)
  (func (export "handler") (result i32) i32.const 180544 i32.load)
  (func (export "flags") (result i32) i32.const 180564 i32.load)
  (func (export "reject") (result i32)
    i32.const 180532 i32.const 4 i32.store
    i32.const 30 i32.const 180512 i32.const 180544 call $versioned)
  (func (export "bad-range") (result i32)
    i32.const 30 i32.const -8 i32.const 180544 call $versioned)
  (func (export "bad-handler") (result i32)
    i32.const 180512 i32.const -1 i32.store
    i32.const 180532 i32.const 0 i32.store
    i32.const 30 i32.const 180512 i32.const 180544 call $versioned)
  (func (export "legacy-ignore") (result i32)
    i32.const 180512 i32.const -2 i32.store
    i32.const 30 i32.const 180512 i32.const 0 call $legacy)
  (func (export "restore") (result i32)
    i32.const 30 i32.const 180576 i32.const 0 call $versioned)
)
(assert_return (invoke $actions "save") (i32.const 0))
(assert_return (invoke $actions "install") (i32.const 0))
(assert_return (invoke $actions "legacy-query") (i32.const 0))
(assert_return (invoke $actions "handler") (i32.const 1))
(assert_return (invoke $actions "flags") (i32.const 0x5a5a5a5a))
(assert_return (invoke $actions "query") (i32.const 0))
(assert_return (invoke $actions "flags") (i32.const 0x10000000))
(assert_return (invoke $actions "reject") (i32.const -22))
(assert_return (invoke $actions "handler") (i32.const 1))
(assert_return (invoke $actions "flags") (i32.const 0x10000000))
(assert_return (invoke $actions "bad-range") (i32.const -14))
(assert_return (invoke $actions "query") (i32.const 0))
(assert_return (invoke $actions "flags") (i32.const 0x10000000))
(assert_return (invoke $actions "bad-handler") (i32.const -22))
(assert_return (invoke $actions "handler") (i32.const 1))
(assert_return (invoke $actions "flags") (i32.const 0x10000000))
(assert_return (invoke $actions "legacy-ignore") (i32.const 0))
(assert_return (invoke $actions "query") (i32.const 0))
(assert_return (invoke $actions "handler") (i32.const 1))
(assert_return (invoke $actions "flags") (i32.const 0))
(assert_return (invoke $actions "legacy-query") (i32.const 0))
(assert_return (invoke $actions "handler") (i32.const -2))
(assert_return (invoke $actions "restore") (i32.const 0))
