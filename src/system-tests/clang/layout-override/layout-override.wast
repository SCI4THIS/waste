;; Actual layout parser values retained after reader/parser destruction.
(module $layout
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/layout-override.bin\00")
  (data (i32.const 180128) "/tmp/layout-override-status.txt\00")
  (func $capture (param $path i32) (param $buffer i32) (param $count i32) (result i32)
    (local $fd i32) (local $got i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $buffer local.get $count call $read local.set $got
    local.get $fd call $close drop local.get $got)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 184000 i32.const 8192 call $capture)
  (func (export "status") (result i32)
    i32.const 180128 i32.const 196000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 196000 i32.load16_u i32.const 0x3633 i32.eq i32.and
    i32.const 196002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func (export "word") (param $index i32) (result i64)
    i32.const 184000 local.get $index i32.const 8 i32.mul i32.add i64.load))
(assert_return (invoke "capture") (i32.const 328))
(assert_return (invoke "status") (i32.const 1))
(assert_return (invoke "word" (i32.const 0)) (i64.const 0))
(assert_return (invoke "word" (i32.const 1)) (i64.const 0))
(assert_return (invoke "word" (i32.const 2)) (i64.const 4))
(assert_return (invoke "word" (i32.const 3)) (i64.const 1))
(assert_return (invoke "word" (i32.const 4)) (i64.const 256))
(assert_return (invoke "word" (i32.const 5)) (i64.const 128))
(assert_return (invoke "word" (i32.const 6)) (i64.const 2))
(assert_return (invoke "word" (i32.const 7)) (i64.const 0))
(assert_return (invoke "word" (i32.const 8)) (i64.const 128))
(assert_return (invoke "word" (i32.const 9)) (i64.const 1))
(assert_return (invoke "word" (i32.const 10)) (i64.const 32))
(assert_return (invoke "word" (i32.const 11)) (i64.const 2))
(assert_return (invoke "word" (i32.const 12)) (i64.const 64))
(assert_return (invoke "word" (i32.const 13)) (i64.const 96))
(assert_return (invoke "word" (i32.const 14)) (i64.const 1))
(assert_return (invoke "word" (i32.const 15)) (i64.const 192))
(assert_return (invoke "word" (i32.const 16)) (i64.const 64))
(assert_return (invoke "word" (i32.const 17)) (i64.const 3))
(assert_return (invoke "word" (i32.const 18)) (i64.const 0))
(assert_return (invoke "word" (i32.const 19)) (i64.const 32))
(assert_return (invoke "word" (i32.const 20)) (i64.const 64))
(assert_return (invoke "word" (i32.const 21)) (i64.const 0))
(assert_return (invoke "word" (i32.const 22)) (i64.const 0))
(assert_return (invoke "word" (i32.const 23)) (i64.const 1))
(assert_return (invoke "word" (i32.const 24)) (i64.const 64))
(assert_return (invoke "word" (i32.const 25)) (i64.const 32))
(assert_return (invoke "word" (i32.const 26)) (i64.const 3))
(assert_return (invoke "word" (i32.const 27)) (i64.const 0))
(assert_return (invoke "word" (i32.const 28)) (i64.const 0))
(assert_return (invoke "word" (i32.const 29)) (i64.const 0))
(assert_return (invoke "word" (i32.const 30)) (i64.const 0))
(assert_return (invoke "word" (i32.const 31)) (i64.const 0))
(assert_return (invoke "word" (i32.const 32)) (i64.const 1))
(assert_return (invoke "word" (i32.const 33)) (i64.const 1099511627776))
(assert_return (invoke "word" (i32.const 34)) (i64.const 128))
(assert_return (invoke "word" (i32.const 35)) (i64.const 2))
(assert_return (invoke "word" (i32.const 36)) (i64.const 0))
(assert_return (invoke "word" (i32.const 37)) (i64.const 1099511627776))
(assert_return (invoke "word" (i32.const 38)) (i64.const 0))
(assert_return (invoke "word" (i32.const 39)) (i64.const 0))
(assert_return (invoke "word" (i32.const 40)) (i64.const 0))
