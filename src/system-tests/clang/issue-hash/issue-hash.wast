;; Actual Actual Clang raw-token normalization and MD5; owned outputs survive a yield.
(module $issue_hash
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/issue-hash.bin\00")
  (data (i32.const 180128) "/tmp/issue-hash-status.txt\00")
  (data (i32.const 200000) "intvalue=42;c985ea45e85e22b1c8faab512c846c47constchar*s=\22a b\5c\5cc\22ac87d527ce61c95260b45b94e37794a7alpha+beta;997ee6c25f4f3051069851a7f2a7bb6eintsecond;662760b0a001432cfe4d3f18f01b3cefnext(3);();7581590df8863191ce7b2f32655eae48")
  (func $capture (param $path i32) (param $output i32) (param $capacity i32) (result i32)
    (local $fd i32) (local $length i32)
    local.get $path i32.const 0 i32.const 0 call $open local.tee $fd
    i32.const 0 i32.lt_s if i32.const -1 return end
    local.get $fd local.get $output local.get $capacity call $read local.set $length
    local.get $fd call $close drop local.get $length)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 184000 i32.const 8192 call $capture)
  (func (export "status") (result i32)
    i32.const 180128 i32.const 193000 i32.const 8 call $capture i32.const 3 i32.eq
    i32.const 193000 i32.load16_u i32.const 0x3633 i32.eq i32.and
    i32.const 193002 i32.load8_u i32.const 10 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i64)
    i32.const 184000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func (export "text") (param $offset i32) (param $length i32) (result i32)
    i32.const 184120 local.get $offset i32.add
    i32.const 200000 local.get $offset i32.add
    local.get $length call $compare i32.eqz)
)
(assert_return (invoke "capture") (i32.const 672))
(assert_return (invoke "status") (i32.const 1))
(assert_return (invoke "value" (i32.const 0)) (i64.const 14))
(assert_return (invoke "value" (i32.const 1)) (i64.const 12))
(assert_return (invoke "text" (i32.const 0) (i32.const 12)) (i32.const 1))
(assert_return (invoke "value" (i32.const 2)) (i64.const 32))
(assert_return (invoke "text" (i32.const 12) (i32.const 32)) (i32.const 1))
(assert_return (invoke "value" (i32.const 3)) (i64.const 20))
(assert_return (invoke "text" (i32.const 44) (i32.const 20)) (i32.const 1))
(assert_return (invoke "value" (i32.const 4)) (i64.const 32))
(assert_return (invoke "text" (i32.const 64) (i32.const 32)) (i32.const 1))
(assert_return (invoke "value" (i32.const 5)) (i64.const 11))
(assert_return (invoke "text" (i32.const 96) (i32.const 11)) (i32.const 1))
(assert_return (invoke "value" (i32.const 6)) (i64.const 32))
(assert_return (invoke "text" (i32.const 107) (i32.const 32)) (i32.const 1))
(assert_return (invoke "value" (i32.const 7)) (i64.const 10))
(assert_return (invoke "text" (i32.const 139) (i32.const 10)) (i32.const 1))
(assert_return (invoke "value" (i32.const 8)) (i64.const 32))
(assert_return (invoke "text" (i32.const 149) (i32.const 32)) (i32.const 1))
(assert_return (invoke "value" (i32.const 9)) (i64.const 8))
(assert_return (invoke "text" (i32.const 181) (i32.const 8)) (i32.const 1))
(assert_return (invoke "value" (i32.const 10)) (i64.const 32))
(assert_return (invoke "text" (i32.const 189) (i32.const 32)) (i32.const 1))
(assert_return (invoke "value" (i32.const 11)) (i64.const 8))
(assert_return (invoke "text" (i32.const 221) (i32.const 8)) (i32.const 1))
(assert_return (invoke "value" (i32.const 12)) (i64.const 32))
(assert_return (invoke "text" (i32.const 229) (i32.const 32)) (i32.const 1))
(assert_return (invoke "value" (i32.const 13)) (i64.const 259))
(assert_return (invoke "text" (i32.const 261) (i32.const 259)) (i32.const 1))
(assert_return (invoke "value" (i32.const 14)) (i64.const 32))
(assert_return (invoke "text" (i32.const 520) (i32.const 32)) (i32.const 1))
