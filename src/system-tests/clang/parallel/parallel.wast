;; Actual LLVM latch, TaskGroup and scalar algorithms with release-build rejection paths.
(module $parallel
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/parallel.bin\00")
  (data (i32.const 180064) "/tmp/parallel-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 1024 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180064 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "value") (param $index i32) (result i32)
    i32.const 182000 local.get $index i32.const 4 i32.mul i32.add i32.load)
)
(assert_return (invoke $parallel "capture") (i32.const 488))
(assert_return (invoke $parallel "exit-status") (i32.const 1))
;; Explicit release-build guest profile and latch ownership.
(assert_return (invoke $parallel "value" (i32.const 0)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 1)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 2)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 3)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 4)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 5)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 6)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 7)) (i32.const 4))
;; Balanced default count and repeated zero sync.
(assert_return (invoke $parallel "value" (i32.const 8)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 9)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 10)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 11)) (i32.const 2))
(assert_return (invoke $parallel "value" (i32.const 12)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 13)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 14)) (i32.const 0))
;; Nonzero initialization, increment and complete drain.
(assert_return (invoke $parallel "value" (i32.const 15)) (i32.const 3))
(assert_return (invoke $parallel "value" (i32.const 16)) (i32.const 4))
(assert_return (invoke $parallel "value" (i32.const 17)) (i32.const 3))
(assert_return (invoke $parallel "value" (i32.const 18)) (i32.const 2))
(assert_return (invoke $parallel "value" (i32.const 19)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 20)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 21)) (i32.const 0))
;; Actual TaskGroup immediate, nested and recursive ordering.
(assert_return (invoke $parallel "value" (i32.const 22)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 23)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 24)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 25)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 26)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 27)) (i32.const 4))
(assert_return (invoke $parallel "value" (i32.const 28)) (i32.const 1234))
(assert_return (invoke $parallel "value" (i32.const 29)) (i32.const 4))
(assert_return (invoke $parallel "value" (i32.const 30)) (i32.const 1234))
;; Shared task captures and heap-backed function closure lifetime.
(assert_return (invoke $parallel "value" (i32.const 31)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 32)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 33)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 34)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 35)) (i32.const 128))
(assert_return (invoke $parallel "value" (i32.const 36)) (i32.const 120))
(assert_return (invoke $parallel "value" (i32.const 37)) (i32.const 5))
(assert_return (invoke $parallel "value" (i32.const 38)) (i32.const 12345))
(assert_return (invoke $parallel "value" (i32.const 39)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 40)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 41)) (i32.const 5))
;; Actual loop range fences, empty input and nested loops.
(assert_return (invoke $parallel "value" (i32.const 42)) (i32.const 4))
(assert_return (invoke $parallel "value" (i32.const 43)) (i32.const 2345))
(assert_return (invoke $parallel "value" (i32.const 44)) (i32.const 99))
(assert_return (invoke $parallel "value" (i32.const 45)) (i32.const 99))
(assert_return (invoke $parallel "value" (i32.const 46)) (i32.const 12))
(assert_return (invoke $parallel "value" (i32.const 47)) (i32.const 13))
(assert_return (invoke $parallel "value" (i32.const 48)) (i32.const 14))
(assert_return (invoke $parallel "value" (i32.const 49)) (i32.const 15))
(assert_return (invoke $parallel "value" (i32.const 50)) (i32.const 99))
(assert_return (invoke $parallel "value" (i32.const 51)) (i32.const 99))
(assert_return (invoke $parallel "value" (i32.const 52)) (i32.const 4))
(assert_return (invoke $parallel "value" (i32.const 53)) (i32.const 9))
(assert_return (invoke $parallel "value" (i32.const 54)) (i32.const 36))
;; In-place range wrapper visits each element.
(assert_return (invoke $parallel "value" (i32.const 55)) (i32.const 4))
(assert_return (invoke $parallel "value" (i32.const 56)) (i32.const 4))
(assert_return (invoke $parallel "value" (i32.const 57)) (i32.const 6))
(assert_return (invoke $parallel "value" (i32.const 58)) (i32.const 10))
(assert_return (invoke $parallel "value" (i32.const 59)) (i32.const 14))
;; Empty and nonempty transform/reduce observations.
(assert_return (invoke $parallel "value" (i32.const 60)) (i32.const 17))
(assert_return (invoke $parallel "value" (i32.const 61)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 62)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 63)) (i32.const 40))
(assert_return (invoke $parallel "value" (i32.const 64)) (i32.const 4))
(assert_return (invoke $parallel "value" (i32.const 65)) (i32.const 4))
(assert_return (invoke $parallel "value" (i32.const 66)) (i32.const 1234))
;; Move-only reduction retains its original allocation.
(assert_return (invoke $parallel "value" (i32.const 67)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 68)) (i32.const 40))
;; Owning string reduction preserves all characters.
(assert_return (invoke $parallel "value" (i32.const 69)) (i32.const 7))
(assert_return (invoke $parallel "value" (i32.const 70)) (i32.const 33))
(assert_return (invoke $parallel "value" (i32.const 71)) (i32.const 97))
(assert_return (invoke $parallel "value" (i32.const 72)) (i32.const 98))
(assert_return (invoke $parallel "value" (i32.const 73)) (i32.const 98))
(assert_return (invoke $parallel "value" (i32.const 74)) (i32.const 99))
(assert_return (invoke $parallel "value" (i32.const 75)) (i32.const 99))
(assert_return (invoke $parallel "value" (i32.const 76)) (i32.const 99))
;; Ascending sort leaves range fences intact.
(assert_return (invoke $parallel "value" (i32.const 77)) (i32.const 111))
(assert_return (invoke $parallel "value" (i32.const 78)) (i32.const -9))
(assert_return (invoke $parallel "value" (i32.const 79)) (i32.const -3))
(assert_return (invoke $parallel "value" (i32.const 80)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 81)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 82)) (i32.const 2))
(assert_return (invoke $parallel "value" (i32.const 83)) (i32.const 2))
(assert_return (invoke $parallel "value" (i32.const 84)) (i32.const 7))
(assert_return (invoke $parallel "value" (i32.const 85)) (i32.const 7))
(assert_return (invoke $parallel "value" (i32.const 86)) (i32.const 222))
;; Descending comparison preserves duplicates and negative values.
(assert_return (invoke $parallel "value" (i32.const 87)) (i32.const 7))
(assert_return (invoke $parallel "value" (i32.const 88)) (i32.const 7))
(assert_return (invoke $parallel "value" (i32.const 89)) (i32.const 2))
(assert_return (invoke $parallel "value" (i32.const 90)) (i32.const 2))
(assert_return (invoke $parallel "value" (i32.const 91)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 92)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 93)) (i32.const -3))
(assert_return (invoke $parallel "value" (i32.const 94)) (i32.const -9))
;; Empty sort never calls its comparison.
(assert_return (invoke $parallel "value" (i32.const 95)) (i32.const 4))
(assert_return (invoke $parallel "value" (i32.const 96)) (i32.const 0))
;; Heap-backed sort order, bounds and element conservation.
(assert_return (invoke $parallel "value" (i32.const 97)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 98)) (i32.const 0))
(assert_return (invoke $parallel "value" (i32.const 99)) (i32.const 30))
(assert_return (invoke $parallel "value" (i32.const 100)) (i32.const 61395))
;; Unfinished sync, count underflow, pending destruction and overflow each terminate only their child.
(assert_return (invoke $parallel "value" (i32.const 101)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 102)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 103)) (i32.const 6))
(assert_return (invoke $parallel "value" (i32.const 104)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 105)) (i32.const 6))
(assert_return (invoke $parallel "value" (i32.const 106)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 107)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 108)) (i32.const 6))
(assert_return (invoke $parallel "value" (i32.const 109)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 110)) (i32.const 6))
(assert_return (invoke $parallel "value" (i32.const 111)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 112)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 113)) (i32.const 6))
(assert_return (invoke $parallel "value" (i32.const 114)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 115)) (i32.const 6))
(assert_return (invoke $parallel "value" (i32.const 116)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 117)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 118)) (i32.const 6))
(assert_return (invoke $parallel "value" (i32.const 119)) (i32.const 1))
(assert_return (invoke $parallel "value" (i32.const 120)) (i32.const 6))
;; Parent remains live after all four rejection paths.
(assert_return (invoke $parallel "value" (i32.const 121)) (i32.const 0))
