  (func (export "cwd-equal") (param $path i32) (result i32)
    (local $i i32) (local $a i32) (local $b i32)
    (loop $next
      (local.set $a (i32.load8_u (i32.add (i32.const 190000) (local.get $i))))
      (local.set $b (i32.load8_u (i32.add (local.get $path) (local.get $i))))
      (if (i32.ne (local.get $a) (local.get $b)) (then (return (i32.const 0))))
      (if (i32.eqz (local.get $a)) (then (return (i32.const 1))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)) i32.const 0)
