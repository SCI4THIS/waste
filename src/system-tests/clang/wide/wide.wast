;; The compiled C++ input records observations; all expectations live here.
(module $wide
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/wide.bin\00")
  (data (i32.const 180032) "/tmp/wide-status.txt\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 1024 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180032 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "field") (param i32) (result i32)
    i32.const 182000 local.get 0 i32.const 4 i32.mul i32.add i32.load)
  (func (export "conversion-value") (param i32) (result i64)
    i32.const 182128 local.get 0 i32.const 16 i32.mul i32.add i64.load)
  (func (export "conversion-end") (param i32) (result i32)
    i32.const 182136 local.get 0 i32.const 16 i32.mul i32.add i32.load)
  (func (export "conversion-errno") (param i32) (result i32)
    i32.const 182140 local.get 0 i32.const 16 i32.mul i32.add i32.load)
  (func (export "floating-low") (param i32) (result i64)
    i32.const 182224 local.get 0 i32.const 24 i32.mul i32.add i64.load)
  (func (export "floating-high") (param i32) (result i64)
    i32.const 182232 local.get 0 i32.const 24 i32.mul i32.add i64.load)
  (func (export "floating-end") (param i32) (result i32)
    i32.const 182240 local.get 0 i32.const 24 i32.mul i32.add i32.load)
  (func (export "floating-errno") (param i32) (result i32)
    i32.const 182244 local.get 0 i32.const 24 i32.mul i32.add i32.load)
)
(assert_return (invoke $wide "capture") (i32.const 296))
(assert_return (invoke $wide "exit-status") (i32.const 1))
(assert_return (invoke $wide "field" (i32.const 0)) (i32.const 4))
(assert_return (invoke $wide "field" (i32.const 1)) (i32.const 1))
(assert_return (invoke $wide "field" (i32.const 2)) (i32.const 12))
(assert_return (invoke $wide "field" (i32.const 3)) (i32.const 2))
(assert_return (invoke $wide "field" (i32.const 4)) (i32.const 4))
(assert_return (invoke $wide "field" (i32.const 5)) (i32.const -1))
(assert_return (invoke $wide "field" (i32.const 6)) (i32.const 0))
(assert_return (invoke $wide "field" (i32.const 7)) (i32.const -1))
(assert_return (invoke $wide "field" (i32.const 8)) (i32.const 1))
(assert_return (invoke $wide "field" (i32.const 9)) (i32.const 0))
(assert_return (invoke $wide "field" (i32.const 10)) (i32.const 1))
(assert_return (invoke $wide "field" (i32.const 11)) (i32.const 0))
(assert_return (invoke $wide "field" (i32.const 12)) (i32.const 128512))
(assert_return (invoke $wide "field" (i32.const 13)) (i32.const -1))
(assert_return (invoke $wide "field" (i32.const 14)) (i32.const 2147483648))
(assert_return (invoke $wide "field" (i32.const 15)) (i32.const 1))
(assert_return (invoke $wide "field" (i32.const 16)) (i32.const 305441741))
(assert_return (invoke $wide "field" (i32.const 17)) (i32.const 305441741))
(assert_return (invoke $wide "field" (i32.const 18)) (i32.const 305441741))
(assert_return (invoke $wide "field" (i32.const 19)) (i32.const 305419896))
(assert_return (invoke $wide "field" (i32.const 20)) (i32.const 1985229328))
(assert_return (invoke $wide "field" (i32.const 21)) (i32.const 1))
(assert_return (invoke $wide "field" (i32.const 22)) (i32.const -1))
(assert_return (invoke $wide "field" (i32.const 23)) (i32.const 1))
(assert_return (invoke $wide "field" (i32.const 24)) (i32.const 65))
(assert_return (invoke $wide "field" (i32.const 25)) (i32.const 1))
(assert_return (invoke $wide "field" (i32.const 26)) (i32.const 2147483648))
(assert_return (invoke $wide "field" (i32.const 27)) (i32.const 2))
(assert_return (invoke $wide "field" (i32.const 28)) (i32.const 1))
(assert_return (invoke $wide "field" (i32.const 29)) (i32.const -1))
(assert_return (invoke $wide "field" (i32.const 30)) (i32.const 4))
(assert_return (invoke $wide "field" (i32.const 31)) (i32.const 1))
;; Actual C++ calls through <cwchar>/<cinttypes>, with wchar_t end offsets.
(assert_return (invoke $wide "conversion-value" (i32.const 0)) (i64.const -2147483648))
(assert_return (invoke $wide "conversion-end" (i32.const 0)) (i32.const 13))
(assert_return (invoke $wide "conversion-errno" (i32.const 0)) (i32.const 17))
(assert_return (invoke $wide "conversion-value" (i32.const 1)) (i64.const 4294967295))
(assert_return (invoke $wide "conversion-end" (i32.const 1)) (i32.const 10))
(assert_return (invoke $wide "conversion-errno" (i32.const 1)) (i32.const 34))
(assert_return (invoke $wide "conversion-value" (i32.const 2)) (i64.const -9223372036854775808))
(assert_return (invoke $wide "conversion-end" (i32.const 2)) (i32.const 19))
(assert_return (invoke $wide "conversion-errno" (i32.const 2)) (i32.const 17))
(assert_return (invoke $wide "conversion-value" (i32.const 3)) (i64.const -1))
(assert_return (invoke $wide "conversion-end" (i32.const 3)) (i32.const 2))
(assert_return (invoke $wide "conversion-errno" (i32.const 3)) (i32.const 17))
(assert_return (invoke $wide "conversion-value" (i32.const 4)) (i64.const 9223372036854775807))
(assert_return (invoke $wide "conversion-end" (i32.const 4)) (i32.const 20))
(assert_return (invoke $wide "conversion-errno" (i32.const 4)) (i32.const 34))
(assert_return (invoke $wide "conversion-value" (i32.const 5)) (i64.const -1))
(assert_return (invoke $wide "conversion-end" (i32.const 5)) (i32.const 18))
(assert_return (invoke $wide "conversion-errno" (i32.const 5)) (i32.const 17))
;; Compile-generated float/double/binary128 returns retain all representation bits.
(assert_return (invoke $wide "floating-low" (i32.const 0)) (i64.const 0x3f800001))
(assert_return (invoke $wide "floating-high" (i32.const 0)) (i64.const 0))
(assert_return (invoke $wide "floating-end" (i32.const 0)) (i32.const 45))
(assert_return (invoke $wide "floating-errno" (i32.const 0)) (i32.const 17))
(assert_return (invoke $wide "floating-low" (i32.const 1)) (i64.const 1))
(assert_return (invoke $wide "floating-high" (i32.const 1)) (i64.const 0))
(assert_return (invoke $wide "floating-end" (i32.const 1)) (i32.const 9))
(assert_return (invoke $wide "floating-errno" (i32.const 1)) (i32.const 17))
(assert_return (invoke $wide "floating-low" (i32.const 2)) (i64.const 1))
(assert_return (invoke $wide "floating-high" (i32.const 2)) (i64.const 0x3fff000000000000))
(assert_return (invoke $wide "floating-end" (i32.const 2)) (i32.const 34))
(assert_return (invoke $wide "floating-errno" (i32.const 2)) (i32.const 17))
