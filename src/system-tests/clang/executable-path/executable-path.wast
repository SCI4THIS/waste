(assert_return (invoke $executable-path "value" (i32.const 3) (i32.const 28)) (i32.const -1))
(assert_return (invoke $executable-path "value" (i32.const 3) (i32.const 29)) (i32.const 14))
(assert_return (invoke $executable-path "value" (i32.const 3) (i32.const 30)) (i32.const -1))
(assert_return (invoke $executable-path "value" (i32.const 3) (i32.const 31)) (i32.const 14))
(assert_return (invoke $executable-path "process-identities") (i32.const 1))
;; Raw ABI targets the active Bash image after the observer exits.
(assert_return (invoke $executable-path "raw-copy" (i32.const 14)) (i32.const 13))
(assert_return (invoke $executable-path "raw-copy-bytes") (i32.const 1))
(assert_return (invoke $executable-path "raw-copy" (i32.const -1)) (i32.const 13))
(assert_return (invoke $executable-path "raw-copy-bytes") (i32.const 1))
(assert_return (invoke $executable-path "raw-short" (i32.const 13)) (i32.const -34))
(assert_return (invoke $executable-path "raw-short-unchanged") (i32.const 1))
(assert_return (invoke $executable-path "raw-short" (i32.const 0)) (i32.const -34))
(assert_return (invoke $executable-path "raw-short-unchanged") (i32.const 1))
(assert_return (invoke $executable-path "raw-null") (i32.const -14))
(assert_return (invoke $executable-path "raw-invalid") (i32.const -14))
(assert_return (invoke $executable-path "raw-tail") (i32.const 1))
(assert_return (invoke $executable-path "raw-tail-result") (i32.const -14))

;; An unlinked open file remains usable through its duplicate descriptor.
(module $unlinked-file
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "dup" (func $dup (param i32) (result i32)))
  (import "env" "fstat" (func $fstat (param i32 i32) (result i32)))
  (import "env" "unlink" (func $unlink (param i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "lseek" (func $lseek (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (global $fd (mut i32) (i32.const -1))
  (global $alias (mut i32) (i32.const -1))
  (global $inode (mut i64) (i64.const 0))
  (data (i32.const 186000) "/tmp/executable-path-unlinked.bin\00")
  (data (i32.const 186064) "AB")
  (func (export "open") (result i32)
    i32.const 186000 i32.const 578 i32.const 384 call $open global.set $fd
    global.get $fd i32.const 186256 call $fstat drop
    i32.const 186264 i64.load global.set $inode
    global.get $fd i32.const 0 i32.ge_s)
  (func (export "alias") (result i32)
    global.get $fd call $dup global.set $alias
    global.get $alias i32.const 0 i32.ge_s)
  (func (export "unlink") (result i32)
    i32.const 186000 call $unlink)
  (func (export "write") (result i32)
    global.get $fd i32.const 186064 i32.const 2 call $write)
  (func (export "seek") (result i32)
    global.get $alias i32.const 0 i32.const 0 call $lseek)
  (func (export "read") (result i32)
    global.get $alias i32.const 186100 i32.const 2 call $read)
  (func (export "bytes") (result i32)
    i32.const 186100 i32.load16_u i32.const 0x4241 i32.eq)
  (func (export "stat") (result i32)
    global.get $alias i32.const 186256 call $fstat i32.eqz
    i32.const 186296 i64.load i64.const 2 i64.eq i32.and
    i32.const 186264 i64.load global.get $inode i64.eq i32.and
    global.get $inode i64.eqz i32.eqz i32.and)
  (func (export "close") (result i32) global.get $fd call $close)
  (func (export "close-alias") (result i32) global.get $alias call $close))
(assert_return (invoke $unlinked-file "open") (i32.const 1))
(assert_return (invoke $unlinked-file "alias") (i32.const 1))
(assert_return (invoke $unlinked-file "unlink") (i32.const 0))
(assert_return (invoke $unlinked-file "write") (i32.const 2))
(assert_return (invoke $unlinked-file "seek") (i32.const 0))
(assert_return (invoke $unlinked-file "read") (i32.const 2))
(assert_return (invoke $unlinked-file "bytes") (i32.const 1))
(assert_return (invoke $unlinked-file "stat") (i32.const 1))
(assert_return (invoke $unlinked-file "close") (i32.const 0))
(assert_return (invoke $unlinked-file "close-alias") (i32.const 0))
