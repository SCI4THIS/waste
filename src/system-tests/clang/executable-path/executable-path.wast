;; Four 640-byte observations: original process, fork child, exec replacement,
;; then the reaped parent. All assertions inspect actual process/provider output.
(module $executable-path
  (import "waste-runtime" "memory" (memory 4))
  (import "waste_kernel" "executable_path_v1" (func $raw-path (param i32 i32) (result i32)))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $memcmp (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/executable-path.bin\00")
  (data (i32.const 180064) "/tmp/executable-path-status.txt\00")
  (func $read-file (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 4096 call $read-file)
  (func (export "exit-status") (result i32)
    i32.const 180064 i32.const 184900 i32.const 8 call $read-file i32.const 2 i32.eq
    i32.const 184900 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func $value (export "value") (param $record i32) (param $index i32) (result i32)
    i32.const 182000 local.get $record i32.const 640 i32.mul i32.add
    local.get $index i32.const 4 i32.mul i32.add i32.load)
  (func (export "path") (param $record i32) (param $slot i32) (param $expected i32) (result i32)
    i32.const 182128 local.get $record i32.const 640 i32.mul i32.add
    local.get $slot i32.const 128 i32.mul i32.add
    i32.const 181000 local.get $expected i32.const 128 i32.mul i32.add
    i32.const 128 call $memcmp i32.eqz)
  (func (export "resource-buffer-fits") (param $record i32) (result i32)
    local.get $record i32.const 2 call $value
    local.get $record i32.const 3 call $value i32.const 1 i32.add i32.ge_u)
  (func (export "process-identities") (result i32)
    i32.const 0 i32.const 1 call $value i32.const 3 i32.const 1 call $value i32.eq
    i32.const 1 i32.const 1 call $value i32.const 2 i32.const 1 call $value i32.eq i32.and
    i32.const 0 i32.const 1 call $value i32.const 1 i32.const 1 call $value i32.ne i32.and
    i32.const 3 i32.const 26 call $value i32.const 1 i32.const 1 call $value i32.eq i32.and)
  (data (i32.const 185000) "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!")
  (data (i32.const 185100) "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!")
  (data (i32.const 185200) "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!")
  (data (i32.const 185300) "/usr/bin/bash\00")
  (func (export "raw-copy") (param $capacity i32) (result i32)
    i32.const 185000 local.get $capacity call $raw-path)
  (func (export "raw-copy-bytes") (result i32)
    i32.const 185000 i32.const 185300 i32.const 14 call $memcmp i32.eqz
    i32.const 185014 i32.load8_u i32.const 33 i32.eq i32.and)
  (func (export "raw-short") (param $capacity i32) (result i32)
    i32.const 185100 local.get $capacity call $raw-path)
  (func (export "raw-short-unchanged") (result i32)
    i32.const 185100 i32.const 185200 i32.const 32 call $memcmp i32.eqz)
  (func (export "raw-null") (result i32)
    i32.const 0 i32.const 14 call $raw-path)
  (func (export "raw-invalid") (result i32)
    i32.const -8 i32.const 14 call $raw-path)
  (global $tail-result (mut i32) (i32.const 0))
  (func (export "raw-tail") (result i32) (local $ptr i32)
    memory.size i32.const 65536 i32.mul i32.const 3 i32.sub local.set $ptr
    local.get $ptr i32.const 0x2121 i32.store16
    local.get $ptr i32.const 2 i32.add i32.const 33 i32.store8
    local.get $ptr i32.const 14 call $raw-path global.set $tail-result
    local.get $ptr i32.load16_u i32.const 0x2121 i32.eq
