;; Compiled public alarm and whole LLVM Watchdog observations.
(module $watchdog
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (data (i32.const 180000) "/tmp/watchdog-controlled.bin\00")
  (data (i32.const 180064) "/tmp/watchdog-controlled-status.txt\00")
  (func $capture (param $path i32) (param $out i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $out local.get $count call $read local.set $bytes
    local.get $fd call $close drop local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 4096 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180064 i32.const 184000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 184000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func $value (export "value") (param $index i32) (result i64)
    i32.const 182000 local.get $index i32.const 8 i32.mul i32.add i64.load)
  (func (export "elapsed") (param $index i32) (param $minimum i64) (result i32)
    local.get $index call $value local.get $minimum i64.ge_u
    local.get $index call $value i64.const 30000000000 i64.lt_u i32.and)
)

(assert_return (invoke $watchdog "capture") (i32.const 360))
(assert_return (invoke $watchdog "exit-status") (i32.const 1))
(assert_return (invoke $watchdog "value" (i32.const 0)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 1)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 2)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 3)) (i64.const 3))
(assert_return (invoke $watchdog "value" (i32.const 4)) (i64.const 2))
(assert_return (invoke $watchdog "value" (i32.const 5)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 6)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 7)) (i64.const 4294967295))
(assert_return (invoke $watchdog "value" (i32.const 8)) (i64.const 73))
(assert_return (invoke $watchdog "value" (i32.const 9)) (i64.const 2))
(assert_return (invoke $watchdog "value" (i32.const 10)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 11)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 12)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 13)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 14)) (i64.const 500000000))
(assert_return (invoke $watchdog "value" (i32.const 15)) (i64.const 3))
(assert_return (invoke $watchdog "value" (i32.const 16)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 17)) (i64.const 1000000000))
(assert_return (invoke $watchdog "value" (i32.const 18)) (i64.const 2))
(assert_return (invoke $watchdog "value" (i32.const 19)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 20)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 21)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 22)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 23)) (i64.const 3000000000))
(assert_return (invoke $watchdog "value" (i32.const 24)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 25)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 26)) (i64.const 1))
(assert_return (invoke $watchdog "value" (i32.const 27)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 28)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 29)) (i64.const 1))
(assert_return (invoke $watchdog "value" (i32.const 30)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 31)) (i64.const 1))
(assert_return (invoke $watchdog "value" (i32.const 32)) (i64.const 14))
(assert_return (invoke $watchdog "value" (i32.const 33)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 34)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 35)) (i64.const -4))
(assert_return (invoke $watchdog "value" (i32.const 36)) (i64.const 73))
(assert_return (invoke $watchdog "value" (i32.const 37)) (i64.const 4000000000))
(assert_return (invoke $watchdog "value" (i32.const 38)) (i64.const 2))
(assert_return (invoke $watchdog "value" (i32.const 39)) (i64.const 14))
(assert_return (invoke $watchdog "value" (i32.const 40)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 41)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 42)) (i64.const 1))
(assert_return (invoke $watchdog "value" (i32.const 43)) (i64.const 0))
(assert_return (invoke $watchdog "value" (i32.const 44)) (i64.const 2))
