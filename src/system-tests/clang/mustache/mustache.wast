(assert_return (invoke $mustache "number-text" (i32.const 36) (i32.const 192152) (i32.const 5)) (i32.const 1))
;; Profile, errno preservation, heap-backed copies/moves, mutation and substring lifetime.
(assert_return (invoke $mustache "metadata" (i32.const 0)) (i32.const 1))
(assert_return (invoke $mustache "metadata" (i32.const 1)) (i32.const 0))
(assert_return (invoke $mustache "metadata" (i32.const 2)) (i32.const 1))
