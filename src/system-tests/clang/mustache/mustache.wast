;; Guest Mustache numeric path; actual native classic streams are a reference.
;; Functional expectations are authored here, independently of both observers.
(module $mustache
  (import "waste-runtime" "memory" (memory 4))
  (import "libc" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "libc" "close" (func $close (param i32) (result i32)))
  (import "libc" "memcmp" (func $compare (param i32 i32 i32) (result i32)))
  (data (i32.const 180000) "/tmp/mustache.bin\00")
  (data (i32.const 180064) "/tmp/mustache-status.txt\00")
  (data (i32.const 180128) "/tmp/mustache-reference.bin\00")
  (data (i32.const 190000) "-nan|\00")
  (data (i32.const 191000) "0\00")
  (data (i32.const 191032) "-0\00")
  (data (i32.const 191064) "1\00")
  (data (i32.const 191096) "-1\00")
  (data (i32.const 191128) "1.25\00")
  (data (i32.const 191160) "-1.25\00")
  (data (i32.const 191192) "3.14159\00")
  (data (i32.const 191224) "2.71828\00")
  (data (i32.const 191256) "1.23457\00")
  (data (i32.const 191288) "123456\00")
  (data (i32.const 191320) "123458\00")
  (data (i32.const 191352) "1.01562\00")
  (data (i32.const 191384) "1.04688\00")
  (data (i32.const 191416) "999999\00")
  (data (i32.const 191448) "1e+06\00")
  (data (i32.const 191480) "100000\00")
  (data (i32.const 191512) "1e+06\00")
  (data (i32.const 191544) "1.25e+06\00")
  (data (i32.const 191576) "0.0001\00")
  (data (i32.const 191608) "1e-05\00")
  (data (i32.const 191640) "9.99999e-05\00")
  (data (i32.const 191672) "0.0001\00")
  (data (i32.const 191704) "0.999999\00")
  (data (i32.const 191736) "1\00")
  (data (i32.const 191768) "1e+20\00")
  (data (i32.const 191800) "1e-20\00")
  (data (i32.const 191832) "1.79769e+308\00")
  (data (i32.const 191864) "2.22507e-308\00")
  (data (i32.const 191896) "2.22507e-308\00")
  (data (i32.const 191928) "4.94066e-324\00")
  (data (i32.const 191960) "-1.79769e+308\00")
  (data (i32.const 191992) "-4.94066e-324\00")
  (data (i32.const 192024) "inf\00")
  (data (i32.const 192056) "-inf\00")
  (data (i32.const 192088) "nan\00")
  (data (i32.const 192120) "nan\00")
  (data (i32.const 192152) "-nan\00")
  (func $capture (param $path i32) (param $output i32) (param $count i32) (result i32)
    (local $fd i32) (local $bytes i32)
    local.get $path i32.const 0 i32.const 0 call $open local.set $fd
    local.get $fd local.get $output local.get $count call $read local.set $bytes
    local.get $fd call $close drop
    local.get $bytes)
  (func (export "capture") (result i32)
    i32.const 180000 i32.const 182000 i32.const 2048 call $capture)
  (func (export "reference") (result i32)
    i32.const 180128 i32.const 188000 i32.const 2048 call $capture)
  (func (export "exit-status") (result i32)
    i32.const 180064 i32.const 187000 i32.const 8 call $capture i32.const 2 i32.eq
    i32.const 187000 i32.load16_u i32.const 0x0a30 i32.eq i32.and)
  (func (export "number-size") (param $index i32) (result i32)
    i32.const 182000 local.get $index i32.const 36 i32.mul i32.add i32.load)
  (func (export "number-text") (param $index i32) (param $expected i32) (param $count i32) (result i32)
    i32.const 182004 local.get $index i32.const 36 i32.mul i32.add
    local.get $expected local.get $count call $compare i32.eqz)
  (func (export "native-match") (result i32)
    i32.const 182000 i32.const 188000 i32.const 1332 call $compare i32.eqz)
  (func (export "metadata") (param $index i32) (result i32)
    i32.const 183332 local.get $index i32.const 4 i32.mul i32.add i32.load)
  (func (export "tail") (result i32)
    i32.const 183400 i32.const 190000 i32.const 6 call $compare i32.eqz)
)
(assert_return (invoke $mustache "capture") (i32.const 1416))
(assert_return (invoke $mustache "reference") (i32.const 1332))
(assert_return (invoke $mustache "exit-status") (i32.const 1))
(assert_return (invoke $mustache "native-match") (i32.const 1))
;; Exact text, length and terminator for six-digit general formatting.
(assert_return (invoke $mustache "number-size" (i32.const 0)) (i32.const 1))
(assert_return (invoke $mustache "number-text" (i32.const 0) (i32.const 191000) (i32.const 2)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 1)) (i32.const 2))
(assert_return (invoke $mustache "number-text" (i32.const 1) (i32.const 191032) (i32.const 3)) (i32.const 1))
