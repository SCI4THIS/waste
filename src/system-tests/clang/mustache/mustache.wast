(assert_return (invoke $mustache "number-text" (i32.const 3) (i32.const 191096) (i32.const 3)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 4)) (i32.const 4))
(assert_return (invoke $mustache "number-text" (i32.const 4) (i32.const 191128) (i32.const 5)) (i32.const 1))
