(assert_return (invoke $mustache "number-size" (i32.const 32)) (i32.const 3))
(assert_return (invoke $mustache "number-text" (i32.const 32) (i32.const 192024) (i32.const 4)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 33)) (i32.const 4))
(assert_return (invoke $mustache "number-text" (i32.const 33) (i32.const 192056) (i32.const 5)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 34)) (i32.const 3))
(assert_return (invoke $mustache "number-text" (i32.const 34) (i32.const 192088) (i32.const 4)) (i32.const 1))
