(assert_return (invoke $mustache "number-size" (i32.const 23)) (i32.const 1))
(assert_return (invoke $mustache "number-text" (i32.const 23) (i32.const 191736) (i32.const 2)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 24)) (i32.const 5))
(assert_return (invoke $mustache "number-text" (i32.const 24) (i32.const 191768) (i32.const 6)) (i32.const 1))
