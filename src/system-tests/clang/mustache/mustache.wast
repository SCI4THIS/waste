(assert_return (invoke $mustache "number-text" (i32.const 5) (i32.const 191160) (i32.const 6)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 6)) (i32.const 7))
(assert_return (invoke $mustache "number-text" (i32.const 6) (i32.const 191192) (i32.const 8)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 7)) (i32.const 7))
(assert_return (invoke $mustache "number-text" (i32.const 7) (i32.const 191224) (i32.const 8)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 8)) (i32.const 7))
(assert_return (invoke $mustache "number-text" (i32.const 8) (i32.const 191256) (i32.const 8)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 9)) (i32.const 6))
(assert_return (invoke $mustache "number-text" (i32.const 9) (i32.const 191288) (i32.const 7)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 10)) (i32.const 6))
(assert_return (invoke $mustache "number-text" (i32.const 10) (i32.const 191320) (i32.const 7)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 11)) (i32.const 7))
(assert_return (invoke $mustache "number-text" (i32.const 11) (i32.const 191352) (i32.const 8)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 12)) (i32.const 7))
(assert_return (invoke $mustache "number-text" (i32.const 12) (i32.const 191384) (i32.const 8)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 13)) (i32.const 6))
(assert_return (invoke $mustache "number-text" (i32.const 13) (i32.const 191416) (i32.const 7)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 14)) (i32.const 5))
(assert_return (invoke $mustache "number-text" (i32.const 14) (i32.const 191448) (i32.const 6)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 15)) (i32.const 6))
(assert_return (invoke $mustache "number-text" (i32.const 15) (i32.const 191480) (i32.const 7)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 16)) (i32.const 5))
(assert_return (invoke $mustache "number-text" (i32.const 16) (i32.const 191512) (i32.const 6)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 17)) (i32.const 8))
(assert_return (invoke $mustache "number-text" (i32.const 17) (i32.const 191544) (i32.const 9)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 18)) (i32.const 6))
(assert_return (invoke $mustache "number-text" (i32.const 18) (i32.const 191576) (i32.const 7)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 19)) (i32.const 5))
(assert_return (invoke $mustache "number-text" (i32.const 19) (i32.const 191608) (i32.const 6)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 20)) (i32.const 11))
(assert_return (invoke $mustache "number-text" (i32.const 20) (i32.const 191640) (i32.const 12)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 21)) (i32.const 6))
(assert_return (invoke $mustache "number-text" (i32.const 21) (i32.const 191672) (i32.const 7)) (i32.const 1))
(assert_return (invoke $mustache "number-size" (i32.const 22)) (i32.const 8))
