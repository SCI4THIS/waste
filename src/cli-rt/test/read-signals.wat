;; The pselect wrapper lives in libc; the handler lives in this application.
;; Its table slot deliberately differs from its function index.
(module
  (import "env" "memory" (memory 2))
  (import "env" "__indirect_function_table" (table 10 funcref))
  (import "env" "__stack_pointer" (global $stack (mut i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "sigaction" (func $action (param i32 i32 i32) (result i32)))
  (import "env" "sigprocmask" (func $mask (param i32 i32 i32) (result i32)))
  (import "libc" "pselect" (func $select (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "env" "exit" (func $exit (param i32)))
  (import "env" "sigsetjmp" (func $setjmp (param i32 i32) (result i32)))
  (import "env" "siglongjmp" (func $longjmp (param i32 i32)))
  (export "__stack_pointer" (global $stack))
  (global $calls (mut i32) (i32.const 0))
  (global $caught (mut i32) (i32.const 0))
  (global $masked (mut i32) (i32.const 0))
  (func $handler (param i32)
    (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
    (global.set $caught (local.get 0))
    (if (call $mask (i32.const 0) (i32.const 0) (i32.const 256)) (then unreachable))
    (global.set $masked (i32.load (i32.const 256))))
  (func $trap (param i32) unreachable)
  (func $exit-handler (param i32) (call $exit (i32.const 23)))
  (func $blocking (param i32) (drop (call $read (i32.const 0) (i32.const 600) (i32.const 1))))
  (func $jump (param i32) (call $longjmp (i32.const 768) (i32.const 7)))
  (func $wrong (result i32) (i32.const 0))
  (elem (i32.const 2) $handler $trap $exit-handler $blocking $jump $wrong)
  (func (export "_start"))
  (func (export "action") (param $slot i32) (param $flags i32) (result i32)
    (memory.fill (i32.const 128) (i32.const 0) (i32.const 24))
    (i32.store (i32.const 128) (local.get $slot))
    (i32.store (i32.const 132) (i32.const 512)) ;; block SIGUSR1 during handler
    (i32.store (i32.const 148) (local.get $flags))
    (call $action (i32.const 28) (i32.const 128) (i32.const 0)))
  (func (export "alias-action") (result i32)
    (call $action (i32.const 28) (i32.const 128) (i32.const 128)))
  (func (export "old-flags") (result i32)
    (if (call $action (i32.const 28) (i32.const 0) (i32.const 160)) (then unreachable))
    (i32.load (i32.const 180)))
  (func (export "bad-output") (result i32)
    (i32.store (i32.const 128) (i32.const 3))
    (call $action (i32.const 28) (i32.const 128) (i32.const -8)))
  (func (export "read") (result i32)
    (i32.store8 (i32.const 512) (i32.const 165))
    (call $read (i32.const 0) (i32.const 512) (i32.const 1)))
  (func (export "select") (result i32)
    (i32.store8 (i32.const 512) (i32.const 165))
    (memory.fill (i32.const 320) (i32.const 0) (i32.const 128))
    (i32.store (i32.const 320) (i32.const 1))
    (call $select (i32.const 1) (i32.const 320) (i32.const 0)
      (i32.const 0) (i32.const 0) (i32.const 0)))
  (func (export "jump") (result i32) (local $n i32)
    (local.set $n (call $setjmp (i32.const 768) (i32.const 1)))
    (if (i32.eqz (local.get $n))
      (then (drop (call $read (i32.const 0) (i32.const 512) (i32.const 1)))))
    (local.get $n))
  (func (export "byte") (result i32) (i32.load8_u (i32.const 512)))
  (func (export "calls") (result i32) (global.get $calls))
  (func (export "caught") (result i32) (global.get $caught))
  (func (export "masked") (result i32) (global.get $masked)))
