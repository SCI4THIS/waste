# ---- f32 binary: pop 2 f32, push f32 ----
function emit_f32_bin(nm, expr) {
    printf "int execute_op_%s(waste_exec_context *ctx, const exec_instr *instr) {\n", nm > source
    print  "    (void)instr;" > source
    print  "    wasm_value right, left; float a, b;" > source
    print  "    if (!stack_pop(ctx->operand_stack, &right) || right.type != WASM_VALTYPE_F32 ||" > source
    print  "        !stack_pop(ctx->operand_stack, &left) || left.type != WASM_VALTYPE_F32)" > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"f32 operands missing\");" > source
    print  "    memcpy(&a, &left.f32, 4); memcpy(&b, &right.f32, 4);" > source
    printf "    float result = %s;\n", expr > source
    print  "    wasm_value out; memset(&out, 0, sizeof(out));" > source
    print  "    out.type = WASM_VALTYPE_F32; memcpy(&out.f32, &result, 4);" > source
    print  "    if (!stack_push(ctx->operand_stack, out))" > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"stack overflow\");" > source
    print  "    return EXEC_OK;" > source
    print  "}" > source
    print  "" > source
}

