#!/usr/bin/awk -f
# gen-dispatch.awk — reads opcodes.tab, emits dispatch_gen.h and dispatch_gen.c
#
# Usage:
#   awk -v outdir=build/engine/gen -f gen-dispatch.awk opcodes.tab
# Writes: dispatch_gen.h and dispatch_gen.c into outdir (default: current dir)

BEGIN {
    FS = "|"
    if (outdir == "") outdir = "."
    header = outdir "/dispatch_gen.h"
    source = outdir "/dispatch_gen.c"
    n = 0  # entry count
}

# Skip comments and blank lines
/^#/ || /^[[:space:]]*$/ { next }

{
    # Trim whitespace from each field
    for (i = 1; i <= NF; i++) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i)
    }

    prefix[n]   = $1
    sub_op[n]   = $2
    name[n]     = $3
    template[n] = $4
    validate[n] = $5
    # Fields 6+ are template parameters.
    # Rejoin into a single string first (recovers C "|" operators
    # that were split by the pipe field separator), then split on
    # semicolons for templates that take multiple parameters.
    joined = ""
    for (i = 6; i <= NF; i++) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i)
        if (i > 6) joined = joined "|"
        joined = joined $i
    }
    nparam = split(joined, _parts, ";")
    for (i = 1; i <= nparam; i++) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", _parts[i])
        params[n, i - 1] = _parts[i]
    }
    if (nparam == 0 && joined != "") {
        params[n, 0] = joined
        nparam = 1
    }
    param_count[n] = nparam
    n++
}

END {
    emit_header()
    emit_source()
}

function emit_header() {
    print "/* Generated by gen-dispatch.awk — do not edit */" > header
    print "#ifndef WASTE_DISPATCH_GEN_H" > header
    print "#define WASTE_DISPATCH_GEN_H" > header
    print "" > header
    print "#include \"op/validate.h\"" > header
    print "" > header
    print "/* ---- Dispatch table types ---- */" > header
    print "" > header
    print "typedef wasm_validation_status (*wasm_validate_handler)(" > header
    print "    wasm_validate_context *ctx, const exec_instr *instr);" > header
    print "" > header
    print "typedef int (*wasm_exec_handler)(waste_exec_context *ctx," > header
    print "                                 const exec_instr *instr);" > header
    print "" > header
    print "typedef struct {" > header
    print "    wasm_exec_handler execute;" > header
    print "    wasm_validate_handler validate;" > header
    print "} wasm_opcode_dispatch;" > header
    print "" > header
    print "/* Lookup: resolves single or multi-byte opcodes */" > header
    print "const wasm_opcode_dispatch *wasm_opcode_get_dispatch(const exec_instr *instr);" > header
    print "" > header

    # Collect unique handler names
    delete seen_exec
    delete seen_validate
    delete exec_names
    delete validate_names
    nexec = 0
    nvalidate = 0

    for (i = 0; i < n; i++) {
        if (template[i] == "CUSTOM") {
            ename = params[i, 0]
        } else {
            ename = "execute_op_" name[i]
        }
        if (!(ename in seen_exec)) {
            seen_exec[ename] = 1
            exec_names[nexec++] = ename
        }
        vname = validate[i]
        if (!(vname in seen_validate)) {
            seen_validate[vname] = 1
            validate_names[nvalidate++] = vname
        }
    }

    print "/* ---- Validate handler declarations ---- */" > header
    print "" > header
    for (i = 0; i < nvalidate; i++) {
        printf "wasm_validation_status %s(wasm_validate_context *ctx, const exec_instr *instr);\n", validate_names[i] > header
    }

    print "" > header
    print "/* ---- Execute handler declarations ---- */" > header
    print "" > header
    for (i = 0; i < nexec; i++) {
        printf "int %s(waste_exec_context *ctx, const exec_instr *instr);\n", exec_names[i] > header
    }

    print "" > header
    print "#endif" > header
    close(header)
}

function emit_source() {
    print "/* Generated by gen-dispatch.awk — do not edit */" > source
    print "#include \"dispatch_gen.h\"" > source
    print "" > source
    print "" > source
    print "#include <limits.h>" > source
    print "#include <math.h>" > source
    print "#include <string.h>" > source
    print "" > source

    # Emit helper functions needed by generated code
    emit_helpers()

    # Emit generated handler functions
    for (i = 0; i < n; i++) {
        if (template[i] != "CUSTOM") {
            emit_handler(i)
        }
    }

    # Emit dispatch table
    emit_dispatch_table()
}

function emit_helpers() {
    print "/* ---- Rotate helpers ---- */" > source
    print "" > source
    print "static uint32_t gen_rotl32(uint32_t v, uint32_t c) {" > source
    print "    c &= 31u; return c ? (v << c) | (v >> (32u - c)) : v;" > source
    print "}" > source
    print "static uint32_t gen_rotr32(uint32_t v, uint32_t c) {" > source
    print "    c &= 31u; return c ? (v >> c) | (v << (32u - c)) : v;" > source
    print "}" > source
    print "" > source
}

function emit_handler(i,    t, nm, expr) {
    t = template[i]
    nm = name[i]
    expr = params[i, 0]

    if (t == "I32_BIN")      emit_i32_bin(nm, expr)
    else if (t == "I32_UN")  emit_i32_un(nm, expr)
    else if (t == "I64_BIN") emit_i64_bin(nm, expr)
    else if (t == "I64_UN")  emit_i64_un(nm, expr)
    else if (t == "I64_CMP") emit_i64_cmp(nm, expr)
    else if (t == "I64_TEST") emit_i64_test(nm, expr)
    else if (t == "F32_BIN") emit_f32_bin(nm, expr)
    else if (t == "F32_UN")  emit_f32_un(nm, expr)
    else if (t == "F32_CMP") emit_f32_cmp(nm, expr)
    else if (t == "F64_BIN") emit_f64_bin(nm, expr)
    else if (t == "F64_UN")  emit_f64_un(nm, expr)
    else if (t == "F64_CMP") emit_f64_cmp(nm, expr)
    else if (t == "I32_DIV_S") emit_i32_div_s(nm)
    else if (t == "I32_DIV_U") emit_i32_div_u(nm)
    else if (t == "I32_REM_S") emit_i32_rem_s(nm)
    else if (t == "I32_REM_U") emit_i32_rem_u(nm)
    else if (t == "I64_DIV_S") emit_i64_div_s(nm)
    else if (t == "I64_DIV_U") emit_i64_div_u(nm)
    else if (t == "I64_REM_S") emit_i64_rem_s(nm)
    else if (t == "I64_REM_U") emit_i64_rem_u(nm)
    else if (t == "I32_ROTL") emit_i32_rot(nm, "gen_rotl32")
    else if (t == "I32_ROTR") emit_i32_rot(nm, "gen_rotr32")
    else if (t == "I64_ROTL") emit_i64_rot(nm, "l")
    else if (t == "I64_ROTR") emit_i64_rot(nm, "r")
    else if (t == "F32_MIN")  emit_f_minmax(nm, "f32", "float", 4, "min")
    else if (t == "F32_MAX")  emit_f_minmax(nm, "f32", "float", 4, "max")
    else if (t == "F32_COPYSIGN") emit_f_copysign(nm, "f32", "float", 4, "uint32_t", "0x7fffffffu", "0x80000000u")
    else if (t == "F64_MIN")  emit_f_minmax(nm, "f64", "double", 8, "min")
    else if (t == "F64_MAX")  emit_f_minmax(nm, "f64", "double", 8, "max")
    else if (t == "F64_COPYSIGN") emit_f_copysign(nm, "f64", "double", 8, "uint64_t", "UINT64_C(0x7fffffffffffffff)", "UINT64_C(0x8000000000000000)")
    else if (t == "CONST_I32") emit_const_i32(nm)
    else if (t == "CONST_I64") emit_const_i64(nm)
    else if (t == "CONST_F32") emit_const_f32(nm)
    else if (t == "CONST_F64") emit_const_f64(nm)
    else if (t == "CONV")      emit_conv(nm, i)
    else if (t == "CONV_F")    emit_conv_float(nm, i)
    else if (t == "CONV_DEMOTE")  emit_conv_demote(nm)
    else if (t == "CONV_PROMOTE") emit_conv_promote(nm)
    else if (t == "TRUNC")     emit_trunc(nm, i)
    else if (t == "REINTERPRET") emit_reinterpret(nm, i)
}

# ---- i32 binary: pop 2 i32, push i32 ----
function emit_i32_bin(nm, expr) {
    printf "int execute_op_%s(waste_exec_context *ctx, const exec_instr *instr) {\n", nm > source
    print  "    (void)instr;" > source
    print  "    wasm_value right, left;" > source
    print  "    if (!stack_pop(ctx->operand_stack, &right) || right.type != WASM_VALTYPE_I32 ||" > source
    print  "        !stack_pop(ctx->operand_stack, &left) || left.type != WASM_VALTYPE_I32)" > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"i32 operands missing\");" > source
    print  "    uint32_t a = (uint32_t)left.i32, b = (uint32_t)right.i32;" > source
    printf "    if (!stack_push(ctx->operand_stack, i32_value(%s)))\n", expr > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"stack overflow\");" > source
    print  "    return EXEC_OK;" > source
    print  "}" > source
    print  "" > source
}

