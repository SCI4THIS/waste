# ---- Truncation with range check (trapping) ----
# params: src_field ; dst_field ; min_bound ; max_bound ; lo_op ; assign_expr
function emit_trunc(nm, idx,    src, dst, lo, hi, lo_op, expr, ft, sz) {
    src   = params[idx, 0]
    dst   = params[idx, 1]
    lo    = params[idx, 2]
    hi    = params[idx, 3]
    lo_op = params[idx, 4]
    expr  = params[idx, 5]
    if (src == "f32") { ft = "float"; sz = 4 }
    else              { ft = "double"; sz = 8 }
    printf "int execute_op_%s(waste_exec_context *ctx, const exec_instr *instr) {\n", nm > source
    print  "    (void)instr;" > source
    print  "    wasm_value v;" > source
    printf "    if (!stack_pop(ctx->operand_stack, &v) || v.type != WASM_VALTYPE_%s)\n", toupper(src) > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"conversion operand missing\");" > source
    printf "    %s f; memcpy(&f, &v.%s, %d);\n", ft, src, sz > source
    printf "    if (f != f || f %s %s || f >= %s)\n", lo_op, lo, hi > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"invalid conversion to integer\");" > source
    print  "    wasm_value out; memset(&out, 0, sizeof(out));" > source
    printf "    out.type = WASM_VALTYPE_%s; %s;\n", toupper(dst), expr > source
    print  "    if (!stack_push(ctx->operand_stack, out))" > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"stack overflow\");" > source
    print  "    return EXEC_OK;" > source
    print  "}" > source
    print  "" > source
}

# ---- Reinterpret (memcpy between fields) ----
# params: src_field | dst_field | byte_width
function emit_reinterpret(nm, idx,    src, dst, sz, src_int, dst_int) {
    src = params[idx, 0]
    dst = params[idx, 1]
    sz  = params[idx, 2]
    if (sz == 4) { src_int = "uint32_t"; dst_int = "uint32_t" }
    else         { src_int = "uint64_t"; dst_int = "uint64_t" }
    printf "int execute_op_%s(waste_exec_context *ctx, const exec_instr *instr) {\n", nm > source
    print  "    (void)instr;" > source
    print  "    wasm_value v;" > source
    printf "    if (!stack_pop(ctx->operand_stack, &v) || v.type != WASM_VALTYPE_%s)\n", toupper(src) > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"reinterpret operand missing\");" > source
    print  "    wasm_value out; memset(&out, 0, sizeof(out));" > source
    printf "    out.type = WASM_VALTYPE_%s;\n", toupper(dst) > source
    # Determine field accessors based on type
    if (src == "f32" && dst == "i32") {
        printf "    %s tmp; memcpy(&tmp, &v.f32, %s); out.i32 = (int32_t)tmp;\n", src_int, sz > source
    } else if (src == "f64" && dst == "i64") {
        printf "    %s tmp; memcpy(&tmp, &v.f64, %s); out.i64 = (int64_t)tmp;\n", src_int, sz > source
    } else if (src == "i32" && dst == "f32") {
        printf "    %s tmp = (uint32_t)v.i32; memcpy(&out.f32, &tmp, %s);\n", src_int, sz > source
    } else if (src == "i64" && dst == "f64") {
        printf "    %s tmp = (uint64_t)v.i64; memcpy(&out.f64, &tmp, %s);\n", src_int, sz > source
    }
    print  "    if (!stack_push(ctx->operand_stack, out))" > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"stack overflow\");" > source
    print  "    return EXEC_OK;" > source
    print  "}" > source
    print  "" > source
}

# ---- Dispatch table emission ----
function emit_dispatch_table(    i, opcode, exec_name) {
    print "/* ---- Main dispatch table ---- */" > source
    print "" > source
    print "static const wasm_opcode_dispatch dispatch_table[256] = {" > source
    for (i = 0; i < n; i++) {
        if (prefix[i] != "-") continue
        opcode = sub_op[i]
        if (template[i] == "CUSTOM") {
            exec_name = params[i, 0]
        } else {
            exec_name = "execute_op_" name[i]
        }
        printf "    [%s] = { %s, %s },\n", opcode, exec_name, validate[i] > source
    }
    print "};" > source
    print "" > source

    # Lookup function
    print "const wasm_opcode_dispatch *wasm_opcode_get_dispatch(const exec_instr *instr) {" > source
    print "    if (instr->opcode > 0xff) return NULL;" > source
    print "    const wasm_opcode_dispatch *entry = &dispatch_table[instr->opcode];" > source
    print "    if (!entry->execute && !entry->validate) return NULL;" > source
    print "    return entry;" > source
    print "}" > source
}
