# ---- i64 rotate ----
function emit_i64_rot(nm, dir) {
    printf "int execute_op_%s(waste_exec_context *ctx, const exec_instr *instr) {\n", nm > source
    print  "    (void)instr;" > source
    print  "    wasm_value right, left;" > source
    print  "    if (!stack_pop(ctx->operand_stack, &right) || right.type != WASM_VALTYPE_I64 ||" > source
    print  "        !stack_pop(ctx->operand_stack, &left) || left.type != WASM_VALTYPE_I64)" > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"i64 operands missing\");" > source
    print  "    uint64_t a = (uint64_t)left.i64;" > source
    print  "    uint32_t c = (uint32_t)((uint64_t)right.i64 & 63u);" > source
    if (dir == "l") {
        print  "    uint64_t result = c ? (a << c) | (a >> (64u - c)) : a;" > source
    } else {
        print  "    uint64_t result = c ? (a >> c) | (a << (64u - c)) : a;" > source
    }
    print  "    wasm_value out; memset(&out, 0, sizeof(out));" > source
    print  "    out.type = WASM_VALTYPE_I64; out.i64 = (int64_t)result;" > source
    print  "    if (!stack_push(ctx->operand_stack, out))" > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"stack overflow\");" > source
    print  "    return EXEC_OK;" > source
    print  "}" > source
    print  "" > source
}

# ---- float min/max with Wasm NaN/zero semantics ----
function emit_f_minmax(nm, vt, ct, sz, op,    sign_mask, exp_mask, frac_mask, canon) {
    if (sz == 4) {
        sign_mask = "0x80000000u"
        exp_mask  = "0x7F800000u"
        frac_mask = "0x007FFFFFu"
        canon     = "0x7FC00000u"
    } else {
        sign_mask = "UINT64_C(0x8000000000000000)"
        exp_mask  = "UINT64_C(0x7FF0000000000000)"
        frac_mask = "UINT64_C(0x000FFFFFFFFFFFFF)"
        canon     = "UINT64_C(0x7FF8000000000000)"
    }
    printf "int execute_op_%s(waste_exec_context *ctx, const exec_instr *instr) {\n", nm > source
    print  "    (void)instr;" > source
    printf "    wasm_value right, left; %s a, b;\n", ct > source
    printf "    if (!stack_pop(ctx->operand_stack, &right) || right.type != WASM_VALTYPE_%s ||\n", toupper(vt) > source
    printf "        !stack_pop(ctx->operand_stack, &left) || left.type != WASM_VALTYPE_%s)\n", toupper(vt) > source
    printf "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"%s operands missing\");\n", vt > source
    printf "    memcpy(&a, &left.%s, %d); memcpy(&b, &right.%s, %d);\n", vt, sz, vt, sz > source
    if (sz == 4) {
        print  "    uint32_t ai, bi;" > source
        printf "    memcpy(&ai, &a, %d); memcpy(&bi, &b, %d);\n", sz, sz > source
        printf "    int a_nan = ((ai & %s) == %s) && (ai & %s);\n", exp_mask, exp_mask, frac_mask > source
        printf "    int b_nan = ((bi & %s) == %s) && (bi & %s);\n", exp_mask, exp_mask, frac_mask > source
    } else {
        print  "    uint64_t ai, bi;" > source
        printf "    memcpy(&ai, &a, %d); memcpy(&bi, &b, %d);\n", sz, sz > source
        printf "    int a_nan = ((ai & %s) == %s) && (ai & %s);\n", exp_mask, exp_mask, frac_mask > source
        printf "    int b_nan = ((bi & %s) == %s) && (bi & %s);\n", exp_mask, exp_mask, frac_mask > source
    }
    printf "    %s result;\n", ct > source
    if (sz == 4) {
        printf "    if (a_nan || b_nan) { uint32_t r = %s; memcpy(&result, &r, %d); }\n", canon, sz > source
    } else {
        printf "    if (a_nan || b_nan) { uint64_t r = %s; memcpy(&result, &r, %d); }\n", canon, sz > source
    }
    if (op == "min") {
        if (sz == 4) {
            printf "    else if (a == 0.0f && b == 0.0f) { uint32_t r = ai | bi; memcpy(&result, &r, %d); }\n", sz > source
        } else {
            printf "    else if (a == 0.0 && b == 0.0) { uint64_t r = ai | bi; memcpy(&result, &r, %d); }\n", sz > source
        }
        print  "    else result = a < b ? a : b;" > source
    } else {
        if (sz == 4) {
            printf "    else if (a == 0.0f && b == 0.0f) { uint32_t r = ai & bi; memcpy(&result, &r, %d); }\n", sz > source
        } else {
            printf "    else if (a == 0.0 && b == 0.0) { uint64_t r = ai & bi; memcpy(&result, &r, %d); }\n", sz > source
        }
        print  "    else result = a > b ? a : b;" > source
    }
    print  "    wasm_value out; memset(&out, 0, sizeof(out));" > source
    printf "    out.type = WASM_VALTYPE_%s; memcpy(&out.%s, &result, %d);\n", toupper(vt), vt, sz > source
    print  "    if (!stack_push(ctx->operand_stack, out))" > source
    print  "        return exec_fail(ctx->error, EXEC_ERROR_TRAP, \"stack overflow\");" > source
    print  "    return EXEC_OK;" > source
    print  "}" > source
    print  "" > source
}

