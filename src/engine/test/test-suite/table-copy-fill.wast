
;; i32 offsets and lengths; both spellings preserve table identity and refs.
(module (type $t (func (result i32)))
  (func $seed (type $t) (i32.const 7))
  (func $f0 (type $t) (i32.const 11))
  (func $f1 (type $t) (i32.const 19))
  (func $f2 (type $t) (i32.const 37))
  (func $f3 (type $t) (i32.const 53))
  (func $f4 (type $t) (i32.const 71))
  (func $fill (type $t) (i32.const 97))
  (func (export "reset")
    (table.fill $target (i32.const 0) (ref.func $seed) (i32.const 5))
    (table.fill $peer (i32.const 0) (ref.func $seed) (i32.const 5))
    (table.init $src $pattern (i32.const 0) (i32.const 0) (i32.const 5)))
  (func (export "seed-target") (table.init $target $pattern (i32.const 0) (i32.const 0) (i32.const 5)))
  (func (export "read0") (param i32) (result i32) (call_indirect 0 (type $t) (local.get 0)))
  (func (export "read1") (param i32) (result i32) (call_indirect 1 (type $t) (local.get 0)))
  (func (export "read2") (param i32) (result i32) (call_indirect 2 (type $t) (local.get 0)))
  (func (export "flat-copy-default") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy
  )
  (func (export "flat-copy-nn") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy 0 1
  )
  (func (export "flat-copy-ni") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy 0 $src
  )
  (func (export "flat-copy-in") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy $target 1
  )
  (func (export "flat-copy-ii") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy $target $src
  )
  (func (export "flat-copy-reverse") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy 1 $target
  )
  (func (export "flat-copy-self") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy 1 1
  )
  (func (export "flat-fill-default") (param i32 i32)
    local.get 0 ref.func $fill local.get 1 table.fill
  )
  (func (export "flat-fill-numeric") (param i32 i32)
    local.get 0 ref.func $fill local.get 1 table.fill 0
  )
  (func (export "flat-fill-named") (param i32 i32)
    local.get 0 ref.func $fill local.get 1 table.fill $target
  )
  (func (export "flat-fill-src-numeric") (param i32 i32)
    local.get 0 ref.func $fill local.get 1 table.fill 1
  )
  (func (export "flat-fill-src-named") (param i32 i32)
    local.get 0 ref.func $fill local.get 1 table.fill $src
  )
  (func (export "flat-null") (param i32 i32)
    local.get 0 ref.null func local.get 1 table.fill 0
  )
  (func (export "fold-copy-default") (param i32 i32 i32)
    (table.copy (local.get 0) (local.get 1) (local.get 2))
  )
  (func (export "fold-copy-nn") (param i32 i32 i32)
    (table.copy 0 1 (local.get 0) (local.get 1) (local.get 2))
  )
  (func (export "fold-copy-ni") (param i32 i32 i32)
    (table.copy 0 $src (local.get 0) (local.get 1) (local.get 2))
  )
  (func (export "fold-copy-in") (param i32 i32 i32)
    (table.copy $target 1 (local.get 0) (local.get 1) (local.get 2))
  )
  (func (export "fold-copy-ii") (param i32 i32 i32)
    (table.copy $target $src (local.get 0) (local.get 1) (local.get 2))
  )
  (func (export "fold-copy-reverse") (param i32 i32 i32)
    (table.copy 1 $target (local.get 0) (local.get 1) (local.get 2))
  )
  (func (export "fold-copy-self") (param i32 i32 i32)
    (table.copy 1 1 (local.get 0) (local.get 1) (local.get 2))
  )
  (func (export "fold-fill-default") (param i32 i32)
    (table.fill (local.get 0) (ref.func $fill) (local.get 1))
  )
  (func (export "fold-fill-numeric") (param i32 i32)
    (table.fill 0 (local.get 0) (ref.func $fill) (local.get 1))
  )
  (func (export "fold-fill-named") (param i32 i32)
    (table.fill $target (local.get 0) (ref.func $fill) (local.get 1))
  )
  (func (export "fold-fill-src-numeric") (param i32 i32)
    (table.fill 1 (local.get 0) (ref.func $fill) (local.get 1))
  )
  (func (export "fold-fill-src-named") (param i32 i32)
    (table.fill $src (local.get 0) (ref.func $fill) (local.get 1))
  )
  (func (export "fold-null") (param i32 i32)
    (table.fill 0 (local.get 0) (ref.null func) (local.get 1))
  )
  (table $target 5 funcref)
  (table $src 5 funcref)
  (table $peer 5 funcref)
  (elem $pattern func $f0 $f1 $f2 $f3 $f4)
  (elem declare func $seed $fill)
)
