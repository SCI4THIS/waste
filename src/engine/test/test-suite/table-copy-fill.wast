(assert_return (invoke "fold-fill-named" (i64.const 1) (i64.const 3)))
(assert_return (invoke "read0" (i64.const 0)) (i32.const 7))
(assert_return (invoke "read0" (i64.const 1)) (i32.const 97))
(assert_return (invoke "read0" (i64.const 3)) (i32.const 97))
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_return (invoke "read2" (i64.const 0)) (i32.const 7))
(assert_return (invoke "reset"))
(assert_return (invoke "fold-fill-src-numeric" (i64.const 1) (i64.const 3)))
(assert_return (invoke "read1" (i64.const 0)) (i32.const 11))
(assert_return (invoke "read1" (i64.const 1)) (i32.const 97))
(assert_return (invoke "read1" (i64.const 3)) (i32.const 97))
(assert_return (invoke "read1" (i64.const 4)) (i32.const 71))
(assert_return (invoke "read2" (i64.const 0)) (i32.const 7))
(assert_return (invoke "reset"))
(assert_return (invoke "fold-fill-src-named" (i64.const 1) (i64.const 3)))
(assert_return (invoke "read1" (i64.const 0)) (i32.const 11))
(assert_return (invoke "read1" (i64.const 1)) (i32.const 97))
(assert_return (invoke "read1" (i64.const 3)) (i32.const 97))
(assert_return (invoke "read1" (i64.const 4)) (i32.const 71))
(assert_return (invoke "read2" (i64.const 0)) (i32.const 7))
(assert_return (invoke "reset"))
(assert_return (invoke "fold-null" (i64.const 1) (i64.const 3)))
(assert_trap (invoke "read0" (i64.const 1)) "uninitialized element")
(assert_trap (invoke "read0" (i64.const 3)) "uninitialized element")
(assert_return (invoke "read0" (i64.const 0)) (i32.const 7))
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_return (invoke "fold-copy-reverse" (i64.const 0) (i64.const 1) (i64.const 3)))
(assert_trap (invoke "read1" (i64.const 0)) "uninitialized element")
(assert_return (invoke "reset"))
(assert_return (invoke "fold-copy-nn" (i64.const 5) (i64.const 5) (i64.const 0)))
(assert_return (invoke "fold-fill-default" (i64.const 5) (i64.const 0)))
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_trap (invoke "fold-copy-nn" (i64.const 4) (i64.const 0) (i64.const 2)) "out of bounds table access")
(assert_return (invoke "read0" (i64.const 0)) (i32.const 7))
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_trap (invoke "fold-copy-nn" (i64.const 0) (i64.const 4) (i64.const 2)) "out of bounds table access")
(assert_return (invoke "read0" (i64.const 0)) (i32.const 7))
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_trap (invoke "fold-copy-nn" (i64.const 6) (i64.const 0) (i64.const 0)) "out of bounds table access")
(assert_return (invoke "read0" (i64.const 0)) (i32.const 7))
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_trap (invoke "fold-copy-nn" (i64.const 0) (i64.const 6) (i64.const 0)) "out of bounds table access")
(assert_return (invoke "read0" (i64.const 0)) (i32.const 7))
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_trap (invoke "fold-copy-nn" (i64.const -1) (i64.const 0) (i64.const 0)) "out of bounds table access")
(assert_return (invoke "read0" (i64.const 0)) (i32.const 7))
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_trap (invoke "fold-copy-nn" (i64.const 0) (i64.const -1) (i64.const 0)) "out of bounds table access")
(assert_return (invoke "read0" (i64.const 0)) (i32.const 7))
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_trap (invoke "fold-fill-default" (i64.const 4) (i64.const 2)) "out of bounds table access")
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_trap (invoke "fold-fill-default" (i64.const 6) (i64.const 0)) "out of bounds table access")
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_trap (invoke "fold-fill-default" (i64.const -1) (i64.const 0)) "out of bounds table access")
(assert_return (invoke "read0" (i64.const 4)) (i32.const 7))
(assert_trap (invoke "fold-copy-nn" (i64.const 4294967296) (i64.const 0) (i64.const 0)) "out of bounds table access")
(assert_trap (invoke "fold-copy-nn" (i64.const 0) (i64.const 4294967296) (i64.const 0)) "out of bounds table access")
(assert_trap (invoke "fold-copy-nn" (i64.const 0) (i64.const 0) (i64.const 4294967296)) "out of bounds table access")
(assert_trap (invoke "fold-fill-default" (i64.const 0) (i64.const 4294967296)) "out of bounds table access")

;; Mixed address widths retain an i32 count in either copy direction.
(module (func $a (result i32) (i32.const 11)) (func $b (result i32) (i32.const 29))
  (func $c (result i32) (i32.const 53)) (func $d (result i32) (i32.const 71))
  (table $small 2 funcref) (table $wide i64 2 funcref)
  (elem $small-data func $a $b) (elem $wide-data func $c $d)
  (func (export "reset") (table.init $small $small-data (i32.const 0) (i32.const 0) (i32.const 2))
    (table.init $wide $wide-data (i64.const 0) (i32.const 0) (i32.const 2)))
  (func (export "flat-to-small") (i32.const 0) (i64.const 1) (i32.const 1) table.copy 0 $wide)
  (func (export "flat-to-wide") (i64.const 0) (i32.const 1) (i32.const 1) table.copy $wide 0)
  (func (export "fold-to-small") (table.copy 0 $wide (i32.const 0) (i64.const 1) (i32.const 1)))
  (func (export "fold-to-wide") (table.copy $wide 0 (i64.const 0) (i32.const 1) (i32.const 1)))
  (func (export "small") (result i32) (call_indirect $small (result i32) (i32.const 0)))
  (func (export "wide") (result i32) (call_indirect $wide (result i32) (i64.const 0)))
)
(assert_return (invoke "reset"))
(assert_return (invoke "flat-to-small"))
(assert_return (invoke "small") (i32.const 71))
(assert_return (invoke "wide") (i32.const 53))
(assert_return (invoke "reset"))
(assert_return (invoke "flat-to-wide"))
(assert_return (invoke "wide") (i32.const 29))
(assert_return (invoke "small") (i32.const 11))
(assert_return (invoke "reset"))
(assert_return (invoke "fold-to-small"))
(assert_return (invoke "small") (i32.const 71))
(assert_return (invoke "wide") (i32.const 53))
(assert_return (invoke "reset"))
(assert_return (invoke "fold-to-wide"))
(assert_return (invoke "wide") (i32.const 29))
(assert_return (invoke "small") (i32.const 11))

;; Externref fill and copy preserve identity, including null replacements.
(module (table $e 2 externref)
  (func (export "fill") (param externref) i32.const 0 local.get 0 i32.const 2 table.fill)
  (func (export "null") (table.fill 0 (i32.const 1) (ref.null extern) (i32.const 1)))
  (func (export "copy") i32.const 1 i32.const 0 i32.const 1 table.copy 0 0)
  (func (export "get") (param i32) (result externref) (table.get $e (local.get 0)))
)
(assert_return (invoke "fill" (ref.extern 17)))
(assert_return (invoke "get" (i32.const 0)) (ref.extern 17))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 17))
(assert_return (invoke "null"))
(assert_return (invoke "get" (i32.const 0)) (ref.extern 17))
(assert_return (invoke "get" (i32.const 1)) (ref.null extern))
(assert_return (invoke "copy"))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 17))

;; Non-null tables accept non-null fill and compatible copies.
(module (func $f (result i32) (i32.const 11)) (func $g (result i32) (i32.const 29))
  (table $n 2 (ref func) (ref.func $f)) (elem declare func $g)
  (func (export "fill") i32.const 0 ref.func $g i32.const 1 table.fill $n)
  (func (export "copy") (table.copy 0 0 (i32.const 1) (i32.const 0) (i32.const 1)))
  (func (export "call") (param i32) (result i32) (call_indirect $n (result i32) (local.get 0)))
)
(assert_return (invoke "fill"))
(assert_return (invoke "call" (i32.const 0)) (i32.const 29))
(assert_return (invoke "call" (i32.const 1)) (i32.const 11))
(assert_return (invoke "copy"))
(assert_return (invoke "call" (i32.const 1)) (i32.const 29))

;; Foreign function owners survive copy, and fill can publish a consumer ref.
(module $provider (func $f (result i32) (i32.const 29))
  (table 1 funcref) (export "source" (table 0)) (elem (i32.const 0) $f)
  (func (export "call") (result i32) (call_indirect (result i32) (i32.const 0))))
(register "copy-provider")
(module $consumer (table $source (import "copy-provider" "source") 1 funcref)
  (func $own (result i32) (i32.const 97)) (table $target 1 funcref) (elem (table $target) (i32.const 0) func $own)
  (func (export "copy") i32.const 0 i32.const 0 i32.const 1 table.copy $target $source)
  (func (export "fill") i32.const 0 ref.func $own i32.const 1 table.fill $source)
  (func (export "call") (result i32) (call_indirect $target (result i32) (i32.const 0))))
(assert_return (invoke "call") (i32.const 97))
(assert_return (invoke "copy"))
(assert_return (invoke "call") (i32.const 29))
(assert_return (invoke "fill"))
(assert_return (invoke $provider "call") (i32.const 97))

;; Invalid modules and malformed text must reject without losing an operator.
(assert_invalid (module (table $t 1 funcref) (func (i32.const 0) (i32.const 0) (i32.const 0) table.copy 2 0)) "unknown table")
(assert_invalid (module (table $t 1 funcref) (func (i32.const 0) (i32.const 0) (i32.const 0) table.copy 0 2)) "unknown table")
(assert_invalid (module (table $t 1 funcref) (func (i32.const 0) (ref.null func) (i32.const 0) table.fill 2)) "unknown table")
(assert_invalid (module (table $t 1 funcref) (func (i32.const 0) (ref.null extern) (i32.const 0) table.fill 0)) "type mismatch")
(assert_invalid (module (table $t 1 funcref) (func  table.copy 0 0)) "type mismatch")
(assert_invalid (module (table $t 1 funcref) (func  table.fill 0)) "type mismatch")
(assert_invalid (module (table $t 1 funcref) (func  table.fill $t)) "type mismatch")
(assert_invalid (module (table i64 1 funcref) (func (i64.const 0) (i64.const 0) (i32.const 0) table.copy 0 0)) "type mismatch")
(assert_invalid (module (table i64 1 funcref) (func (i32.const 0) (ref.null func) (i64.const 0) table.fill 0)) "type mismatch")
(assert_invalid (module (table i64 1 funcref) (func (i64.const 0) (ref.null func) (i32.const 0) table.fill 0)) "type mismatch")
(assert_invalid (module (table 1 funcref) (table i64 1 funcref) (func (i32.const 0) (i64.const 0) (i64.const 0) table.copy 0 1)) "type mismatch")
(assert_invalid (module (func $f) (table $n 1 (ref func) (ref.func $f)) (table $p 1 funcref) (func (i32.const 0) (i32.const 0) (i32.const 0) table.copy $n $p)) "type mismatch")
(assert_invalid (module (func $f) (table $n 1 (ref func) (ref.func $f)) (func (i32.const 0) (ref.null func) (i32.const 0) table.fill $n)) "type mismatch")
(assert_invalid (module (table $t 1 funcref) (func (table.copy 2 0 (i32.const 0) (i32.const 0) (i32.const 0)))) "unknown table")
(assert_invalid (module (table $t 1 funcref) (func (table.copy 0 2 (i32.const 0) (i32.const 0) (i32.const 0)))) "unknown table")
(assert_invalid (module (table $t 1 funcref) (func (table.fill 2 (i32.const 0) (ref.null func) (i32.const 0)))) "unknown table")
(assert_invalid (module (table $t 1 funcref) (func (table.fill 0 (i32.const 0) (ref.null extern) (i32.const 0)))) "type mismatch")
(assert_invalid (module (table $t 1 funcref) (func (table.copy 0 0 ))) "type mismatch")
(assert_invalid (module (table $t 1 funcref) (func (table.fill 0 ))) "type mismatch")
(assert_invalid (module (table $t 1 funcref) (func (table.fill $t ))) "type mismatch")
(assert_invalid (module (table i64 1 funcref) (func (table.copy 0 0 (i64.const 0) (i64.const 0) (i32.const 0)))) "type mismatch")
(assert_invalid (module (table i64 1 funcref) (func (table.fill 0 (i32.const 0) (ref.null func) (i64.const 0)))) "type mismatch")
(assert_invalid (module (table i64 1 funcref) (func (table.fill 0 (i64.const 0) (ref.null func) (i32.const 0)))) "type mismatch")
(assert_invalid (module (table 1 funcref) (table i64 1 funcref) (func (table.copy 0 1 (i32.const 0) (i64.const 0) (i64.const 0)))) "type mismatch")
(assert_invalid (module (func $f) (table $n 1 (ref func) (ref.func $f)) (table $p 1 funcref) (func (table.copy $n $p (i32.const 0) (i32.const 0) (i32.const 0)))) "type mismatch")
(assert_invalid (module (func $f) (table $n 1 (ref func) (ref.func $f)) (func (table.fill $n (i32.const 0) (ref.null func) (i32.const 0)))) "type mismatch")
(assert_malformed (module quote "(module (table 1 funcref) (func table.copy 0))") "unexpected token")
(assert_malformed (module quote "(module (table 1 funcref) (func table.copy $absent 0))") "unknown table")
(assert_malformed (module quote "(module (table 1 funcref) (func table.fill $absent))") "unknown table")
