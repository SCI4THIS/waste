;; Required immediates and unresolved symbolic references are malformed text.
(assert_malformed (module quote "(module (table 1 funcref) (elem func) (func table.init))\n") "unexpected token")
(assert_malformed (module quote "(module (data \"owned parser payload\") (elem func) (func data.drop))\n") "unexpected token")
(assert_malformed (module quote "(module (data \"owned parser payload\") (elem func) (func elem.drop))\n") "unexpected token")
(assert_malformed (module quote "(module (table 1 funcref) (elem func) (func table.init $absent))\n") "unknown elem")
(assert_malformed (module quote "(module (data \"owned parser payload\") (elem func) (func data.drop $absent))\n") "unknown data")
(assert_malformed (module quote "(module (data \"owned parser payload\") (elem func) (func elem.drop $absent))\n") "unknown elem")
