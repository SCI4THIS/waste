  (func $g (type $t) (i32.const 29))
  (func (export "reset")
    (table.set $base (i64.const 0) (ref.func $seed))
    (table.set $other (i64.const 0) (ref.func $seed))
  )
  (func (export "call0") (result i32) (call_indirect 0 (type $t) (i64.const 0)))
  (func (export "call1") (result i32) (call_indirect 1 (type $t) (i64.const 0)))
  (func (export "flat-numeric")
    i64.const 0 i32.const 0 i32.const 1 table.init 0
  )
  (func (export "flat-named")
    i64.const 0 i32.const 0 i32.const 1 table.init $a
  )
  (func (export "flat-nn")
    i64.const 0 i32.const 0 i32.const 1 table.init 1 0
  )
  (func (export "flat-ni")
    i64.const 0 i32.const 0 i32.const 1 table.init 1 $a
  )
  (func (export "flat-in")
    i64.const 0 i32.const 0 i32.const 1 table.init $other 0
  )
  (func (export "flat-ii")
    i64.const 0 i32.const 0 i32.const 1 table.init $other $a
  )
  (func (export "flat-second")
    i64.const 0 i32.const 0 i32.const 1 table.init $b
