  (func (export "fold-nn")
    (table.init 1 0 (i64.const 0) (i32.const 0) (i32.const 1))
  )
  (func (export "fold-ni")
    (table.init 1 $a (i64.const 0) (i32.const 0) (i32.const 1))
  )
  (func (export "fold-in")
    (table.init $other 0 (i64.const 0) (i32.const 0) (i32.const 1))
  )
  (func (export "fold-ii")
    (table.init $other $a (i64.const 0) (i32.const 0) (i32.const 1))
  )
  (func (export "fold-second")
    (table.init $b (i64.const 0) (i32.const 0) (i32.const 1))
  )
  (func (export "fold-second-nn")
    (table.init 1 1 (i64.const 0) (i32.const 0) (i32.const 1))
  )
  (func (export "data-a-flat") data.drop 0)
  (func (export "data-a-fold") (data.drop $d0))
  (func (export "data-b-flat") data.drop $d1)
  (func (export "data-b-fold") (data.drop 1))
  (func (export "elem-a-flat") elem.drop 0)
  (func (export "elem-a-fold") (elem.drop $a))
  (func (export "elem-b-flat") elem.drop $b)
  (func (export "elem-b-fold") (elem.drop 1))
  (func (export "data-init0") (result i32)
    i64.const 0 i32.const 0 i32.const 1 memory.init 0
    (i32.load8_u (i64.const 0)))
  (func (export "data-zero0") i64.const 0 i32.const 0 i32.const 0 memory.init 0)
  (func (export "elem-zero0") i64.const 0 i32.const 0 i32.const 0 table.init 0)
  (func (export "data-init1") (result i32)
    i64.const 0 i32.const 0 i32.const 1 memory.init 1
    (i32.load8_u (i64.const 0)))
  (func (export "data-zero1") i64.const 0 i32.const 0 i32.const 0 memory.init 1)
  (func (export "elem-zero1") i64.const 0 i32.const 0 i32.const 0 table.init 1)
  (elem $a func $f)
  (elem $b func $g)
  (elem declare func $seed)
  (data $d0 "x")
  (data $d1 "Y")
)
