(assert_invalid (module (data "") (func data.drop 1)) "unknown data segment")
(assert_invalid (module (elem func) (func elem.drop 1)) "unknown elem segment")
(assert_invalid (module (table 1 funcref) (elem func) (func (i32.const 0) (i32.const 0) (i32.const 0) table.init 0 3)) "unknown elem segment")
(assert_invalid (module (table 1 funcref) (elem func) (func (i32.const 0) (i32.const 0) (i32.const 0) table.init 3 0)) "unknown table")
(assert_invalid (module (table 1 funcref) (elem $e func) (func table.init 0)) "type mismatch")
(assert_invalid (module (table 1 funcref) (elem $e func) (func table.init $e)) "type mismatch")
(assert_invalid (module (table i64 1 funcref) (elem func) (func i32.const 0 i32.const 0 i32.const 0 table.init 0)) "type mismatch")
