;; Terminal SELECT and canonical/raw reads use real guest imports.
;; The shared JSON contract delivers input only after an actual READ/SELECT
;; yield. Partial canonical lines and VMIN input must preserve that wait.
;; EOF is supplied as canonical VEOF input, supported by both session adapters.
(module
  (import "env" "select" (func $select (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "pselect" (func $pselect (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "tcgetattr" (func $get (param i32 i32) (result i32)))
  (import "env" "tcsetattr" (func $set (param i32 i32 i32) (result i32)))
  (import "env" "tcflow" (func $flow (param i32 i32) (result i32)))
  (import "env" "exit" (func $exit (param i32)))
  (memory 1)
  ;; No echo or output processing: marker/output bytes are part of the contract.
  (data (i32.const 64) "RAW\0aLINE\0aEDIT\0aKILL\0aMIN\0aEOF\0a")
  (data (i32.const 96) "hello")
  (func (export "get") (result i32) (call $get (i32.const 0) (i32.const 256)))
  (func (export "mode") (param $canonical i32) (param $minimum i32) (result i32)
    (i32.store (i32.const 256) (i32.mul (local.get $canonical) (i32.const 256)))
    (i32.store (i32.const 260) (i32.const 0))
    (i32.store (i32.const 268) (i32.mul (local.get $canonical) (i32.const 3)))
    (i32.store8 (i32.const 275) (i32.const 127))
    (i32.store8 (i32.const 276) (i32.const 21))
    (i32.store8 (i32.const 277) (i32.const 4))
    (i32.store8 (i32.const 278) (i32.const 0))
    (i32.store8 (i32.const 279) (local.get $minimum))
    (call $set (i32.const 0) (i32.const 0) (i32.const 256)))
  ;; Sets at 512/656/800, zero timeval/timespec at 944, empty mask at 976.
  (func $prepare (param $r i32) (param $w i32) (param $e i32)
    (memory.fill (i32.const 512) (i32.const 0) (i32.const 128))
    (memory.fill (i32.const 656) (i32.const 0) (i32.const 128))
    (memory.fill (i32.const 800) (i32.const 0) (i32.const 128))
    (i32.store (i32.const 512) (local.get $r))
    (i32.store (i32.const 656) (local.get $w))
    (i32.store (i32.const 800) (local.get $e)))
  (func (export "poll") (param $nfds i32) (param $r i32) (param $w i32)
      (param $e i32) (param $variant i32) (result i32)
    (call $prepare (local.get $r) (local.get $w) (local.get $e))
    (if (result i32) (local.get $variant)
      (then (call $pselect (local.get $nfds) (i32.const 512) (i32.const 656)
        (i32.const 800) (i32.const 944)
        (select (i32.const 976) (i32.const 0) (i32.eq (local.get $variant) (i32.const 2)))))
      (else (call $select (local.get $nfds) (i32.const 512) (i32.const 656)
        (i32.const 800) (i32.const 944)))))
  (func (export "word") (param i32) (result i32) (i32.load (local.get 0)))
  (func (export "bit") (param $base i32) (param $fd i32) (result i32)
    (i32.ne (i32.and (i32.load (local.get $base))
      (i32.shl (i32.const 1) (local.get $fd))) (i32.const 0)))
  (func $marker (param $address i32) (param $length i32)
    (if (i32.ne (call $write (i32.const 1) (local.get $address) (local.get $length))
        (local.get $length)) (then unreachable)))
  (func (export "input") (param i32 i32) (result i32)
    (call $marker (local.get 0) (local.get 1))
    (call $prepare (i32.const 1) (i32.const 0) (i32.const 0))
    (call $select (i32.const 1) (i32.const 512) (i32.const 0) (i32.const 0) (i32.const 0)))
  (func (export "minimum") (result i32)
    (call $prepare_read)
    (call $marker (i32.const 83) (i32.const 4))
    (call $read (i32.const 0) (i32.const 1024) (i32.const 16)))
  (func (export "read") (param i32) (result i32)
    (if (i32.gt_u (local.get 0) (i32.const 64)) (then unreachable))
    (call $prepare_read)
    (call $read (i32.const 0) (i32.const 1024) (local.get 0)))
  (func $prepare_read
    (memory.fill (i32.const 1024) (i32.const 165) (i32.const 64))
    (i32.store (i32.const 1020) (i32.const 0x13579bdf))
    (i32.store (i32.const 1088) (i32.const 0x13579bdf)))
  (func (export "bounds") (param $count i32) (result i32) (local $i i32)
    (if (i32.gt_u (local.get $count) (i32.const 64)) (then unreachable))
    (if (i32.ne (i32.load (i32.const 1020)) (i32.const 0x13579bdf))
      (then (return (i32.const 0))))
    (if (i32.ne (i32.load (i32.const 1088)) (i32.const 0x13579bdf))
      (then (return (i32.const 0))))
    (local.set $i (local.get $count))
    (block $done (loop $next
      (br_if $done (i32.eq (local.get $i) (i32.const 64)))
      (if (i32.ne (i32.load8_u (i32.add (i32.const 1024) (local.get $i)))
          (i32.const 165)) (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $next)))
    (i32.const 1))
  (func (export "write") (result i32)
    (call $write (i32.const 1) (i32.const 96) (i32.const 5)))
  (func (export "source_bytes") (result i32)
    (i32.and (i32.eq (i32.load (i32.const 96)) (i32.const 1819043176))
      (i32.eq (i32.load8_u (i32.const 100)) (i32.const 111))))
  (func (export "byte") (param i32) (result i32)
    (i32.load8_u (i32.add (i32.const 1024) (local.get 0))))
  (func (export "edited") (result i32)
    (i32.and (i32.eq (i32.load16_u (i32.const 1024)) (i32.const 23160))
      (i32.eq (i32.load8_u (i32.const 1026)) (i32.const 10))))
  (func (export "raw_bytes") (result i32)
    (i32.and (i32.eq (i32.load16_u (i32.const 1024)) (i32.const 31096))
      (i32.eq (i32.load8_u (i32.const 1026)) (i32.const 122))))
  (func (export "flow") (param i32) (result i32)
    (call $flow (i32.const 0) (local.get 0)))
  (func (export "done") (call $exit (i32.const 0))))

;; Raw setup and initial terminal polling, with no preloaded input.
(assert_return (invoke "get") (i32.const 0))
(assert_return (invoke "mode" (i32.const 0) (i32.const 1)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 6) (i32.const 33) (i32.const 0) (i32.const 0) (i32.const 0)) (i32.const -9))
(assert_return (invoke "word" (i32.const 512)) (i32.const 33))
(assert_return (invoke "poll" (i32.const 2) (i32.const 0) (i32.const 2) (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 656) (i32.const 1)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 3) (i32.const 0) (i32.const 7) (i32.const 0) (i32.const 0)) (i32.const 3))
(assert_return (invoke "word" (i32.const 656)) (i32.const 7))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "bit" (i32.const 512) (i32.const 0)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 1)) (i32.const 0))
(assert_return (invoke "bit" (i32.const 512) (i32.const 0)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1) (i32.const 1) (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 512) (i32.const 0)) (i32.const 0))
(assert_return (invoke "bit" (i32.const 656) (i32.const 0)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 2) (i32.const 2) (i32.const 2) (i32.const 2) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 512) (i32.const 1)) (i32.const 0))
(assert_return (invoke "bit" (i32.const 656) (i32.const 1)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 800) (i32.const 1)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 2) (i32.const 0) (i32.const 5) (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 656) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 656) (i32.const 2)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 100) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "word" (i32.const 636)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 2) (i32.const 0) (i32.const 2) (i32.const 0) (i32.const 1)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 656) (i32.const 1)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 3) (i32.const 0) (i32.const 4) (i32.const 0) (i32.const 2)) (i32.const 1))
(assert_return (invoke "word" (i32.const 656)) (i32.const 4))

;; Delayed raw hello input: same fd counted once per ready interest.
(assert_return (invoke "input" (i32.const 64) (i32.const 4)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 512) (i32.const 0)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1) (i32.const 1) (i32.const 0) (i32.const 0)) (i32.const 2))
(assert_return (invoke "bit" (i32.const 512) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 656) (i32.const 0)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 3) (i32.const 1) (i32.const 7) (i32.const 1) (i32.const 0)) (i32.const 4))
(assert_return (invoke "bit" (i32.const 512) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 656) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 800) (i32.const 0)) (i32.const 0))
(assert_return (invoke "bit" (i32.const 656) (i32.const 1)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 656) (i32.const 2)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 3) (i32.const 7) (i32.const 0) (i32.const 0) (i32.const 1)) (i32.const 3))
(assert_return (invoke "word" (i32.const 512)) (i32.const 7))
(assert_return (invoke "read" (i32.const 16)) (i32.const 5))
(assert_return (invoke "bounds" (i32.const 5)) (i32.const 1))
(assert_return (invoke "word" (i32.const 1024)) (i32.const 1819043176))
(assert_return (invoke "byte" (i32.const 4)) (i32.const 111))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "word" (i32.const 512)) (i32.const 0))

;; Canonical partial line stays blocked until newline. Reads return one line.
(assert_return (invoke "mode" (i32.const 1) (i32.const 1)) (i32.const 0))
(assert_return (invoke "input" (i32.const 68) (i32.const 5)) (i32.const 1))
(assert_return (invoke "read" (i32.const 16)) (i32.const 4))
(assert_return (invoke "bounds" (i32.const 4)) (i32.const 1))
(assert_return (invoke "word" (i32.const 1024)) (i32.const 174285409))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 0)) (i32.const 0))

;; Both erase encodings, kill editing and ICRNL run in the real terminal kernel.
(assert_return (invoke "input" (i32.const 73) (i32.const 5)) (i32.const 1))
(assert_return (invoke "read" (i32.const 16)) (i32.const 3))
(assert_return (invoke "bounds" (i32.const 3)) (i32.const 1))
(assert_return (invoke "edited") (i32.const 1))
(assert_return (invoke "input" (i32.const 78) (i32.const 5)) (i32.const 1))
(assert_return (invoke "read" (i32.const 16)) (i32.const 2))
(assert_return (invoke "bounds" (i32.const 2)) (i32.const 1))
(assert_return (invoke "byte" (i32.const 0)) (i32.const 82))
(assert_return (invoke "byte" (i32.const 1)) (i32.const 10))

;; Raw READ requires three bytes and stays blocked after the first two.
(assert_return (invoke "mode" (i32.const 0) (i32.const 3)) (i32.const 0))
(assert_return (invoke "minimum") (i32.const 3))
(assert_return (invoke "bounds" (i32.const 3)) (i32.const 1))
(assert_return (invoke "raw_bytes") (i32.const 1))
(assert_return (invoke "flow" (i32.const 1)) (i32.const 0))
(assert_return (invoke "flow" (i32.const 99)) (i32.const -22))

;; Canonical VEOF releases pending bytes, then remains read-ready at EOF.
(assert_return (invoke "mode" (i32.const 1) (i32.const 1)) (i32.const 0))
(assert_return (invoke "input" (i32.const 87) (i32.const 4)) (i32.const 1))
(assert_return (invoke "read" (i32.const 16)) (i32.const 7))
(assert_return (invoke "bounds" (i32.const 7)) (i32.const 1))
(assert_return (invoke "word" (i32.const 1024)) (i32.const 1953653104))
(assert_return (invoke "byte" (i32.const 4)) (i32.const 105))
(assert_return (invoke "byte" (i32.const 5)) (i32.const 97))
(assert_return (invoke "byte" (i32.const 6)) (i32.const 108))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 0)) (i32.const 1))
(assert_return (invoke "bit" (i32.const 512) (i32.const 0)) (i32.const 1))
(assert_return (invoke "read" (i32.const 16)) (i32.const 0))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 1) (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 1)) (i32.const 1))
(assert_return (invoke "word" (i32.const 512)) (i32.const 1))

;; Repeated EOF leaves the full buffer untouched; all aliases stay ready.
(assert_return (invoke "read" (i32.const 32)) (i32.const 0))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 3) (i32.const 7) (i32.const 7) (i32.const 0) (i32.const 2)) (i32.const 6))
(assert_return (invoke "word" (i32.const 512)) (i32.const 7))
(assert_return (invoke "word" (i32.const 656)) (i32.const 7))
;; Output remains available after EOF and consumes exactly the five source bytes.
(assert_return (invoke "write") (i32.const 5))
(assert_return (invoke "source_bytes") (i32.const 1))
(invoke "done")
