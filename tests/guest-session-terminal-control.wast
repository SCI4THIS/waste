;; Controls are delivered after genuine waits, never as terminal bytes.
(module
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "tcgetattr" (func $get (param i32 i32) (result i32)))
  (import "env" "tcsetattr" (func $set (param i32 i32 i32) (result i32)))
  (import "env" "ioctl" (func $ioctl (param i32 i32 i32) (result i32)))
  (import "env" "pselect" (func $select (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "env" "sigaction" (func $action (param i32 i32 i32) (result i32)))
  (import "env" "fork" (func $fork (result i32)))
  (import "env" "waitpid" (func $wait (param i32 i32 i32) (result i32)))
  (import "env" "exit" (func $exit (param i32)))
  (memory (export "memory") 1)
  (global $caught (mut i32) (i32.const 0))
  (data (i32.const 64) "RESIZE\0aSAME\0aIGNORED\0aREAD\0aCHILD\0a")
  ;; The shared env ABI stores the Wasm function index, not a table slot.
  (data (i32.const 128) "\0b\00\00\00")
  (data (i32.const 160) "\01\00\00\00")
  (func (export "__errno_location") (result i32) (i32.const 0))
  (func $handler (param $signal i32) (global.set $caught (local.get $signal)))
  (func (export "setup") (result i32)
    (drop (call $get (i32.const 0) (i32.const 256)))
    (i32.store (i32.const 256) (i32.const 0))
    (i32.store (i32.const 260) (i32.const 0))
    (i32.store (i32.const 268) (i32.const 0))
    (i32.store8 (i32.const 279) (i32.const 1))
    (drop (call $set (i32.const 0) (i32.const 0) (i32.const 256)))
    (drop (call $action (i32.const 28) (i32.const 128) (i32.const 0)))
    (drop (call $action (i32.const 12) (i32.const 128) (i32.const 0)))
    (call $action (i32.const 10) (i32.const 160) (i32.const 0)))
  (func $size (param $columns i32) (param $rows i32) (result i32)
    (if (i32.ne (call $ioctl (i32.const 0) (i32.const 21523) (i32.const 320)) (i32.const 0))
      (then (return (i32.const 0))))
    (i32.and (i32.eq (i32.load16_u (i32.const 320)) (local.get $rows))
      (i32.eq (i32.load16_u (i32.const 322)) (local.get $columns))))
  (func $pause (param $marker i32) (param $length i32) (result i32)
    (global.set $caught (i32.const 0))
    (drop (call $write (i32.const 1) (local.get $marker) (local.get $length)))
    (if (i32.ne (call $select (i32.const 0) (i32.const 0) (i32.const 0)
          (i32.const 0) (i32.const 0) (i32.const 0)) (i32.const -4))
      (then (return (i32.const -1))))
    (global.get $caught))
  (func (export "resize") (result i32)
    (if (i32.ne (call $pause (i32.const 64) (i32.const 7)) (i32.const 28))
      (then (return (i32.const -1))))
    (call $size (i32.const 120) (i32.const 40)))
  (func (export "same") (result i32)
    (if (i32.ne (call $pause (i32.const 71) (i32.const 5)) (i32.const 28))
      (then (return (i32.const -1))))
    (call $size (i32.const 120) (i32.const 40)))
  (func (export "ignored") (result i32)
    (call $pause (i32.const 76) (i32.const 8)))
  (func (export "read") (result i32)
    (drop (call $write (i32.const 1) (i32.const 84) (i32.const 5)))
    (if (i32.ne (call $read (i32.const 0) (i32.const 340) (i32.const 1)) (i32.const 1))
      (then (return (i32.const -1))))
    (if (i32.eqz (call $size (i32.const 100) (i32.const 30)))
      (then (return (i32.const -2))))
    (i32.load8_u (i32.const 340)))
  (func (export "drain") (result i32)
    (drop (call $select (i32.const 0) (i32.const 0) (i32.const 0)
      (i32.const 0) (i32.const 384) (i32.const 0)))
    (global.get $caught))
  (func (export "child") (result i32) (local $pid i32)
    (local.set $pid (call $fork))
    (if (i32.eqz (local.get $pid)) (then
      (if (i32.ne (call $pause (i32.const 89) (i32.const 6)) (i32.const 28))
        (then (call $exit (i32.const 91))))
      (call $exit (i32.const 23))))
    (drop (call $wait (local.get $pid) (i32.const 360) (i32.const 0)))
    (i32.shr_u (i32.load (i32.const 360)) (i32.const 8)))
  (func (export "parent") (result i32)
    (if (i32.ne (global.get $caught) (i32.const 28))
      (then (return (i32.const -1))))
    (if (i32.ne (call $select (i32.const 0) (i32.const 0) (i32.const 0)
          (i32.const 0) (i32.const 384) (i32.const 0)) (i32.const 0))
      (then (return (i32.const -2))))
    (call $size (i32.const 90) (i32.const 20)))
  (func (export "done") (call $exit (i32.const 0))))
(assert_return (invoke "setup") (i32.const 0))
(assert_return (invoke "resize") (i32.const 1))
(assert_return (invoke "same") (i32.const 1))
(assert_return (invoke "ignored") (i32.const 12))
(assert_return (invoke "read") (i32.const 90))
(assert_return (invoke "drain") (i32.const 28))
(assert_return (invoke "child") (i32.const 23))
(assert_return (invoke "parent") (i32.const 1))
(invoke "done")
