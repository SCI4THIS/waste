;; Real SELECT/pselect waits with host input, absolute frozen-clock events and
;; caught signals. The JSON session contract supplies events after each yield;
;; ordinary batch execution cannot substitute for these outside-guest events.
(module
  (import "env" "select" (func $select (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "pselect" (func $pselect (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "tcgetattr" (func $get (param i32 i32) (result i32)))
  (import "env" "tcsetattr" (func $set (param i32 i32 i32) (result i32)))
  (import "env" "sigemptyset" (func $empty (param i32) (result i32)))
  (import "env" "sigaddset" (func $add (param i32 i32) (result i32)))
  (import "env" "sigprocmask" (func $mask (param i32 i32 i32) (result i32)))
  (import "env" "sigpending" (func $pending (param i32) (result i32)))
  (import "env" "sigaction" (func $action (param i32 i32 i32) (result i32)))
  (import "env" "exit" (func $exit (param i32)))
  (memory (export "memory") 1)
  (data (i32.const 64) "INPUT\0aTIMEOUT\0aREPEAT\0aSIGNAL\0aAGAIN\0a")
  (global $calls (mut i32) (i32.const 0))
  (global $caught (mut i32) (i32.const 0))
  ;; Existing sigaction handler slots name engine function indices: twelve
  ;; imports place this first defined function at index 12.
  (func $handler (param i32)
    (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
    (global.set $caught (local.get 0))
    (if (call $mask (i32.const 99) (i32.const 0) (i32.const 768)) (then unreachable))
    (if (call $pending (i32.const 784)) (then unreachable)))
  (func (export "__errno_location") (result i32) (i32.const 8))
  (func (export "setup") (result i32)
    (if (call $get (i32.const 0) (i32.const 256)) (then unreachable))
    (i32.store (i32.const 256) (i32.const 0))
    (i32.store (i32.const 260) (i32.const 0))
    (i32.store (i32.const 268) (i32.const 0))
    (i32.store8 (i32.const 279) (i32.const 1))
    (if (call $set (i32.const 0) (i32.const 0) (i32.const 256)) (then unreachable))
    (if (call $empty (i32.const 672)) (then unreachable))
    (if (call $empty (i32.const 704)) (then unreachable))
    (if (call $add (i32.const 704) (i32.const 15)) (then unreachable))
    (if (call $mask (i32.const 2) (i32.const 704) (i32.const 0)) (then unreachable))
    (memory.fill (i32.const 256) (i32.const 0) (i32.const 20))
    (i32.store (i32.const 256) (i32.const 12))
    (i32.store (i32.const 260) (i32.const 16384))
    (call $action (i32.const 2) (i32.const 256) (i32.const 0)))
  (func $prepare (param $bit i32) (param $sec i64) (param $fraction i32)
    (memory.fill (i32.const 512) (i32.const 0) (i32.const 128))
    (i32.store (i32.const 512) (local.get $bit))
    (i64.store (i32.const 640) (local.get $sec))
    (i32.store (i32.const 648) (local.get $fraction)))
  (func $marker (param i32 i32)
    (if (i32.ne (call $write (i32.const 1) (local.get 0) (local.get 1)) (local.get 1))
      (then unreachable)))
  (func (export "ready_before") (result i32)
    (call $prepare (i32.const 2) (i64.const 5) (i32.const 0))
    (call $select (i32.const 2) (i32.const 0) (i32.const 512) (i32.const 0) (i32.const 640)))
  (func $input (param i32 i32) (result i32)
    (call $prepare (i32.const 1) (i64.const 5) (i32.const 0))
    (call $marker (local.get 0) (local.get 1))
    (call $select (i32.const 1) (i32.const 512) (i32.const 0) (i32.const 0) (i32.const 640)))
  (func (export "input") (result i32) (call $input (i32.const 64) (i32.const 6)))
  (func (export "again") (result i32) (call $input (i32.const 92) (i32.const 6)))
  (func (export "byte") (result i32)
    (if (i32.ne (call $read (i32.const 0) (i32.const 800) (i32.const 1)) (i32.const 1))
      (then unreachable))
    (i32.load8_u (i32.const 800)))
  (func $timeout (param i32 i32) (result i32)
    (call $prepare (i32.const 1) (i64.const 0) (i32.const 500))
    (call $marker (local.get 0) (local.get 1))
    (call $select (i32.const 1) (i32.const 512) (i32.const 0) (i32.const 0) (i32.const 640)))
  (func (export "timeout") (result i32) (call $timeout (i32.const 70) (i32.const 8)))
  (func (export "repeat") (result i32) (call $timeout (i32.const 78) (i32.const 7)))
  (func (export "signal") (result i32)
    (call $prepare (i32.const 1) (i64.const 5) (i32.const 0))
    (call $marker (i32.const 85) (i32.const 7))
    (call $pselect (i32.const 1) (i32.const 512) (i32.const 0) (i32.const 0)
      (i32.const 640) (i32.const 672)))
  (func (export "word") (param i32) (result i32) (i32.load (local.get 0)))
  (func (export "calls") (result i32) (global.get $calls))
  (func (export "caught") (result i32) (global.get $caught))
  (func (export "restored") (result i32)
    (if (call $mask (i32.const 0) (i32.const 0) (i32.const 704)) (then unreachable))
    (i32.load (i32.const 704)))
  (func (export "pending") (result i32)
    (if (call $pending (i32.const 736)) (then unreachable))
    (i32.load (i32.const 736)))
  (func (export "done") (call $exit (i32.const 0))))
(assert_return (invoke "setup") (i32.const 0))
(assert_return (invoke "ready_before") (i32.const 1))
(assert_return (invoke "word" (i32.const 512)) (i32.const 2))
(assert_return (invoke "word" (i32.const 636)) (i32.const 0))
(assert_return (invoke "input") (i32.const 1))
(assert_return (invoke "word" (i32.const 512)) (i32.const 1))
(assert_return (invoke "byte") (i32.const 120))
(assert_return (invoke "timeout") (i32.const 0))
(assert_return (invoke "word" (i32.const 512)) (i32.const 0))
(assert_return (invoke "word" (i32.const 636)) (i32.const 0))
(assert_return (invoke "repeat") (i32.const 0))
(assert_return (invoke "word" (i32.const 512)) (i32.const 0))
(assert_return (invoke "signal") (i32.const -4))
(assert_return (invoke "calls") (i32.const 1))
(assert_return (invoke "caught") (i32.const 2))
(assert_return (invoke "word" (i32.const 768)) (i32.const 16386))
(assert_return (invoke "word" (i32.const 784)) (i32.const 0))
(assert_return (invoke "restored") (i32.const 16384))
(assert_return (invoke "pending") (i32.const 0))
(assert_return (invoke "again") (i32.const 1))
(assert_return (invoke "word" (i32.const 512)) (i32.const 1))
(assert_return (invoke "byte") (i32.const 89))
(assert_return (invoke "calls") (i32.const 1))
(invoke "done")
