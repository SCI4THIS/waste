;; Reject unresolved binding after another binding was already resolved.
(assert_unlinkable
  (module
    (import "c" "f" (func (result i32)))
    (import "c" "missing" (func (result i32))))
  "unknown import")

;; Invalid imported function type after metadata allocation.
(assert_invalid (module binary
  "\00\61\73\6d\01\00\00\00\01\05\01\60\00\01\7f\02\07\01\01\63\01\66\00\01\07\05\01\01\66\00\00") "invalid function metadata")

;; Combined index exactly beyond the available functions.
(assert_invalid (module binary
  "\00\61\73\6d\01\00\00\00\01\05\01\60\00\01\7f\02\07\01\01\63\01\66\00\00\03\02\01\00\07\05\01\01\66\00\02\0a\06\01\04\00\41\2a\0b") "invalid function metadata")

