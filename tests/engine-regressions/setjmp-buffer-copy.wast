;; A saved Bash jump buffer survives temporary reuse by a nested activation.
;; The evaluator token is opaque guest data and copies with the buffer.
(module $jumps
  (import "env" "sigsetjmp" (func $save (param i32 i32) (result i32)))
  (import "env" "siglongjmp" (func $jump (param i32 i32)))
  (import "env" "longjmp" (func $alias (param i32 i32)))
  (import "env" "sigprocmask" (func $mask (param i32 i32 i32) (result i32)))
  (memory 1)
  (global $sp (export "__stack_pointer") (mut i32) (i32.const 1024))
  (data (i32.const 384) "\00\02\00\00\00\00\00\00\20\00\00\00\00\00\00\00")
  (data (i32.const 400) "\00\08\00\00\00\00\00\00\00\00\00\00\00\20\00\00")
  (func $inner
    (global.set $sp (i32.const 512))
    (drop (call $save (i32.const 64) (i32.const 0)))
    (global.set $sp (i32.const 256)))
  (func (export "run") (result i32 i32) (local $result i32)
    (global.set $sp (i32.const 1024))
    (local.set $result (call $save (i32.const 64) (i32.const 0)))
    (if (i32.eqz (local.get $result))
      (then
        (memory.copy (i32.const 128) (i32.const 64) (i32.const 4))
        (call $inner)
        (memory.copy (i32.const 64) (i32.const 128) (i32.const 4))
        (call $jump (i32.const 64) (i32.const 7))
        unreachable))
    (local.get $result)
    (global.get $sp))
  (func (export "zero") (result i32) (local $result i32)
    (local.set $result (call $save (i32.const 64) (i32.const 0)))
    (if (i32.eqz (local.get $result))
      (then (call $jump (i32.const 64) (i32.const 0)) unreachable))
    (local.get $result))
  (func (export "bad_save")
    (drop (call $save (i32.const 65534) (i32.const 0))))
  (func (export "bad_jump")
    (call $jump (i32.const 65534) (i32.const 1)))
  (func (export "alias") (result i32) (local $result i32)
    (local.set $result (call $save (i32.const 256) (i32.const 0)))
    (if (i32.eqz (local.get $result))
      (then (call $alias (i32.const 256) (i32.const 9)) unreachable))
    (local.get $result))
  (func $returned
    (drop (call $save (i32.const 256) (i32.const 0))))
  (func (export "stale")
    (call $returned)
    (call $alias (i32.const 256) (i32.const 1)))
  (func (export "unknown")
    (i32.store (i32.const 256) (i32.const 0))
    (call $alias (i32.const 256) (i32.const 1)))
  (func (export "mask") (param $save_mask i32) (result i32 i32 i32 i32)
    (local $result i32)
    (drop (call $mask (i32.const 2) (i32.const 384) (i32.const 448)))
    (local.set $result (call $save (i32.const 256) (local.get $save_mask)))
    (if (i32.eqz (local.get $result))
      (then
        (memory.copy (i32.const 320) (i32.const 256) (i32.const 4))
        (drop (call $mask (i32.const 2) (i32.const 400) (i32.const 0)))
        (call $alias (i32.const 320) (i32.const 9))
        unreachable))
    (drop (call $mask (i32.const 0) (i32.const 0) (i32.const 416)))
    (drop (call $mask (i32.const 2) (i32.const 448) (i32.const 0)))
    (local.get $result)
    (i32.load (i32.const 416))
    (i32.load (i32.const 424))
    (i32.load (i32.const 428))))
(assert_return (invoke $jumps "run") (i32.const 7) (i32.const 1024))
(assert_return (invoke $jumps "run") (i32.const 7) (i32.const 1024))
(assert_return (invoke $jumps "zero") (i32.const 1))
(assert_trap (invoke $jumps "bad_save") "invalid setjmp buffer")
(assert_trap (invoke $jumps "bad_jump") "invalid longjmp buffer")
(assert_return (invoke $jumps "alias") (i32.const 9))
(assert_trap (invoke $jumps "stale") "longjmp target not active")
(assert_trap (invoke $jumps "unknown") "longjmp target not active")
;; A copied token retains the saved mask; zero explicitly keeps current changes.
(assert_return (invoke $jumps "mask" (i32.const 0)) (i32.const 9) (i32.const 2048) (i32.const 0) (i32.const 8192))
(assert_return (invoke $jumps "mask" (i32.const 1)) (i32.const 9) (i32.const 512) (i32.const 32) (i32.const 0))
(assert_return (invoke $jumps "mask" (i32.const -1)) (i32.const 9) (i32.const 512) (i32.const 32) (i32.const 0))
(assert_return (invoke $jumps "mask" (i32.const 0)) (i32.const 9) (i32.const 2048) (i32.const 0) (i32.const 8192))
