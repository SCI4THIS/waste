;; Guest counterparts of posix-path-vfs.c. All files are private kernel files;
;; no installed VFS or host filesystem mutations are needed. Stat offsets are
;; the public Wasm32 ABI. Installation, symlink seeding, snapshot ownership and
;; codec round trips remain direct C probes (see docs/techniques.md).
(module
  (import "env" "open" (func $open (param i32 i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "lseek" (func $lseek (param i32 i64 i32) (result i64)))
  (import "env" "stat" (func $stat (param i32 i32) (result i32)))
  (import "env" "access" (func $access (param i32 i32) (result i32)))
  (import "env" "chmod" (func $chmod (param i32 i32) (result i32)))
  (import "env" "mkdir" (func $mkdir (param i32 i32) (result i32)))
  (import "env" "rename" (func $rename (param i32 i32) (result i32)))
  (import "env" "unlink" (func $unlink (param i32) (result i32)))
  (import "env" "rmdir" (func $rmdir (param i32) (result i32)))
  (import "waste_kernel" "readlink_v1" (func $readlink (param i32 i32 i32) (result i32)))
  (import "env" "chdir" (func $chdir (param i32) (result i32)))
  (import "env" "getcwd" (func $getcwd (param i32 i32) (result i32)))
  (memory 1)
  (global $fd (mut i32) (i32.const -1))
  (data (i32.const 32) "/tmp/path-vfs\00")
  (data (i32.const 64) "/tmp/path-vfs/tool\00")
  (data (i32.const 96) "/tmp/path-vfs/readme\00")
  (data (i32.const 128) "/tmp/path-vfs/secret\00")
  (data (i32.const 160) "/tmp/path-vfs/new\00")
  (data (i32.const 192) "/tmp/path-vfs/work\00")
  (data (i32.const 224) "/tmp/path-vfs/work/file\00")
  (data (i32.const 256) "/tmp/path-vfs/tool/child\00")
  (data (i32.const 288) "/tmp/path-vfs/tool/sub\00")
  (data (i32.const 320) "/tmp/path-vfs/missing\00")
  (data (i32.const 352) "././readme\00")
  (data (i32.const 384) "../path-vfs/../path-vfs/tool\00")
  (data (i32.const 416) "../../../../tmp/path-vfs/tool\00")
  (data (i32.const 448) "//tmp///path-vfs//tool\00")
  (data (i32.const 512) "hello")
  (data (i32.const 528) "abc")
  ;; errno at 8, read buffer at 768, stat record at 1024, cwd at 1280.
  (func (export "__errno_location") (result i32) (i32.const 8))
  (func (export "errno") (result i32) (i32.load (i32.const 8)))
  ;; Reset before each pathname call: repeated ENOTDIR cases must not pass
  ;; by observing errno left behind by the preceding assertion.
  (func $reset_errno (i32.store (i32.const 8) (i32.const 0)))
  (func (export "open") (param i32 i32 i32) (result i32)
    (call $reset_errno)
    (global.set $fd (call $open (local.get 0) (local.get 1) (local.get 2)))
    (if (result i32) (i32.lt_s (global.get $fd) (i32.const 0))
      (then (global.get $fd)) (else (i32.const 0))))
  (func (export "close") (result i32) (call $close (global.get $fd)))
  (func (export "read") (param i32) (result i32)
    (call $read (global.get $fd) (i32.const 768) (local.get 0)))
  (func (export "write") (param i32 i32) (result i32)
    (call $write (global.get $fd) (local.get 0) (local.get 1)))
  (func (export "bytes") (result i32) (i32.load (i32.const 768)))
  (func (export "byte") (param i32) (result i32)
    (i32.load8_u (i32.add (i32.const 768) (local.get 0))))
  (func (export "seek") (param i64 i32) (result i64)
    (call $lseek (global.get $fd) (local.get 0) (local.get 1)))
  (func (export "stat") (param i32) (result i32)
    (call $reset_errno)
    (call $stat (local.get 0) (i32.const 1024)))
  (func (export "mode") (result i32) (i32.load (i32.const 1040)))
  (func (export "size") (result i64) (i64.load (i32.const 1064)))
  (func (export "mkdir") (param i32 i32) (result i32)
    (call $reset_errno)
    (call $mkdir (local.get 0) (local.get 1)))
  (func (export "access") (param i32 i32) (result i32)
    (call $reset_errno)
    (call $access (local.get 0) (local.get 1)))
  (func (export "chmod") (param i32 i32) (result i32)
    (call $chmod (local.get 0) (local.get 1)))
  (func (export "rename") (param i32 i32) (result i32)
    (call $reset_errno)
    (call $rename (local.get 0) (local.get 1)))
  (func (export "unlink") (param i32) (result i32)
    (call $reset_errno) (call $unlink (local.get 0)))
  (func (export "rmdir") (param i32) (result i32) (call $rmdir (local.get 0)))
  (func (export "readlink") (param i32) (result i32)
    (local $result i32)
    (call $reset_errno)
    ;; Like guest libc's env_result, translate the versioned negative errno.
    (local.set $result (call $readlink (local.get 0) (i32.const 768) (i32.const 32)))
    (if (result i32) (i32.lt_s (local.get $result) (i32.const 0))
      (then (i32.const -1)) (else (local.get $result))))
  (func (export "chdir") (param i32) (result i32)
    (call $reset_errno) (call $chdir (local.get 0)))
  (func (export "cwd") (result i32)
    (if (i32.ne (call $getcwd (i32.const 1280) (i32.const 64)) (i32.const 1280))
      (then unreachable))
    ;; Check the complete 13-byte pathname plus terminator, not a prefix.
    (i32.and (i64.eq (i64.load (i32.const 1280)) (i64.const 0x7461702f706d742f))
      (i64.eq (i64.and (i64.load (i32.const 1288)) (i64.const 0xffffffffffff))
        (i64.const 0x007366762d68))))
)

;; Setup and file contents through real open/write/read/close.
(assert_return (invoke "mkdir" (i32.const 32) (i32.const 493)) (i32.const 0))
(assert_return (invoke "open" (i32.const 64) (i32.const 66) (i32.const 493)) (i32.const 0))
(assert_return (invoke "close") (i32.const 0))
(assert_return (invoke "open" (i32.const 96) (i32.const 66) (i32.const 420)) (i32.const 0))
(assert_return (invoke "write" (i32.const 512) (i32.const 5)) (i32.const 5))
(assert_return (invoke "seek" (i64.const 0) (i32.const 0)) (i64.const 0))
(assert_return (invoke "read" (i32.const 5)) (i32.const 5))
(assert_return (invoke "bytes") (i32.const 0x6c6c6568))
(assert_return (invoke "byte" (i32.const 4)) (i32.const 111))
(assert_return (invoke "seek" (i64.const 2) (i32.const 0)) (i64.const 2))
(assert_return (invoke "seek" (i64.const 1) (i32.const 1)) (i64.const 3))
(assert_return (invoke "close") (i32.const 0))
(assert_return (invoke "chmod" (i32.const 96) (i32.const 292)) (i32.const 0))
(assert_return (invoke "access" (i32.const 96) (i32.const 2)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 13))
(assert_return (invoke "open" (i32.const 128) (i32.const 66) (i32.const 420)) (i32.const 0))
(assert_return (invoke "close") (i32.const 0))
(assert_return (invoke "chmod" (i32.const 128) (i32.const 0)) (i32.const 0))
(assert_return (invoke "access" (i32.const 128) (i32.const 0)) (i32.const 0))
(assert_return (invoke "access" (i32.const 64) (i32.const 1)) (i32.const 0))
(assert_return (invoke "access" (i32.const 320) (i32.const 0)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 2))
(assert_return (invoke "access" (i32.const 64) (i32.const 8)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "stat" (i32.const 64)) (i32.const 0))
(assert_return (invoke "size") (i64.const 0))
(assert_return (invoke "mode") (i32.const 0x81ed))
(assert_return (invoke "stat" (i32.const 96)) (i32.const 0))
(assert_return (invoke "size") (i64.const 5))
(assert_return (invoke "mode") (i32.const 0x8124))

;; Creating, moving and removing a file preserves its length.
(assert_return (invoke "open" (i32.const 160) (i32.const 66) (i32.const 438)) (i32.const 0))
(assert_return (invoke "write" (i32.const 528) (i32.const 3)) (i32.const 3))
(assert_return (invoke "close") (i32.const 0))
(assert_return (invoke "stat" (i32.const 160)) (i32.const 0))
(assert_return (invoke "size") (i64.const 3))
(assert_return (invoke "mkdir" (i32.const 192) (i32.const 511)) (i32.const 0))
(assert_return (invoke "rename" (i32.const 160) (i32.const 224)) (i32.const 0))
(assert_return (invoke "stat" (i32.const 224)) (i32.const 0))
(assert_return (invoke "size") (i64.const 3))
(assert_return (invoke "unlink" (i32.const 224)) (i32.const 0))
(assert_return (invoke "stat" (i32.const 224)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 2))
(assert_return (invoke "rmdir" (i32.const 192)) (i32.const 0))

;; Every tested traversal through a regular file reports ENOTDIR, not ENOENT.
(assert_return (invoke "stat" (i32.const 256)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 20))
(assert_return (invoke "open" (i32.const 256) (i32.const 65) (i32.const 420)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 20))
(assert_return (invoke "open" (i32.const 256) (i32.const 0) (i32.const 0)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 20))
(assert_return (invoke "mkdir" (i32.const 288) (i32.const 493)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 20))
(assert_return (invoke "stat" (i32.const 256)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 20))
(assert_return (invoke "unlink" (i32.const 256)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 20))
(assert_return (invoke "rename" (i32.const 256) (i32.const 160)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 20))
(assert_return (invoke "rename" (i32.const 96) (i32.const 256)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 20))
(assert_return (invoke "readlink" (i32.const 256)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 20))

;; Cwd, relative components, root clamping and repeated separators.
(assert_return (invoke "chdir" (i32.const 32)) (i32.const 0))
(assert_return (invoke "cwd") (i32.const 1))
(assert_return (invoke "stat" (i32.const 352)) (i32.const 0))
(assert_return (invoke "size") (i64.const 5))
(assert_return (invoke "stat" (i32.const 384)) (i32.const 0))
(assert_return (invoke "stat" (i32.const 416)) (i32.const 0))
(assert_return (invoke "stat" (i32.const 448)) (i32.const 0))
(assert_return (invoke "chdir" (i32.const 96)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 20))
(assert_return (invoke "cwd") (i32.const 1))
