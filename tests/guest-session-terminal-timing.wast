;; EOF/output/VTIME exercise real terminal imports. Clock/input events come
;; from the shared JSON contract at actual READ/SELECT yields. The existing
;; timer begins at the first read wait; this audits that implementation contract.
(module
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "tcgetattr" (func $get (param i32 i32) (result i32)))
  (import "env" "tcsetattr" (func $set (param i32 i32 i32) (result i32)))
  (import "env" "select" (func $select (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "exit" (func $exit (param i32)))
  (memory 1)
  (data (i32.const 64) "a\0ab")
  (data (i32.const 128) "ZERO\0aPARTIAL\0aEARLY\0aREPEAT\0aEOF\0a")
  ;; 257 source bytes cross the adapter's 256-byte output chunk boundary.
  (func (export "get") (result i32) (call $get (i32.const 0) (i32.const 256)))
  (func (export "mode") (param $minimum i32) (param $time i32)
      (param $canonical i32) (param $output i32) (result i32)
    (i32.store (i32.const 256) (i32.mul (local.get $canonical) (i32.const 256)))
    (i32.store (i32.const 260) (local.get $output))
    (i32.store (i32.const 268) (i32.mul (local.get $canonical) (i32.const 2)))
    (i32.store8 (i32.const 277) (i32.const 4))
    (i32.store8 (i32.const 278) (local.get $time))
    (i32.store8 (i32.const 279) (local.get $minimum))
    (call $set (i32.const 0) (i32.const 0) (i32.const 256)))
  (func (export "output") (param i32) (result i32)
    (call $write (local.get 0) (i32.const 64) (i32.const 3)))
  (func (export "chunks") (result i32)
    (memory.fill (i32.const 1600) (i32.const 97) (i32.const 254))
    (i32.store8 (i32.const 1854) (i32.const 10))
    (i32.store8 (i32.const 1855) (i32.const 10))
    (i32.store8 (i32.const 1856) (i32.const 90))
    (call $write (i32.const 1) (i32.const 1600) (i32.const 257)))
  (func (export "canaries")
    (i32.store (i32.const 1020) (i32.const 324478056))
    (i32.store (i32.const 1040) (i32.const 324478056)))
  (func (export "timed") (param i32 i32) (result i32)
    (memory.fill (i32.const 1024) (i32.const 165) (i32.const 16))
    (if (i32.ne (call $write (i32.const 1) (local.get 0) (local.get 1))
      (local.get 1)) (then unreachable))
    (call $read (i32.const 0) (i32.const 1024) (i32.const 16)))
  (func (export "read") (result i32)
    (call $read (i32.const 0) (i32.const 1024) (i32.const 16)))
  (func (export "word") (param i32) (result i32) (i32.load (local.get 0)))
  (func (export "byte") (param i32) (result i32)
    (i32.load8_u (i32.add (i32.const 1024) (local.get 0))))
  (func (export "eof") (result i32)
    (if (i32.ne (call $write (i32.const 1) (i32.const 154) (i32.const 4))
      (i32.const 4)) (then unreachable))
    (memory.fill (i32.const 512) (i32.const 0) (i32.const 128))
    (i32.store (i32.const 512) (i32.const 1))
    (call $select (i32.const 1) (i32.const 512) (i32.const 0) (i32.const 0) (i32.const 0)))
  (func (export "done") (call $exit (i32.const 0))))

;; Output returns source byte count; the shared transcript records transformed bytes.
(assert_return (invoke "get") (i32.const 0))
(assert_return (invoke "mode" (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 5)) (i32.const 0))
(assert_return (invoke "output" (i32.const 1)) (i32.const 3))
(assert_return (invoke "mode" (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 0)) (i32.const 0))
(assert_return (invoke "output" (i32.const 2)) (i32.const 3))
(assert_return (invoke "mode" (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 4)) (i32.const 0))
(assert_return (invoke "output" (i32.const 1)) (i32.const 3))
(assert_return (invoke "mode" (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 1)) (i32.const 0))
(assert_return (invoke "output" (i32.const 1)) (i32.const 3))
(assert_return (invoke "mode" (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 5)) (i32.const 0))
(assert_return (invoke "chunks") (i32.const 257))
(assert_return (invoke "mode" (i32.const 0) (i32.const 2) (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "canaries"))

;; VMIN=0 VTIME=2: remain blocked at 199,999,999 ns; return 0 at 200,000,000 ns.
(assert_return (invoke "timed" (i32.const 128) (i32.const 5)) (i32.const 0))
(assert_return (invoke "word" (i32.const 1024)) (i32.const 2779096485))
(assert_return (invoke "word" (i32.const 1036)) (i32.const 2779096485))
(assert_return (invoke "word" (i32.const 1020)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 1040)) (i32.const 324478056))

;; VMIN=3: preserve a partial byte across resumes, release it at the original deadline.
(assert_return (invoke "mode" (i32.const 3) (i32.const 2) (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "timed" (i32.const 133) (i32.const 8)) (i32.const 1))
(assert_return (invoke "byte" (i32.const 0)) (i32.const 120))
(assert_return (invoke "byte" (i32.const 1)) (i32.const 165))
(assert_return (invoke "word" (i32.const 1036)) (i32.const 2779096485))
(assert_return (invoke "word" (i32.const 1020)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 1040)) (i32.const 324478056))

;; A fresh VMIN=0 read releases real input before its deadline; no stale byte replay.
(assert_return (invoke "mode" (i32.const 0) (i32.const 2) (i32.const 0) (i32.const 0)) (i32.const 0))
(assert_return (invoke "timed" (i32.const 141) (i32.const 6)) (i32.const 1))
(assert_return (invoke "byte" (i32.const 0)) (i32.const 81))
(assert_return (invoke "byte" (i32.const 1)) (i32.const 165))

;; The next timed read has a fresh independent deadline and leaves the buffer unchanged.
(assert_return (invoke "timed" (i32.const 147) (i32.const 7)) (i32.const 0))
(assert_return (invoke "word" (i32.const 1024)) (i32.const 2779096485))
(assert_return (invoke "word" (i32.const 1036)) (i32.const 2779096485))
(assert_return (invoke "word" (i32.const 1020)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 1040)) (i32.const 324478056))

;; Canonical VEOF releases pending bytes once, then returns zero without touching the buffer.
(assert_return (invoke "mode" (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 0)) (i32.const 0))
(assert_return (invoke "eof") (i32.const 1))
(assert_return (invoke "read") (i32.const 7))
(assert_return (invoke "word" (i32.const 1024)) (i32.const 1953653104))
(assert_return (invoke "byte" (i32.const 4)) (i32.const 105))
(assert_return (invoke "byte" (i32.const 5)) (i32.const 97))
(assert_return (invoke "byte" (i32.const 6)) (i32.const 108))
(assert_return (invoke "read") (i32.const 0))
(assert_return (invoke "word" (i32.const 1024)) (i32.const 1953653104))
(assert_return (invoke "word" (i32.const 1020)) (i32.const 324478056))
(assert_return (invoke "word" (i32.const 1040)) (i32.const 324478056))
(invoke "done")
