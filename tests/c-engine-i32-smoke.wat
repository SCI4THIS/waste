(module
  (type $pair-type (func (param i32 i32) (result i32 i32)))
  (memory 1 2)
  (data (i32.const 8) "\78\56\34\12\80")
  (global $value (mut i32) (i32.const 5))
  (global $wide (mut i64) (i64.const 0x1122334455667788))
  (global $single (mut f32) (f32.const -3.5))
  (global $double (mut f64) (f64.const 9.25))
  (global $null-func (mut funcref) (ref.null func))
  (func $pair (type $pair-type)
    local.get 0 local.get 1)
  (func $sum (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.add)
  (func (export "add") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.add)
  (func (export "rotl") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.rotl)
  (func (export "div_s") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.div_s)
  (func (export "div_u") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.div_u)
  (func (export "locals") (param i32 i32) (result i32) (local i32)
    local.get 0 local.set 2
    local.get 1 local.tee 2 drop
    local.get 2)
  (func (export "choose") (param i32 i32) (result i32)
    local.get 0 local.get 1 local.get 0 select)
  (func (export "call") (param i32 i32) (result i32)
    local.get 0 local.get 1 call $sum)
  (func (export "early") (param i32 i32) (result i32)
    local.get 0 return local.get 1)
  (func (export "ifelse") (param i32 i32) (result i32)
    local.get 0 if (result i32) local.get 0 else local.get 1 end)
  (func (export "branch") (param i32 i32) (result i32)
    block (result i32) local.get 0 br 0 local.get 1 end)
  (func (export "branch-if") (param i32 i32) (result i32)
    block (result i32)
      local.get 0 local.get 1 br_if 0 drop local.get 1
    end)
  (func (export "countdown") (param i32 i32) (result i32)
    loop
      local.get 0 i32.const 1 i32.sub local.tee 0 br_if 0
    end
    local.get 0)
  (func (export "branch-table") (param i32 i32) (result i32)
    block (result i32)
      block (result i32)
        local.get 0 local.get 1 br_table 0 1
      end
    end)
  (func (export "multi-call") (param i32 i32) (result i32)
    local.get 0 local.get 1 call $pair i32.sub)
  (func (export "multi-block") (param i32 i32) (result i32)
    local.get 0 local.get 1
    block (type $pair-type) br 0 end
    i32.sub)
  (func (export "pair") (param i32 i32) (result i32 i32)
    local.get 0 local.get 1)
  (func (export "load-data") (param i32 i32) (result i32)
    local.get 0 i32.load)
  (func (export "load8-s") (param i32 i32) (result i32)
    local.get 0 i32.load8_s)
  (func (export "store-load") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.store
    local.get 0 i32.load)
  (func (export "global") (param i32 i32) (result i32)
    local.get 0 global.set $value global.get $value)
  (func (export "grow") (param i32 i32) (result i32)
    local.get 0 memory.grow)
  (func (export "size") (param i32 i32) (result i32)
    memory.size)
  (func (export "global-i64") (param i32 i32) (result i64) global.get $wide)
  (func (export "global-f32") (param i32 i32) (result f32) global.get $single)
  (func (export "global-f64") (param i32 i32) (result f64) global.get $double)
  (func (export "global-null") (param i32 i32) (result i32)
    global.get $null-func ref.is_null))
