;; Terminal aliases use real imports and post-yield input. Raw readiness,
;; reference lifetime and independently allocated kernels remain private C gates.
(module
  (import "env" "dup" (func $dup (param i32) (result i32)))
  (import "env" "dup2" (func $dup2 (param i32 i32) (result i32)))
  (import "env" "close" (func $close (param i32) (result i32)))
  (import "env" "read" (func $read (param i32 i32 i32) (result i32)))
  (import "env" "write" (func $write (param i32 i32 i32) (result i32)))
  (import "env" "select" (func $select (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "tcgetattr" (func $get (param i32 i32) (result i32)))
  (import "env" "tcsetattr" (func $set (param i32 i32 i32) (result i32)))
  (import "env" "isatty" (func $tty (param i32) (result i32)))
  (import "env" "exit" (func $exit (param i32)))
  (memory 1)
  (data (i32.const 64) "DUP\0aORIGINAL\0aSHARED\0aLAST\0aREOPEN\0aFINAL\0a")
  (func (export "__errno_location") (result i32) (i32.const 8))
  (func (export "errno") (result i32) (i32.load (i32.const 8)))
  (func $reset (i32.store (i32.const 8) (i32.const 0)))
  (func (export "dup") (param i32) (result i32)
    (call $reset) (call $dup (local.get 0)))
  (func (export "dup2") (param i32 i32) (result i32)
    (call $reset) (call $dup2 (local.get 0) (local.get 1)))
  (func (export "close") (param i32) (result i32)
    (call $reset) (call $close (local.get 0)))
  (func (export "tty") (param i32) (result i32) (call $tty (local.get 0)))
  (func (export "get") (param i32) (result i32)
    (call $get (local.get 0) (i32.const 256)))
  (func (export "minimum") (result i32) (i32.load8_u (i32.const 279)))
  (func (export "mode") (param $fd i32) (param $minimum i32) (result i32)
    (i32.store (i32.const 256) (i32.const 0))
    (i32.store (i32.const 260) (i32.const 0))
    (i32.store (i32.const 268) (i32.const 0))
    (i32.store8 (i32.const 278) (i32.const 0))
    (i32.store8 (i32.const 279) (local.get $minimum))
    (call $set (local.get $fd) (i32.const 0) (i32.const 256)))
  (func $marker (param i32 i32)
    (if (i32.ne (call $write (i32.const 1) (local.get 0) (local.get 1))
      (local.get 1)) (then unreachable)))
  (func (export "mark") (param i32 i32) (call $marker (local.get 0) (local.get 1)))
  (func $prepare (param i32)
    (memory.fill (i32.const 512) (i32.const 0) (i32.const 128))
    (i32.store (i32.const 512) (local.get 0)))
  (func (export "input") (param i32 i32 i32) (result i32)
    (call $marker (local.get 0) (local.get 1)) (call $prepare (local.get 2))
    (call $select (i32.const 6) (i32.const 512) (i32.const 0) (i32.const 0) (i32.const 0)))
  (func (export "poll") (param i32) (result i32)
    (call $prepare (local.get 0))
    (call $select (i32.const 6) (i32.const 512) (i32.const 0) (i32.const 0) (i32.const 704)))
  (func (export "bits") (result i32) (i32.load (i32.const 512)))
  (func (export "read") (param i32 i32) (result i32)
    (call $reset)
    (memory.fill (i32.const 1024) (i32.const 165) (i32.const 16))
    (i32.store (i32.const 1020) (i32.const 0x13579bdf))
    (i32.store (i32.const 1040) (i32.const 0x13579bdf))
    (call $read (local.get 0) (i32.const 1024) (local.get 1)))
  (func (export "byte") (param i32) (result i32)
    (i32.load8_u (i32.add (i32.const 1024) (local.get 0))))
  (func (export "bounds") (param $count i32) (result i32) (local $i i32)
    (if (i32.gt_u (local.get $count) (i32.const 16)) (then unreachable))
    (if (i32.ne (i32.load (i32.const 1020)) (i32.const 0x13579bdf)) (then (return (i32.const 0))))
    (if (i32.ne (i32.load (i32.const 1040)) (i32.const 0x13579bdf)) (then (return (i32.const 0))))
    (local.set $i (local.get $count))
    (block $done (loop $next
      (br_if $done (i32.eq (local.get $i) (i32.const 16)))
      (if (i32.ne (i32.load8_u (i32.add (i32.const 1024) (local.get $i))) (i32.const 165))
        (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
    (i32.const 1))
  (func (export "done") (call $exit (i32.const 0))))

;; Raw VMIN=2 through the duplicate: one byte must not satisfy the read.
(assert_return (invoke "get" (i32.const 0)) (i32.const 0))
(assert_return (invoke "dup" (i32.const 0)) (i32.const 3))
(assert_return (invoke "tty" (i32.const 3)) (i32.const 1))
(assert_return (invoke "mode" (i32.const 3) (i32.const 2)) (i32.const 0))
(assert_return (invoke "get" (i32.const 0)) (i32.const 0))
(assert_return (invoke "minimum") (i32.const 2))
(assert_return (invoke "mark" (i32.const 64) (i32.const 4)))
(assert_return (invoke "read" (i32.const 3) (i32.const 16)) (i32.const 2))
(assert_return (invoke "byte" (i32.const 0)) (i32.const 104))
(assert_return (invoke "byte" (i32.const 1)) (i32.const 105))
(assert_return (invoke "bounds" (i32.const 2)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 9)) (i32.const 0))
(assert_return (invoke "bits") (i32.const 0))
(assert_return (invoke "close" (i32.const 3)) (i32.const 0))
(assert_return (invoke "tty" (i32.const 3)) (i32.const 0))
(assert_return (invoke "read" (i32.const 3) (i32.const 16)) (i32.const -9))
(assert_return (invoke "errno") (i32.const 0))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "close" (i32.const 3)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 9))
(assert_return (invoke "tty" (i32.const 0)) (i32.const 1))
(assert_return (invoke "mode" (i32.const 1) (i32.const 1)) (i32.const 0))
(assert_return (invoke "get" (i32.const 0)) (i32.const 0))
(assert_return (invoke "minimum") (i32.const 1))
(assert_return (invoke "mark" (i32.const 68) (i32.const 9)))
(assert_return (invoke "read" (i32.const 0) (i32.const 16)) (i32.const 1))
(assert_return (invoke "byte" (i32.const 0)) (i32.const 120))
(assert_return (invoke "bounds" (i32.const 1)) (i32.const 1))

;; New duplicates share the terminal state and drain the same real input.
(assert_return (invoke "dup" (i32.const 0)) (i32.const 3))
(assert_return (invoke "dup2" (i32.const 3) (i32.const 5)) (i32.const 5))
(assert_return (invoke "dup2" (i32.const 3) (i32.const 3)) (i32.const 3))
(assert_return (invoke "tty" (i32.const 0)) (i32.const 1))
(assert_return (invoke "tty" (i32.const 3)) (i32.const 1))
(assert_return (invoke "tty" (i32.const 5)) (i32.const 1))
(assert_return (invoke "mode" (i32.const 5) (i32.const 1)) (i32.const 0))
(assert_return (invoke "get" (i32.const 3)) (i32.const 0))
(assert_return (invoke "minimum") (i32.const 1))
(assert_return (invoke "dup" (i32.const -1)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "dup" (i32.const 64)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "dup" (i32.const 63)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 9))
(assert_return (invoke "dup2" (i32.const 3) (i32.const -1)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "dup2" (i32.const 3) (i32.const 64)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "dup2" (i32.const 63) (i32.const 5)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 9))
(assert_return (invoke "tty" (i32.const 5)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 41)) (i32.const 0))
(assert_return (invoke "close" (i32.const 63)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 9))
(assert_return (invoke "close" (i32.const -1)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "close" (i32.const 64)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 22))
(assert_return (invoke "input" (i32.const 77) (i32.const 7) (i32.const 41)) (i32.const 3))
(assert_return (invoke "bits") (i32.const 41))
(assert_return (invoke "read" (i32.const 3) (i32.const 1)) (i32.const 1))
(assert_return (invoke "byte" (i32.const 0)) (i32.const 65))
(assert_return (invoke "bounds" (i32.const 1)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 41)) (i32.const 3))
(assert_return (invoke "bits") (i32.const 41))
(assert_return (invoke "read" (i32.const 5) (i32.const 1)) (i32.const 1))
(assert_return (invoke "byte" (i32.const 0)) (i32.const 66))
(assert_return (invoke "bounds" (i32.const 1)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 41)) (i32.const 0))
(assert_return (invoke "bits") (i32.const 0))

;; Close stdin after input arrives; remaining real aliases keep the queued byte.
(assert_return (invoke "input" (i32.const 84) (i32.const 5) (i32.const 9)) (i32.const 2))
(assert_return (invoke "bits") (i32.const 9))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))
(assert_return (invoke "tty" (i32.const 0)) (i32.const 0))
(assert_return (invoke "close" (i32.const 0)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 9))
(assert_return (invoke "read" (i32.const 0) (i32.const 16)) (i32.const -9))
(assert_return (invoke "errno") (i32.const 0))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(assert_return (invoke "tty" (i32.const 1)) (i32.const 1))
(assert_return (invoke "tty" (i32.const 2)) (i32.const 1))
(assert_return (invoke "tty" (i32.const 3)) (i32.const 1))
(assert_return (invoke "tty" (i32.const 5)) (i32.const 1))
(assert_return (invoke "read" (i32.const 3) (i32.const 16)) (i32.const 1))
(assert_return (invoke "byte" (i32.const 0)) (i32.const 90))
(assert_return (invoke "bounds" (i32.const 1)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 8)) (i32.const 0))

;; Restore fd 0 with dup2 before delivering more outside-guest input.
(assert_return (invoke "dup2" (i32.const 3) (i32.const 0)) (i32.const 0))
(assert_return (invoke "tty" (i32.const 0)) (i32.const 1))
(assert_return (invoke "get" (i32.const 0)) (i32.const 0))
(assert_return (invoke "minimum") (i32.const 1))
(assert_return (invoke "mark" (i32.const 89) (i32.const 7)))
(assert_return (invoke "read" (i32.const 0) (i32.const 16)) (i32.const 1))
(assert_return (invoke "byte" (i32.const 0)) (i32.const 81))
(assert_return (invoke "bounds" (i32.const 1)) (i32.const 1))
(assert_return (invoke "close" (i32.const 5)) (i32.const 0))
(assert_return (invoke "tty" (i32.const 5)) (i32.const 0))
(assert_return (invoke "poll" (i32.const 9)) (i32.const 0))

;; Last input precedes closing stdin/duplicate; stdout still reads shared bytes.
(assert_return (invoke "input" (i32.const 96) (i32.const 6) (i32.const 9)) (i32.const 2))
(assert_return (invoke "close" (i32.const 0)) (i32.const 0))
(assert_return (invoke "close" (i32.const 3)) (i32.const 0))
(assert_return (invoke "dup" (i32.const 0)) (i32.const -1))
(assert_return (invoke "errno") (i32.const 9))
(assert_return (invoke "tty" (i32.const 1)) (i32.const 1))
(assert_return (invoke "tty" (i32.const 2)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 6)) (i32.const 2))
(assert_return (invoke "bits") (i32.const 6))
(assert_return (invoke "read" (i32.const 1) (i32.const 16)) (i32.const 1))
(assert_return (invoke "byte" (i32.const 0)) (i32.const 82))
(assert_return (invoke "bounds" (i32.const 1)) (i32.const 1))
(assert_return (invoke "poll" (i32.const 6)) (i32.const 0))
(assert_return (invoke "close" (i32.const 1)) (i32.const 0))
(assert_return (invoke "tty" (i32.const 1)) (i32.const 0))
(assert_return (invoke "tty" (i32.const 2)) (i32.const 1))
(assert_return (invoke "get" (i32.const 2)) (i32.const 0))
(assert_return (invoke "close" (i32.const 2)) (i32.const 0))
(assert_return (invoke "tty" (i32.const 2)) (i32.const 0))
(assert_return (invoke "read" (i32.const 2) (i32.const 16)) (i32.const -9))
(assert_return (invoke "errno") (i32.const 0))
(assert_return (invoke "bounds" (i32.const 0)) (i32.const 1))
(invoke "done")
