;; Native mount boundary, not a replacement for later guest-runtime parity.
(module
  (import "waste_kernel" "path_access_v1" (func $access (param i32 i32 i32 i32) (result i32)))
  (import "waste_kernel" "path_stat_v1" (func $stat (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "/bin/echo")
  (data (i32.const 32) "/usr/bin/echo")
  (data (i32.const 64) "/lib/libncurses.so.wasm")
  (data (i32.const 96) "/usr/lib/libncurses.so.wasm")
  (data (i32.const 128) "/usr/share/waste/launch.wast")
  (data (i32.const 192) "/bin/wat")
  (func (export "access") (param i32 i32 i32) (result i32)
    (call $access (local.get 0) (local.get 1) (local.get 2) (i32.const 0)))
  (func (export "mode") (param i32 i32) (result i32)
    (drop (call $stat (local.get 0) (local.get 1) (i32.const 1) (i32.const 256)))
    (i32.load (i32.const 260))))
(assert_return (invoke "access" (i32.const 0) (i32.const 9) (i32.const 1)) (i32.const 0))
(assert_return (invoke "access" (i32.const 32) (i32.const 13) (i32.const 1)) (i32.const 0))
(assert_return (invoke "access" (i32.const 64) (i32.const 23) (i32.const 4)) (i32.const 0))
(assert_return (invoke "access" (i32.const 96) (i32.const 27) (i32.const 4)) (i32.const 0))
(assert_return (invoke "access" (i32.const 128) (i32.const 28) (i32.const 4)) (i32.const 0))
(assert_return (invoke "access" (i32.const 192) (i32.const 8) (i32.const 1)) (i32.const 0))
(assert_return (invoke "mode" (i32.const 0) (i32.const 9)) (i32.const 493))
(assert_return (invoke "mode" (i32.const 64) (i32.const 23)) (i32.const 420))
