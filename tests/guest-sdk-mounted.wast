;; Mounted SDK paths must be identical in native and browser kernels.
(module
  (import "waste_kernel" "path_access_v1" (func $access (param i32 i32 i32 i32) (result i32)))
  (memory 1)
  (data (i32.const 0) "/usr/include/stdio.h")
  (data (i32.const 64) "/usr/include/sys/stat.h")
  (data (i32.const 128) "/usr/include/sys/ioctl.h")
  (data (i32.const 192) "/usr/include/sys/mman.h")
  (data (i32.const 256) "/usr/include/curses.h")
  (data (i32.const 320) "/usr/lib/waste/cc/include/stdarg.h")
  (data (i32.const 384) "/usr/share/waste/sdk.json")
  (data (i32.const 448) "/usr/include/helper.h")
  (data (i32.const 512) "/usr/include/kernel.h")
  (data (i32.const 576) "/usr/include/syscall.h")
  (data (i32.const 640) "/usr/include/ncurses_cfg.h")
  (data (i32.const 704) "/usr/include/waste-gnulib-compat.h")
  (func (export "access") (param i32 i32) (result i32)
    (call $access (local.get 0) (local.get 1) (i32.const 4) (i32.const 0))))
(assert_return (invoke "access" (i32.const 0) (i32.const 20)) (i32.const 0))
(assert_return (invoke "access" (i32.const 64) (i32.const 23)) (i32.const 0))
(assert_return (invoke "access" (i32.const 128) (i32.const 24)) (i32.const 0))
(assert_return (invoke "access" (i32.const 192) (i32.const 23)) (i32.const 0))
(assert_return (invoke "access" (i32.const 256) (i32.const 21)) (i32.const 0))
(assert_return (invoke "access" (i32.const 320) (i32.const 34)) (i32.const 0))
(assert_return (invoke "access" (i32.const 384) (i32.const 25)) (i32.const 0))
(assert_return (invoke "access" (i32.const 448) (i32.const 21)) (i32.const -2))
(assert_return (invoke "access" (i32.const 512) (i32.const 21)) (i32.const -2))
(assert_return (invoke "access" (i32.const 576) (i32.const 22)) (i32.const -2))
(assert_return (invoke "access" (i32.const 640) (i32.const 26)) (i32.const -2))
(assert_return (invoke "access" (i32.const 704) (i32.const 34)) (i32.const -2))
