+let clone_address_space (root : moduleinst) =
+  let promises = ref [] in
+  let instance_pairs = ref [] in
+  let function_pairs = ref [] in
+  let global_pairs = ref [] in
+  let memory_pairs = ref [] in
+  let table_pairs = ref [] in
+  let rec promise_for (source : moduleinst) =
+    match List.find_opt (fun (candidate, _) -> candidate == source) !promises with
+    | Some (_, promise) -> promise
+    | None ->
+      let promise = Lib.Promise.make () in
+      promises := (source, promise) :: !promises;
+      let memories = List.map Memory.clone source.memories in
+      memory_pairs := List.combine source.memories memories @ !memory_pairs;
+      let functions = List.map (function
+        | Func.AstFunc (deftype, owner, body) ->
+          Func.AstFunc (deftype, promise_for (Lib.Promise.value owner), body)
+        | Func.HostFunc (deftype, host) -> Func.HostFunc (deftype, host)
+      ) source.funcs in
+      function_pairs := List.combine source.funcs functions @ !function_pairs;
+      let map_ref = function
+        | FuncRef function_ -> FuncRef (physical_assoc function_ !function_pairs)
+        | reference -> reference in
+      let map_value = function Ref reference -> Ref (map_ref reference) | value -> value in
+      let globals = List.map (fun global ->
+        Global.alloc (Global.type_of global) (map_value (Global.load global))) source.globals in
+      let globals_here = List.combine source.globals globals in
+      global_pairs := globals_here @ !global_pairs;
+      let tables = List.map (fun table ->
+        let size = Table.size table in
+        let initial = if size = 0L then NullRef else map_ref (Table.load table 0L) in
+        let copy = Table.alloc (Table.type_of table) initial in
+        for index = 0 to Int64.to_int size - 1 do
+          Table.store copy (Int64.of_int index) (map_ref (Table.load table (Int64.of_int index)))
+        done;
+        copy
+      ) source.tables in
+      table_pairs := List.combine source.tables tables @ !table_pairs;
+      let datas = List.map (fun data ->
+        Data.alloc (Data.load_bytes data 0L (Int64.to_int (Data.size data)))) source.datas in
+      let elems = List.map (fun elem ->
+        let size = Elem.size elem in
+        Elem.alloc (List.init (Int64.to_int size)
+          (fun index -> map_ref (Elem.load elem (Int64.of_int index))))
+      ) source.elems in
