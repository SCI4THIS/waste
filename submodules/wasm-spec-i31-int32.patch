diff --git 1/interpreter/control_stubs.c 2/interpreter/control_stubs.c
new file mode 100644
index 000000000..d9804a636
--- /dev/null
+++ 2/interpreter/control_stubs.c
@@ -0,0 +1,34 @@
+#include <caml/mlvalues.h>
+#include <stdint.h>
+#include <time.h>
+
+/* Native reference-interpreter builds have no browser control page. */
+CAMLprim value waste_control_atomic_load(value index)
+{
+  (void)index;
+  return Val_int(0);
+}
+
+CAMLprim value waste_control_wait_while_paused(value unit)
+{
+  (void)unit;
+  return Val_unit;
+}
+
+CAMLprim value waste_control_wait_timeout(value milliseconds)
+{
+  int ms = Int_val(milliseconds);
+  struct timespec duration = {ms / 1000, (long)(ms % 1000) * 1000000L};
+  while (nanosleep(&duration, &duration) != 0) {}
+  return Val_unit;
+}
+
+CAMLprim value waste_clock_part(value kind, value index)
+{
+  struct timespec now;
+  clockid_t clock = Int_val(kind) == 0 ? CLOCK_REALTIME : CLOCK_MONOTONIC;
+  uint64_t milliseconds;
+  clock_gettime(clock, &now);
+  milliseconds = (uint64_t)now.tv_sec * 1000ULL + (uint64_t)now.tv_nsec / 1000000ULL;
+  return Val_int((milliseconds >> (16 * Int_val(index))) & 0xffffU);
+}
diff --git 1/interpreter/exec/control.ml 2/interpreter/exec/control.ml
new file mode 100644
index 000000000..3100d9f9d
--- /dev/null
+++ 2/interpreter/exec/control.ml
@@ -0,0 +1,61 @@
+(* Browser-to-interpreter control page.
+
+   The common path performs one atomic load.  Commands are stored in a
+   single-producer ring and published by incrementing the write sequence only
+   after the payload has been written.  Keeping the read sequence in the
+   interpreter makes control state part of a schedulable process, rather than
+   hidden mutable state in JavaScript. *)
+
+type command =
+  | Pause
+  | Terminate
+  | Signal of int
+
+type state = {mutable read_sequence : int}
+
+let header_words = 4
+let ring_words = 256
+let ring_mask = ring_words - 1
+
+let enabled = ref false
+
+external atomic_load : int -> int = "waste_control_atomic_load"
+external wait_while_paused : unit -> unit = "waste_control_wait_while_paused"
+external wait_timeout : int -> unit = "waste_control_wait_timeout"
+
+let enable () = enabled := true
+let disable () = enabled := false
+let is_enabled () = !enabled
+let create () = {read_sequence = 0}
+let copy state = {read_sequence = state.read_sequence}
+
+let decode word =
+  let operation = word lsr 16 in
+  let argument = word land 0xffff in
+  match operation with
+  | 1 -> Some Pause
+  | 2 -> Some (Signal argument)
+  | 3 -> Some Terminate
+  | _ -> None
+
+let poll state =
+  if not !enabled then None else
+  let published = atomic_load 0 in
+  if published = state.read_sequence then None else begin
+    let next = state.read_sequence + 1 in
+    let slot = header_words + (next land ring_mask) in
+    let command = decode (atomic_load slot) in
+    state.read_sequence <- next;
+    command
+  end
+
+let pause () = if !enabled then wait_while_paused ()
+let sleep_ms milliseconds = if milliseconds > 0 then wait_timeout milliseconds
+
+let defer callback milliseconds =
+  let set_timeout =
+    Js_of_ocaml.Js.Unsafe.get Js_of_ocaml.Js.Unsafe.global "waste_defer"
+  in
+  ignore (Js_of_ocaml.Js.Unsafe.fun_call set_timeout
+    [|Js_of_ocaml.Js.Unsafe.inject (Js_of_ocaml.Js.wrap_callback callback);
+      Js_of_ocaml.Js.Unsafe.inject milliseconds|])
