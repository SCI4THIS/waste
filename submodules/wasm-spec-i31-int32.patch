+val terminate : state -> Posix_kernel.exit_cause -> unit
+val wait_ready : state -> wait -> bool
+val next_timer_delay_ms : state -> int64 option
+val blocked : state -> int64
+val set_blocked : state -> int64 -> unit
+val reset_action : state -> int -> unit
+val request : string -> value list -> value list
+val poll_control : state -> unit
+val queue_signal : state -> int -> bool
+val signal_pending : state -> bool
+val poll_required : state -> bool
+val next_signal : state -> (int * signal_action) option
+val apply_default : state -> int -> default_effect
+val dispatch : state -> moduleinst -> string -> value list -> result
diff --git c/interpreter/host/posix_clock.ml w/interpreter/host/posix_clock.ml
