+let report_task id success =
+  Printf.printf "WASTE_RESULT %d %d\n%!" id (if success then 0 else 1)
+
+let report_task_slice id =
+  Printf.printf "WASTE_TASK %d\n%!" id
+
+let run_scheduled sources =
+  if !quantum <= 0 || !max_threads <= 0 then begin
+    if !max_threads <= 0 then
+      prerr_endline "option --threads: thread count must be positive"
+    else
+    prerr_endline "option -q: instruction quantum must be positive";
+    false
+  end else begin
+    Eval.set_quantum !quantum;
+    Eval.reset_profile ();
+    let profile_started = Posix_clock.monotonic_ms () in
+    let profile_slices = ref 0 in
+    let profile_steps = ref 0 in
+    let profile_slice_ms = ref 0L in
+    let profile_max_slice_ms = ref 0L in
+    let report_profile force =
+      if !Flags.trace && (force || !profile_slices mod 100 = 0) then begin
+        let elapsed = Int64.sub (Posix_clock.monotonic_ms ()) profile_started in
+        let outside = max 0L (Int64.sub elapsed !profile_slice_ms) in
+        Printf.printf
+          "-- [profile +%Ld ms] slices=%d steps=%d slice_ms=%Ld outside_ms=%Ld max_slice_ms=%Ld %s\n%!"
+          elapsed !profile_slices !profile_steps !profile_slice_ms outside !profile_max_slice_ms
+          (Eval.profile_report ())
+      end
+    in
+    let initial_state = Run.save_state () in
+    let tasks = Queue.create () in
+    let pending = Queue.create () in
+    let blocked = ref [] in
+    let deferred = ref None in
+    let last = List.length sources - 1 in
+    List.iteri (fun id source ->
+      if !fail_last && id = last then deferred := Some (id, source)
+      else Queue.add (id, source) pending
+    ) sources;
+    let active = ref 0 in
+    let make_task id source =
+      let group = {result_id = id; live = 1; successful = true} in
+      {id; group; state = Run.isolate_state initial_state; waiting = None;
+       resume = (fun () -> run_slice (fun () ->
+         try Finished (Run.run_string source)
+         with Posix.Terminated status -> Finished (status = 0)))}
+    in
+    let fill_slots () =
+      while !active < !max_threads && not (Queue.is_empty pending) do
+        let id, source = Queue.take pending in
+        Queue.add (make_task id source) tasks;
+        incr active
+      done
+    in
+    let deferred = match !deferred with
+      | None -> None
+      | Some (id, source) -> Some (make_task id source)
+    in
+    fill_slots ();
+    let success = ref true in
+    let enqueue_spawned task =
+      List.iter (fun child ->
+        task.group.live <- task.group.live + 1;
+        Queue.add
+          {id = task.id; group = task.group;
+           state = Run.with_eval_state task.state (Eval.spawned_state child);
+           resume = (fun () -> run_slice (fun () -> Eval.run_spawned child; Finished true));
+           waiting = None}
+          tasks
+      ) (Eval.take_spawned ())
+    in
+    let wake_blocked () =
+      let still_blocked = ref [] in
+      List.iter (fun task -> match task.waiting with
+        | Some wait when not (Run.wait_ready task.state wait) ->
+          still_blocked := task :: !still_blocked
+        | _ -> task.waiting <- None; Queue.add task tasks
+      ) !blocked;
+      blocked := List.rev !still_blocked
+    in
+    let next_timer_delay () =
+      let delays = List.filter_map (fun task -> Run.next_timer_delay_ms task.state) !blocked in
+      match List.sort Int64.compare delays with
+      | [] -> None
+      | delay :: _ -> Some (max 1 (min 50 (Int64.to_int delay)))
+    in
+    let fail_blocked () =
+      List.iter (fun task ->
+        task.group.successful <- false;
+        task.group.live <- task.group.live - 1;
+        if task.group.live = 0 then begin
+          success := false;
+          report_task task.group.result_id false;
+          decr active
+        end
+      ) !blocked;
+      blocked := [];
+      fill_slots ()
+    in
+    let finished = ref false in
+    let finish () =
+      if not !finished then begin
+        finished := true;
+        Option.iter (fun task ->
+          success := false;
+          report_task task.id false
+        ) deferred;
+        Run.restore_state initial_state;
+        Eval.set_quantum 0;
+        if !browser_schedule then
+          Printf.printf "WASTE_DONE %d\n%!" (if !success then 0 else 1)
+      end
+    in
+    let rec run_ready_tasks () =
+      if not !finished then begin
+        wake_blocked ();
+        fill_slots ();
+        if Queue.is_empty tasks then begin
+          match !blocked, next_timer_delay () with
+          | [], _ -> finish ()
+          | _, Some delay when !browser_schedule ->
+            Control.defer run_ready_tasks delay
+          | _, Some delay ->
+            Control.sleep_ms delay;
+            run_ready_tasks ()
+          | _, None when !browser_schedule ->
+            Control.defer run_ready_tasks 10
+          | _, None ->
+            fail_blocked ();
+            if Queue.is_empty tasks then finish ()
+        end;
+        if not (Queue.is_empty tasks) then begin
+          let task = Queue.take tasks in
+          Run.restore_state task.state;
+          Eval.reset_quantum ();
+          report_task_slice task.id;
+          let slice_started = Posix_clock.monotonic_ms () in
+          let slice =
+            try task.resume () with exn ->
+              flush_all ();
+              prerr_endline
+                (Sys.argv.(0) ^ ": task " ^ string_of_int task.id ^
+                 " uncaught exception " ^ Printexc.to_string exn);
+              Printexc.print_backtrace stderr;
+              Finished false
+          in
+          let slice_ms = Int64.sub (Posix_clock.monotonic_ms ()) slice_started in
+          incr profile_slices;
+          profile_steps := !profile_steps + Eval.slice_steps ();
+          profile_slice_ms := Int64.add !profile_slice_ms slice_ms;
+          profile_max_slice_ms := max !profile_max_slice_ms slice_ms;
+          task.state <- Run.save_state ();
+          enqueue_spawned task;
+          begin match slice with
+          | Finished ok ->
+            task.group.successful <- task.group.successful && ok;
+            task.group.live <- task.group.live - 1;
+            if task.group.live = 0 then begin
+              if not task.group.successful then success := false;
+              report_task task.group.result_id task.group.successful;
+              decr active;
+              fill_slots ()
+            end
+          | Suspended (waiting, resume) ->
+            task.resume <- resume;
+            task.waiting <- waiting;
+            begin match waiting with None -> Queue.add task tasks | Some _ -> blocked := task :: !blocked end
+          end;
+          report_profile
+            (match slice with Finished _ | Suspended (Some _, _) -> true | _ -> false);
+          if !browser_schedule then Control.defer run_ready_tasks 0
+          else run_ready_tasks ()
+        end
+      end
+    in
+    run_ready_tasks ();
+    if !browser_schedule then true else !success
+  end
+
 let () =
