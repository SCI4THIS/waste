diff --git 1/interpreter/host/control_runtime.js 2/interpreter/host/control_runtime.js
new file mode 100644
index 000000000..cd6a00cfc
--- /dev/null
+++ 2/interpreter/host/control_runtime.js
@@ -0,0 +1,14 @@
+//Provides: waste_control_atomic_load_js
+function waste_control_atomic_load_js(index) {
+  const page = globalThis.waste_control_page;
+  return page instanceof Int32Array ? globalThis.Atomics.load(page, index) : 0;
+}
+
+//Provides: waste_control_wait_while_paused_js
+function waste_control_wait_while_paused_js() {
+  const page = globalThis.waste_control_page;
+  if (!(page instanceof Int32Array)) return 0;
+  while (globalThis.Atomics.load(page, 1) === 1)
+    globalThis.Atomics.wait(page, 1, 1);
+  return 0;
+}
