+type slice =
+  | Finished of bool
+  | Suspended of (unit -> slice)
+
+type task =
+{
+  id : int;
+  mutable state : Run.state;
+  mutable resume : unit -> slice;
+}
+
+let run_slice f =
+  Effect.Deep.try_with f ()
+  {
+    Effect.Deep.effc = fun (type a) (eff : a Effect.t) ->
+      match eff with
+      | Eval.Yield ->
+        Some (fun (continuation : (a, slice) Effect.Deep.continuation) ->
+          Suspended (fun () -> Effect.Deep.continue continuation ()))
+      | _ -> None
+  }
+
+let report_task id success =
+  Printf.printf "WASTE_RESULT %d %d\n%!" id (if success then 0 else 1)
+
+let report_task_slice id =
+  Printf.printf "WASTE_TASK %d\n%!" id
+
+let run_scheduled sources =
+  if !quantum <= 0 then begin
+    prerr_endline "option -q: instruction quantum must be positive";
+    false
+  end else begin
+    Eval.set_quantum !quantum;
+    let initial_state = Run.save_state () in
+    let tasks = Queue.create () in
+    let deferred = ref None in
+    let last = List.length sources - 1 in
+    List.iteri (fun id source ->
+      let task =
+        {id; state = Run.fork_state initial_state;
+         resume = (fun () -> run_slice (fun () -> Finished (Run.run_string source)))}
