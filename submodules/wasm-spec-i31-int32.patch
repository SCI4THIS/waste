@@ -0,0 +1,10 @@
+external part : int -> int -> int = "waste_clock_part"
+
+let read kind =
+  let word index = Int64.of_int (part kind index land 0xffff) in
+  Int64.logor (word 0)
+    (Int64.logor (Int64.shift_left (word 1) 16)
+      (Int64.logor (Int64.shift_left (word 2) 32) (Int64.shift_left (word 3) 48)))
+
+let realtime_ms () = read 0
+let monotonic_ms () = read 1
