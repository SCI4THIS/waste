+val terminate : state -> Posix_kernel.exit_cause -> unit
+val wait_ready : state -> wait -> bool
+val next_timer_delay_ms : state -> int64 option
+val blocked : state -> int64
+val set_blocked : state -> int64 -> unit
+val reset_action : state -> int -> unit
+val request : string -> value list -> value list
+val poll_control : state -> unit
