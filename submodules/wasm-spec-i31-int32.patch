+        | ExternGlobal global -> ExternGlobal (physical_assoc global !global_pairs)
+        | ExternMemory memory -> ExternMemory (physical_assoc memory !memory_pairs)
+        | ExternTable table -> ExternTable (physical_assoc table !table_pairs)
+        | ExternFunc function_ -> ExternFunc (physical_assoc function_ !function_pairs)
+        | ExternTag tag -> ExternTag tag
