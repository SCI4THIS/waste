diff --git 1/interpreter/host/posix_kernel.ml 2/interpreter/host/posix_kernel.ml
new file mode 100644
index 000000000..1ae2de1e1
--- /dev/null
+++ 2/interpreter/host/posix_kernel.ml
@@ -0,0 +1,663 @@
+type pid = int32
+
+let errno_eperm = 1
+let errno_enoent = 2
+let errno_esrch = 3
+let errno_eintr = 4
+let errno_eio = 5
+let errno_ebadf = 9
+let errno_echild = 10
+let errno_eagain = 11
+let errno_enomem = 12
+let errno_eacces = 13
+let errno_efault = 14
+let errno_ebusy = 16
+let errno_eexist = 17
+let errno_enotdir = 20
+let errno_eisdir = 21
+let errno_einval = 22
+let errno_enfile = 23
+let errno_emfile = 24
+let errno_enotty = 25
+let errno_espipe = 29
+let errno_epipe = 32
+let errno_erange = 34
+let errno_enotempty = 39
+
+let o_accmode = 0x3l
+let o_rdonly = 0l
+let o_wronly = 1l
+let o_rdwr = 2l
+let o_creat = 0x40l
+let o_excl = 0x80l
+let o_trunc = 0x200l
+let o_append = 0x400l
+let o_nonblock = 0x800l
+let o_directory = 0x1_0000l
+let fd_cloexec = 1l
+
+type exit_cause = Exited of int | Signaled of int
+type process_status = Running | Stopped of int | Zombie of exit_cause
+
+type wait_target = Any_child | Child of pid | Process_group of pid
+type wait_event =
+  | Child_exited of pid * int
+  | Child_stopped of pid * int
+  | Child_continued of pid
+  | No_children
+  | Would_block
+
+type pipe_buffer =
+{
+  data : bytes;
+  mutable start : int;
+  mutable length : int;
+  mutable readers : int;
+  mutable writers : int;
+}
+
+type terminal =
+{
+  mutable foreground_group : pid;
+  controlling_session : pid;
+  input : pipe_buffer;
+  output : Buffer.t;
+  mutable attributes : string;
+}
+
+type node_kind = Directory of (string, node) Hashtbl.t | Regular of bytes ref | Terminal of terminal
+and node =
+{
+  inode : int64;
+  mutable mode : int32;
+  uid : int32;
+  gid : int32;
+  mutable links : int32;
+  mutable atime_ms : int64;
+  mutable mtime_ms : int64;
+  mutable ctime_ms : int64;
+  node_kind : node_kind;
+}
+
+type open_kind = Node of node | Pipe_read of pipe_buffer | Pipe_write of pipe_buffer
+type open_file =
+{
+  open_kind : open_kind;
+  mutable offset : int64;
+  mutable status_flags : int32;
+  mutable references : int;
+}
+
+type descriptor = {file : open_file; mutable flags : int32}
+
+type process_event = Exit_event of int | Stop_event of int | Continue_event
+
+type process =
+{
+  system : kernel;
+  id : pid;
+  mutable parent : pid;
+  mutable group : pid;
+  mutable session_ : pid;
+  mutable state : process_status;
+  mutable cwd_ : string;
+  mutable umask : int32;
+  descriptors : (int, descriptor) Hashtbl.t;
+  mutable child_events : (pid * process_event) list;
+  mutable alarm_deadline : int64 option;
+  mutable timer_deadline : int64 option;
+  mutable timer_interval : int64;
+}
+
+and kernel =
+{
+  processes_ : (pid, process) Hashtbl.t;
+  mutable next_pid : pid;
+  mutable next_inode : int64;
+  mutable next_file : int;
+  mutable next_pipe : int;
+  root : node;
+  tty : terminal;
+  clock : unit -> int64;
+}
+
+type wait_reason = Pipe_readable of pipe_buffer | Pipe_writable of pipe_buffer | Child_changed | Deadline of int64 | Process_running of process
+type io_result = Done of string | End_of_file | Blocked of wait_reason | Read_signal of int | Read_error of int
+type write_result = Written of int | Write_blocked of wait_reason | Write_error of int
+type clock = unit -> int64
+
+let now_ms process = process.system.clock ()
+
+let make_pipe id =
+  ignore id;
+  {data = Bytes.create 4096; start = 0; length = 0; readers = 0; writers = 0}
+
+let pipe_capacity pipe = Bytes.length pipe.data
+
+let pipe_compact pipe =
+  if pipe.start > 0 && pipe.length > 0 then
+    Bytes.blit pipe.data pipe.start pipe.data 0 pipe.length;
+  pipe.start <- 0
+
+let pipe_push pipe string =
+  let available = pipe_capacity pipe - pipe.length in
+  let count = min available (String.length string) in
+  if count > 0 then begin
+    if pipe.start + pipe.length + count > pipe_capacity pipe then pipe_compact pipe;
+    Bytes.blit_string string 0 pipe.data (pipe.start + pipe.length) count;
+    pipe.length <- pipe.length + count
+  end;
+  count
+
+let pipe_take pipe count =
+  let count = min count pipe.length in
+  let result = Bytes.sub_string pipe.data pipe.start count in
+  pipe.start <- pipe.start + count;
+  pipe.length <- pipe.length - count;
+  if pipe.length = 0 then pipe.start <- 0;
+  result
+
+let make_node inode mode now kind =
+  {inode; mode; uid = 0l; gid = 0l; links = 1l;
+   atime_ms = now; mtime_ms = now; ctime_ms = now; node_kind = kind}
+
+let create ?(clock = fun () -> 0L) () =
+  let input = make_pipe 0 in
+  let tty =
+    {foreground_group = 1l; controlling_session = 1l; input;
+     output = Buffer.create 4096; attributes = String.make 60 '\000'} in
+  let now = clock () in
+  let root = make_node 1L 0o040755l now (Directory (Hashtbl.create 16)) in
+  let system =
+    {processes_ = Hashtbl.create 16; next_pid = 2l; next_inode = 2L;
+     next_file = 3; next_pipe = 1; root; tty; clock} in
+  let process =
+    {system; id = 1l; parent = 0l; group = 1l; session_ = 1l; state = Running;
+     cwd_ = "/"; umask = 0o022l; descriptors = Hashtbl.create 16;
+     child_events = []; alarm_deadline = None; timer_deadline = None;
+     timer_interval = 0L} in
+  let tty_node = make_node 2L 0o020666l now (Terminal tty) in
+  system.next_inode <- 3L;
+  let root_entries = match root.node_kind with Directory entries -> entries | _ -> assert false in
+  let dev = make_node 3L 0o040755l now (Directory (Hashtbl.create 4)) in
+  let tmp = make_node 4L 0o041777l now (Directory (Hashtbl.create 8)) in
+  system.next_inode <- 5L;
+  Hashtbl.add root_entries "dev" dev;
+  Hashtbl.add root_entries "tmp" tmp;
+  begin match dev.node_kind with Directory entries -> Hashtbl.add entries "tty" tty_node | _ -> () end;
+  let terminal_file id =
+    ignore id;
+    {open_kind = Node tty_node; offset = 0L; status_flags = o_rdwr; references = 1} in
+  Hashtbl.add process.descriptors 0 {file = terminal_file 0; flags = 0l};
+  Hashtbl.add process.descriptors 1 {file = terminal_file 1; flags = 0l};
+  Hashtbl.add process.descriptors 2 {file = terminal_file 2; flags = 0l};
+  Hashtbl.add system.processes_ process.id process;
+  system, process
+
+let kernel process = process.system
+let pid process = process.id
+let ppid process = process.parent
+let pgid process = process.group
+let sid process = process.session_
+let status process = process.state
+let cwd process = process.cwd_
+let find_process system id = Hashtbl.find_opt system.processes_ id
+let processes system = Hashtbl.fold (fun _ process result -> process :: result) system.processes_ []
+let children process = List.filter (fun child -> child.parent = process.id) (processes process.system)
+
+let descriptor_copy descriptor =
+  descriptor.file.references <- descriptor.file.references + 1;
+  {file = descriptor.file; flags = descriptor.flags}
+
+let release_descriptor descriptor =
+  descriptor.file.references <- descriptor.file.references - 1;
+  if descriptor.file.references = 0 then match descriptor.file.open_kind with
+    | Pipe_read pipe -> pipe.readers <- pipe.readers - 1
+    | Pipe_write pipe -> pipe.writers <- pipe.writers - 1
+    | Node _ -> ()
+
+let fork parent =
+  let system = parent.system in
+  let id = system.next_pid in
+  system.next_pid <- Int32.succ id;
+  let descriptors = Hashtbl.create (Hashtbl.length parent.descriptors + 1) in
+  Hashtbl.iter (fun fd descriptor -> Hashtbl.add descriptors fd (descriptor_copy descriptor)) parent.descriptors;
+  let child =
+    {system; id; parent = parent.id; group = parent.group; session_ = parent.session_;
+     state = Running; cwd_ = parent.cwd_; umask = parent.umask; descriptors;
+     child_events = []; alarm_deadline = None; timer_deadline = None;
+     timer_interval = 0L} in
+  Hashtbl.add system.processes_ id child;
+  child
+
+let clone_isolated _process = create ()
+
+let notify_parent process event =
+  match find_process process.system process.parent with
+  | None -> ()
+  | Some parent -> parent.child_events <- parent.child_events @ [process.id, event]
+
+let terminate process cause =
+  match process.state with
+  | Zombie _ -> ()
+  | Running | Stopped _ ->
+    Hashtbl.iter (fun _ descriptor -> release_descriptor descriptor) process.descriptors;
+    Hashtbl.clear process.descriptors;
+    List.iter (fun child -> child.parent <- 1l) (children process);
+    process.state <- Zombie cause;
+    notify_parent process (Exit_event (match cause with Exited code -> code lsl 8 | Signaled signal -> signal land 0x7f))
+
+let stop process signal =
+  match process.state with
+  | Running -> process.state <- Stopped signal; notify_parent process (Stop_event signal)
+  | _ -> ()
+
+let continue process =
+  match process.state with
+  | Stopped _ -> process.state <- Running; notify_parent process Continue_event
+  | _ -> ()
+
+let setpgid caller target group =
+  let target = if target = 0l then caller.id else target in
+  let group = if group = 0l then target else group in
+  match find_process caller.system target with
+  | None -> false
+  | Some process when process.id <> caller.id && process.parent <> caller.id -> false
+  | Some process when process.session_ <> caller.session_ || process.id = process.session_ -> false
+  | Some process -> process.group <- group; true
+
+let setsid process =
+  if process.group = process.id then None else begin
+    process.session_ <- process.id;
+    process.group <- process.id;
+    Some process.id
+  end
+
+let target_matches parent target child =
+  child.parent = parent.id && match target with
+  | Any_child -> true
+  | Child id -> child.id = id
+  | Process_group group -> child.group = group
+
+let waitpid parent target ~nohang ~untraced ~continued =
+  let matching = List.filter (target_matches parent target) (processes parent.system) in
+  if matching = [] then No_children else
+  let rec take before = function
+    | [] -> None
+    | ((child_id, event) as item) :: rest ->
+      begin match find_process parent.system child_id with
+      | Some child when target_matches parent target child ->
+        let accepted = match event with
+          | Exit_event _ -> true | Stop_event _ -> untraced | Continue_event -> continued in
+        if accepted then begin
+          parent.child_events <- List.rev_append before rest;
+          Some (child, event)
+        end else take (item :: before) rest
+      | _ -> take (item :: before) rest
+      end
+  in
+  match take [] parent.child_events with
+  | Some (child, Exit_event status) ->
+    Hashtbl.remove parent.system.processes_ child.id;
+    Child_exited (child.id, status)
+  | Some (child, Stop_event signal) -> Child_stopped (child.id, signal)
+  | Some (child, Continue_event) -> Child_continued child.id
+  | None -> if nohang then Would_block else Would_block
+
+let components path =
+  String.split_on_char '/' path |> List.filter (fun part -> part <> "" && part <> ".")
+
+let normalize cwd path =
+  let initial = if String.length path > 0 && path.[0] = '/' then [] else components cwd in
+  let rec fold result = function
+    | [] -> result
+    | ".." :: rest -> fold (match result with [] -> [] | _ :: tail -> tail) rest
+    | part :: rest -> fold (part :: result) rest
+  in
+  "/" ^ String.concat "/" (List.rev (fold (List.rev initial) (components path)))
+
+let lookup_absolute system path =
+  let rec walk node = function
+    | [] -> Some node
+    | part :: rest ->
+      begin match node.node_kind with
+      | Directory entries -> Option.bind (Hashtbl.find_opt entries part) (fun child -> walk child rest)
+      | _ -> None
+      end
+  in walk system.root (components path)
+
+let lookup process path = lookup_absolute process.system (normalize process.cwd_ path)
+
+let parent_and_name process path =
+  let absolute = normalize process.cwd_ path in
+  match List.rev (components absolute) with
+  | [] -> None
+  | name :: reverse_parent ->
+    Option.map (fun parent -> parent, name)
+      (lookup_absolute process.system ("/" ^ String.concat "/" (List.rev reverse_parent)))
+
+let allocate_fd process minimum =
+  let rec find fd =
+    if fd >= 1024 then None
+    else if Hashtbl.mem process.descriptors fd then find (fd + 1) else Some fd
+  in find (max 0 minimum)
+
+let allocate_file system kind status_flags =
+  system.next_file <- system.next_file + 1;
+  {open_kind = kind; offset = 0L; status_flags; references = 1}
+
+let open_file process path flags mode =
+  let existing = lookup process path in
+  let node_result = match existing with
+    | Some node when Int32.logand flags o_excl <> 0l && Int32.logand flags o_creat <> 0l -> Error errno_eexist
+    | Some node -> Ok node
+    | None when Int32.logand flags o_creat = 0l -> Error errno_enoent
+    | None ->
+      begin match parent_and_name process path with
+      | Some ({node_kind = Directory entries; _}, name) ->
+        let now = now_ms process in
+        let permissions = Int32.logand mode (Int32.lognot process.umask) in
+        let node = make_node process.system.next_inode (Int32.logor 0o100000l permissions) now (Regular (ref Bytes.empty)) in
+        process.system.next_inode <- Int64.succ process.system.next_inode;
+        Hashtbl.add entries name node;
+        Ok node
+      | Some _ -> Error errno_enotdir
+      | None -> Error errno_enoent
+      end
+  in
+  match node_result with
+  | Error error -> Error error
+  | Ok ({node_kind = Directory _; _}) when Int32.logand flags o_accmode <> o_rdonly -> Error errno_eisdir
+  | Ok node when Int32.logand flags o_directory <> 0l && (match node.node_kind with Directory _ -> false | _ -> true) -> Error errno_enotdir
+  | Ok node ->
+    begin match node.node_kind with
+    | Regular contents when Int32.logand flags o_trunc <> 0l && Int32.logand flags o_accmode <> o_rdonly -> contents := Bytes.empty
+    | _ -> ()
+    end;
+    begin match allocate_fd process 0 with
+    | None -> Error errno_emfile
+    | Some fd ->
+      let file = allocate_file process.system (Node node) flags in
+      if Int32.logand flags o_append <> 0l then begin
+        match node.node_kind with Regular contents -> file.offset <- Int64.of_int (Bytes.length !contents) | _ -> ()
+      end;
+      Hashtbl.add process.descriptors fd {file; flags = 0l};
+      Ok fd
+    end
+
+let close process fd =
+  match Hashtbl.find_opt process.descriptors fd with
+  | None -> Error errno_ebadf
+  | Some descriptor -> Hashtbl.remove process.descriptors fd; release_descriptor descriptor; Ok ()
+
+let dup process fd ~minimum ~cloexec =
+  match Hashtbl.find_opt process.descriptors fd, allocate_fd process minimum with
+  | None, _ -> Error errno_ebadf
+  | _, None -> Error errno_emfile
+  | Some descriptor, Some target ->
+    let copy = descriptor_copy descriptor in
+    copy.flags <- if cloexec then fd_cloexec else 0l;
+    Hashtbl.add process.descriptors target copy;
+    Ok target
+
+let dup2 process source target ~cloexec =
+  if target < 0 || target >= 1024 then Error errno_ebadf else
+  match Hashtbl.find_opt process.descriptors source with
+  | None -> Error errno_ebadf
+  | Some _ when source = target -> Ok target
+  | Some descriptor ->
+    Option.iter release_descriptor (Hashtbl.find_opt process.descriptors target);
+    let copy = descriptor_copy descriptor in
+    copy.flags <- if cloexec then fd_cloexec else 0l;
+    Hashtbl.replace process.descriptors target copy;
+    Ok target
+
+let pipe process =
+  match allocate_fd process 0 with
+  | None -> Error errno_emfile
+  | Some read_fd ->
+    let pipe = make_pipe process.system.next_pipe in
+    process.system.next_pipe <- process.system.next_pipe + 1;
+    pipe.readers <- 1; pipe.writers <- 1;
+    let read_file = allocate_file process.system (Pipe_read pipe) o_rdonly in
+    let write_file = allocate_file process.system (Pipe_write pipe) o_wronly in
+    Hashtbl.add process.descriptors read_fd {file = read_file; flags = 0l};
+    begin match allocate_fd process 0 with
+    | Some write_fd ->
+      Hashtbl.add process.descriptors write_fd {file = write_file; flags = 0l};
+      Ok (read_fd, write_fd)
+    | None ->
+      Hashtbl.remove process.descriptors read_fd;
+      release_descriptor {file = read_file; flags = 0l};
+      Error errno_emfile
+    end
+
+let can_read descriptor = Int32.logand descriptor.file.status_flags o_accmode <> o_wronly
+let can_write descriptor = Int32.logand descriptor.file.status_flags o_accmode <> o_rdonly
+let nonblocking descriptor = Int32.logand descriptor.file.status_flags o_nonblock <> 0l
+
+let read process fd count =
+  match Hashtbl.find_opt process.descriptors fd with
+  | None -> Read_error errno_ebadf
+  | Some descriptor when not (can_read descriptor) -> Read_error errno_ebadf
+  | Some descriptor ->
+    match descriptor.file.open_kind with
+    | Pipe_write _ -> Read_error errno_ebadf
+    | Pipe_read pipe ->
+      if pipe.length > 0 then Done (pipe_take pipe count)
+      else if pipe.writers = 0 then End_of_file
+      else if nonblocking descriptor then Read_error errno_eagain
+      else Blocked (Pipe_readable pipe)
+    | Node {node_kind = Regular contents; _} ->
+      let offset = Int64.to_int descriptor.file.offset in
+      let available = max 0 (Bytes.length !contents - offset) in
+      let count = min count available in
+      descriptor.file.offset <- Int64.add descriptor.file.offset (Int64.of_int count);
+      begin match descriptor.file.open_kind with Node node -> node.atime_ms <- now_ms process | _ -> () end;
+      if count = 0 then End_of_file else Done (Bytes.sub_string !contents offset count)
+    | Node {node_kind = Directory _; _} -> Read_error errno_eisdir
+    | Node {node_kind = Terminal tty; _} ->
+      if process.group <> tty.foreground_group then Read_signal 21 (* SIGTTIN *)
+      else if tty.input.length > 0 then Done (pipe_take tty.input count)
+      else if nonblocking descriptor then Read_error errno_eagain
+      else Blocked (Pipe_readable tty.input)
+
+let write_regular process node file contents string =
+  let offset =
+    if Int32.logand file.status_flags o_append <> 0l then Bytes.length !contents
+    else Int64.to_int file.offset in
+  let required = offset + String.length string in
+  if required > Bytes.length !contents then begin
+    let grown = Bytes.make required '\000' in
+    Bytes.blit !contents 0 grown 0 (Bytes.length !contents);
+    contents := grown
+  end;
+  Bytes.blit_string string 0 !contents offset (String.length string);
+  file.offset <- Int64.of_int required;
+  let now = now_ms process in
+  node.mtime_ms <- now;
+  node.ctime_ms <- now;
+  Written (String.length string)
+
+let write process fd string =
+  match Hashtbl.find_opt process.descriptors fd with
+  | None -> Write_error errno_ebadf
+  | Some descriptor when not (can_write descriptor) -> Write_error errno_ebadf
+  | Some descriptor ->
+    match descriptor.file.open_kind with
+    | Pipe_read _ -> Write_error errno_ebadf
+    | Pipe_write pipe ->
+      if pipe.readers = 0 then Write_error errno_epipe else
+      let count = pipe_push pipe string in
+      if count > 0 then Written count
+      else if nonblocking descriptor then Write_error errno_eagain
+      else Write_blocked (Pipe_writable pipe)
+    | Node ({node_kind = Regular contents; _} as node) -> write_regular process node descriptor.file contents string
+    | Node {node_kind = Directory _; _} -> Write_error errno_eisdir
+    | Node {node_kind = Terminal tty; _} ->
+      Buffer.add_string tty.output string;
+      Written (String.length string)
+
+let seek process fd offset whence =
+  match Hashtbl.find_opt process.descriptors fd with
+  | None -> Error errno_ebadf
+  | Some {file = {open_kind = (Pipe_read _ | Pipe_write _ | Node {node_kind = Terminal _; _}); _}; _} -> Error errno_espipe
+  | Some descriptor ->
+    let size = match descriptor.file.open_kind with Node {node_kind = Regular bytes; _} -> Int64.of_int (Bytes.length !bytes) | _ -> 0L in
+    let base = match whence with 0 -> 0L | 1 -> descriptor.file.offset | 2 -> size | _ -> -1L in
+    let result = Int64.add base offset in
+    if base < 0L || result < 0L then Error errno_einval
+    else (descriptor.file.offset <- result; Ok result)
+
+let fd_flags process fd = match Hashtbl.find_opt process.descriptors fd with None -> Error errno_ebadf | Some descriptor -> Ok descriptor.flags
+let set_fd_flags process fd flags = match Hashtbl.find_opt process.descriptors fd with None -> Error errno_ebadf | Some descriptor -> descriptor.flags <- Int32.logand flags fd_cloexec; Ok ()
+let status_flags process fd = match Hashtbl.find_opt process.descriptors fd with None -> Error errno_ebadf | Some descriptor -> Ok descriptor.file.status_flags
+let set_status_flags process fd flags = match Hashtbl.find_opt process.descriptors fd with None -> Error errno_ebadf | Some descriptor -> descriptor.file.status_flags <- flags; Ok ()
+let fchmod process fd mode = match Hashtbl.find_opt process.descriptors fd with
+  | None -> Error errno_ebadf
+  | Some {file = {open_kind = Node node; _}; _} ->
+    node.mode <- Int32.logor (Int32.logand node.mode 0o170000l) (Int32.logand mode 0o7777l);
+    node.ctime_ms <- now_ms process;
+    Ok ()
+  | Some _ -> Error errno_einval
+let umask process mask = let previous = process.umask in process.umask <- Int32.logand mask 0o777l; previous
+
+let chdir process path =
+  match lookup process path with
+  | Some {node_kind = Directory _; _} -> process.cwd_ <- normalize process.cwd_ path; Ok ()
+  | Some _ -> Error errno_enotdir
+  | None -> Error errno_enoent
+
+let getcwd process = process.cwd_
+
+let mkdir process path mode =
+  if lookup process path <> None then Error errno_eexist else
+  match parent_and_name process path with
+  | Some ({node_kind = Directory entries; _}, name) ->
+    let now = now_ms process in
+    let node = make_node process.system.next_inode (Int32.logor 0o040000l (Int32.logand mode (Int32.lognot process.umask))) now (Directory (Hashtbl.create 8)) in
+    process.system.next_inode <- Int64.succ process.system.next_inode;
+    Hashtbl.add entries name node;
+    Ok ()
+  | Some _ -> Error errno_enotdir
+  | None -> Error errno_enoent
+
+let unlink process path ~directory =
+  match parent_and_name process path with
+  | Some ({node_kind = Directory entries; _}, name) ->
+    begin match Hashtbl.find_opt entries name with
+    | None -> Error errno_enoent
+    | Some {node_kind = Directory _; _} when not directory -> Error errno_eisdir
+    | Some {node_kind = Directory children; _} when Hashtbl.length children <> 0 -> Error errno_enotempty
+    | Some node -> node.links <- Int32.pred node.links; Hashtbl.remove entries name; Ok ()
+    end
+  | Some _ -> Error errno_enotdir
+  | None -> Error errno_enoent
+
+let rename process old_path new_path =
+  match parent_and_name process old_path, parent_and_name process new_path with
+  | Some ({node_kind = Directory old_entries; _}, old_name), Some ({node_kind = Directory new_entries; _}, new_name) ->
+    begin match Hashtbl.find_opt old_entries old_name with
+    | None -> Error errno_enoent
+    | Some node ->
+      node.ctime_ms <- now_ms process;
+      Hashtbl.replace new_entries new_name node;
+      Hashtbl.remove old_entries old_name;
+      Ok ()
+    end
+  | _ -> Error errno_enoent
+
+let access process path = lookup process path <> None
+
+type node_info =
+{
+  inode : int64; mode : int32; size : int64; links : int32; uid : int32; gid : int32;
+  atime_ms : int64; mtime_ms : int64; ctime_ms : int64;
+}
+
+let node_info node =
+  let size = match node.node_kind with Regular bytes -> Int64.of_int (Bytes.length !bytes) | _ -> 0L in
+  {inode = node.inode; mode = node.mode; size; links = node.links; uid = node.uid; gid = node.gid;
+   atime_ms = node.atime_ms; mtime_ms = node.mtime_ms; ctime_ms = node.ctime_ms}
+
+let stat process path ~follow:_ = match lookup process path with None -> Error errno_enoent | Some node -> Ok (node_info node)
+let fstat process fd = match Hashtbl.find_opt process.descriptors fd with
+  | None -> Error errno_ebadf
+  | Some {file = {open_kind = Node node; _}; _} -> Ok (node_info node)
+  | Some _ -> Ok {inode = 0L; mode = 0o010600l; size = 0L; links = 1l; uid = 0l; gid = 0l; atime_ms = 0L; mtime_ms = 0L; ctime_ms = 0L}
+
+let terminal_of_fd process fd = match Hashtbl.find_opt process.descriptors fd with
+  | Some {file = {open_kind = Node {node_kind = Terminal terminal; _}; _}; _} -> Some terminal
+  | _ -> None
+
+let isatty process fd = terminal_of_fd process fd <> None
+let tty_foreground_group process fd = match terminal_of_fd process fd with None -> Error errno_enotty | Some tty -> Ok tty.foreground_group
+let group_exists system group session = List.exists (fun process -> process.group = group && process.session_ = session) (processes system)
+let tty_set_foreground_group process fd group = match terminal_of_fd process fd with
+  | None -> Error errno_enotty
+  | Some tty when tty.controlling_session <> process.session_ -> Error errno_eperm
+  | Some _ when not (group_exists process.system group process.session_) -> Error errno_esrch
+  | Some tty -> tty.foreground_group <- group; Ok ()
+let tty_get_attributes process fd = match terminal_of_fd process fd with None -> Error errno_enotty | Some tty -> Ok tty.attributes
+let tty_set_attributes process fd attributes = match terminal_of_fd process fd with None -> Error errno_enotty | Some tty -> tty.attributes <- attributes; Ok ()
+let terminal_output system = Buffer.contents system.tty.output
+let terminal_feed system string = ignore (pipe_push system.tty.input string)
+
+let remaining now = function None -> 0L | Some deadline -> max 0L (Int64.sub deadline now)
+let set_alarm process seconds =
+  let now = now_ms process in
+  let previous = Int64.div (Int64.add (remaining now process.alarm_deadline) 999L) 1000L in
+  process.alarm_deadline <- if seconds = 0L then None else Some (Int64.add now (Int64.mul seconds 1000L));
+  previous
+
+let set_interval_timer process ~initial_ms ~interval_ms =
+  let now = now_ms process in
+  let previous = remaining now process.timer_deadline, process.timer_interval in
+  process.timer_deadline <- if initial_ms = 0L then None else Some (Int64.add now initial_ms);
+  process.timer_interval <- interval_ms;
+  previous
+
+let poll_timers process =
+  if process.alarm_deadline = None && process.timer_deadline = None then [] else begin
+    let now = now_ms process in
+    let signals = ref [] in
+    begin match process.alarm_deadline with
+    | Some deadline when deadline <= now -> process.alarm_deadline <- None; signals := 14 :: !signals
+    | _ -> ()
+    end;
+    begin match process.timer_deadline with
+    | Some deadline when deadline <= now ->
+      signals := 14 :: !signals;
+      process.timer_deadline <- if process.timer_interval = 0L then None else Some (Int64.add now process.timer_interval)
+    | _ -> ()
+    end;
+    !signals
+  end
+
+let wait_ready process = function
+  | Pipe_readable pipe -> pipe.length > 0 || pipe.writers = 0
+  | Pipe_writable pipe -> pipe.readers = 0 || pipe.length < pipe_capacity pipe
+  | Child_changed -> process.child_events <> []
+  | Deadline deadline -> now_ms process >= deadline
+  | Process_running stopped -> stopped.state = Running
+
+let deadline_wait deadline = Deadline deadline
+let child_wait = Child_changed
+let stopped_wait process = Process_running process
+
+let next_timer_delay_ms process =
+  let now = now_ms process in
+  let deadlines = List.filter_map (fun value -> value) [process.alarm_deadline; process.timer_deadline] in
+  match List.sort Int64.compare deadlines with [] -> None | deadline :: _ -> Some (max 0L (Int64.sub deadline now))
+
+let signal_targets caller target =
+  let all = processes caller.system in
+  if target > 0l then Option.map (fun process -> [process]) (find_process caller.system target)
+  else if target = 0l then Some (List.filter (fun process -> process.group = caller.group) all)
+  else if target = -1l then Some (List.filter (fun process -> process.id <> 1l) all)
+  else Some (List.filter (fun process -> process.group = Int32.neg target) all)
+
+let process_group_targets caller group =
+  let group = if group = 0l then caller.group else group in
+  let targets = List.filter (fun process -> process.group = group) (processes caller.system) in
+  if targets = [] then None else Some targets
