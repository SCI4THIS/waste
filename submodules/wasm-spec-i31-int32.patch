+type slice =
+  | Finished of bool
+  | Suspended of (unit -> slice)
+
+type task =
+{
+  id : int;
+  mutable state : Run.state;
+  mutable resume : unit -> slice;
+}
+
+let run_slice f =
+  Effect.Deep.try_with f ()
+  {
+    Effect.Deep.effc = fun (type a) (eff : a Effect.t) ->
+      match eff with
+      | Eval.Yield ->
+        Some (fun (continuation : (a, slice) Effect.Deep.continuation) ->
+          Suspended (fun () -> Effect.Deep.continue continuation ()))
+      | _ -> None
+  }
+
+let report_task id success =
+  Printf.printf "WASTE_RESULT %d %d\n%!" id (if success then 0 else 1)
+
+let report_task_slice id =
+  Printf.printf "WASTE_TASK %d\n%!" id
+
+let run_scheduled sources =
+  if !quantum <= 0 then begin
+    prerr_endline "option -q: instruction quantum must be positive";
+    false
+  end else begin
+    Eval.set_quantum !quantum;
+    let initial_state = Run.save_state () in
+    let tasks = Queue.create () in
+    let deferred = ref None in
+    let last = List.length sources - 1 in
+    List.iteri (fun id source ->
+      let task =
+        {id; state = initial_state;
+         resume = (fun () -> run_slice (fun () -> Finished (Run.run_string source)))}
+      in
+      if !fail_last && id = last then deferred := Some task else
+      Queue.add task tasks
+    ) sources;
+    let success = ref true in
+    let run_ready_tasks () =
+      while not (Queue.is_empty tasks) do
+        let task = Queue.take tasks in
+        Run.restore_state task.state;
+        Eval.reset_quantum ();
+        report_task_slice task.id;
+        let slice =
+          try task.resume () with exn ->
+            flush_all ();
+            prerr_endline
+              (Sys.argv.(0) ^ ": task " ^ string_of_int task.id ^
+               " uncaught exception " ^ Printexc.to_string exn);
+            Printexc.print_backtrace stderr;
+            Finished false
+        in
+        task.state <- Run.save_state ();
+        match slice with
+        | Finished ok ->
+          if not ok then success := false;
+          report_task task.id ok
+        | Suspended resume ->
+          task.resume <- resume;
+          Queue.add task tasks
+      done
+    in
+    run_ready_tasks ();
+    Option.iter (fun task ->
+      success := false;
+      report_task task.id false
+    ) !deferred;
+    Run.restore_state initial_state;
+    Eval.set_quantum 0;
+    !success
+  end
+
