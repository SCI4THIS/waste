+type pid = int32
+
+type exit_cause = Exited of int | Signaled of int
+type process_status = Running | Stopped of int | Zombie of exit_cause
+
+type wait_target = Any_child | Child of pid | Process_group of pid
+type wait_event =
+  | Child_exited of pid * int
+  | Child_stopped of pid * int
+  | Child_continued of pid
+  | No_children
+  | Would_block
+
+type wait_reason
+type io_result = Done of string | End_of_file | Blocked of wait_reason | Read_signal of int | Read_error of int
+type write_result = Written of int | Write_blocked of wait_reason | Write_error of int
+
+type clock = unit -> int64
+type kernel
+type process
+
+val create : ?clock:clock -> unit -> kernel * process
+val clone_isolated : process -> kernel * process
+val fork : process -> process
+
+val kernel : process -> kernel
+val pid : process -> pid
+val ppid : process -> pid
+val pgid : process -> pid
+val sid : process -> pid
+val status : process -> process_status
+val cwd : process -> string
+
+val find_process : kernel -> pid -> process option
+val processes : kernel -> process list
+val children : process -> process list
+
+val setpgid : process -> pid -> pid -> bool
+val setsid : process -> pid option
+val terminate : process -> exit_cause -> unit
+val stop : process -> int -> unit
+val continue : process -> unit
+val waitpid : process -> wait_target -> nohang:bool -> untraced:bool -> continued:bool -> wait_event
+
+val open_file : process -> string -> int32 -> int32 -> (int, int) result
+val close : process -> int -> (unit, int) result
+val dup : process -> int -> minimum:int -> cloexec:bool -> (int, int) result
+val dup2 : process -> int -> int -> cloexec:bool -> (int, int) result
+val pipe : process -> ((int * int), int) result
+val read : process -> int -> int -> io_result
+val write : process -> int -> string -> write_result
+val seek : process -> int -> int64 -> int -> (int64, int) result
+val fd_flags : process -> int -> (int32, int) result
+val set_fd_flags : process -> int -> int32 -> (unit, int) result
+val status_flags : process -> int -> (int32, int) result
+val set_status_flags : process -> int -> int32 -> (unit, int) result
+val fchmod : process -> int -> int32 -> (unit, int) result
+val umask : process -> int32 -> int32
+
+val chdir : process -> string -> (unit, int) result
+val getcwd : process -> string
+val mkdir : process -> string -> int32 -> (unit, int) result
+val unlink : process -> string -> directory:bool -> (unit, int) result
+val rename : process -> string -> string -> (unit, int) result
+val access : process -> string -> bool
+
+type node_info =
+{
+  inode : int64;
+  mode : int32;
+  size : int64;
+  links : int32;
+  uid : int32;
+  gid : int32;
+  atime_ms : int64;
+  mtime_ms : int64;
+  ctime_ms : int64;
+}
+
+val stat : process -> string -> follow:bool -> (node_info, int) result
+val fstat : process -> int -> (node_info, int) result
+
+val isatty : process -> int -> bool
+val tty_foreground_group : process -> int -> (pid, int) result
+val tty_set_foreground_group : process -> int -> pid -> (unit, int) result
+val tty_get_attributes : process -> int -> (string, int) result
+val tty_set_attributes : process -> int -> string -> (unit, int) result
+val terminal_output : kernel -> string
+val terminal_feed : kernel -> string -> unit
+
+val set_alarm : process -> int64 -> int64
+val set_interval_timer : process -> initial_ms:int64 -> interval_ms:int64 -> int64 * int64
+val poll_timers : process -> int list
+val now_ms : process -> int64
+val wait_ready : process -> wait_reason -> bool
+val deadline_wait : int64 -> wait_reason
+val child_wait : wait_reason
+val stopped_wait : process -> wait_reason
+val next_timer_delay_ms : process -> int64 option
+
+val signal_targets : process -> pid -> process list option
+val process_group_targets : process -> pid -> process list option
+
+val errno_eperm : int
+val errno_enoent : int
+val errno_esrch : int
+val errno_eintr : int
+val errno_eio : int
+val errno_ebadf : int
+val errno_echild : int
+val errno_eagain : int
+val errno_enomem : int
+val errno_eacces : int
+val errno_efault : int
+val errno_ebusy : int
+val errno_eexist : int
+val errno_enotdir : int
+val errno_eisdir : int
+val errno_einval : int
+val errno_enfile : int
+val errno_emfile : int
+val errno_enotty : int
+val errno_espipe : int
+val errno_epipe : int
+val errno_erange : int
+val errno_enotempty : int
