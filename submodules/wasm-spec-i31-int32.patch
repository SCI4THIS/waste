diff --git 1/interpreter/exec/control.ml 2/interpreter/exec/control.ml
new file mode 100644
index 000000000..c1f077b27
--- /dev/null
+++ 2/interpreter/exec/control.ml
@@ -0,0 +1,51 @@
+(* Browser-to-interpreter control page.
+
+   The common path performs one atomic load.  Commands are stored in a
+   single-producer ring and published by incrementing the write sequence only
+   after the payload has been written.  Keeping the read sequence in the
+   interpreter makes control state part of a schedulable process, rather than
+   hidden mutable state in JavaScript. *)
+
+type command =
+  | Pause
+  | Terminate
+  | Signal of int
+
+type state = {mutable read_sequence : int}
+
+let header_words = 4
+let ring_words = 256
+let ring_mask = ring_words - 1
+
+let enabled = ref false
+
+external atomic_load : int -> int = "waste_control_atomic_load"
+external wait_while_paused : unit -> unit = "waste_control_wait_while_paused"
+
+let enable () = enabled := true
+let disable () = enabled := false
+let is_enabled () = !enabled
+let create () = {read_sequence = 0}
+let copy state = {read_sequence = state.read_sequence}
+
+let decode word =
+  let operation = word lsr 16 in
+  let argument = word land 0xffff in
+  match operation with
+  | 1 -> Some Pause
+  | 2 -> Some (Signal argument)
+  | 3 -> Some Terminate
+  | _ -> None
+
+let poll state =
+  if not !enabled then None else
+  let published = atomic_load 0 in
+  if published = state.read_sequence then None else begin
+    let next = state.read_sequence + 1 in
+    let slot = header_words + (next land ring_mask) in
+    let command = decode (atomic_load slot) in
+    state.read_sequence <- next;
+    command
+  end
+
+let pause () = if !enabled then wait_while_paused ()
