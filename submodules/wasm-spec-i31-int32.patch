--- /dev/null
+++ w/interpreter/exec/control.mli
@@ -0,0 +1,14 @@
+type command = Pause | Terminate | Signal of int | Input of int
+type state
+
+val header_words : int
+val ring_words : int
+val enable : unit -> unit
+val disable : unit -> unit
+val is_enabled : unit -> bool
+val create : unit -> state
+val copy : state -> state
+val poll : state -> command option
+val pause : unit -> unit
+val defer : (unit -> unit) -> int -> unit
+val sleep_ms : int -> unit
diff --git c/interpreter/host/control_runtime.wat w/interpreter/host/control_runtime.wat
new file mode 100644
index 000000000..1b0227641
--- /dev/null
+++ w/interpreter/host/control_runtime.wat
@@ -0,0 +1,32 @@
+(module
+  (import "js" "waste_control_atomic_load_js"
+    (func $atomic_load (param i32) (result i32)))
+  (import "js" "waste_control_wait_while_paused_js"
+    (func $wait_while_paused (result i32)))
+  (import "js" "waste_control_wait_timeout_js"
+    (func $wait_timeout (param i32) (result i32)))
+  (import "js" "waste_clock_part_js"
+    (func $clock_part (param i32 i32) (result i32)))
+
+  (func (export "waste_control_atomic_load")
+    (param $index (ref eq)) (result (ref eq))
+    (ref.i31
+      (call $atomic_load
+        (i31.get_s (ref.cast (ref i31) (local.get $index))))))
+
+  (func (export "waste_control_wait_while_paused")
+    (param (ref eq)) (result (ref eq))
+    (drop (call $wait_while_paused))
+    (ref.i31 (i32.const 0)))
+
+  (func (export "waste_control_wait_timeout")
+    (param $milliseconds (ref eq)) (result (ref eq))
+    (drop (call $wait_timeout
+      (i31.get_s (ref.cast (ref i31) (local.get $milliseconds)))))
+    (ref.i31 (i32.const 0)))
+
+  (func (export "waste_clock_part")
+    (param $kind (ref eq)) (param $index (ref eq)) (result (ref eq))
+    (ref.i31 (call $clock_part
+      (i31.get_s (ref.cast (ref i31) (local.get $kind)))
+      (i31.get_s (ref.cast (ref i31) (local.get $index)))))))
diff --git c/interpreter/host/posix.ml w/interpreter/host/posix.ml
new file mode 100644
index 000000000..6e6acabf5
--- /dev/null
+++ w/interpreter/host/posix.ml
@@ -0,0 +1,702 @@
+open Value
+open Instance
+
+(* Host calls raise this request so Eval can service it with the invoking
+   module instance and the currently selected process state. *)
+exception Syscall of string * value list
+type wait = Posix_kernel.wait_reason
+
+type disposition = Default | Ignore | Handler of int32
+
+type signal_action =
+{
+  disposition : disposition;
+  mask : int64;
+  flags : int32;
+}
+
+type state =
+{
+  control : Control.state;
+  mutable blocked : int64;
+  mutable pending : int64;
+  mutable deliverable : bool;
+  actions : signal_action array;
+  process : Posix_kernel.process;
+  peers : (int32, state) Hashtbl.t;
+  mutable sleep_deadline : int64 option;
+  mutable last_error : int;
+}
+
+type result =
+  | Return of value list
+  | SaveJump of int32 * bool
+  | RestoreJump of int32 * int32
+  | Block of Posix_kernel.wait_reason
+  | Fork of state * int32
+  | Exit of int
+
+type default_effect = Default_ignore | Default_continue | Default_stop of wait | Default_terminate
+
+exception Terminated of int
+
+let signal_max = 64
+
+let create () =
+  let _, process = Posix_kernel.create ~clock:Posix_clock.monotonic_ms () in
+  let peers = Hashtbl.create 16 in
+  let state =
+    {control = Control.create (); blocked = 0L; pending = 0L; deliverable = false;
+     process; peers;
+     sleep_deadline = None; last_error = 0;
+     actions = Array.init (signal_max + 1)
+       (fun _ -> {disposition = Default; mask = 0L; flags = 0l})}
+  in
+  Hashtbl.add peers (Posix_kernel.pid process) state;
+  state
+
+let copy state =
+  let _, process = Posix_kernel.clone_isolated state.process in
+  let peers = Hashtbl.create 16 in
+  let copied =
+    {control = Control.copy state.control; blocked = state.blocked;
+     pending = state.pending; deliverable = state.deliverable;
+     actions = Array.copy state.actions; process; peers;
+     sleep_deadline = None; last_error = state.last_error}
+  in
+  Hashtbl.add peers (Posix_kernel.pid process) copied;
+  copied
+
+let fork state =
+  let process = Posix_kernel.fork state.process in
+  let child =
+    {control = Control.copy state.control; blocked = state.blocked; pending = 0L;
+     deliverable = false;
+     actions = Array.copy state.actions; process; peers = state.peers;
+     sleep_deadline = None; last_error = state.last_error}
+  in
+  Hashtbl.add state.peers (Posix_kernel.pid process) child;
+  child
+
+let pid state = Posix_kernel.pid state.process
+let terminate state cause = Posix_kernel.terminate state.process cause
+let next_timer_delay_ms state =
+  let now = Posix_kernel.now_ms state.process in
+  let sleep = Option.map (fun deadline -> max 0L (Int64.sub deadline now)) state.sleep_deadline in
+  match sleep, Posix_kernel.next_timer_delay_ms state.process with
+  | None, timer | timer, None -> timer
+  | Some left, Some right -> Some (min left right)
+
+let blocked state = state.blocked
+let refresh_deliverable state =
+  state.deliverable <-
+    Int64.logand state.pending (Int64.lognot state.blocked) <> 0L
+let set_blocked state mask =
+  state.blocked <- mask;
+  refresh_deliverable state
+let reset_action state signal =
+  state.actions.(signal) <- {disposition = Default; mask = 0L; flags = 0l}
+
+let bit signal =
+  if signal < 1 || signal > signal_max then None else
+  Some Int64.(shift_left 1L (signal - 1))
+
+let queue_signal state signal =
+  match bit signal with
+  | None -> false
+  | Some mask ->
+    state.pending <- Int64.logor state.pending mask;
+    if Int64.logand state.blocked mask = 0L then state.deliverable <- true;
+    true
+
+let signal_pending state = state.deliverable
+
+let poll_required state =
+  state.deliverable || Control.is_enabled () || Posix_kernel.has_timers state.process
+
+let next_signal state =
+  if not state.deliverable then None else
+    let ready = Int64.logand state.pending (Int64.lognot state.blocked) in
+    let rec find signal =
+      if signal > signal_max then None else
+      match bit signal with
+      | Some mask when Int64.logand ready mask <> 0L ->
+        state.pending <- Int64.logand state.pending (Int64.lognot mask);
+        refresh_deliverable state;
+        Some (signal, state.actions.(signal))
+      | _ -> find (signal + 1)
+    in find 1
+
+let apply_default state signal =
+  match signal with
+  | 17 | 23 | 28 -> Default_ignore (* SIGCHLD, SIGURG, SIGWINCH *)
+  | 18 -> Posix_kernel.continue state.process; Default_continue (* SIGCONT *)
+  | 19 | 20 | 21 | 22 ->
+    Posix_kernel.stop state.process signal;
+    Default_stop (Posix_kernel.stopped_wait state.process)
+  | _ ->
+    Posix_kernel.terminate state.process (Posix_kernel.Signaled signal);
+    Default_terminate
+
+let rec poll_control state =
+  List.iter (fun signal -> ignore (queue_signal state signal))
+    (Posix_kernel.poll_timers state.process);
+  match Control.poll state.control with
+  | None -> ()
+  | Some Control.Pause -> Control.pause (); poll_control state
+  | Some (Control.Signal signal) -> ignore (queue_signal state signal); poll_control state
+  | Some (Control.Input byte) ->
+    Posix_kernel.process_terminal_feed state.process (String.make 1 (Char.chr (byte land 0xff)));
+    poll_control state
+  | Some Control.Terminate -> raise (Terminated 143)
+
+let wait_ready state wait =
+  poll_control state;
+  Int64.logand state.pending (Int64.lognot state.blocked) <> 0L ||
+  Posix_kernel.wait_ready state.process wait
+
+let request name values = raise (Syscall (name, values))
+
+let i32 = function
+  | Num (I32 value) -> value
+  | _ -> invalid_arg "Posix.i32"
+
+let return_i32 value = Return [Num (I32 value)]
+let return_i64 value = Return [Num (I64 value)]
+let memory inst = Lib.List32.nth inst.memories 0l
+
+let load_u32 mem address =
+  let byte n = Int32.of_int (Memory.load_byte mem Int64.(add (of_int32 address) (of_int n))) in
+  Int32.logor (byte 0)
+    (Int32.logor (Int32.shift_left (byte 1) 8)
+      (Int32.logor (Int32.shift_left (byte 2) 16) (Int32.shift_left (byte 3) 24)))
+
+let store_u32 mem address value =
+  for n = 0 to 3 do
+    Memory.store_byte mem Int64.(add (of_int32 address) (of_int n))
+      Int32.(to_int (logand (shift_right_logical value (n * 8)) 0xffl))
+  done
+
+let load_u64 mem address =
+  let low = Int64.logand (Int64.of_int32 (load_u32 mem address)) 0xffff_ffffL in
+  let high = Int64.shift_left
+      (Int64.logand (Int64.of_int32 (load_u32 mem (Int32.add address 4l))) 0xffff_ffffL) 32 in
+  Int64.logor low high
+
+let store_u64 mem address value =
+  store_u32 mem address (Int64.to_int32 value);
+  store_u32 mem (Int32.add address 4l) (Int64.to_int32 (Int64.shift_right_logical value 32))
+
+let load_string mem address =
+  let buffer = Buffer.create 64 in
+  let rec loop offset =
+    let byte = Memory.load_byte mem Int64.(add (of_int32 address) (of_int offset)) in
+    if byte = 0 then Buffer.contents buffer else begin
+      Buffer.add_char buffer (Char.chr byte);
+      loop (offset + 1)
+    end
+  in loop 0
+
+let store_string mem address capacity string =
+  let capacity = Int32.to_int capacity in
+  if capacity <= String.length string then false else begin
+    Memory.store_bytes mem (Int64.of_int32 address) string;
+    Memory.store_byte mem Int64.(add (of_int32 address) (of_int (String.length string))) 0;
+    true
+  end
+
+let set_error state error = state.last_error <- error; return_i32 (-1l)
+let result_i32 state = function Ok value -> return_i32 (Int32.of_int value) | Error error -> set_error state error
+let result_unit state = function Ok () -> return_i32 0l | Error error -> set_error state error
+
+let load_sigset mem address =
+  let low = Int64.logand (Int64.of_int32 (load_u32 mem address)) 0xffff_ffffL in
+  let high = Int64.shift_left
+      (Int64.logand (Int64.of_int32 (load_u32 mem (Int32.add address 4l))) 0xffff_ffffL) 32 in
+  Int64.logor low high
+
+let store_sigset mem address set =
+  for n = 0 to 127 do
+    let value =
+      if n < 8 then Int64.(to_int (logand (shift_right_logical set (n * 8)) 0xffL))
+      else 0
+    in
+    Memory.store_byte mem Int64.(add (of_int32 address) (of_int n)) value
+  done
+
+let valid_signal signal = signal >= 1 && signal <= signal_max
+
+let sigemptyset inst = function
+  | [set] -> store_sigset (memory inst) (i32 set) 0L; return_i32 0l
+  | _ -> invalid_arg "sigemptyset"
+
+let sigaddset operation inst = function
+  | [set; signal_value] ->
+    let address, signal = i32 set, Int32.to_int (i32 signal_value) in
+    if not (valid_signal signal) then return_i32 (-1l) else
+    let mem = memory inst in
+    let mask = Option.get (bit signal) in
+    let old = load_sigset mem address in
+    let value = if operation = `Add then Int64.logor old mask
+      else Int64.logand old (Int64.lognot mask) in
+    store_sigset mem address value;
+    return_i32 0l
+  | _ -> invalid_arg "sigaddset"
+
+let sigismember inst = function
+  | [set; signal_value] ->
+    let signal = Int32.to_int (i32 signal_value) in
+    if not (valid_signal signal) then return_i32 (-1l) else
+    let mask = Option.get (bit signal) in
+    return_i32 (if Int64.logand (load_sigset (memory inst) (i32 set)) mask <> 0L
+      then 1l else 0l)
+  | _ -> invalid_arg "sigismember"
+
+let sigprocmask state inst = function
+  | [how_value; set_value; old_value] ->
+    let how, set, old = i32 how_value, i32 set_value, i32 old_value in
+    let mem = memory inst in
+    if old <> 0l then store_sigset mem old state.blocked;
+    if set = 0l then return_i32 0l else
+    let requested = load_sigset mem set in
+    begin match how with
+    | 0l -> set_blocked state (Int64.logor state.blocked requested)
+    | 1l -> set_blocked state (Int64.logand state.blocked (Int64.lognot requested))
+    | 2l -> set_blocked state requested
+    | _ -> ()
+    end;
+    if how < 0l || how > 2l then return_i32 (-1l) else return_i32 0l
+  | _ -> invalid_arg "sigprocmask"
+
+(* wasm32 glibc layout used by src/bash.wat:
+   sa_handler +0, sa_mask +4 (128 bytes), sa_flags +132. *)
+let sigaction state inst = function
+  | [signal_value; action_value; old_value] ->
+    let signal = Int32.to_int (i32 signal_value) in
+    let action, old = i32 action_value, i32 old_value in
+    if not (valid_signal signal) || signal = 9 || signal = 19 then return_i32 (-1l) else
+    let mem = memory inst in
+    if old <> 0l then begin
+      let previous = state.actions.(signal) in
+      let handler = match previous.disposition with
+        | Default -> 0l | Ignore -> 1l | Handler index -> index in
+      store_u32 mem old handler;
+      store_sigset mem (Int32.add old 4l) previous.mask;
+      store_u32 mem (Int32.add old 132l) previous.flags
+    end;
+    if action <> 0l then begin
+      let handler = load_u32 mem action in
+      let disposition =
+        if handler = 0l || handler = -1l then Default
+        else if handler = 1l || handler = -2l then Ignore
+        else Handler handler in
+      state.actions.(signal) <-
+        {disposition; mask = load_sigset mem (Int32.add action 4l);
+         flags = load_u32 mem (Int32.add action 132l)}
+    end;
+    return_i32 0l
+  | _ -> invalid_arg "sigaction"
+
+let send_current state signal =
+  if signal = 0 then 0l
+  else if queue_signal state signal then 0l else -1l
+
+let deliver state target signal =
+  if signal = 0 then 0l else
+  match Hashtbl.find_opt state.peers (Posix_kernel.pid target) with
+  | Some peer when queue_signal peer signal ->
+    if signal = 18 then Posix_kernel.continue target;
+    0l
+  | Some _ -> -1l
+  | None -> -1l
+
+let deliver_all state targets signal =
+  if signal < 0 || signal > signal_max then -1l else begin
+    let delivered = List.fold_left (fun count target ->
+      if deliver state target signal = 0l then count + 1 else count) 0 targets in
+    if delivered > 0 || signal = 0 then 0l else -1l
+  end
+
+let kill state = function
+  | [pid_value; signal_value] ->
+    let target = i32 pid_value in
+    let signal = Int32.to_int (i32 signal_value) in
+    begin match Posix_kernel.signal_targets state.process target with
+    | Some targets -> return_i32 (deliver_all state targets signal)
+    | None -> set_error state Posix_kernel.errno_esrch
+    end
+  | _ -> invalid_arg "kill"
+
+let killpg state = function
+  | [group_value; signal_value] ->
+    let group = i32 group_value in
+    let signal = Int32.to_int (i32 signal_value) in
+    begin match Posix_kernel.process_group_targets state.process group with
+    | Some targets -> return_i32 (deliver_all state targets signal)
+    | None -> set_error state Posix_kernel.errno_esrch
+    end
+  | _ -> invalid_arg "killpg"
+
+let raise_signal state = function
+  | [signal_value] ->
+    return_i32 (send_current state (Int32.to_int (i32 signal_value)))
+  | _ -> invalid_arg "raise"
+
+let getpid state = return_i32 (Posix_kernel.pid state.process)
+let getppid state = return_i32 (Posix_kernel.ppid state.process)
+let getpgrp state = return_i32 (Posix_kernel.pgid state.process)
+
+let setpgid state = function
+  | [target; group] ->
+    if Posix_kernel.setpgid state.process (i32 target) (i32 group) then return_i32 0l
+    else set_error state Posix_kernel.errno_eperm
+  | _ -> invalid_arg "setpgid"
+
+let setsid state = function
+  | [] ->
+    begin match Posix_kernel.setsid state.process with
+    | Some session -> return_i32 session
+    | None -> set_error state Posix_kernel.errno_eperm
+    end
+  | _ -> invalid_arg "setsid"
+
+let fork_process state = function
+  | [] ->
+    let child = fork state in
+    Fork (child, pid child)
+  | _ -> invalid_arg "fork"
+
+let exit_process = function
+  | [status] -> (Exit (Int32.to_int (i32 status)) : result)
+  | _ -> invalid_arg "exit"
+
+let waitpid state inst = function
+  | [target_value; status_address; options_value] ->
+    let target = i32 target_value in
+    let status_address = i32 status_address in
+    let options = i32 options_value in
+    let target =
+      if target = -1l then Posix_kernel.Any_child
+      else if target > 0l then Posix_kernel.Child target
+      else if target = 0l then Posix_kernel.Process_group (Posix_kernel.pgid state.process)
+      else Posix_kernel.Process_group (Int32.neg target) in
+    let nohang = Int32.logand options 1l <> 0l in
+    let untraced = Int32.logand options 2l <> 0l in
+    let continued = Int32.logand options 8l <> 0l in
+    begin match Posix_kernel.waitpid state.process target ~nohang ~untraced ~continued with
+    | Posix_kernel.Child_exited (child, status) ->
+      Hashtbl.remove state.peers child;
+      if status_address <> 0l then store_u32 (memory inst) status_address (Int32.of_int status);
+      return_i32 child
+    | Posix_kernel.Child_stopped (child, signal) ->
+      if status_address <> 0l then store_u32 (memory inst) status_address (Int32.of_int ((signal lsl 8) lor 0x7f));
+      return_i32 child
+    | Posix_kernel.Child_continued child ->
+      if status_address <> 0l then store_u32 (memory inst) status_address 0xffffl;
+      return_i32 child
+    | Posix_kernel.No_children -> set_error state Posix_kernel.errno_echild
+    | Posix_kernel.Would_block when nohang -> return_i32 0l
+    | Posix_kernel.Would_block -> Block Posix_kernel.child_wait
+    end
+  | _ -> invalid_arg "waitpid"
+
+let open_file state inst = function
+  | [path; flags; mode] ->
+    let path = load_string (memory inst) (i32 path) in
+    result_i32 state (Posix_kernel.open_file state.process path (i32 flags) (i32 mode))
+  | _ -> invalid_arg "open"
+
+let close_file state = function
+  | [fd] -> result_unit state (Posix_kernel.close state.process (Int32.to_int (i32 fd)))
+  | _ -> invalid_arg "close"
+
+let read_file state inst = function
+  | [fd; address; count] ->
+    let fd, address, count = Int32.to_int (i32 fd), i32 address, Int32.to_int (i32 count) in
+    begin match Posix_kernel.read state.process fd count with
+    | Posix_kernel.Done string ->
+      Memory.store_bytes (memory inst) (Int64.of_int32 address) string;
+      return_i32 (Int32.of_int (String.length string))
+    | Posix_kernel.End_of_file -> return_i32 0l
+    | Posix_kernel.Blocked wait -> Block wait
+    | Posix_kernel.Read_signal signal ->
+      ignore (queue_signal state signal);
+      set_error state Posix_kernel.errno_eintr
+    | Posix_kernel.Read_error error -> set_error state error
+    end
+  | _ -> invalid_arg "read"
+
+let write_file state inst = function
+  | [fd; address; count] ->
+    let fd, address, count = Int32.to_int (i32 fd), i32 address, Int32.to_int (i32 count) in
+    let string = Memory.load_bytes (memory inst) (Int64.of_int32 address) count in
+    begin match Posix_kernel.write state.process fd string with
+    | Posix_kernel.Written count ->
+      if fd = 1 || fd = 2 then (print_string (String.sub string 0 count); flush_all ());
+      return_i32 (Int32.of_int count)
+    | Posix_kernel.Write_blocked wait -> Block wait
+    | Posix_kernel.Write_error error ->
+      if error = Posix_kernel.errno_epipe then ignore (queue_signal state 13);
+      set_error state error
+    end
+  | _ -> invalid_arg "write"
+
+let pipe state inst = function
+  | [address] ->
+    begin match Posix_kernel.pipe state.process with
+    | Ok (read_fd, write_fd) ->
+      store_u32 (memory inst) (i32 address) (Int32.of_int read_fd);
+      store_u32 (memory inst) (Int32.add (i32 address) 4l) (Int32.of_int write_fd);
+      return_i32 0l
+    | Error error -> set_error state error
+    end
+  | _ -> invalid_arg "pipe"
+
+let dup state = function
+  | [fd] -> result_i32 state (Posix_kernel.dup state.process (Int32.to_int (i32 fd)) ~minimum:0 ~cloexec:false)
+  | _ -> invalid_arg "dup"
+
+let dup2 state = function
+  | [source; target] -> result_i32 state
+      (Posix_kernel.dup2 state.process (Int32.to_int (i32 source)) (Int32.to_int (i32 target)) ~cloexec:false)
+  | _ -> invalid_arg "dup2"
+
+let fcntl state = function
+  | [fd_value; command_value; argument_value] ->
+    let fd, command, argument = Int32.to_int (i32 fd_value), Int32.to_int (i32 command_value), i32 argument_value in
+    begin match command with
+    | 0 -> result_i32 state (Posix_kernel.dup state.process fd ~minimum:(Int32.to_int argument) ~cloexec:false)
+    | 1 -> result_i32 state (Result.map Int32.to_int (Posix_kernel.fd_flags state.process fd))
+    | 2 -> result_unit state (Posix_kernel.set_fd_flags state.process fd argument)
+    | 3 -> result_i32 state (Result.map Int32.to_int (Posix_kernel.status_flags state.process fd))
+    | 4 -> result_unit state (Posix_kernel.set_status_flags state.process fd argument)
+    | 1030 -> result_i32 state (Posix_kernel.dup state.process fd ~minimum:(Int32.to_int argument) ~cloexec:true)
+    | _ -> set_error state Posix_kernel.errno_einval
+    end
+  | _ -> invalid_arg "fcntl"
+
+let lseek state = function
+  | [fd; offset; whence] ->
+    begin match Posix_kernel.seek state.process (Int32.to_int (i32 fd))
+        (match offset with Num (I64 value) -> value | _ -> invalid_arg "lseek")
+        (Int32.to_int (i32 whence)) with
+    | Ok value -> return_i64 value
+    | Error error -> state.last_error <- error; return_i64 (-1L)
+    end
+  | _ -> invalid_arg "lseek"
+
+let chdir state inst = function
+  | [path] -> result_unit state (Posix_kernel.chdir state.process (load_string (memory inst) (i32 path)))
+  | _ -> invalid_arg "chdir"
+
+let getcwd state inst = function
+  | [address; size] ->
+    if store_string (memory inst) (i32 address) (i32 size) (Posix_kernel.getcwd state.process)
+    then Return [Num (I32 (i32 address))]
+    else set_error state Posix_kernel.errno_erange
+  | _ -> invalid_arg "getcwd"
+
+let unlink state inst = function
+  | [path] -> result_unit state (Posix_kernel.unlink state.process (load_string (memory inst) (i32 path)) ~directory:false)
+  | _ -> invalid_arg "unlink"
+
+let rename state inst = function
+  | [old_path; new_path] -> result_unit state
+      (Posix_kernel.rename state.process (load_string (memory inst) (i32 old_path)) (load_string (memory inst) (i32 new_path)))
+  | _ -> invalid_arg "rename"
+
+let access state inst = function
+  | path :: _ ->
+    if Posix_kernel.access state.process (load_string (memory inst) (i32 path)) then return_i32 0l
+    else set_error state Posix_kernel.errno_enoent
+  | _ -> invalid_arg "access"
+
+let isatty state = function
+  | [fd] -> return_i32 (if Posix_kernel.isatty state.process (Int32.to_int (i32 fd)) then 1l else 0l)
+  | _ -> invalid_arg "isatty"
+
+let tcgetpgrp state = function
+  | [fd] ->
+    begin match Posix_kernel.tty_foreground_group state.process (Int32.to_int (i32 fd)) with
+    | Ok group -> return_i32 group | Error error -> set_error state error end
+  | _ -> invalid_arg "tcgetpgrp"
+
+let tcsetpgrp state = function
+  | [fd; group] -> result_unit state
+      (Posix_kernel.tty_set_foreground_group state.process (Int32.to_int (i32 fd)) (i32 group))
+  | _ -> invalid_arg "tcsetpgrp"
+
+let tcgetattr state inst = function
+  | [fd; address] ->
+    begin match Posix_kernel.tty_get_attributes state.process (Int32.to_int (i32 fd)) with
+    | Ok attributes -> Memory.store_bytes (memory inst) (Int64.of_int32 (i32 address)) attributes; return_i32 0l
+    | Error error -> set_error state error
+    end
+  | _ -> invalid_arg "tcgetattr"
+
+let tcsetattr state inst = function
+  | [fd; _actions; address] ->
+    let attributes = Memory.load_bytes (memory inst) (Int64.of_int32 (i32 address)) 60 in
+    result_unit state (Posix_kernel.tty_set_attributes state.process (Int32.to_int (i32 fd)) attributes)
+  | _ -> invalid_arg "tcsetattr"
+
+let alarm state = function
+  | [seconds] -> return_i32 (Int64.to_int32 (Posix_kernel.set_alarm state.process (Int64.of_int32 (i32 seconds))))
+  | _ -> invalid_arg "alarm"
+
+let sleep state = function
+  | [seconds] ->
+    let now = Posix_kernel.now_ms state.process in
+    begin match state.sleep_deadline with
+    | Some deadline when deadline <= now -> state.sleep_deadline <- None; return_i32 0l
+    | Some deadline -> Block (Posix_kernel.deadline_wait deadline)
+    | None ->
+      let deadline = Int64.add now (Int64.mul (Int64.of_int32 (i32 seconds)) 1000L) in
+      state.sleep_deadline <- Some deadline;
+      if i32 seconds = 0l then (state.sleep_deadline <- None; return_i32 0l)
+      else Block (Posix_kernel.deadline_wait deadline)
+    end
+  | _ -> invalid_arg "sleep"
+
+let time state inst = function
+  | [address] ->
+    let seconds = Int64.div (Posix_clock.realtime_ms ()) 1000L in
+    if i32 address <> 0l then store_u64 (memory inst) (i32 address) seconds;
+    return_i64 seconds
+  | _ -> invalid_arg "time"
+
+let gettimeofday state inst = function
+  | [address; _timezone] ->
+    let milliseconds = Posix_clock.realtime_ms () in
+    store_u64 (memory inst) (i32 address) (Int64.div milliseconds 1000L);
+    store_u32 (memory inst) (Int32.add (i32 address) 8l)
+      (Int64.to_int32 (Int64.mul (Int64.rem milliseconds 1000L) 1000L));
+    return_i32 0l
+  | _ -> invalid_arg "gettimeofday"
+
+let setitimer state inst = function
+  | [_which; new_address; old_address] ->
+    let mem = memory inst in
+    let timeval_ms address =
+      Int64.add (Int64.mul (load_u64 mem address) 1000L)
+        (Int64.div (Int64.of_int32 (load_u32 mem (Int32.add address 8l))) 1000L) in
+    let new_address = i32 new_address in
+    let interval = timeval_ms new_address in
+    let initial = timeval_ms (Int32.add new_address 16l) in
+    let previous_initial, previous_interval =
+      Posix_kernel.set_interval_timer state.process ~initial_ms:initial ~interval_ms:interval in
+    if i32 old_address <> 0l then begin
+      let store_timeval address milliseconds =
+        store_u64 mem address (Int64.div milliseconds 1000L);
+        store_u32 mem (Int32.add address 8l) (Int64.to_int32 (Int64.mul (Int64.rem milliseconds 1000L) 1000L));
+        store_u32 mem (Int32.add address 12l) 0l in
+      store_timeval (i32 old_address) previous_interval;
+      store_timeval (Int32.add (i32 old_address) 16l) previous_initial
+    end;
+    return_i32 0l
+  | _ -> invalid_arg "setitimer"
+
+let store_stat mem address (info : Posix_kernel.node_info) =
+  store_u64 mem address info.Posix_kernel.inode;
+  store_u32 mem (Int32.add address 8l) info.Posix_kernel.mode;
+  store_u32 mem (Int32.add address 12l) info.Posix_kernel.links;
+  store_u32 mem (Int32.add address 16l) info.Posix_kernel.uid;
+  store_u32 mem (Int32.add address 20l) info.Posix_kernel.gid;
+  store_u64 mem (Int32.add address 24l) info.Posix_kernel.size;
+  let timestamp offset milliseconds =
+    store_u64 mem (Int32.add address offset) (Int64.div milliseconds 1000L);
+    store_u32 mem (Int32.add address (Int32.add offset 8l))
+      (Int64.to_int32 (Int64.mul (Int64.rem milliseconds 1000L) 1_000_000L)) in
+  timestamp 40l info.Posix_kernel.atime_ms;
+  timestamp 56l info.Posix_kernel.mtime_ms;
+  timestamp 72l info.Posix_kernel.ctime_ms
+
+let stat state inst follow = function
+  | [path; address] ->
+    begin match Posix_kernel.stat state.process (load_string (memory inst) (i32 path)) ~follow with
+    | Ok info -> store_stat (memory inst) (i32 address) info; return_i32 0l
+    | Error error -> set_error state error
+    end
+  | _ -> invalid_arg "stat"
+
+let fstat state inst = function
+  | [fd; address] ->
+    begin match Posix_kernel.fstat state.process (Int32.to_int (i32 fd)) with
+    | Ok info -> store_stat (memory inst) (i32 address) info; return_i32 0l
+    | Error error -> set_error state error
+    end
+  | _ -> invalid_arg "fstat"
+
+let fchmod state = function
+  | [fd; mode] -> result_unit state
+      (Posix_kernel.fchmod state.process (Int32.to_int (i32 fd)) (i32 mode))
+  | _ -> invalid_arg "fchmod"
+
+let umask state = function
+  | [mask] -> return_i32 (Posix_kernel.umask state.process (i32 mask))
+  | _ -> invalid_arg "umask"
+
+let getdtablesize = function
+  | [] -> return_i32 1024l
+  | _ -> invalid_arg "getdtablesize"
+
+let dispatch state inst name values =
+  match name with
+  | "sigsetjmp" ->
+    begin match values with
+    | [buffer; save_mask] -> SaveJump (i32 buffer, i32 save_mask <> 0l)
+    | _ -> invalid_arg name
+    end
+  | "siglongjmp" ->
+    begin match values with
+    | [buffer; value] -> RestoreJump (i32 buffer, i32 value)
+    | _ -> invalid_arg name
+    end
+  | "sigemptyset" -> sigemptyset inst values
+  | "sigaddset" -> sigaddset `Add inst values
+  | "sigdelset" -> sigaddset `Delete inst values
+  | "sigismember" -> sigismember inst values
+  | "sigprocmask" -> sigprocmask state inst values
+  | "sigaction" -> sigaction state inst values
+  | "kill" -> kill state values
+  | "killpg" -> killpg state values
+  | "raise" -> raise_signal state values
+  | "getpid" -> getpid state
+  | "getppid" -> getppid state
+  | "getpgrp" -> getpgrp state
+  | "setpgid" -> setpgid state values
+  | "setsid" -> setsid state values
+  | "fork" -> fork_process state values
+  | "waitpid" -> waitpid state inst values
+  | "exit" | "_exit" -> exit_process values
+  | "open" -> open_file state inst values
+  | "close" -> close_file state values
+  | "read" -> read_file state inst values
+  | "write" -> write_file state inst values
+  | "pipe" -> pipe state inst values
+  | "dup" -> dup state values
+  | "dup2" -> dup2 state values
+  | "fcntl" -> fcntl state values
+  | "lseek" -> lseek state values
+  | "chdir" -> chdir state inst values
+  | "getcwd" -> getcwd state inst values
+  | "unlink" -> unlink state inst values
+  | "rename" -> rename state inst values
+  | "access" | "eaccess" | "faccessat" -> access state inst values
+  | "isatty" -> isatty state values
+  | "tcgetpgrp" -> tcgetpgrp state values
+  | "tcsetpgrp" -> tcsetpgrp state values
+  | "tcgetattr" -> tcgetattr state inst values
+  | "tcsetattr" -> tcsetattr state inst values
+  | "alarm" -> alarm state values
+  | "sleep" -> sleep state values
+  | "time" -> time state inst values
+  | "gettimeofday" -> gettimeofday state inst values
+  | "setitimer" -> setitimer state inst values
+  | "stat" -> stat state inst true values
+  | "lstat" -> stat state inst false values
+  | "fstat" -> fstat state inst values
+  | "fchmod" -> fchmod state values
+  | "umask" -> umask state values
+  | "getdtablesize" -> getdtablesize values
+  | _ -> invalid_arg ("unsupported POSIX dispatch: " ^ name)
