diff --git a/gnulib/lib/fpending.c b/gnulib/lib/fpending.c
index 0000000..0000000 100644
--- a/gnulib/lib/fpending.c
+++ b/gnulib/lib/fpending.c
@@ -55,4 +55,7 @@ __fpending (FILE *fp)
 #elif defined EPLAN9                 /* Plan9 */
   return fp->wp - fp->buf;
+#elif defined WASTE_WASM             /* WASTE guest FILE has no host layout */
+  (void) fp;
+  return 0;
 #else
 # error "Please port gnulib fpending.c to your platform!"

